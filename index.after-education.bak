const CAT_REC_PCT={Housing:'25–35%',Food:'10–15%',Transport:'10–15%',Bills:'10–15%',Medical:'3–7%',Entertainment:'3–5%',Shopping:'3–5%',Subscriptions:'3–5%',Charity:'2–5%',Investments:'10–20%',['Credit Card Payments']:'5–15%',Education:'varies',Fees:'avoid',Other:'remaining'};
const BUDGET_FRAMEWORK={
  '50-30-20':{Housing:25,Food:10,Transport:5,Bills:8,Medical:2,Shopping:10,Entertainment:8,Subscriptions:8,Charity:4,Investments:10,['Credit Card Payments']:5,Other:0},
  '60-20-20':{Housing:30,Food:12,Transport:8,Bills:10,Medical:5,Shopping:7,Entertainment:7,Subscriptions:6,Charity:3,Investments:8,['Credit Card Payments']:4,Other:0}
};
const INCOME_SRC_CLR={Salary:'#6366f1',DirectDeposit:'#8b5cf6',Government:'#14b8a6',Rewards:'#f97316',Deposit:'#22c55e',Zelle:'#3b82f6',Interest:'#f59e0b',Misc:'#ec4899',Refund:'#06b6d4',Transfers:'#84cc16',Other:'#6b7280'};

// Build flat sorted keyword list once — longer keywords checked first so
// "uber eats" beats "uber" and "amazon prime" beats "amazon".
// Set to null here; will be rebuilt on first autoCat() call.
let _kwCache = null;

// Anything the bank charges you for itself — service/maintenance/late/overdraft/ATM/wire/annual/foreign-transaction
// fees, pay-plan fees, NSF — is a Fee. (HOA fees stay Housing; "coffee" etc. never match because of \b.)
const FEE_RE=/\b(fees?|overdraft protection|overdraft|nsf|insufficient funds|service charge)\b/i;
const EDU_RE=/tuition|fairleigh dic|bursar|registrar|student account|textbook|\bchegg\b|coursera|udemy/i;
function isEduDesc(desc){ return EDU_RE.test(String(desc||'')); }
function isFeeDesc(desc){ const d=String(desc||''); return FEE_RE.test(d)&&!/\bhoa\b|overdraft protection from/i.test(d)&&!EDU_RE.test(d); }

function recatExistingForCharity(){
  if(!S.transactions) return 0;
  let changed=0;
  S.transactions.forEach(tx=>{
    if(tx.override||tx.category==='Charity') return;
    if(tx.category==='Other'||!tx.category){
      const newCat=autoCat(tx.description||'');
      if(newCat==='Charity'){tx.category='Charity';changed++;}
    }
  });
  return changed;
}

function initDefaultMerchantRules(){
  if(!S.merchantRules) S.merchantRules={};
  const rules=S.merchantRules;
  const defaults={
    'mobile banking payment to crd':'Credit Card Payments',
    'payment to crd':'Credit Card Payments',
    'pmt to crd':'Credit Card Payments',
    'online payment to':'Credit Card Payments',
    'bill pay to':'Credit Card Payments',
    'ach payment to':'Credit Card Payments',
    'credit card payment':'Credit Card Payments',
    'autopay':'Credit Card Payments',
    'auto pay':'Credit Card Payments',
    'online pmt':'Credit Card Payments',
    'mobile pmt':'Credit Card Payments',
    'web pmt':'Credit Card Payments',
    'epay ':'Credit Card Payments',
    'e-payment':'Credit Card Payments',
    'payment - thank you':'Credit Card Payments',
    'transfer to robinhood':'Investments',
    'transfer to webull':'Investments',
    'transfer to fidelity':'Investments',
    'transfer to vanguard':'Investments',
    'transfer to schwab':'Investments',
    'transfer to coinbase':'Investments',
    'transfer to crypto.com':'Investments',
    'transfer to kraken':'Investments',
    'transfer to binance':'Investments',
    'transfer to betterment':'Investments',
    'transfer to wealthfront':'Investments',
    'transfer to acorns':'Investments',
    'brokerage deposit':'Investments',
    'ira contribution':'Investments'
  };
  let added=0;
  Object.entries(defaults).forEach(([kw,cat])=>{ if(!(kw in rules)){rules[kw]=cat;added++;} });
  return added;
}

function isExcludedFromSpend(t){
  if(t.internalXfer) return true;
  if(t.source==='cc-csv'&&t.isPayment) return true; // CC payment receipt on card side — not real spending
  if(t.category==='Investments'&&!S.includeInvestmentsInSpend) return true;
  if(t.category==='Credit Card Payments'&&!S.includeCCPaymentsInSpend) return true;
  return false;
}

function recatEducation(){
  if(!S.transactions) return 0;
  let n=0;
  S.transactions.forEach(tx=>{
    if(tx.override||tx.category==='Education'||tx.internalXfer||tx.isPayment||!(tx.amount<0)) return;
    if(tx.category==='Credit Card Payments'||tx.category==='Investments') return;
    if(autoCat(tx.description||tx.desc||'')==='Education'){tx.category='Education';n++;}
  });
  return n;
}

function recatFees(){
  if(!S.transactions) return 0;
  let n=0;
  S.transactions.forEach(tx=>{
    if(tx.override||tx.category==='Fees'||tx.internalXfer||tx.isPayment||!(tx.amount<0)) return;
    if(tx.category==='Credit Card Payments'||tx.category==='Investments') return;
    if(autoCat(tx.description||tx.desc||'')==='Fees'){tx.category='Fees';n++;}
  });
  return n;
}

function recatForNewCats(){
  if(!S.transactions) return 0;
  _kwCache=null;
  let changed=0;
  const targets=new Set(['Investments','Credit Card Payments']);
  S.transactions.forEach(tx=>{
    if(tx.override||targets.has(tx.category)) return;
    if(tx.category==='Transfers'||tx.category==='Other'){
      const newCat=autoCat(tx.description||'');
      if(targets.has(newCat)){tx.category=newCat;changed++;}
    }
  });
  return changed;
}

function matchCCPaymentToCard(desc,amount,date){
  const d=(desc||'').toUpperCase();
  const m=/\bCRD\s+(\d{4})\b/.exec(d);
  if(m){
    const last4=m[1];
    const card=(S.cards||[]).find(c=>(c.name||'').includes(last4));
    if(card){
      if(!card.payments) card.payments=[];
      const dup=card.payments.find(p=>p.date===date&&Math.abs(Math.abs(p.amount)-Math.abs(amount))<1);
      if(!dup) card.payments.push({date,amount:Math.abs(amount),desc:'Bank transfer'});
      return card;
    }
  }
  return null;
}
function kwList(){
  if(!_kwCache){
    _kwCache=[];
    for(const[cat,kws] of Object.entries(CAT_KW)) kws.forEach(kw=>_kwCache.push({kw,cat}));
    _kwCache.sort((a,b)=>b.kw.length-a.kw.length);
  }
  return _kwCache;
}

function autoCat(desc){
  if(!desc) return 'Other';
  const d=desc.toLowerCase();
  // Merchant memory has highest priority
  const rules=S.merchantRules||{};
  const ruleKeys=Object.keys(rules).sort((a,b)=>b.length-a.length);
  for(const kw of ruleKeys) if(d.includes(kw)) return rules[kw];
  if(isEduDesc(desc)) return 'Education';
  if(isFeeDesc(desc)) return 'Fees';
  // Apple look-through: "APPLE PAY <merchant>" → categorize by the trailing merchant.
  // A trailing space is appended so keywords like 'shell ' still match at end-of-string.
  if(d.includes('apple')){
    if(d.includes('apple pay')){
      const after=d.replace(/.*?apple pay\s*/,'').trim();
      if(after) return autoCat(after+' ');
      return 'Subscriptions';
    }
    if(d.includes('apple cash')) return 'Shopping';
    if(d.includes('apple store')) return 'Shopping';
    // APPLE.COM/BILL, APPLE SUBSCRIPTION, bare APPLE → Subscriptions
    return 'Subscriptions';
  }
  // Built-in keyword list
  for(const{kw,cat} of kwList()) if(d.includes(kw)) return cat;
  return 'Other';
}

// ── CSV FORMAT DETECTION ──────────────────────────────────────────────────────
const SUMMARY_RE=/ending balance|beginning balance|total debits|total credits|opening balance|closing balance|available balance|account balance/i;

function isSummaryRow(desc){
  if(!desc||!desc.trim()) return true;
  return SUMMARY_RE.test(desc);
}

function detectFormat(headers){
  const h=headers.map(x=>x.toLowerCase().trim());
  if(h.some(x=>/running bal/i.test(x))) return 'bofa';
  if(h.some(x=>x==='payee')&&h.some(x=>/posted date/i.test(x))) return 'bofa-cc';
  if(h.some(x=>x==='asset type')&&h.some(x=>x==='transaction type')) return 'cashapp';
  if(h.some(x=>x==='currency')&&h.some(x=>x==='name')) return 'paypal';
  if(h.some(x=>x==='status')&&h.some(x=>x==='type')) return 'sofi';
  return 'auto';
}

// ── CONTENT-BASED COLUMN DETECTION ────────────────────────────────────────────
// For CSV formats we don't recognize by header name, don't guess columns by position
// (keys[1]/keys[2]) — score every column by how well its actual VALUES look like a
// date or a currency amount, and pick the best-scoring ones. Column-name hints are
// used only as a small tiebreaker. This is what getRowFields() falls back to below.
function _colDateScore(rows,key){
  if(!key) return 0;
  let hits=0,total=0;
  for(let i=0;i<rows.length;i++){
    const v=String(rows[i][key]||'').trim(); if(!v) continue;
    total++; if(normalizeDate(v)) hits++;
  }
  return total?hits/total:0;
}
function _colAmountScore(rows,key){
  if(!key) return 0;
  let hits=0,total=0;
  for(let i=0;i<rows.length;i++){
    let v=String(rows[i][key]||'').trim(); if(!v) continue;
    total++;
    v=v.replace(/[$,\s]/g,'').replace(/^\((.+)\)$/,'-$1');
    if(v&&/^-?\d+(\.\d+)?$/.test(v)) hits++;
  }
  return total?hits/total:0;
}
function _colTextScore(rows,key){
  // Rewards columns with varied, non-numeric text — the shape of a description field
  if(!key) return 0;
  let lenSum=0,total=0,numericish=0;
  for(let i=0;i<rows.length;i++){
    const v=String(rows[i][key]||'').trim(); if(!v) continue;
    total++; lenSum+=v.length;
    if(/^[-$.,()\d\s]+$/.test(v)) numericish++;
  }
  if(!total) return 0;
  const avgLen=lenSum/total,numericRatio=numericish/total;
  return Math.max(0,Math.min(1,avgLen/20)*(1-numericRatio));
}
// Scores every column of `rows` (array of {header:value} objects) and returns the
// best date/amount/description column plus a 0-1 confidence (avg of the winning
// date/amount scores) so callers can warn the user when detection is shaky.
function detectColumnsByContent(rows){
  if(!rows||!rows.length) return{dateKey:null,amtKey:null,descKey:null,confidence:0};
  const sample=rows.slice(0,Math.min(rows.length,30));
  const keys=Object.keys(sample[0]||{});
  if(!keys.length) return{dateKey:null,amtKey:null,descKey:null,confidence:0};
  const nameHint={date:/date|time|timestamp/,amount:/amount|debit|credit|sum|value|total|subtotal|net|price/};
  const pick=(scoreFn,hintRe,exclude)=>{
    let best=null;
    keys.forEach(k=>{
      if(exclude&&exclude.has(k)) return;
      const raw=scoreFn(sample,k);
      const s=raw+(hintRe.test(k.toLowerCase())?0.1:0);
      if(!best||s>best.s) best={k,s,raw};
    });
    return best;
  };
  const dateBest=pick(_colDateScore,nameHint.date,null);
  const amtBest=pick(_colAmountScore,nameHint.amount,new Set(dateBest&&dateBest.raw>0?[dateBest.k]:[]));
  const used=new Set([dateBest&&dateBest.raw>0?dateBest.k:null,amtBest&&amtBest.raw>0?amtBest.k:null].filter(Boolean));
  let descBest=null;
  keys.filter(k=>!used.has(k)).forEach(k=>{
    const score=_colTextScore(sample,k);
    if(!descBest||score>descBest.score) descBest={k,score};
  });
  const confidence=Math.round((((dateBest&&dateBest.raw>0?dateBest.raw:0)+(amtBest&&amtBest.raw>0?amtBest.raw:0))/2)*100)/100;
  return{
    dateKey:dateBest&&dateBest.raw>0?dateBest.k:null,
    amtKey:amtBest&&amtBest.raw>0?amtBest.k:null,
    descKey:descBest&&descBest.score>0?descBest.k:null,
    confidence
  };
}

function getRowFields(rows,fmt){
  const rowsArr=Array.isArray(rows)?rows:[rows];
  const row=rowsArr[0]||{};
  const keys=Object.keys(row);
  const find=fn=>keys.find(k=>fn(k.toLowerCase().trim()));
  let dateKey,descKey,amtKey,balKey=null,typeKey=null,statusKey=null,addrKey=null,confidence=1;
  switch(fmt){
    case 'bofa':
      dateKey=find(k=>k==='date');
      descKey=find(k=>k==='description');
      amtKey=find(k=>k==='amount');
      balKey=find(k=>/running bal/i.test(k));
      break;
    case 'bofa-cc':
      dateKey=find(k=>/posted date/i.test(k));
      descKey=find(k=>k==='payee');
      amtKey=find(k=>k==='amount');
      addrKey=find(k=>k==='address');
      break;
    case 'sofi':
      dateKey=find(k=>k==='date');
      descKey=find(k=>k==='description');
      amtKey=find(k=>k==='amount');
      balKey=find(k=>/current.?balance/i.test(k));
      typeKey=find(k=>k==='type');
      statusKey=find(k=>k==='status');
      break;
    case 'cashapp':
      dateKey=find(k=>k==='date');
      descKey=find(k=>k==='notes')||find(k=>k==='transaction type');
      amtKey=find(k=>k==='net amount')||find(k=>k==='amount');
      break;
    case 'paypal':
      dateKey=find(k=>k==='date');
      descKey=find(k=>k==='name');
      amtKey=find(k=>k==='gross')||find(k=>k.includes('gross'));
      break;
    default:{
      // Unrecognized format: score columns by actual content instead of guessing by
      // position. Falls back to name-only regex matching if content scoring is
      // inconclusive (e.g. a file with too few sample rows).
      const scored=detectColumnsByContent(rowsArr);
      dateKey=scored.dateKey||find(k=>/date/.test(k));
      amtKey=scored.amtKey||find(k=>/amount|debit|credit|sum|value/.test(k))||keys[2];
      descKey=scored.descKey||find(k=>/desc|memo|payee|narr|detail/.test(k))||keys[1];
      confidence=scored.confidence;
    }
  }
  return{dateKey,descKey,amtKey,balKey,typeKey,statusKey,addrKey,confidence};
}

function sofiCat(type,desc){
  const t=(type||'').toUpperCase().trim();
  if(isFeeDesc(desc)&&!/refund|reversal|returned/i.test(desc)) return 'Fees';
  if(t==='INTEREST_EARNED') return 'Income';
  if(t==='DIRECT_DEPOSIT') return 'Income';
  if(t==='ZELLE') return 'Transfers';
  if(t==='WITHDRAWAL') return 'Transfers';
  if(t==='DEPOSIT'){
    if(/miscellaneous credit|interest earned|sofi rewards/i.test(desc)) return 'Income';
    return 'Transfers';
  }
  return autoCat(desc);
}

function sofiIncomeType(type,desc,amount){
  const t=(type||'').toUpperCase().trim();
  if(amount<=0) return null;
  if(t==='INTEREST_EARNED') return 'Interest';
  if(t==='DIRECT_DEPOSIT'){
    if(/fairleigh dickin/i.test(desc)) return 'Salary';
    if(/irs treas|treas 310|dept of treasury|us treasury/i.test(desc)) return 'Government';
    if(/state of n\.?j|new jersey/i.test(desc)) return 'Government';
    return 'DirectDeposit';
  }
  if(t==='ZELLE') return 'Zelle';
  if(t==='DEPOSIT'){
    if(/interest earned/i.test(desc)) return 'Interest';
    if(/sofi rewards/i.test(desc)) return 'Rewards';
    if(/miscellaneous credit/i.test(desc)) return 'Misc';
    return 'Deposit';
  }
  return null;
}

function universalIncomeType(type,desc,amount,fmt){
  if(amount<=0) return null;
  if(fmt==='bofa-cc') return null;
  const t=(type||'').toUpperCase().trim();
  const dl=(desc||'').toLowerCase();

  // STEP 1 — Internal transfers: exclude entirely, never income
  if(/\b(to|from)\s+\w[\w\s]*vault\b/i.test(desc)) return null;   // any SoFi vault
  if(/online banking transfer|mobile banking transfer/i.test(dl)) return null;  // BofA
  if(/\btransfer from\b|\btransfer to\b/i.test(dl)) return null;
  if(t==='TRANSFER_IN'||t==='TRANSFER_OUT'||t==='TRANSFER') return null; // type-based

  // STEP 2 — CC payments visible as positive in bank account: not income
  if(/payment from sav|payment from chk|payment from checking/i.test(dl)) return null;
  if(/mobile banking payment to crd|online payment to\b/i.test(dl)) return null;
  if(/\bpayment - thank you\b|\bpayment-thank you\b/i.test(dl)) return null;

  // STEP 3 — Confirmed income sources (type-based first, highest confidence)
  if(t==='INTEREST_EARNED'||t==='INTEREST') return 'Interest';
  if(t==='PAYROLL') return 'Salary';
  if(t==='DIRECT_DEPOSIT'||t==='ACH_CREDIT'){
    if(/irs treas|treas 310|dept of treasury|us treasury/i.test(desc)) return 'Government';
    if(/state of |state tax|comptroller/i.test(desc)) return 'Government';
    if(/ssa treas|social security|ssi treas|va benefit|veterans|disability/i.test(desc)) return 'Government';
    return 'Salary';
  }
  if(t==='ZELLE') return 'Zelle';
  if(t==='DEPOSIT'){
    if(/interest earned|interest paid/i.test(desc)) return 'Interest';
    if(/sofi rewards|rewards redemption|cash.?back reward/i.test(desc)) return 'Rewards';
    if(/miscellaneous credit/i.test(desc)) return 'Misc';
    return null;
  }
  if(t==='CREDIT'){
    if(/payroll|direct dep|dir dep/i.test(dl)) return 'Salary';
    if(/interest/i.test(dl)) return 'Interest';
    return null;
  }
  // Description-based income detection
  if(/\bpayroll\b|paychex|adp\s+\w|gusto\b|workday\b/i.test(desc)) return 'Salary';
  if(/\bdirect dep(osit)?\b|dir dep\b|ddr\b|ach deposit\b|ach credit\b/i.test(dl)){
    if(/irs|treasury|tax refund/i.test(dl)) return 'Government';
    if(/social security|\bssa\b|\bssi\b|veteran|disability/i.test(dl)) return 'Government';
    return 'Salary';
  }
  if(/irs treas|treas 310|tax refund/i.test(dl)) return 'Government';
  if(/\bssa treas|\bssi treas|social security benefit|va benefit\b/i.test(dl)) return 'Government';
  if(/interest (paid|earned|credit)|dividend paid/i.test(dl)) return 'Interest';
  if(/cash.?back reward|rewards redemption|reward deposit/i.test(dl)) return 'Rewards';
  if(/\bzelle from\b|\bzelle credit\b/i.test(dl)) return 'Zelle';
  if(/venmo from\b|cashapp from\b|cash app from\b/i.test(dl)) return 'Transfers';
  if(/\brefund\b/i.test(dl)) return 'Refund';
  return null;
}

// One-time scan that fixes previously-imported transactions mis-tagged as income
function reclassifyExistingIncome(){
  let fixed=0;
  S.transactions.forEach(t=>{
    if(t.amount<=0) return;
    const dl=(t.description||'').toLowerCase();
    // Vault transactions are always internal, never income
    if(/\b(to|from)\s+\w[\w\s]*vault\b/i.test(t.description||'')){
      if(t.incomeType){delete t.incomeType;fixed++;}
      t.internalXfer=true; return;
    }
    // BofA-style account transfers
    if(/online banking transfer|mobile banking transfer|\btransfer from\b|\btransfer to\b/i.test(dl)){
      if(t.incomeType){delete t.incomeType;fixed++;}
      t.internalXfer=true; return;
    }
    // CC payments visible as positive amounts in bank accounts
    if(/payment from sav|payment from chk|payment from checking/i.test(dl)||
       /mobile banking payment to crd|online payment to\b/i.test(dl)||
       /\bpayment - thank you\b|\bpayment-thank you\b/i.test(dl)){
      if(t.incomeType){delete t.incomeType;fixed++;}
      return;
    }
    // Old TRANSFER_IN type incorrectly tagged as income 'Transfers'
    if(t.incomeType==='Transfers'){
      delete t.incomeType; t.internalXfer=true; fixed++;
    }
  });
  return fixed;
}

function isSofiInternalXfer(desc){
  // Covers any "to/from [Name] Vault" pattern, plus standard SoFi account transfers
  return /\b(from savings|to savings|to checking|from checking)\b/i.test(desc)
      || /\b(to|from)\s+\w[\w\s]*vault\b/i.test(desc);
}

// ── SPLIT PAYCHECK DETECTION ──────────────────────────────────────────────────
function detectSplitPaychecks(employerName){
  if(!employerName) return [];
  const empUpper=employerName.trim().toUpperCase();
  const allDeposits=S.transactions
    .filter(t=>t.amount>0&&(t.incomeType==='Salary'||t.incomeType==='DirectDeposit')&&
      (t.description||'').toUpperCase().includes(empUpper))
    .map(t=>({id:t.id,date:normalizeDate(t.date)||t.date||'',amount:t.amount,account:t.account||'',description:t.description||''}))
    .filter(t=>t.date)
    .sort((a,b)=>a.date.localeCompare(b.date));
  if(!allDeposits.length) return [];

  const paychecks=[];
  const used=new Set();

  allDeposits.forEach(deposit=>{
    if(used.has(deposit.id)) return;
    // Find deposits from different accounts within 3 days — these are split portions
    const window3=allDeposits.filter(d=>{
      if(used.has(d.id)||d.id===deposit.id) return false;
      if(d.account===deposit.account) return false; // same account = not a split
      const dayDiff=Math.abs(new Date(d.date+'T12:00:00')-new Date(deposit.date+'T12:00:00'))/86400000;
      return dayDiff<=3;
    });

    const splits=[deposit,...window3].sort((a,b)=>a.date.localeCompare(b.date));
    const totalAmount=Math.round(splits.reduce((s,d)=>s+d.amount,0)*100)/100;
    // Official payday = latest date (SoFi releases early, BofA is official)
    const officialDate=splits[splits.length-1].date;
    const earlyDate=splits[0].date;
    const isSplit=splits.length>1;
    const splitOffset=isSplit?
      Math.round((new Date(officialDate+'T12:00:00')-new Date(earlyDate+'T12:00:00'))/86400000):0;
    const groupId=splits.map(d=>d.id).sort().join(':');

    // Tag source transactions
    splits.forEach(d=>{
      const tx=S.transactions.find(t=>t.id===d.id);
      if(tx){tx.isSplitPaycheck=isSplit;if(isSplit)tx.splitGroupId=groupId;else delete tx.splitGroupId;}
    });

    paychecks.push({
      type:isSplit?'split':'single',
      totalAmount,
      payPeriodDate:officialDate,
      earlyDate,
      splitOffset,
      accounts:splits.map(d=>d.account).filter(Boolean),
      employer:employerName,
      splits:splits.map(d=>({
        account:d.account,amount:d.amount,date:d.date,
        isEarly:d.date<officialDate,
        daysEarly:Math.round((new Date(officialDate+'T12:00:00')-new Date(d.date+'T12:00:00'))/86400000)
      }))
    });
    splits.forEach(d=>used.add(d.id));
  });

  return paychecks;
}
function toggleSplitRow(idx){const el=document.getElementById('pc-split-'+idx);if(el)el.style.display=el.style.display==='none'?'':'none';}

// ── PAY SCHEDULE DETECTION ────────────────────────────────────────────────────
function detectPaySchedule(){
  const salaryTx=S.transactions
    .filter(t=>t.incomeType==='Salary')
    .map(t=>({date:normalizeDate(t.date)||t.date||'',amount:t.amount,description:t.description||''}))
    .filter(t=>t.date)
    .sort((a,b)=>a.date.localeCompare(b.date));
  if(!salaryTx.length) return null;

  // Derive employer from most common description prefix
  const descMap={};
  salaryTx.forEach(t=>{
    const words=(t.description||'').trim().toUpperCase().replace(/\s+/g,' ').split(/\s+/).slice(0,4).join(' ');
    if(words) descMap[words]=(descMap[words]||0)+1;
  });
  const topDesc=Object.entries(descMap).sort((a,b)=>b[1]-a[1])[0];
  const employer=S.confirmedEmployer||(topDesc?topDesc[0]:'Direct Deposit');

  // Use split-merged paychecks for accurate intervals and totals
  const splitPaychecks=detectSplitPaychecks(employer);
  // Fall back to raw transactions when no split data available (new import, no account field)
  const mergedEvents=splitPaychecks.length?splitPaychecks:
    salaryTx.map(t=>({type:'single',totalAmount:t.amount,payPeriodDate:t.date,earlyDate:t.date,splitOffset:0,accounts:[],splits:[{account:'',amount:t.amount,date:t.date,isEarly:false,daysEarly:0}]}));

  // Filter outlier amounts using median (removes fee reversals and partial deposits)
  const amounts=mergedEvents.map(p=>p.totalAmount).sort((a,b)=>a-b);
  const medAmt=amounts[Math.floor(amounts.length/2)];
  const payEvents=(()=>{const f=mergedEvents.filter(p=>p.totalAmount>=medAmt*0.25&&p.totalAmount<=medAmt*4);return f.length>=2?f:mergedEvents;})();
  const avgAmount=Math.round(payEvents.reduce((s,p)=>s+p.totalAmount,0)/payEvents.length*100)/100;

  let cycle='bi-weekly',cycledays=14;
  if(payEvents.length>=2){
    const sorted=[...payEvents].sort((a,b)=>a.payPeriodDate.localeCompare(b.payPeriodDate));
    const intervals=[];
    for(let i=1;i<sorted.length;i++){
      const d1=new Date(sorted[i-1].payPeriodDate+'T12:00:00'),d2=new Date(sorted[i].payPeriodDate+'T12:00:00');
      const days=Math.round((d2-d1)/86400000);
      if(days>=3) intervals.push(days); // skip near-duplicates
    }
    if(intervals.length){
      intervals.sort((a,b)=>a-b);
      const med=intervals[Math.floor(intervals.length/2)]; // median is robust to outlier gaps
      if(med<10){cycle='weekly';cycledays=7;}
      else if(med<19){cycle='bi-weekly';cycledays=14;}
      else if(med<35){cycle='semi-monthly';cycledays=15;}
      else{cycle='monthly';cycledays=30;}
    }
  }

  const lastEvent=payEvents[payEvents.length-1];
  const lastPayday=lastEvent.payPeriodDate;
  let next=new Date(lastPayday+'T12:00:00');
  const today=new Date();today.setHours(12,0,0,0);
  while(next<=today) next=new Date(next.getTime()+cycledays*86400000);
  const nextPayday=next.toISOString().split('T')[0];
  const daysAway=Math.round((next-today)/86400000);

  // Derive average early-deposit offset from split data
  const splitOccurrences=payEvents.filter(p=>p.type==='split'&&p.splitOffset>0);
  const avgSplitOffset=splitOccurrences.length?
    Math.round(splitOccurrences.reduce((s,p)=>s+p.splitOffset,0)/splitOccurrences.length):null;

  // Compute split account proportions from recent history (for planner projection)
  const splitSplit=splitOccurrences.length?
    splitOccurrences[splitOccurrences.length-1].splits.map(sp=>({account:sp.account,pct:sp.amount/splitOccurrences[splitOccurrences.length-1].totalAmount})):null;

  return{
    employer,avgAmount,cycle,cycledays,nextPayday,lastPayday,daysAway,
    count:payEvents.length,
    dates:payEvents.map(p=>p.payPeriodDate),
    amounts:payEvents.map(p=>p.totalAmount),
    paychecks:payEvents,
    hasSplits:payEvents.some(p=>p.type==='split'),
    avgSplitOffset,
    splitAccountPcts:splitSplit
  };
}

// ── AUTO-CLASSIFY NEEDS REVIEW ────────────────────────────────────────────────
function autoClassifyNeedsReview(){
  let changed=0;
  S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&!t.incomeType&&!t.isPayment).forEach(t=>{
    const dl=(t.description||'').toLowerCase();
    // Amounts under $1 are bank micro-adjustments, not income
    if(t.amount<1){t.internalXfer=true;changed++;return;}
    // Zelle deposits (exclude payment-to flows which appear negative anyway)
    if(/\bzelle\b/i.test(dl)&&!/\bpayment to\b|\bpaid to\b/i.test(dl)){t.incomeType='Zelle';changed++;return;}
    // Venmo deposits
    if(/\bvenmo\b/i.test(dl)&&!/\bpayment to\b|\bpaid to\b/i.test(dl)){t.incomeType='Transfers';changed++;return;}
    // Cash App deposits
    if(/\bcash\s?app\b/i.test(dl)&&!/\bpayment to\b|\bpaid to\b/i.test(dl)){t.incomeType='Transfers';changed++;return;}
    // Interest and dividends
    if(/interest (paid|earned|credit)|dividend (paid|credit)/i.test(dl)){t.incomeType='Interest';changed++;return;}
    // Cashback and rewards
    if(/cash.?back|rewards credit|reward deposit|points redemption/i.test(dl)){t.incomeType='Rewards';changed++;return;}
    // Fee refunds and overdraft refunds (bank crediting a fee back — not real income)
    if(/fee refund|returned fee|fee reversal|overdraft fee refund|atm fee refund/i.test(dl)){t.internalXfer=true;changed++;return;}
    // Round-up savings returned / micro-savings reversals
    if(/round.?up|round up savings|acorns|stash (transfer|deposit)/i.test(dl)){t.internalXfer=true;changed++;return;}
  });
  return changed;
}

// ── RECURRING INCOME DETECTION ────────────────────────────────────────────────
function detectRecurringIncome(){
  // Find positive non-internal transactions grouped by normalized description
  const dismissed=S.dismissedIncomeSuggestions||[];
  const confirmed=S.confirmedIncomeNames||{};
  const byDesc={};
  S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&!t.incomeType&&!t.isPayment).forEach(t=>{
    const key=(t.description||'').trim().toUpperCase().replace(/\s+/g,' ');
    if(!key||key.length<4) return;
    if(!byDesc[key]) byDesc[key]=[];
    byDesc[key].push({date:normalizeDate(t.date),amount:t.amount});
  });
  const results=[];
  for(const [desc,txs] of Object.entries(byDesc)){
    if(dismissed.includes(desc)||confirmed[desc]) continue;
    const sorted=txs.filter(t=>t.date).sort((a,b)=>a.date.localeCompare(b.date));
    if(sorted.length<2) continue;
    const amounts=sorted.map(t=>t.amount);
    const avgAmt=amounts.reduce((a,b)=>a+b,0)/amounts.length;
    const maxDev=Math.max(...amounts.map(a=>Math.abs(a-avgAmt)));
    if(maxDev>avgAmt*0.25) continue; // more than 25% variance in amount → skip
    const intervals=[];
    for(let i=1;i<sorted.length;i++){
      const d1=new Date(sorted[i-1].date+'T12:00:00'),d2=new Date(sorted[i].date+'T12:00:00');
      intervals.push(Math.round((d2-d1)/86400000));
    }
    const avgInterval=intervals.reduce((a,b)=>a+b,0)/intervals.length;
    const maxIntDev=Math.max(...intervals.map(x=>Math.abs(x-avgInterval)));
    if(maxIntDev>8) continue; // irregular — skip
    let frequency='irregular';
    if(avgInterval<9) frequency='weekly';
    else if(avgInterval<19) frequency='biweekly';
    else if(avgInterval<35) frequency='monthly';
    else continue;
    results.push({desc,count:sorted.length,avgAmount:avgAmt,frequency,lastDate:sorted[sorted.length-1].date});
  }
  return results.sort((a,b)=>b.avgAmount-a.avgAmount);
}
function confirmIncomeSource(desc,name){
  if(!S.confirmedIncomeNames) S.confirmedIncomeNames={};
  S.confirmedIncomeNames[desc]=name||desc;
  // Tag all matching untagged transactions
  S.transactions.forEach(t=>{
    const key=(t.description||'').trim().toUpperCase().replace(/\s+/g,' ');
    if(key===desc&&t.amount>0&&!t.internalXfer&&!t.incomeType&&!t.isPayment) t.incomeType='Salary';
  });
  S.paySchedule=detectPaySchedule();
  save(); renderBudget();
}
function dismissIncomeSource(desc){
  if(!S.dismissedIncomeSuggestions) S.dismissedIncomeSuggestions=[];
  if(!S.dismissedIncomeSuggestions.includes(desc)) S.dismissedIncomeSuggestions.push(desc);
  save(); renderBudget();
}
function reviewTxAsIncome(txId){
  const t=S.transactions.find(x=>x.id===txId);
  if(!t) return;
  t.incomeType='Misc';
  delete t.internalXfer;
  const key=(t.description||'').trim();
  if(key){
    if(!S.merchantRules) S.merchantRules={};
    if(!S.merchantRules[key]) S.merchantRules[key]={};
    S.merchantRules[key].isIncome=true;
    S.merchantRules[key].incomeType='Misc';
  }
  save(); renderBudget();
}
function reviewTxAsExclude(txId){
  const t=S.transactions.find(x=>x.id===txId);
  if(!t) return;
  t.internalXfer=true;
  delete t.incomeType;
  const key=(t.description||'').trim();
  if(key){
    if(!S.merchantRules) S.merchantRules={};
    if(!S.merchantRules[key]) S.merchantRules[key]={};
    S.merchantRules[key].excludeIncome=true;
  }
  save(); renderBudget();
}
function saveIncomeSettings(){
  const base=document.querySelector('input[name="f-inc-dti-base"]:checked')?.value||'net';
  const salary=parseFloat($('f-inc-salary')?.value||0)||0;
  const hourly=parseFloat($('f-inc-hourly')?.value||0)||0;
  const hours=parseFloat($('f-inc-hours')?.value||40)||40;
  const otherGross=parseFloat($('f-inc-other-gross')?.value||0)||0;
  const grossMonthly=Math.round((salary/12+hourly*hours*52/12+otherGross)*100)/100;
  const manualNet=parseFloat($('f-inc-manual-net')?.value||0)||0;
  const et=parseFloat($('f-inc-expected')?.value||0)||0;
  const st=$('f-inc-transfers')?.checked;
  const si=$('f-inc-interest')?.checked;
  const sc=$('f-inc-cashback')?.checked;
  S.incomeSettings={
    ...(S.incomeSettings||{}),
    showTransfers:!!st,showInterest:!!si,showCashback:!!sc,expectedMonthly:et,
    dtiIncomeBase:base,
    grossMonthly,grossSalary:salary,grossHourly:hourly,grossHours:hours||40,grossOther:otherGross,
    manualMonthlyNet:manualNet
  };
  // Mirror into income.configuration for the new schema
  _syncIncomeConfigFromSettings();
  DataStore.sync('income-settings');
}

function _syncIncomeConfigFromSettings(){
  const is=S.incomeSettings||{};
  const cfg=AnchorDB.income.configuration;
  cfg.dtiIncomeBase=is.dtiIncomeBase||'net';
  cfg.totalMonthlyGross=is.grossMonthly||0;
  cfg.totalMonthlyNet=is.manualMonthlyNet||getMonthlyIncomeEstimate()||0;
  cfg.totalDTIEligible=cfg.dtiIncomeBase==='gross'?cfg.totalMonthlyGross:cfg.totalMonthlyNet;
  if(is.grossMonthly>0||is.manualMonthlyNet>0){
    cfg.configuredManually=true;
    cfg.configuredAt=new Date().toISOString();
  }
}

// ── INCOME CONFIGURATION MODAL ────────────────────────────────────────────────
let _icEditData=null, _icEditingId=null;

function openIncomeConfig(){
  _icEditData=null; _icEditingId=null;
  _icRender();
  openModal('m-income-config');
}

function _icRender(){
  const srcs=AnchorDB.income.sources||[];
  const active=srcs.filter(s=>s.status!=='archived');
  const archived=srcs.filter(s=>s.status==='archived');
  const autoNet=getMonthlyIncomeEstimate()||0;
  const is=S.incomeSettings||{};
  const base=is.dtiIncomeBase||'net';
  $('income-config-body').innerHTML=`
    <div class="fs12 fw6 mb8" style="text-transform:uppercase;letter-spacing:.06em;color:var(--text-sec)">DTI Calculation Basis</div>
    <div class="g2 mb16" style="gap:8px">
      <label class="dti-basis-opt" data-basis="net" onclick="toggleDtiBasis('net')" style="cursor:pointer;display:block;border:1.5px solid ${base==='net'?'var(--accent)':'var(--border)'};border-radius:var(--r);padding:10px 12px" id="ic-basis-net">
        <input type="radio" name="f-ic-dti-base" value="net" ${base==='net'?'checked':''} style="display:none">
        <div class="fw6 fs13">Take-home (net) <span class="badge fs10" style="background:rgba(0,212,170,.15);color:var(--green)">default</span></div>
        <div class="text-muted fs11 mt2">After-tax deposits — your actual spendable cash</div>
      </label>
      <label class="dti-basis-opt" data-basis="gross" onclick="toggleDtiBasis('gross')" style="cursor:pointer;display:block;border:1.5px solid ${base==='gross'?'var(--accent)':'var(--border)'};border-radius:var(--r);padding:10px 12px" id="ic-basis-gross">
        <input type="radio" name="f-ic-dti-base" value="gross" ${base==='gross'?'checked':''} style="display:none">
        <div class="fw6 fs13">Bank standard (gross)</div>
        <div class="text-muted fs11 mt2">Pre-tax income — how lenders evaluate you</div>
      </label>
    </div>

    ${autoNet>0?`<div class="fs12 mb12" style="background:var(--surface3);border-radius:var(--r-sm);padding:8px 12px">Auto-detected from CSV: <strong style="color:var(--green)">${fmt(autoNet)}/mo</strong>. ${active.filter(s=>s.isManual).length===0?'Add sources below to override.':'Manual sources below are used for calculations.'}</div>`:''}

    <div class="fs12 fw6 mb8" style="text-transform:uppercase;letter-spacing:.06em;color:var(--text-sec)">Income Sources</div>
    <div id="ic-srcs">
      ${active.length===0&&_icEditingId!=='new'?'<div class="fs13 text-muted mb8">No income sources added yet.</div>':''}
      ${active.map(s=>_icEditingId===s.id?_icEditFormHTML():_icSourceCardHTML(s)).join('')}
      ${_icEditingId==='new'?_icEditFormHTML():''}
    </div>
    <button onclick="_icAddSource()" style="display:block;width:100%;padding:8px;border:1.5px dashed var(--border);border-radius:var(--r);background:transparent;color:var(--text-sec);font-size:13px;cursor:pointer;margin-bottom:12px">+ Add income source</button>
    ${archived.length?`<details style="margin-top:4px"><summary class="fs12 fw6" style="cursor:pointer;color:var(--muted);padding:4px 0">Past income sources (${archived.length})</summary>
      <div style="padding-top:6px">${archived.map(s=>_icSourceCardHTML(s)).join('')}</div></details>`:''}`;
}

function _icSourceCardHTML(src){
  const ist=getIncomeStatus(src);
  const st=ist.status;
  const mo=ist.includeInCalculations?(src.monthlyNet||0):(src.monthlyNet||0);
  const dr=_srcDateRange(src);
  const endingSoon=st==='ending-soon';
  const ended=st==='ended';
  const upcoming=st==='upcoming';
  const seasonalInactive=st==='seasonal-inactive';
  const archived=st==='archived';
  let contextNote='';
  if(upcoming) contextNote=`<div class="fs11 mt6" style="color:#f59e0b;background:#f59e0b18;border-radius:4px;padding:4px 8px">Not included in calculations — starts ${src.startDate}</div>`;
  else if(seasonalInactive) contextNote=`<div class="fs11 mt6" style="color:#3b82f6;background:#3b82f618;border-radius:4px;padding:4px 8px">${ist.label} — excluded from calculations this month</div>`;
  else if(endingSoon) contextNote=`<div class="fs11 mt6" style="color:#f59e0b;background:#f59e0b18;border-radius:4px;padding:4px 8px">${ist.warning||ist.label}</div>`;
  else if(ended) contextNote=`<div class="fs11 mt6" style="color:var(--red);background:var(--red)18;border-radius:4px;padding:4px 8px">Excluded from income. <button class="btn btn-ghost btn-xs" style="color:var(--green)" onclick="_reactivateSource('${src.id}')">Reactivate →</button></div>`;
  return `<div class="ic-source-card${archived?' ic-archived':''}">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
      <div style="min-width:0;flex:1">
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap">
          ${_srcTypeBadge(src.type)}
          <span class="fs14 fw6">${esc(src.name||src.type)}</span>
          ${_srcStatusBadge(src)}
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          ${mo>0?`<span class="fs13 fw7" style="color:${ist.includeInCalculations?'var(--green)':'var(--muted)'}">${fmt(mo)}/mo${!ist.includeInCalculations?' (excluded)':''}</span>`:''}
          ${dr?`<span class="fs12 text-muted">${dr}</span>`:''}
          ${src.isSeasonal?`<span class="fs11" style="color:var(--yellow)">● Seasonal</span>`:''}
        </div>
        ${contextNote}
      </div>
      <div style="display:flex;gap:4px;flex-shrink:0">
        ${!archived&&!ended?`<button class="btn btn-ghost btn-xs" onclick="_icEditSource('${src.id}')">Edit</button>`:''}
        ${archived
          ?`<button class="btn btn-ghost btn-xs" onclick="_icUnarchiveSource('${src.id}')">Restore</button>`
          :ended
          ?`<button class="btn btn-ghost btn-xs" onclick="_icEditSource('${src.id}')">Edit</button><button class="btn btn-ghost btn-xs" onclick="_icArchiveSource('${src.id}')" title="Archive this ended source">Archive</button>`
          :`<button class="btn btn-ghost btn-xs" onclick="_icArchiveSource('${src.id}')" title="Keep history but exclude from calculations">Archive</button>`}
        <button class="btn btn-ghost btn-xs" style="color:var(--red)" onclick="appConfirm('Delete this income source permanently?',{danger:true}).then(function(ok){if(ok)_icDeleteSource('${src.id}')})">✕</button>
      </div>
    </div>
  </div>`;
}

function _icEditSource(id){
  const src=(AnchorDB.income.sources||[]).find(s=>s.id===id);
  if(!src) return;
  _icEditingId=id; _icEditData={...src};
  _icRender();
}

function _icAddSource(){
  const y1=new Date();y1.setFullYear(y1.getFullYear()-1);
  _icEditData={id:uid(),type:'salary',name:'',paycheckAmount:0,payFreq:'biweekly',
    showGross:false,grossSalary:0,hourlyRate:0,hoursPerWeek:40,monthlyAvg:0,
    monthlyRent:0,benefitType:'social_security',monthlyBenefits:0,monthlyOther:0,
    startDate:y1.toISOString().split('T')[0],endDate:'',hasEndDate:false,
    isSeasonal:false,activeMonths:[],isRenewable:false,
    isManual:true,createdAt:new Date().toISOString()};
  _icEditingId='new';
  _icRender();
}

function _icEditFormHTML(){
  if(!_icEditData) return '';
  const src=_icEditData;
  const types=[{id:'salary',icon:'💼',label:'Salary'},{id:'hourly',icon:'⏰',label:'Hourly'},
    {id:'freelance',icon:'💻',label:'Freelance'},{id:'contract',icon:'📋',label:'Contract'},
    {id:'rental',icon:'🏠',label:'Rental'},{id:'benefits',icon:'🏛️',label:'Benefits'},
    {id:'other',icon:'➕',label:'Other'}];
  return `<div class="sj-income-card ic-editing">
    <div class="flex-sb mb10">
      <span class="fs11 fw6" style="text-transform:uppercase;letter-spacing:.05em;color:var(--accent)">${_icEditingId==='new'?'New income source':'Editing income source'}</span>
      <button class="btn btn-ghost btn-xs" onclick="_icCancelEdit()">Cancel</button>
    </div>
    <div class="sj-type-pills">${types.map(t=>`<button class="sj-type-pill${src.type===t.id?' active':''}" onclick="_icField('type','${t.id}');_icRefresh()">${t.icon} ${t.label}</button>`).join('')}</div>
    ${_icTypeFieldsSimple(src)}
    ${_icDateFieldsHTML(src)}
    <button class="btn btn-primary" style="width:100%;margin-top:12px;padding:10px" onclick="_icSaveSource()">Save source</button>
  </div>`;
}

function _icTypeFieldsSimple(src){
  const mo=_computeMonthlyNet(src);
  const freqBtns=['weekly','biweekly','semimonthly','monthly'].map(f=>{
    const lbl={weekly:'Weekly',biweekly:'Every 2 wks',semimonthly:'Twice/mo',monthly:'Monthly'}[f];
    return `<button class="sj-type-pill${(src.payFreq||'biweekly')===f?' active':''}" style="font-size:12px;padding:5px 10px" onclick="_icField('payFreq','${f}');_icRefresh()">${lbl}</button>`;
  }).join('');
  if(src.type==='salary'||src.type==='contract'){
    return `<div class="form-group mb8"><label class="form-label">Employer${src.type==='contract'?' / Client':''}</label>
      <input class="form-input" type="text" placeholder="e.g. Acme Corp" value="${esc(src.name||'')}" oninput="_icField('name',this.value)"></div>
      <div class="form-group mb8"><label class="form-label">Take-home per paycheck <span class="text-muted fw4 fs11">after taxes</span></label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.paycheckAmount||''}" oninput="_icField('paycheckAmount',+this.value);_icRefresh()"></div>
      <div class="form-group mb8"><label class="form-label">Pay frequency</label>
        <div class="sj-type-pills" style="margin-bottom:0">${freqBtns}</div></div>
      ${mo>0?`<div class="fs13 fw7 mb8" style="color:var(--green)">~${fmt(mo)}/month take-home</div>`:''}
      <label class="flex gap8 align-center fs13 mb4" style="cursor:pointer">
        <input type="checkbox" ${src.showGross?'checked':''} onchange="_icField('showGross',this.checked);_icRefresh()">
        Enter gross salary (for bank-standard DTI)
      </label>
      ${src.showGross?`<div class="form-group mb0 mt6"><label class="form-label">Annual gross salary</label>
        <input class="form-input" type="number" placeholder="e.g. 72000" value="${src.grossSalary||''}" oninput="_icField('grossSalary',+this.value)"></div>`:''}`;
  }
  if(src.type==='hourly'){
    return `<div class="form-group mb8"><label class="form-label">Employer name <span class="text-muted fw4 fs11">(optional)</span></label>
      <input class="form-input" type="text" placeholder="e.g. Company Inc." value="${esc(src.name||'')}" oninput="_icField('name',this.value)"></div>
      <div class="g2 mb8" style="gap:8px">
        <div class="form-group mb0"><label class="form-label">Hourly rate ($)</label>
          <input class="form-input" type="number" placeholder="0.00" value="${src.hourlyRate||''}" oninput="_icField('hourlyRate',+this.value);_icRefresh()"></div>
        <div class="form-group mb0"><label class="form-label">Hours/week</label>
          <input class="form-input" type="number" placeholder="40" value="${src.hoursPerWeek||40}" oninput="_icField('hoursPerWeek',+this.value);_icRefresh()"></div>
      </div>
      ${mo>0?`<div class="fs13 fw7 mb8" style="color:var(--green)">~${fmt(mo)}/month estimated take-home</div>`:''}`;
  }
  if(src.type==='freelance'){
    return `<div class="form-group mb8"><label class="form-label">Source name <span class="text-muted fw4 fs11">(optional)</span></label>
      <input class="form-input" type="text" placeholder="e.g. Consulting, Etsy shop" value="${esc(src.name||'')}" oninput="_icField('name',this.value)"></div>
      <div class="form-group mb0"><label class="form-label">Average monthly take-home ($)</label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.monthlyAvg||''}" oninput="_icField('monthlyAvg',+this.value)"></div>`;
  }
  if(src.type==='rental'){
    return `<div class="form-group mb8"><label class="form-label">Property description <span class="text-muted fw4 fs11">(optional)</span></label>
      <input class="form-input" type="text" placeholder="e.g. 2BR Apartment" value="${esc(src.name||'')}" oninput="_icField('name',this.value)"></div>
      <div class="form-group mb0"><label class="form-label">Monthly rent received ($)</label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.monthlyRent||''}" oninput="_icField('monthlyRent',+this.value)">
        <div class="fs11 text-muted mt2">75% of rent is counted toward DTI (standard bank calculation).</div></div>`;
  }
  if(src.type==='benefits'){
    const bTypes=[{id:'social_security',label:'Social Security'},{id:'disability',label:'Disability'},{id:'va',label:'VA Benefits'},{id:'other',label:'Other'}];
    return `<div class="form-group mb8"><label class="form-label">Benefit type</label>
      <div class="sj-type-pills" style="margin-bottom:0">${bTypes.map(b=>`<button class="sj-type-pill${(src.benefitType||'social_security')===b.id?' active':''}" style="font-size:12px;padding:5px 10px" onclick="_icField('benefitType','${b.id}')">${b.label}</button>`).join('')}</div></div>
      <div class="form-group mb0"><label class="form-label">Monthly amount ($)</label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.monthlyBenefits||''}" oninput="_icField('monthlyBenefits',+this.value)">
        <div class="fs11 text-muted mt2">Grossed up 125% for DTI (standard bank calculation).</div></div>`;
  }
  return `<div class="form-group mb8"><label class="form-label">Source description</label>
    <input class="form-input" type="text" placeholder="e.g. Child support, alimony" value="${esc(src.name||'')}" oninput="_icField('name',this.value)"></div>
    <div class="form-group mb0"><label class="form-label">Monthly amount ($)</label>
      <input class="form-input" type="number" placeholder="0.00" value="${src.monthlyOther||''}" oninput="_icField('monthlyOther',+this.value)"></div>`;
}

function _icDateFieldsHTML(src){
  const mos=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `<div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
      <div class="form-group mb0"><label class="form-label">Start date <span class="text-muted fw4 fs11">(optional)</span></label>
        <input class="form-input" type="date" value="${src.startDate||''}" oninput="_icField('startDate',this.value)"></div>
      <div class="form-group mb0" id="ic-end-date-wrap" style="display:${src.hasEndDate?'block':'none'}">
        <label class="form-label">End date</label>
        <input class="form-input" type="date" value="${src.endDate||''}" oninput="_icField('endDate',this.value)"></div>
    </div>
    <label class="flex gap8 align-center fs13 mb8" style="cursor:pointer">
      <input type="checkbox" ${src.hasEndDate?'checked':''} onchange="_icToggleEndDate(this.checked)">
      This job has an end date
    </label>
    <label class="flex gap8 align-center fs13 mb0" style="cursor:pointer">
      <input type="checkbox" ${src.isSeasonal?'checked':''} onchange="_icField('isSeasonal',this.checked);_icRefresh()">
      Seasonal income (not year-round)
    </label>
    ${src.isSeasonal?`<div style="margin-top:8px;padding:10px;background:var(--surface3);border-radius:var(--r-sm)">
      <div class="fs11 fw6 mb8" style="text-transform:uppercase;letter-spacing:.04em;color:var(--text-sec)">Active months:</div>
      <div style="display:flex;gap:4px;flex-wrap:wrap">
        ${mos.map((mo,mi)=>`<label style="display:inline-flex;align-items:center;gap:3px;cursor:pointer;font-size:12px;min-width:38px">
          <input type="checkbox" ${(src.activeMonths||[]).includes(mi)?'checked':''} onchange="_icToggleMonth(${mi},this.checked)">${mo}</label>`).join('')}
      </div></div>`:''}
    ${(()=>{const st=_srcStatus(src);return st==='active'?'':`<div style="margin-top:6px">${_srcStatusBadge(src)}</div>`;})()}
    <div class="fs11 text-muted mt6">Start and end dates let Anchor calculate accurate income for the months you actually worked.</div>
  </div>`;
}

function _icField(field,value){if(_icEditData)_icEditData[field]=value;}
function _icRefresh(){const el=$('ic-srcs');if(!el||!_icEditData)return;const cards=Array.from(el.children);const editCardIdx=cards.findIndex(c=>c.classList.contains('ic-editing'));if(editCardIdx<0)return;const tmp=document.createElement('div');tmp.innerHTML=_icEditFormHTML();if(tmp.firstElementChild)cards[editCardIdx].replaceWith(tmp.firstElementChild);}

function _icToggleEndDate(checked){
  if(!_icEditData) return;
  _icEditData.hasEndDate=checked;
  if(!checked) _icEditData.endDate='';
  const el=$('ic-end-date-wrap');
  if(el) el.style.display=checked?'block':'none';
  else _icRefresh();
}

function _icToggleMonth(mi,checked){
  if(!_icEditData) return;
  const months=[...(_icEditData.activeMonths||[])];
  if(checked&&!months.includes(mi)) months.push(mi);
  else if(!checked){const p=months.indexOf(mi);if(p>=0)months.splice(p,1);}
  _icEditData.activeMonths=months.sort((a,b)=>a-b);
}

function _icSaveSource(){
  if(!_icEditData) return;
  const src={..._icEditData,
    monthlyNet:_computeMonthlyNet(_icEditData),
    monthlyGross:_icEditData.type==='salary'&&_icEditData.grossSalary?Math.round(_icEditData.grossSalary/12):0,
    isManual:true,lastUpdated:new Date().toISOString()};
  if(!src.id) src.id=uid();
  if(!src.createdAt) src.createdAt=new Date().toISOString();
  if(!AnchorDB.income.sources) AnchorDB.income.sources=[];
  const idx=AnchorDB.income.sources.findIndex(s=>s.id===src.id);
  if(idx>=0) AnchorDB.income.sources[idx]=src;
  else AnchorDB.income.sources.push(src);
  _icSyncToSettings();
  save();
  _icEditData=null; _icEditingId=null;
  _icRender();
}

function _icCancelEdit(){
  _icEditData=null; _icEditingId=null;
  _icRender();
}

function _icArchiveSource(id){
  const src=(AnchorDB.income.sources||[]).find(s=>s.id===id);
  if(!src) return;
  src.status='archived'; src.lastUpdated=new Date().toISOString();
  _icSyncToSettings(); save(); _icRender();
}

function _icUnarchiveSource(id){
  const src=(AnchorDB.income.sources||[]).find(s=>s.id===id);
  if(!src) return;
  src.status='active'; src.lastUpdated=new Date().toISOString();
  _icSyncToSettings(); save(); _icRender();
}

function _icDeleteSource(id){
  if(!AnchorDB.income.sources) return;
  AnchorDB.income.sources=AnchorDB.income.sources.filter(s=>s.id!==id);
  _icSyncToSettings(); save(); _icRender();
}

function saveIncomeConfig(){
  const base=document.querySelector('input[name="f-ic-dti-base"]:checked')?.value||'net';
  S.incomeSettings={...(S.incomeSettings||{}),dtiIncomeBase:base};
  _icSyncToSettings();
  _syncIncomeConfigFromSettings();
  closeModal('m-income-config');
  DataStore.sync('income-configured');
}

function _iqConfirmCSVIncome(){
  const net=getMonthlyIncomeEstimate()||0;
  if(!net) return;
  AnchorDB.income.configuration={
    ...AnchorDB.income.configuration,
    totalMonthlyNet:net,totalDTIEligible:net,
    configuredManually:true,configuredViaQuiz:false,
    configuredAt:new Date().toISOString(),
    sources:[{id:uid(),type:'auto-detected',name:'Auto-detected deposits',monthlyNet:net,isManual:false,fromQuiz:false,isApproximate:true,lastUpdated:new Date().toISOString()}]
  };
  S.incomeSettings={...(S.incomeSettings||{}),manualMonthlyNet:net};
  _syncIncomeConfigFromSettings();
  DataStore.sync('income-csv-confirmed');
}

// ── INCOME QUIZ ───────────────────────────────────────────────────────────────
const IQ_RANGE_MID={
  'under500':350,'500_1000':750,'1000_1500':1250,'1500_2500':2000,
  '2500_4000':3250,'over4000':4500
};
const IQ_RANGE_LABELS={
  'under500':'Under $500','500_1000':'$500 – $1,000','1000_1500':'$1,000 – $1,500',
  '1500_2500':'$1,500 – $2,500','2500_4000':'$2,500 – $4,000','over4000':'Over $4,000'
};
const IQ_ADD_SRC=[
  {id:'side_hustle',icon:'💻',label:'Side hustle or freelance work'},
  {id:'rental',icon:'🏠',label:'Rental income'},
  {id:'benefits',icon:'🏛️',label:'Government benefits',sub:'Social Security, disability'},
  {id:'investments',icon:'💰',label:'Investments or dividends'},
  {id:'scholarship',icon:'🎓',label:'Scholarships or grants'},
  {id:'support',icon:'👶',label:'Child support or alimony'},
  {id:'other_inc',icon:'➕',label:'Other regular income'},
];
const IQ_FREQ_MULT={weekly:52/12,biweekly:26/12,semimonthly:2,monthly:1};

let _iqState={step:1,answers:{empType:null,payFreq:null,checkRange:null,checkExact:null,usedRange:false,addSrcs:[],addAmounts:{},grossSalary:null},addSrcQueue:[],currentAddSrc:null};

function openIncomeQuiz(){
  _iqState={step:1,answers:{empType:null,payFreq:null,checkRange:null,checkExact:null,usedRange:false,addSrcs:[],addAmounts:{},grossSalary:null},addSrcQueue:[],currentAddSrc:null};
  $('m-income-quiz').style.display='flex';
  document.body.style.overflow='hidden';
  _iqRender();
}
function _iqClose(){
  $('m-income-quiz').style.display='none';
  document.body.style.overflow='';
}
function dismissIncomeQuiz(){
  AnchorDB.preferences.incomeQuizDismissedAt=Date.now();
  save(); renderBudget(); _iqClose();
}

function _iqDots(total,current){
  const el=$('iq-dots'); if(!el) return;
  el.innerHTML=Array.from({length:total},(_,i)=>{
    const cls=i+1<current?'iq-dot done':i+1===current?'iq-dot active':'iq-dot';
    return`<div class="${cls}"></div>`;
  }).join('');
}

function _iqSlide(html){
  const el=$('iq-body');
  el.classList.remove('iq-slide');
  void el.offsetWidth; // reflow triggers animation
  el.classList.add('iq-slide');
  el.innerHTML=html;
}

function _iqNav(backFn,skipFn){
  return`<div class="iq-nav">
    <button class="btn btn-ghost btn-sm" onclick="${backFn||'_iqClose()'}">← Back</button>
    <button class="iq-skip" onclick="${skipFn||'_iqClose()'}">Skip for now</button>
  </div>`;
}

function _iqRender(){
  const s=_iqState;
  if(s.step===1) _iqStep1();
  else if(s.step===2) _iqStep2();
  else if(s.step===3) _iqStep3();
  else if(s.step==='3exact') _iqStep3Exact();
  else if(s.step===4) _iqStep4();
  else if(s.step==='4amt') _iqStep4Amt();
  else if(s.step===5) _iqStep5();
  else if(s.step==='results') _iqResults();
  else if(s.step==='skip') _iqSkip();
}

function _iqStep1(){
  _iqDots(5,1);
  _iqSlide(`
    <div class="iq-q">How would you describe your work situation?</div>
    <div class="iq-choices">
      ${[
        ['salaried','💼','I have a regular job','Same employer, regular paychecks'],
        ['hourly','⏰','I work hourly','Pay varies based on hours worked'],
        ['self_employed','💻','I\'m self-employed or freelance','I pay my own taxes'],
        ['multiple','🔀','I have multiple income sources','Job + side hustle, or similar'],
        ['skip','🤐','I\'d prefer not to say','Skip income setup'],
      ].map(([v,icon,label,sub])=>`
        <button class="iq-choice" onclick="_iqPickEmp('${v}')">
          <span class="iq-choice-icon">${icon}</span>
          <span class="iq-choice-text"><div class="iq-choice-label">${label}</div><div class="iq-choice-sub">${sub}</div></span>
        </button>`).join('')}
    </div>
    ${_iqNav('_iqClose()','_iqClose()')}
  `);
}
function _iqPickEmp(v){
  _iqState.answers.empType=v;
  if(v==='skip'){ _iqState.step='skip'; _iqRender(); return; }
  _iqState.step=(v==='salaried'||v==='hourly')?2:3;
  _iqRender();
}

function _iqStep2(){
  _iqDots(5,2);
  _iqSlide(`
    <div class="iq-q">How often do you get paid?</div>
    <div class="iq-choices">
      ${[
        ['weekly','📅','Every week','52 paychecks a year'],
        ['biweekly','📅','Every two weeks','26 paychecks — most common'],
        ['semimonthly','📅','Twice a month','1st and 15th'],
        ['monthly','📅','Once a month','12 paychecks a year'],
      ].map(([v,icon,label,sub])=>`
        <button class="iq-choice" onclick="_iqPickFreq('${v}')">
          <span class="iq-choice-icon">${icon}</span>
          <span class="iq-choice-text"><div class="iq-choice-label">${label}</div><div class="iq-choice-sub">${sub}</div></span>
        </button>`).join('')}
    </div>
    ${_iqNav('_iqState.step=1;_iqRender()','_iqClose()')}
  `);
}
function _iqPickFreq(v){
  _iqState.answers.payFreq=v;
  _iqState.step=3; _iqRender();
}

function _iqStep3(){
  const isMonthly=_iqState.answers.payFreq==='monthly';
  const label=isMonthly?'per month':'per paycheck';
  _iqDots(5,3);
  _iqSlide(`
    <div class="iq-q">Roughly how much do you take home ${label} — after taxes?</div>
    <div class="iq-sub">Just to get you started. You can update the exact amount anytime.</div>
    <div class="iq-choices">
      ${Object.entries(IQ_RANGE_LABELS).map(([v,label])=>`
        <button class="iq-choice" onclick="_iqPickRange('${v}')">
          <span class="iq-choice-text"><div class="iq-choice-label">${label}</div></span>
        </button>`).join('')}
      <button class="iq-choice" onclick="_iqState.step='3exact';_iqRender()">
        <span class="iq-choice-icon">✏️</span>
        <span class="iq-choice-text"><div class="iq-choice-label">I'd rather enter the exact amount</div></span>
      </button>
      <button class="iq-choice" onclick="_iqPickRange(null)">
        <span class="iq-choice-icon">🤐</span>
        <span class="iq-choice-text"><div class="iq-choice-label">I'd prefer not to say</div></span>
      </button>
    </div>
    ${_iqNav(`_iqState.step=${(_iqState.answers.empType==='salaried'||_iqState.answers.empType==='hourly')?2:1};_iqRender()`,'_iqClose()')}
  `);
}
function _iqPickRange(v){
  if(v===null){ _iqState.answers.checkRange=null; _iqState.answers.checkExact=null; }
  else{ _iqState.answers.checkRange=v; _iqState.answers.checkExact=IQ_RANGE_MID[v]; _iqState.answers.usedRange=true; }
  _iqState.step=4; _iqRender();
}

function _iqStep3Exact(){
  _iqDots(5,3);
  _iqSlide(`
    <div class="iq-q">What's your take-home amount per paycheck?</div>
    <div class="iq-sub">After taxes and deductions. This stays on your device.</div>
    <div class="form-group" style="margin-bottom:20px">
      <label class="form-label">Take-home per ${_iqState.answers.payFreq==='monthly'?'month':'paycheck'} ($)</label>
      <input class="form-input" id="iq-exact-amt" type="number" placeholder="e.g. 1850" style="font-size:18px;padding:12px 14px" autofocus>
    </div>
    <button class="btn btn-primary" onclick="_iqConfirmExact()" style="width:100%;margin-bottom:8px">Continue →</button>
    ${_iqNav('_iqState.step=3;_iqRender()','_iqClose()')}
  `);
  setTimeout(()=>$('iq-exact-amt')?.focus(),50);
}
function _iqConfirmExact(){
  const v=parseFloat($('iq-exact-amt')?.value||0)||0;
  if(!v){$('iq-exact-amt').style.outline='2px solid var(--red)';return;}
  _iqState.answers.checkExact=v; _iqState.answers.usedRange=false; _iqState.answers.checkRange=null;
  _iqState.step=4; _iqRender();
}

function _iqStep4(){
  _iqDots(5,4);
  const sel=_iqState.answers.addSrcs;
  _iqSlide(`
    <div class="iq-q">Do you have any other regular income?</div>
    <div class="iq-sub">Select all that apply. You can add more later.</div>
    <div class="iq-choices" id="iq-add-list">
      ${IQ_ADD_SRC.map(s=>`
        <button class="iq-choice multi-sel${sel.includes(s.id)?' selected':''}" onclick="_iqToggleAdd('${s.id}',this)">
          <span class="iq-choice-icon">${s.icon}</span>
          <span class="iq-choice-text"><div class="iq-choice-label">${s.label}</div>${s.sub?`<div class="iq-choice-sub">${s.sub}</div>`:''}</span>
          <span style="font-size:16px;color:var(--green)">${sel.includes(s.id)?'✓':''}</span>
        </button>`).join('')}
      <button class="iq-choice${!sel.length?' selected':''}" onclick="_iqNoExtra()">
        <span class="iq-choice-icon">✗</span>
        <span class="iq-choice-text"><div class="iq-choice-label">No, just my main income</div></span>
      </button>
    </div>
    <button class="btn btn-primary" onclick="_iqConfirmAdd()" style="width:100%;margin-bottom:8px">Continue →</button>
    ${_iqNav('_iqState.step=3;_iqRender()','_iqState.step=5;_iqRender()')}
  `);
}
function _iqToggleAdd(id,btn){
  const arr=_iqState.answers.addSrcs;
  const i=arr.indexOf(id);
  if(i>=0) arr.splice(i,1); else arr.push(id);
  btn.classList.toggle('selected');
  const tick=btn.querySelector('span:last-child'); if(tick) tick.textContent=arr.includes(id)?'✓':'';
}
function _iqNoExtra(){
  _iqState.answers.addSrcs=[];
  _iqState.step=5; _iqRender();
}
function _iqConfirmAdd(){
  const srcs=_iqState.answers.addSrcs;
  if(!srcs.length){ _iqState.step=5; _iqRender(); return; }
  _iqState.addSrcQueue=[...srcs];
  _iqState.currentAddSrc=_iqState.addSrcQueue.shift();
  _iqState.step='4amt'; _iqRender();
}

function _iqStep4Amt(){
  const srcId=_iqState.currentAddSrc;
  const srcDef=IQ_ADD_SRC.find(s=>s.id===srcId)||{icon:'💰',label:srcId};
  const remaining=_iqState.addSrcQueue.length;
  _iqDots(5,4);
  _iqSlide(`
    <div class="iq-q">How much from <strong>${srcDef.label}</strong>?</div>
    <div class="iq-sub">Roughly per month. You can update this later.</div>
    <div class="iq-choices">
      ${Object.entries(IQ_RANGE_LABELS).map(([v,label])=>`
        <button class="iq-choice" onclick="_iqPickAddAmt('${v}')">
          <span class="iq-choice-text"><div class="iq-choice-label">${label}</div><div class="iq-choice-sub">≈ ${fmt(IQ_RANGE_MID[v])}/mo</div></span>
        </button>`).join('')}
      <button class="iq-choice" onclick="_iqPickAddAmt(null)">
        <span class="iq-choice-icon">🤐</span>
        <span class="iq-choice-text"><div class="iq-choice-label">Skip this one</div></span>
      </button>
    </div>
    ${remaining?`<div class="text-muted fs12" style="text-align:center;margin-bottom:8px">${remaining} more source${remaining!==1?'s':''} after this</div>`:''}
    ${_iqNav('_iqState.step=4;_iqRender()','_iqState.step=5;_iqRender()')}
  `);
}
function _iqPickAddAmt(v){
  if(v!==null) _iqState.answers.addAmounts[_iqState.currentAddSrc]=IQ_RANGE_MID[v];
  if(_iqState.addSrcQueue.length){
    _iqState.currentAddSrc=_iqState.addSrcQueue.shift();
    _iqRender();
  } else {
    _iqState.step=5; _iqRender();
  }
}

function _iqStep5(){
  const hasAmt=_iqState.answers.checkExact>0;
  _iqDots(5,5);
  _iqSlide(`
    <div class="iq-q">One last optional question — do you know your gross income?</div>
    <div class="iq-sub">Before taxes. This helps calculate your debt-to-income ratio the way banks do. Totally optional — skip if you're unsure.</div>
    <div class="form-group" style="margin-bottom:6px">
      <label class="form-label">Annual salary, before taxes ($) <span class="text-muted fw4">— optional</span></label>
      <input class="form-input" id="iq-gross-salary" type="number" placeholder="e.g. 72000" value="${_iqState.answers.grossSalary||''}" style="font-size:16px;padding:11px 14px">
    </div>
    <div class="priv-note mb16">🔒 This never leaves your device. Used only to calculate DTI — the same way a lender would.</div>
    <button class="btn btn-primary" onclick="_iqConfirmGross()" style="width:100%;margin-bottom:8px">Continue →</button>
    ${_iqNav('_iqState.step=4;_iqRender()','_iqState.step=\'results\';_iqRender()')}
  `);
  setTimeout(()=>$('iq-gross-salary')?.focus(),50);
}
function _iqConfirmGross(){
  const v=parseFloat($('iq-gross-salary')?.value||0)||0;
  _iqState.answers.grossSalary=v||null;
  _iqState.step='results'; _iqRender();
}

function _iqResults(){
  const a=_iqState.answers;
  const freq=a.payFreq||'biweekly';
  const mult=IQ_FREQ_MULT[freq]||IQ_FREQ_MULT.biweekly;
  const primaryNet=a.checkExact>0?Math.round(a.checkExact*mult):0;
  const addNet=Object.values(a.addAmounts).reduce((s,v)=>s+(v||0),0);
  const totalNet=primaryNet+addNet;
  const empLabels={salaried:'Salaried employee',hourly:'Hourly worker',self_employed:'Self-employed / freelance',multiple:'Multiple income sources'};
  const freqLabels={weekly:'Weekly',biweekly:'Biweekly',semimonthly:'Semi-monthly',monthly:'Monthly'};
  const addSrcDefs=IQ_ADD_SRC.filter(s=>a.addSrcs.includes(s.id));

  _iqDots(5,5);
  $('iq-dots').innerHTML='<span class="fw6 fs13" style="color:var(--green)">Complete ✓</span>';
  _iqSlide(`
    <div class="iq-q">Here's what we set up for you</div>
    <div style="background:var(--surface2);border-radius:var(--r);padding:16px;margin-bottom:16px">
      <div class="fw6 fs13 mb8">Primary income</div>
      <div class="flex gap8 mb4" style="flex-wrap:wrap">
        ${a.empType?`<span class="badge" style="background:rgba(108,99,255,.15);color:var(--accent)">${empLabels[a.empType]||a.empType}</span>`:''}
        ${a.payFreq?`<span class="badge" style="background:var(--surface3)">${freqLabels[a.payFreq]}</span>`:''}
        ${a.usedRange?`<span class="badge" style="background:var(--surface3)">Range-based estimate</span>`:''}
      </div>
      ${primaryNet>0?`<div style="font-size:22px;font-weight:700;color:var(--green);margin:8px 0">~${fmt(primaryNet)}<span class="text-muted fs13 fw4">/mo take-home</span></div>`:'<div class="text-muted fs13">Amount not provided</div>'}
      ${addSrcDefs.length?`<div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px">
        ${addSrcDefs.map(s=>{const amt=a.addAmounts[s.id];return`<div class="flex-sb fs13"><span>${s.icon} ${s.label}</span><span class="text-green fw6">${amt?'+'+fmt(amt)+'/mo':'—'}</span></div>`;}).join('')}
      </div>`:''}
      ${totalNet>0?`<div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px;font-size:15px;font-weight:700">Monthly total: ~${fmt(totalNet)}</div>`:''}
    </div>
    <div class="fs13 fw6 mb8">What this unlocks:</div>
    <div class="fs13" style="line-height:2;margin-bottom:16px">
      ✓ Debt-to-income ratio calculated<br>
      ✓ Percentage budgets now available<br>
      ✓ Paycheck planner amounts estimated<br>
      ✓ Financial health score updated
    </div>
    <div class="priv-note mb20">🔒 All of this is stored locally on your device. Nothing is sent anywhere. You can edit or delete it anytime in Budget → Income.</div>
    <div class="g2" style="gap:8px;margin-bottom:8px">
      <button class="btn btn-ghost" onclick="_iqState.step=5;_iqRender()">← Edit</button>
      <button class="btn btn-primary" onclick="saveIncomeQuizResults()">Looks good →</button>
    </div>
  `);
}

function _iqSkip(){
  $('iq-dots').innerHTML='';
  _iqSlide(`
    <div class="iq-q">No problem</div>
    <div class="iq-sub">You can always set this up later in <strong>Budget → Income</strong>. Anchor will continue using auto-detected deposits for estimates.</div>
    <button class="btn btn-primary" onclick="_iqClose()" style="width:100%;margin-bottom:8px">Got it</button>
    <div style="text-align:center"><button class="iq-skip" onclick="dismissIncomeQuiz()">Don't show for 7 days</button></div>
  `);
}

function saveIncomeQuizResults(){
  const a=_iqState.answers;
  const freq=a.payFreq||'biweekly';
  const mult=IQ_FREQ_MULT[freq]||IQ_FREQ_MULT.biweekly;
  const primaryNet=a.checkExact>0?Math.round(a.checkExact*mult*100)/100:0;
  const addNet=Math.round(Object.values(a.addAmounts).reduce((s,v)=>s+(v||0),0)*100)/100;
  const totalNet=primaryNet+addNet;
  const grossMonthly=a.grossSalary?Math.round(a.grossSalary/12*100)/100:0;
  const sources=[{
    id:uid(),type:a.empType||'salaried',name:'Primary income',
    monthlyNet:primaryNet,payFrequency:freq,paycheckAmount:a.checkExact||0,
    annualGross:a.grossSalary||null,monthlyGross:grossMonthly||null,
    isManual:true,fromQuiz:true,isApproximate:a.usedRange,
    lastUpdated:new Date().toISOString()
  }];
  IQ_ADD_SRC.filter(s=>a.addSrcs.includes(s.id)).forEach(s=>{
    const amt=a.addAmounts[s.id]||0;
    if(amt>0) sources.push({id:uid(),type:s.id,name:s.label,monthlyNet:amt,isManual:true,fromQuiz:true,isApproximate:true,lastUpdated:new Date().toISOString()});
  });
  AnchorDB.income.configuration={
    dtiIncomeBase:a.grossSalary?'gross':'net',
    sources,bonusHistory:[],monthlyBonusAverage:0,
    totalMonthlyGross:grossMonthly,totalMonthlyNet:totalNet,
    totalDTIEligible:a.grossSalary?grossMonthly:totalNet,
    configuredAt:new Date().toISOString(),configuredManually:true,configuredViaQuiz:true
  };
  // Sync to incomeSettings for backward compat
  S.incomeSettings={
    ...(S.incomeSettings||{}),
    dtiIncomeBase:a.grossSalary?'gross':'net',
    manualMonthlyNet:totalNet||null,
    grossMonthly:grossMonthly||0,
    grossSalary:a.grossSalary||0
  };
  _iqClose();
  DataStore.sync('income-quiz-completed');
}

// ── EMERGENCY FUND ────────────────────────────────────────────────────────────
// ── VAULT BALANCE RECONSTRUCTION ──────────────────────────────────────────────
// Reads transaction descriptions to determine vault flow direction,
// so sign errors in the CSV never corrupt the vault balance.
function _vaultOpening(name){ const m=AnchorDB.vaultOpening||{}; return +m[String(name).toLowerCase()]||0; }
function getVaultData(vaultName){
  const nameEsc=vaultName.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  const nameRe=new RegExp(nameEsc,'i');
  const toRe=new RegExp('\\bto\\s+'+nameEsc,'i');
  const fromRe=new RegExp('\\bfrom\\s+'+nameEsc,'i');
  const vaultTx=S.transactions
    .filter(t=>nameRe.test(t.description||''))
    .filter(t=>normalizeDate(t.date))
    .sort((a,b)=>normalizeDate(a.date).localeCompare(normalizeDate(b.date)));
  const opening=_vaultOpening(vaultName);   // balance before the first CSV row (0 unless matched to SoFi)
  let balance=opening;
  const monthlyFlow={},ledger=[];
  vaultTx.forEach(t=>{
    const desc=t.description||'';
    let delta,rule;
    if(toRe.test(desc)){ delta=Math.abs(t.amount); rule='to'; }        // "To [Vault]" = money entering vault
    else if(fromRe.test(desc)){ delta=-Math.abs(t.amount); rule='from'; } // "From [Vault]" = money leaving vault
    else { delta=-t.amount; rule='flip'; }                              // fallback: sign flip (withdrawal = into vault)
    balance+=delta;
    ledger.push({t,delta,rule,running:balance});
    const nd=normalizeDate(t.date); if(!nd) return;
    const mo=nd.slice(0,7);
    monthlyFlow[mo]=(monthlyFlow[mo]||0)+delta;
  });
  return{balance:Math.max(0,balance),raw:balance,opening,ledger,transactions:vaultTx,monthlyFlow};
}

// Backward-compat wrapper
function getEmergencyFundData(){
  return getVaultData('Emergency Fund Vault');
}

// Scan all transactions for any "[Name] Vault" description patterns
function detectAllVaults(){
  const vaultMap={};
  S.transactions.forEach(t=>{
    const m=/(?:to|from)\s+(.+?vault)\b/i.exec(t.description||'');
    if(m){const name=m[1].trim(); vaultMap[name.toLowerCase()]=name;}
  });
  return Object.values(vaultMap);
}

// Create/update virtual account entries for every detected vault
function syncVirtualAccounts(){
  if(!AnchorDB.virtualAccounts) AnchorDB.virtualAccounts=[];
  const vaults=detectAllVaults();
  const newVaults=[];
  vaults.forEach(vaultName=>{
    const data=getVaultData(vaultName);
    if(!data.transactions.length) return;
    const id='vault-'+vaultName.toLowerCase().replace(/\s+/g,'-');
    const lastTx=data.transactions[data.transactions.length-1];
    const existing=AnchorDB.virtualAccounts.find(v=>v.id===id);
    const entry={
      id,name:vaultName,type:'savings-vault',institution:'SoFi',
      balance:Math.round(data.balance*100)/100,
      rawBalance:Math.round(data.raw*100)/100,
      lastUpdated:lastTx?normalizeDate(lastTx.date):null,
      transactionCount:data.transactions.length,
      isVirtual:true,monthlyFlow:data.monthlyFlow
    };
    if(!existing){newVaults.push(entry);AnchorDB.virtualAccounts.push(entry);}
    else Object.assign(existing,entry);
  });
  syncEmergencyFundGoal();
  return{vaults:AnchorDB.virtualAccounts.filter(v=>v.type==='savings-vault'),newVaults};
}

function syncEmergencyFundGoal(){
  const efVault=(AnchorDB.virtualAccounts||[]).find(v=>/emergency fund/i.test(v.name));
  const efData=efVault?{balance:efVault.balance,transactions:{length:efVault.transactionCount}}:getEmergencyFundData();
  if(!(efVault?efVault.transactionCount:efData.transactions.length)) return;
  const balance=efData.balance;
  let goal=S.emergencyFundGoalId?S.goals.find(g=>g.id===S.emergencyFundGoalId):null;
  if(!goal) goal=S.goals.find(g=>/emergency fund/i.test(g.name));
  if(!goal){
    goal={id:uid(),name:'Emergency Fund',target:Math.round(balance*3/100)*100||1000,current:0,targetDate:''};
    S.goals.push(goal);
  }
  S.emergencyFundGoalId=goal.id;
  goal.current=Math.round(balance*100)/100;
  goal.vaultLinked=true;
  goal.vaultId=efVault?efVault.id:'vault-emergency-fund-vault';
  if(!goal.target||goal.target<goal.current) goal.target=Math.round(goal.current*3/100)*100||1000;
}

function extractKeyword(desc){
  if(!desc) return '';
  // First token before space / * # — gives the merchant root (e.g. "WHOLEFDS")
  const first=(desc.split(/[\s*#/]/)[0]||'').toLowerCase().replace(/[^a-z0-9&-]/g,'');
  return first.length>=3?first:desc.toLowerCase().split(/\s+/).slice(0,2).join(' ');
}

