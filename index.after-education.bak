    <div style="display:flex;flex-direction:column;gap:8px">
      <button class="btn btn-primary" onclick="selectAccountMatchMode('update')">Update existing account <span class="fs11" style="opacity:.7">(recommended)</span></button>
      <button class="btn btn-ghost" onclick="selectAccountMatchMode('new')">Create new account</button>
      <button class="btn btn-ghost" onclick="selectAccountMatchMode('rename')">Rename existing to "<span id="m-acct-match-rename-to"></span>"</button>
    </div>
    <div class="modal-actions" style="margin-top:16px">
      <button class="btn btn-ghost" onclick="closeModal('m-acct-match')">Cancel</button>
    </div>
