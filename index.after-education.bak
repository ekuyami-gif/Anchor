</div>

<!-- MODAL: Budget target -->
<div class="overlay" id="m-budget">
  <div class="modal" style="max-width:540px;max-height:90vh;overflow-y:auto">
    <div class="modal-title">Set Budget</div>

    <!-- Mode toggle -->
    <div style="display:flex;gap:4px;padding:3px;background:var(--surface2);border-radius:20px;margin-bottom:16px;width:fit-content">
      <button id="btn-mode-dollar" class="btn btn-sm btn-primary" style="border-radius:17px;padding:5px 16px" onclick="setBudgetMode('dollar')">$ Dollar Amount</button>
      <button id="btn-mode-pct" class="btn btn-sm btn-ghost" style="border-radius:17px;padding:5px 16px" onclick="setBudgetMode('percentage')">% Percentage</button>
    </div>

    <!-- Income basis (% mode only) -->
    <div id="budget-income-row" style="display:none;background:var(--surface2);border-radius:var(--r-sm);padding:12px;margin-bottom:14px;border-left:3px solid var(--green)">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:6px">Income Basis for % Calculations</div>
      <div id="budget-income-display" style="font-size:13px;margin-bottom:8px"></div>
      <div style="display:flex;gap:8px;align-items:center">
        <input class="form-input" id="f-income-override" placeholder="Override: expected monthly income" type="number" min="0" oninput="updateIncomeDisplay()" style="flex:1;font-size:13px">
        <span style="font-size:11px;color:var(--muted);white-space:nowrap">$/mo</span>
      </div>
    </div>

    <!-- Overall budget section -->
    <div style="font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px">Overall Budget</div>

    <!-- Dollar mode input -->
    <div id="budget-dollar-row" style="display:flex;gap:10px;align-items:flex-start;margin-bottom:4px">
      <div class="form-group" style="flex:1;margin-bottom:0">
        <label class="form-label">Amount ($)</label>
        <input class="form-input" id="f-budget" placeholder="3000" type="number" min="0" oninput="updateBudgetHint()">
      </div>
      <div class="form-group" style="width:130px;margin-bottom:0">
        <label class="form-label">Cycle</label>
        <select class="form-input" id="f-budget-cycle" onchange="updateBudgetHint()">
          <option value="monthly">Monthly</option>
          <option value="annual">Annual</option>
        </select>
      </div>
    </div>

    <!-- Percentage mode input -->
    <div id="budget-pct-row" style="display:none;margin-bottom:4px">
      <label class="form-label">% of monthly income</label>
      <div style="position:relative;max-width:220px">
        <input class="form-input" id="f-budget-pct" placeholder="80" type="number" min="0" max="100" step="1" oninput="updateBudgetHint()" style="padding-right:30px">
        <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px">%</span>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
        <button class="btn btn-ghost btn-xs" onclick="applyBudgetPresetPct(50)" style="background:var(--surface2)">50% needs</button>
        <button class="btn btn-ghost btn-xs" onclick="applyBudgetPresetPct(30)" style="background:var(--surface2)">30% wants</button>
        <button class="btn btn-ghost btn-xs" onclick="applyBudgetPresetPct(20)" style="background:var(--surface2)">20% savings</button>
        <button class="btn btn-ghost btn-xs" onclick="applyBudgetPresetPct(80)" style="background:var(--surface2)">80% spending</button>
      </div>
    </div>

    <div id="f-budget-hint" style="font-size:12px;color:var(--accent);margin-bottom:14px;min-height:18px"></div>
    <div class="divider"></div>

    <!-- Framework presets (% mode only) -->
    <div id="budget-framework-row" style="display:none;margin-bottom:14px">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:8px">Budget Framework Presets</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:6px">
        <button class="btn btn-ghost btn-sm" onclick="applyFrameworkPreset('50-30-20')">50/30/20 Rule</button>
        <button class="btn btn-ghost btn-sm" onclick="applyFrameworkPreset('60-20-20')">60/20/20 Rule</button>
      </div>
      <div style="font-size:11px;color:var(--muted);line-height:1.6"><b>50/30/20:</b> 50% Needs · 30% Wants · 20% Savings<br><b>60/20/20:</b> 60% Fixed Expenses · 20% Wants · 20% Savings</div>
    </div>

    <!-- Allocation tracker bar (% mode only) -->
    <div id="budget-alloc-tracker" style="display:none;margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
        <div id="alloc-summary" style="font-size:12px;color:var(--muted)"></div>
      </div>
      <div id="alloc-bar" style="height:10px;border-radius:5px;background:var(--surface2);overflow:hidden;display:flex;margin-bottom:5px;border:1px solid var(--border)"></div>
      <div id="alloc-warning" style="font-size:11px;min-height:14px"></div>
    </div>

    <!-- Category budgets header -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
      <div id="budget-cat-label" style="font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em">Category Budgets <span style="font-weight:400;color:var(--dim)">(monthly · optional)</span></div>
    </div>
    <div class="form-row" id="f-cat-budgets"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-budget')">Cancel</button>
      <button class="btn btn-primary" onclick="saveBudget()">Save</button>
    </div>
  </div>
</div>

<!-- MODAL: Edit transaction category -->
<div class="overlay" id="m-tx">
  <div class="modal">
    <div class="modal-title">Edit Transaction Category</div>
    <div id="m-tx-info" style="font-size:13px;color:var(--muted);margin-bottom:16px;padding:10px;background:var(--surface2);border-radius:var(--r-sm)"></div>
    <div class="form-group"><label class="form-label">Category</label>
      <select class="form-input" id="f-tx-cat">
        <option>Housing</option><option>Food</option><option>Transport</option>
        <option>Bills</option><option>Subscriptions</option><option>Shopping</option>
        <option>Medical</option><option>Entertainment</option>
        <option>Charity</option><option>Investments</option><option>Credit Card Payments</option>
        <option>Education</option><option>Fees</option><option>Transfers</option><option>Other</option>
      </select>
    </div>
    <div style="background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:12px;margin-bottom:4px">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;font-weight:500;margin-bottom:0">
        <input type="checkbox" id="f-tx-remember" style="accent-color:var(--accent);width:15px;height:15px"
          onchange="$('f-tx-kw-wrap').style.display=this.checked?'block':'none'">
        Remember this merchant for future imports
      </label>
      <div id="f-tx-kw-wrap" style="display:none;margin-top:10px">
        <label class="form-label">Keyword to match <span style="font-weight:400;color:var(--dim)">(case-insensitive, partial match)</span></label>
        <input class="form-input" id="f-tx-kw" placeholder="e.g. wholefds" type="text">
        <div style="font-size:11px;color:var(--muted);margin-top:4px">Any transaction containing this keyword will be auto-categorized going forward.</div>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-tx')">Cancel</button>
      <button class="btn btn-primary" onclick="saveTxCat()">Save</button>
    </div>
  </div>
</div>

<!-- MODAL: Bank / format picker -->
<!-- MODAL: Upload Intercept -->
<div class="overlay" id="m-upload">
  <div class="modal" style="max-width:560px;max-height:90vh;overflow-y:auto">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
      <div class="modal-title" style="margin-bottom:0">Upload a Bank Statement</div>
      <button class="icon-btn" onclick="closeModal('m-upload')" style="flex-shrink:0;font-size:15px">✕</button>
    </div>
    <div class="text-muted fs12" style="margin-bottom:20px">Select your bank · supports CSV and PDF statements</div>

    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:10px">Step 1 — Your bank</div>
    <div id="upload-bank-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px"></div>

    <div id="upload-type-wrap" style="margin-bottom:16px">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:10px">Step 2 — Account type</div>
      <div style="display:flex;flex-wrap:wrap;gap:8px" id="upload-type-btns"></div>
    </div>

    <div class="form-group" id="upload-name-wrap" style="margin-bottom:16px">
      <label class="form-label">Account name <span style="font-weight:400;color:var(--dim)">(optional)</span></label>
      <input class="form-input" id="f-upload-name" type="text" placeholder="e.g. BofA Checking" list="upload-acct-suggestions" autocomplete="off">
      <datalist id="upload-acct-suggestions"></datalist>
    </div>

    <details id="upload-howto" style="margin-bottom:4px">
      <summary style="cursor:pointer;font-size:13px;font-weight:600;color:var(--accent);list-style:none;padding:10px 0;border-top:1px solid var(--border);display:flex;align-items:center;gap:6px" id="upload-howto-summary">
        <span id="upload-howto-label">📋 How to export your CSV →</span>
      </summary>
      <div id="upload-howto-body" style="padding:12px 0 4px"></div>
    </details>

    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-upload')">Cancel</button>
      <button class="btn btn-primary" onclick="triggerUploadFile()">Choose File →</button>
    </div>
  </div>
</div>

<!-- MODAL: Account match / duplicate detection -->
<div class="overlay" id="m-acct-match">
  <div class="modal" style="max-width:460px">
