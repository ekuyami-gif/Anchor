// ── PDF PARSING ENGINE ────────────────────────────────────────────────────────
let _pdfPendingRows=[], _pdfPendingCtx='budget', _pdfPendingAccount='', _pdfMeta=null;
let _investPDFPending=null;

// TEXT EXTRACTION
async function extractPDFText(file){
  const ab=await file.arrayBuffer();
  const pdf=await pdfjsLib.getDocument({data:ab}).promise;
  console.log('[PDF] Loaded, pages:', pdf.numPages);
  let out='';
  for(let i=1;i<=pdf.numPages;i++){
    const page=await pdf.getPage(i);
    const content=await page.getTextContent();
    const lineMap={};
    content.items.forEach(item=>{
      const y=Math.round(item.transform[5]/4)*4;
      if(!lineMap[y]) lineMap[y]=[];
      lineMap[y].push({x:item.transform[4],str:item.str});
    });
    Object.keys(lineMap).map(Number).sort((a,b)=>b-a).forEach(y=>{
      const row=lineMap[y].sort((a,b)=>a.x-b.x);
      out+=row.map(r=>r.str).join(' ').trim()+'\n';
    });
  }
  console.log('[PDF] Extracted text length:', out.length);
  return out;
}

// BANK DETECTION
function detectPDFBank(text){
  const t=text.toLowerCase();
  if(/bank of america|bankofamerica/.test(t)) return 'bofa_pdf';
  if(/wells fargo/.test(t)) return 'wellsfargo_pdf';
  if(/chase\.com|jpmorgan chase|chase bank/.test(t)) return 'chase_pdf';
  if(/\bwebull\b/.test(t)) return 'webull_pdf';
  if(/fidelity investments|fidelity\.com/.test(t)) return 'fidelity_pdf';
  if(/charles schwab|schwab\.com/.test(t)) return 'schwab_pdf';
  if(/\bvanguard\b/.test(t)) return 'vanguard_pdf';
  if(/sofi\.com|sofi bank/.test(t)) return 'sofi_pdf';
  if(/credit one/.test(t)) return 'creditone_pdf';
  return 'generic_pdf';
}
function _pdfBankLabel(f){
  return {bofa_pdf:'Bank of America',wellsfargo_pdf:'Wells Fargo',chase_pdf:'Chase',webull_pdf:'Webull',
    fidelity_pdf:'Fidelity',schwab_pdf:'Schwab',vanguard_pdf:'Vanguard',sofi_pdf:'SoFi',
    creditone_pdf:'Credit One',generic_pdf:'Bank'}[f]||'Bank';
}

// INVESTMENT PDF PARSER — extracts portfolio value, not transactions
function parseInvestmentPDF(text){
  let currentValue=null,currentDate='',priorValue=null,priorDate='';
  const holdings=[];
  let detectedPlatform='';
  if(/webull/i.test(text)) detectedPlatform='webull';
  else if(/fidelity investments|fidelity\.com/i.test(text)) detectedPlatform='fidelity';
  else if(/charles schwab|schwab\.com/i.test(text)) detectedPlatform='schwab';
  else if(/\bvanguard\b/i.test(text)) detectedPlatform='vanguard';
  else if(/robinhood/i.test(text)) detectedPlatform='robinhood';
  else if(/coinbase/i.test(text)) detectedPlatform='coinbase';
  else if(/e\*trade|etrade/i.test(text)) detectedPlatform='etrade';
  console.log('[InvestPDF] Platform:', detectedPlatform||'unknown');

  // Webull "Assets Held In Webull Account" text PDF
  if(/Assets Held In Webull Account/i.test(text)){
    const priorM=/Prior Month:\s*((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s*\d{4})/i.exec(text);
    const curM=/Current Month:\s*((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s*\d{4})/i.exec(text);
    if(priorM) priorDate=_parseWebullDate(priorM[1]);
    if(curM) currentDate=_parseWebullDate(curM[1]);
    const totalLine=text.match(/Total\(Combined Assets\)[^\n]*/i);
    if(totalLine){
      const ns=totalLine[0].match(/[\d,]+\.\d+/g);
      if(ns&&ns.length>=2){ priorValue=parseFloat(ns[0].replace(/,/g,'')); currentValue=parseFloat(ns[ns.length>=4?3:ns.length-1].replace(/,/g,'')); }
    }
    ['Stock','Bond','Option','FDIC Cash','SIPC Cash Balance','Crypto'].forEach(asset=>{
      const m=text.match(new RegExp(asset+'[^\\n]+','i'));
      if(m){ const ns=m[0].match(/[\d,]+\.\d+/g); if(ns&&ns.length>0){ const v=parseFloat(ns[ns.length>=4?3:ns.length-1].replace(/,/g,'')); if(!isNaN(v)&&v>0) holdings.push({label:asset,value:v}); } }
    });
    console.log('[InvestPDF] Webull: current='+currentValue+' prior='+priorValue+' date='+currentDate);
  }

  // Generic total value patterns
  if(currentValue===null){
    const pats=[
      /Total Account Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Total Portfolio Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Net Portfolio Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Total Assets\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Account Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Total Equity\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Estimated(?:\s+Portfolio)?\s+Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Portfolio Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
      /Total\(Combined Assets\)\s+\$?([\d,]+\.?\d*)/i,
      /Market Value\s*[:\$\s]+\$?([\d,]+\.?\d*)/i,
    ];
    for(const re of pats){ const m=re.exec(text); if(m){ const v=parseFloat(m[1].replace(/,/g,'')); if(!isNaN(v)&&v>0){currentValue=v;console.log('[InvestPDF] Value via:',re.source,v);break;} } }
  }

  // Prior value patterns
  if(priorValue===null){
    const pats=[
      /Prior(?:\s+Month)?\s*[:\s]+\$?([\d,]+\.?\d*)/i,
      /Previous(?:\s+Period)?\s*[:\s]+\$?([\d,]+\.?\d*)/i,
      /Last\s+Month\s*[:\s]+\$?([\d,]+\.?\d*)/i,
      /Beginning\s+(?:Portfolio\s+)?Value\s*[:\s]+\$?([\d,]+\.?\d*)/i,
      /Beginning\s+Balance\s*[:\s]+\$?([\d,]+\.?\d*)/i,
    ];
    for(const re of pats){ const m=re.exec(text); if(m){ const v=parseFloat(m[1].replace(/,/g,'')); if(!isNaN(v)&&v>0){priorValue=v;break;} } }
  }

  // Statement date patterns
  if(!currentDate){
    const pats=[
      /As\s+of\s+((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s+\d{4})/i,
      /Current\s+Month:\s*((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s*\d{4})/i,
      /Statement\s+(?:Date|Period)\s*[:\s]+([\w]+ \d{1,2},?\s+\d{4})/i,
      /through\s+((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s+\d{4})/i,
      /ending\s+((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s+\d{4})/i,
    ];
    for(const re of pats){ const m=re.exec(text); if(m){ const nd=normalizeDate(m[1]); if(nd){currentDate=nd;break;} } }
  }

  // Prior date
  if(!priorDate){
    const m=/Prior\s+Month:\s*((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2},?\s*\d{4})/i.exec(text);
    if(m) priorDate=_parseWebullDate(m[1])||normalizeDate(m[1].replace(/,/g,' '));
  }

  console.log('[InvestPDF] Result: value='+currentValue+' date='+currentDate+' prior='+priorValue+' priorDate='+priorDate);
  return {currentValue,currentDate,priorValue,priorDate,holdings,detectedPlatform};
}

function showInvestmentPDFSnapshot(data, acctNameHint){
  const body=$('pdf-preview-body'), actions=$('pdf-preview-actions');
  const {currentValue,currentDate,priorValue,priorDate,holdings,detectedPlatform}=data;
  const platLabel=detectedPlatform?(INVEST_PLATFORM_LBL[detectedPlatform]||detectedPlatform):'';

  if(currentValue===null){
    body.innerHTML='<div style="padding:8px 0">'+
      '<div style="font-size:28px;margin-bottom:12px;text-align:center">&#x1F4CA;</div>'+
      '<div class="fw7 mb8" style="text-align:center;font-size:15px">No portfolio value found</div>'+
      '<div class="text-muted fs12 mb16">We couldn\'t extract a portfolio value from this PDF.<br><br>'+
      'This could be because:<br>&bull; The PDF is a scanned image (not text-based)<br>&bull; The format isn\'t yet supported<br><br>Try these options:</div>'+
      '<div style="display:flex;flex-direction:column;gap:8px">'+
      '<button class="btn btn-ghost" onclick="closeModal(\'m-pdf-preview\')" style="justify-content:center">Enter value manually</button>'+
      '<button class="btn btn-ghost" onclick="closeModal(\'m-pdf-preview\');setTimeout(()=>{const i=$(' + "'investCsvFile'" + ');if(i)i.click();},100)" style="justify-content:center">Upload CSV instead</button>'+
      '<a href="https://tabula.technology" target="_blank" class="btn btn-ghost" style="justify-content:center">Open Tabula to convert PDF &rarr; CSV</a>'+
      '</div></div>';
    actions.innerHTML='<button class="btn btn-ghost" onclick="closeModal(\'m-pdf-preview\')">Close</button>';
    return;
  }

  const chg=priorValue!==null?currentValue-priorValue:null;
  const chgPct=chg!==null&&priorValue>0?((currentValue/priorValue-1)*100):null;
  const invs=S.investments||[];
  let preselect='';
  invs.forEach(inv=>{ if(detectedPlatform&&(inv.platform===detectedPlatform||(inv.name||'').toLowerCase().includes(detectedPlatform))) preselect=inv.id; });
  const accountOpts=invs.map(inv=>'<option value="'+inv.id+'"'+(inv.id===preselect?' selected':'')+'>'+esc(inv.name)+'</option>').join('');

  body.innerHTML=
    '<div class="fw7 mb4" style="font-size:15px">Portfolio Snapshot Detected</div>'+
    '<div class="text-muted fs12 mb14">'+(platLabel?platLabel+' &mdash; ':'')+'PDF portfolio summary</div>'+
    '<div class="'+(priorValue!==null?'g2':'')+'mb12" style="'+(priorValue===null?'display:block':'')+'">'+
    '<div class="stat"><div class="stat-label">Current Value</div>'+
    '<div class="stat-value text-green">'+fmt(currentValue)+'</div>'+
    '<div class="stat-sub">'+(currentDate?'As of '+currentDate:'Date unknown')+'</div></div>'+
    (priorValue!==null?
      '<div class="stat"><div class="stat-label">Prior Value</div>'+
      '<div class="stat-value">'+fmt(priorValue)+'</div>'+
      '<div class="stat-sub">'+(priorDate?'As of '+priorDate:'Prior period')+'</div></div>':'')+
    '</div>'+
    (chg!==null?
      '<div class="stat mb12" style="padding:10px 14px"><div class="stat-label">Change</div>'+
      '<div class="stat-value '+(chg>=0?'text-green':'text-red')+'">'+
      (chg>=0?'+':'')+fmt(chg)+(chgPct!==null?' ('+pct(chgPct)+') '+(chg>=0?'&#x2191;':'&#x2193;'):'')+'</div></div>':'')+
    (holdings.length?
      '<div class="mb12"><div class="fw7 fs12 mb8">Breakdown</div>'+
      holdings.map(h=>'<div class="flex-sb fs12 mb4 text-muted"><span>'+esc(h.label)+'</span><span class="fw7" style="color:var(--fg)">'+fmt(h.value)+'</span></div>').join('')+'</div>':'')+
    '<div class="form-group mb0"><label class="form-label">Apply to account</label>'+
    (invs.length?
      '<select class="form-input" id="pdf-invest-acct-sel">'+accountOpts+'</select>':
      '<div class="text-muted fs12 mb8">No investment accounts yet — a new one will be created automatically.</div>'+
      '<input class="form-input" id="pdf-invest-acct-name" type="text" value="'+esc(acctNameHint||platLabel||'Portfolio')+'" placeholder="Account name">')+
    '</div>';

  actions.innerHTML=
    '<button class="btn btn-ghost" onclick="closeModal(\'m-pdf-preview\')">Cancel</button>'+
    '<button class="btn btn-primary" onclick="applyInvestmentPDFSnapshot()">Update Account Value &rarr;</button>';
}

function applyInvestmentPDFSnapshot(){
  const data=_investPDFPending; if(!data) return;
  const {currentValue,currentDate,priorValue,priorDate,detectedPlatform}=data;
  if(currentValue===null) return;
  if(!S.investments) S.investments=[];
  let inv=null;
  const sel=$('pdf-invest-acct-sel');
  if(sel&&sel.value){
    inv=S.investments.find(x=>x.id===sel.value);
  } else {
    const nm=(($('pdf-invest-acct-name')||{}).value||detectedPlatform||'Portfolio').trim();
    inv=S.investments.find(x=>x.name.toLowerCase()===nm.toLowerCase());
    if(!inv){ inv={id:uid(),name:nm,platform:detectedPlatform||'',investType:'stocks',value:0,costBasis:0,notes:'',history:[]}; S.investments.push(inv); }
  }
  if(!inv) return;
  if(!inv.history) inv.history=[];
  if(priorDate&&priorValue!==null){
    const ei=inv.history.findIndex(e=>e.date===priorDate);
    if(ei>=0) inv.history[ei].value=priorValue; else inv.history.push({date:priorDate,value:priorValue,note:'PDF import'});
  }
  const saveDate=currentDate||new Date().toISOString().split('T')[0];
  const ei=inv.history.findIndex(e=>e.date===saveDate);
  if(ei>=0) inv.history[ei].value=currentValue; else inv.history.push({date:saveDate,value:currentValue,note:'PDF import'});
  _syncInvValue(inv);
  syncInvestToAssets();
  autoLogNW();
  _investPDFPending=null;
  save(); closeModal('m-pdf-preview'); renderInvest();
  showSaveToast((INVEST_PLATFORM_LBL[detectedPlatform]||inv.name)+' portfolio updated');
}

// STATEMENT PERIOD
const _MONTH_NUM={january:'01',february:'02',march:'03',april:'04',may:'05',june:'06',
  july:'07',august:'08',september:'09',october:'10',november:'11',december:'12',
  jan:'01',feb:'02',mar:'03',apr:'04',jun:'06',jul:'07',aug:'08',sep:'09',oct:'10',nov:'11',dec:'12'};
const _MONTH_NAME=['','January','February','March','April','May','June','July','August','September','October','November','December'];

function normalizePDFDate(str, fallbackYear){
  if(!str) return null;
  str=str.trim();
  const mdy=/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/.exec(str);
  if(mdy){
    const y=mdy[3].length===2?(parseInt(mdy[3])<50?'20':'19')+mdy[3]:mdy[3];
    return `${y}-${mdy[1].padStart(2,'0')}-${mdy[2].padStart(2,'0')}`;
  }
  // MM/DD only (Chase-style) — needs fallback year from statement period
  const md=/^(\d{1,2})\/(\d{1,2})$/.exec(str);
  if(md&&fallbackYear) return `${fallbackYear}-${md[1].padStart(2,'0')}-${md[2].padStart(2,'0')}`;
  // Month DD, YYYY
  const written=/^([a-z]+)\.?\s+(\d{1,2}),?\s+(\d{4})$/i.exec(str);
  if(written){const mo=_MONTH_NUM[written[1].toLowerCase().replace('.','')];if(mo) return `${written[3]}-${mo}-${written[2].padStart(2,'0')}`;}
  return null;
}

function detectStatementPeriod(text){
  const lines=text.split('\n').map(l=>l.trim());
  let start=null, end=null;
  const tryPair=(s1,s2)=>{const a=normalizePDFDate(s1);const b=normalizePDFDate(s2);if(a&&b&&a<=b){start=a;end=b;return true;}return false;};
  for(const line of lines){
    let m=/(\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4})\s*(?:to|through|[-])\s*(\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4})/i.exec(line);
    if(m&&tryPair(m[1],m[2])) break;
    m=/([A-Za-z]+ \d{1,2},? \d{4})\s*(?:to|through|[-])\s*([A-Za-z]+ \d{1,2},? \d{4})/i.exec(line);
    if(m&&tryPair(m[1],m[2])) break;
    m=/statement date[:\s]+(\d{1,2}\/\d{1,2}\/\d{4})/i.exec(line);
    if(m&&!end){end=normalizePDFDate(m[1]);}
  }
  let label=null, year=null;
  if(start&&end){
    year=start.slice(0,4);
    const sm=parseInt(start.slice(5,7)),em=parseInt(end.slice(5,7));
    label=(sm===em&&start.slice(0,4)===end.slice(0,4))?_MONTH_NAME[sm]+' '+year:`${_MONTH_NAME[sm]} - ${_MONTH_NAME[em]} ${year}`;
  } else if(end){
    year=end.slice(0,4);
    label=_MONTH_NAME[parseInt(end.slice(5,7))]+' '+year;
  }
  const result={start,end,year,label};
  console.log('[PDF] Detected period:', result);
  return result;
}

// STATEMENT SUMMARY EXTRACTION
function extractStatementSummary(text){
  const lines=text.split('\n').map(l=>l.trim());
  const r={beginBalance:null,endBalance:null,totalDeposits:null,totalWithdrawals:null};
  const getAmt=s=>{const m=/\$?([\d,]+\.\d{2})/.exec(s);return m?parseFloat(m[1].replace(/,/g,'')):null;};
  for(const line of lines){
    const lo=line.toLowerCase();
    if(/beginning balance/.test(lo)&&r.beginBalance===null){const v=getAmt(line.replace(/beginning balance/i,''));if(v!==null)r.beginBalance=v;}
    if(/ending balance|end of (statement )?period/.test(lo)&&r.endBalance===null){const v=getAmt(line.replace(/ending balance|end of (statement )?period/i,''));if(v!==null)r.endBalance=v;}
    if(/total (deposits?|additions?|credits?)/.test(lo)&&r.totalDeposits===null){const v=getAmt(line.replace(/total (deposits?|additions?|credits?)/i,''));if(v!==null)r.totalDeposits=v;}
    if(/total (withdrawals?|subtractions?|debits?|charges?)/.test(lo)&&r.totalWithdrawals===null){const v=getAmt(line.replace(/total (withdrawals?|subtractions?|debits?|charges?)/i,''));if(v!==null)r.totalWithdrawals=v;}
  }
  return r;
}

// SECTION DEFINITIONS (sign: +1=deposit, -1=withdrawal, 0=ambiguous from PDF)
const _PDF_SECTIONS={
  bofa_pdf:[
    {re:/deposits and other additions|deposits\s*&\s*other additions/i,      sign:1,  label:'Deposit'},
    {re:/withdrawals and other subtractions|withdrawals\s*&\s*other subtractions/i, sign:-1, label:'Withdrawal'},
    {re:/\bchecks\b/i,                                                         sign:-1, label:'Check'},
    {re:/service fees?/i,                                                      sign:-1, label:'Fee'},
    {re:/other transactions/i,                                                 sign:0,  label:'Other'},
  ],
  sofi_pdf:[
    {re:/\bcredits?\b/i,  sign:1,  label:'Credit'},
    {re:/\bdebits?\b/i,   sign:-1, label:'Debit'},
  ],
  chase_pdf:[
    {re:/deposits and additions|deposits\s*&\s*additions/i,        sign:1,  label:'Deposit'},
    {re:/electronic withdrawals|atm\s*&\s*debit card withdrawals/i, sign:-1, label:'Withdrawal'},
    {re:/checks paid/i,                                              sign:-1, label:'Check'},
    {re:/\bfees?\b/i,                                                sign:-1, label:'Fee'},
  ],
  wellsfargo_pdf:[
    {re:/transaction history/i, sign:0, label:'Transaction'},
  ],
  creditone_pdf:[
    {re:/purchases/i,             sign:-1, label:'Purchase'},
    {re:/payments and credits/i,  sign:1,  label:'Payment'},
    {re:/fees?/i,                 sign:-1, label:'Fee'},
  ],
  webull_pdf:[
    {re:/transaction history/i, sign:0, label:'Transaction'},
  ],
  generic_pdf:[
    {re:/deposits?|additions?|credits?/i,      sign:1,  label:'Deposit'},
    {re:/withdrawals?|subtractions?|debits?/i, sign:-1, label:'Withdrawal'},
    {re:/\bchecks?\b/i,                         sign:-1, label:'Check'},
    {re:/fees?|charges?/i,                      sign:-1, label:'Fee'},
  ],
};

// Lines to always skip
const _PDF_SKIP_RE=/^(beginning balance|ending balance|total (deposits?|withdrawals?|credits?|debits?|checks?|fees?|additions?|subtractions?)|subtotal|daily balance summary|balance summary|account summary|transaction summary|continued on next|page \d|routing number|member fdic|annual percentage|minimum payment due|credit limit|payment due date|^date\s+description|^date\s+amount|\bbalance\b$)/i;

// MAIN TRANSACTION PARSER
function parsePDFTransactions(text, bankFmt, fallbackYear){
  const lines=text.split('\n').map(l=>l.trim()).filter(Boolean);
  const sections=_PDF_SECTIONS[bankFmt]||_PDF_SECTIONS.generic_pdf;
  const txs=[]; let skippedCount=0, currentSectionIdx=-1, inTxHistory=false;
  const sectionsFound=[];
  const dateRe=/^(\d{1,2}[\/\-]\d{1,2}(?:[\/\-]\d{2,4})?)\s+/;
  const amtRe=/(-?\(?\$?[\d,]+\.\d{2}\)?)/g;

  for(const line of lines){
    if(_PDF_SKIP_RE.test(line)){skippedCount++;continue;}
    // Section header detection
    let matchedSection=false;
    for(let si=0;si<sections.length;si++){
      if(sections[si].re.test(line)){
        currentSectionIdx=si;
        const lbl=sections[si].label;
        if(!sectionsFound.includes(lbl)) sectionsFound.push(lbl);
        console.log('[PDF] Section ->', lbl, '|', line.slice(0,60));
        matchedSection=true; break;
      }
    }
    if(matchedSection) continue;
    // Webull: only parse inside Transaction History block
    if(bankFmt==='webull_pdf'){
      if(/transaction history/i.test(line)){inTxHistory=true;continue;}
      if(/portfolio holdings|account summary/i.test(line)){inTxHistory=false;continue;}
      if(!inTxHistory) continue;
    }
    // Date at line start
    const dm=dateRe.exec(line); if(!dm) continue;
    const normalDate=normalizePDFDate(dm[1], fallbackYear); if(!normalDate) continue;
    const rest=line.slice(dm[0].length);
    const amounts=[]; let m;
    while((m=amtRe.exec(rest))!==null) amounts.push({val:m[1],idx:m.index});
    amtRe.lastIndex=0;
    if(!amounts.length){skippedCount++;continue;}
    // Second-to-last = transaction amount; last = running balance (when 2+ present)
    const txAmtStr=amounts.length>=2?amounts[amounts.length-2].val:amounts[amounts.length-1].val;
    let amount=parsePDFAmount(txAmtStr);
    if(amount===null||amount===0){skippedCount++;continue;}
    // Apply section sign: section context overrides raw PDF sign for unsigned amounts
    const sectionSign=currentSectionIdx>=0?sections[currentSectionIdx].sign:0;
    if(sectionSign!==0) amount=sectionSign*Math.abs(amount);
    // Description: text before first amount
    const firstAmtIdx=amounts[0].idx;
    let desc=firstAmtIdx>0?rest.slice(0,firstAmtIdx).trim():rest.replace(txAmtStr,'').trim();
    // Check number rows: pure digits -> make readable
    if(currentSectionIdx>=0&&sections[currentSectionIdx].label==='Check'&&/^[\d\s]+$/.test(desc)){
      desc='Check #'+desc.trim();
    }
    if(!desc||desc.length<2||/^[\d\s\-\.\$,]+$/.test(desc)){skippedCount++;continue;}
    const section=currentSectionIdx>=0?sections[currentSectionIdx].label:undefined;
    txs.push({date:normalDate,description:desc,amount,category:autoCat(desc),section,include:true});
  }
  console.log('[PDF] Sections found:', sectionsFound);
  console.log('[PDF] Transactions parsed:', txs.length);
  if(txs.length) console.log('[PDF] Sample transactions:', txs.slice(0,3));
  return {txs,skippedCount,sectionsFound};
}

function parsePDFAmount(str){
  if(!str) return null;
  str=str.trim();
  const paren=/^\(\$?([\d,]+\.?\d*)\)$/.exec(str);
  if(paren) return -parseFloat(paren[1].replace(/,/g,''));
  const val=parseFloat(str.replace(/[$,\s]/g,''));
  return isNaN(val)?null:val;
}

// DUPLICATE PERIOD CHECK
function pdfCheckDuplicatePeriod(acctLabel, startDate, endDate){
  if(!startDate||!endDate||!acctLabel) return 0;
  return S.transactions.filter(t=>t.account===acctLabel&&t.date>=startDate&&t.date<=endDate).length;
}

// MAIN FLOW
async function openPDFFlow(file, ctx, bank, acctNameHint){
  const body=$('pdf-preview-body'), actions=$('pdf-preview-actions');
  body.innerHTML=`<div class="pdf-loading"><div style="font-size:36px;margin-bottom:12px">&#x1F4C4;</div><div class="fw7 mb6">Reading PDF&#x2026;</div><div class="text-muted fs12">Extracting text from your statement</div></div>`;
  actions.innerHTML='';
  openModal('m-pdf-preview');
  try{
    const text=await extractPDFText(file);
    if(text.replace(/\s/g,'').length<150){
      const scannedMsg=ctx==='invest'
        ?'Investment PDFs need to be text-based. Try downloading the PDF directly from your broker\'s website (not a scan).'
        :'Scanned statements can\'t be read automatically. Here are your options:';
      const scannedBtn=ctx==='invest'
        ?'<button class="btn btn-ghost" onclick="closeModal(\'m-pdf-preview\')" style="justify-content:center">Enter value manually</button>'
        :'<button class="btn btn-ghost" onclick="closeModal(\'m-pdf-preview\')" style="justify-content:center">Enter transactions manually</button>';
      body.innerHTML=`<div class="pdf-scanned">
        <div style="font-size:36px;margin-bottom:12px">&#x1F5A8;&#xFE0F;</div>
        <div class="fw7 mb6" style="font-size:15px">This looks like a scanned PDF</div>
        <div class="text-muted fs13 mb16">${scannedMsg}</div>
        <div style="display:flex;flex-direction:column;gap:10px;max-width:340px;margin:0 auto">
          <a href="https://tabula.technology" target="_blank" class="btn btn-ghost" style="justify-content:center">Convert with Tabula (free)</a>
          ${scannedBtn}
        </div>
        <div class="text-muted fs11 mt16">For best results, download a <strong>digital PDF</strong> (not a scan) directly from your broker's website.</div>
      </div>`;
      actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-pdf-preview')">Close</button>`;
      return;
    }
    // INVESTMENT CONTEXT: use portfolio snapshot parser, not transaction parser
    if(ctx==='invest'){
      const data=parseInvestmentPDF(text);
      _investPDFPending=data;
      showInvestmentPDFSnapshot(data, acctNameHint||'');
      return;
    }
    const bankFmt=detectPDFBank(text);
    console.log('[PDF] Detected bank:', bankFmt);
    const period=detectStatementPeriod(text);
    const summary=extractStatementSummary(text);
    console.log('[PDF] Statement summary:', summary);
    const bankLabel=bank&&bank!=='auto'?(_UBNAME[bank]||_pdfBankLabel(bankFmt)):_pdfBankLabel(bankFmt);
    _pdfPendingCtx=ctx||'budget';
    _pdfPendingAccount=(acctNameHint||bankLabel)+(period.label?' - '+period.label:' Statement');
    const {txs,skippedCount,sectionsFound}=parsePDFTransactions(text,bankFmt,period.year);
    _pdfPendingRows=txs;
    _pdfMeta={bankFmt,period,summary,skippedCount,sectionsFound,filename:file.name};
    showPDFPreview(txs,_pdfMeta);
  } catch(err){
    console.error('[PDF] Error:', err);
    body.innerHTML=`<div style="text-align:center;padding:32px 0"><div style="font-size:32px;margin-bottom:12px">&#x26A0;&#xFE0F;</div><div class="fw7 mb6 text-red">Failed to read PDF</div><div class="text-muted fs12">${esc(String(err.message||err))}<br><br>Check browser console (F12) for details. Make sure you're online for the first load.</div></div>`;
    actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-pdf-preview')">Close</button>`;
  }
}

// PREVIEW MODAL
function showPDFPreview(txs, meta){
  const body=$('pdf-preview-body'), actions=$('pdf-preview-actions');
  const {bankFmt,period,summary,skippedCount,sectionsFound,filename}=meta;
  if(!txs.length){
    body.innerHTML=`<div style="text-align:center;padding:24px 0">
      <div style="font-size:28px;margin-bottom:10px">&#x1F615;</div>
      <div class="fw7 mb6">No transactions found</div>
      <div class="text-muted fs12">Anchor couldn't extract transactions from this PDF.<br>
      Try a CSV export, or use <a href="https://tabula.technology" target="_blank" style="color:var(--accent)">Tabula</a> to convert first.
      ${skippedCount?`<br>${skippedCount} lines were seen but didn't match transaction patterns.`:''}<br>
      Open browser console (F12) for detailed parsing logs.</div>
    </div>`;
    actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-pdf-preview')">Close</button>`;
    return;
  }
  const extDeposits=txs.filter(t=>t.amount>0).reduce((s,t)=>s+t.amount,0);
  const extWithdrawals=txs.filter(t=>t.amount<0).reduce((s,t)=>s+Math.abs(t.amount),0);
  const dupCount=pdfCheckDuplicatePeriod(_pdfPendingAccount,period.start,period.end);
  // Validation against statement summary
  let validationHtml='';
  if(summary.totalDeposits!==null||summary.totalWithdrawals!==null){
    const dDiff=summary.totalDeposits!==null?Math.abs(extDeposits-summary.totalDeposits):null;
    const wDiff=summary.totalWithdrawals!==null?Math.abs(extWithdrawals-summary.totalWithdrawals):null;
    if((dDiff===null||dDiff<0.02)&&(wDiff===null||wDiff<0.02)){
      validationHtml=`<div style="background:var(--green-bg);border:1px solid rgba(0,212,170,.25);border-radius:var(--r-sm);padding:8px 12px;font-size:12px;color:var(--green);margin-bottom:10px">Extracted totals match statement summary</div>`;
    } else {
      const msgs=[];
      if(dDiff!==null&&dDiff>=0.02) msgs.push(`deposits extracted ${fmt(extDeposits)} vs statement ${fmt(summary.totalDeposits)}`);
      if(wDiff!==null&&wDiff>=0.02) msgs.push(`withdrawals extracted ${fmt(extWithdrawals)} vs statement ${fmt(summary.totalWithdrawals)}`);
      validationHtml=`<div class="pdf-warning">Total mismatch - some transactions may have been missed<br><span style="font-size:11px;opacity:.85">${msgs.join(' / ')}</span></div>`;
    }
  }
  const dupHtml=dupCount>0?`<div class="pdf-warning">${dupCount} existing transaction${dupCount!==1?'s':''} found for this account in this period - duplicates will be skipped on import</div>`:'';
  const allPositive=txs.length>2&&txs.every(t=>t.amount>=0);
  const signHtml=allPositive?`<div class="pdf-warning">All amounts appear positive - if these are spending transactions, flip signs below<label style="display:flex;align-items:center;gap:8px;margin-top:8px;cursor:pointer"><input type="checkbox" id="pdf-flip-sign" onchange="pdfFlipSigns()"> <span>Flip all amounts to negative (charges/spending)</span></label></div>`:'';
  const skipHtml=skippedCount?`<div class="pdf-warning">${skippedCount} line${skippedCount!==1?'s':''} could not be parsed and will be skipped</div>`:'';
  const preview=txs.slice(0,10);
  const catOpts=CATS.map(c=>`<option value="${c}">${c}</option>`).join('');
  const hasSectionCol=txs.some(t=>t.section);
  body.innerHTML=`
    <div style="margin-bottom:14px">
      <div class="fw7 mb2" style="font-size:15px">${_pdfBankLabel(bankFmt)} Statement</div>
      <div class="text-muted fs12">${period.label||'Period unknown'} - ${txs.length} transactions extracted</div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px">
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Period</div><div style="font-size:12px;font-weight:600;margin-top:2px;line-height:1.3">${period.label||'Unknown'}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Begin Balance</div><div style="font-size:14px;font-weight:700;margin-top:2px">${summary.beginBalance!==null?fmt(summary.beginBalance):'--'}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">End Balance</div><div style="font-size:14px;font-weight:700;margin-top:2px">${summary.endBalance!==null?fmt(summary.endBalance):'--'}</div></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px">
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Transactions</div><div class="stat-value" style="font-size:20px">${txs.length}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Deposits</div><div class="stat-value" style="font-size:20px;color:var(--green)">${extDeposits?fmt(extDeposits):'--'}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Withdrawals</div><div class="stat-value" style="font-size:20px;color:var(--red)">${extWithdrawals?fmt(extWithdrawals):'--'}</div></div>
    </div>
    ${validationHtml}${dupHtml}${signHtml}${skipHtml}
    <div class="fw7 mb8 fs13">Preview <span class="text-muted fw4 fs11">(first ${preview.length} of ${txs.length})</span></div>
    <div class="tbl-wrap" style="max-height:220px;overflow-y:auto;margin-bottom:8px;border:1px solid var(--border);border-radius:var(--r-sm)">
      <table class="pdf-preview-tbl">
        <thead><tr><th>Date</th><th>Description</th><th>Amount</th>${hasSectionCol?'<th>Section</th>':''}<th>Category</th><th style="text-align:center">Include</th></tr></thead>
        <tbody id="pdf-preview-rows">${_pdfPreviewRows(preview,catOpts,hasSectionCol)}</tbody>
      </table>
    </div>
    ${txs.length>10?`<div class="text-muted fs12 mb6">+ ${txs.length-10} more will also be imported (all checked by default)</div>`:''}
    <div class="text-muted fs11">Open browser console (F12) to see detailed parsing logs.</div>`;
  actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-pdf-preview')">Cancel</button>
    <button class="btn btn-primary" onclick="importPDFTransactions()">Import ${txs.length} Transactions</button>`;
}

function _pdfPreviewRows(rows, catOpts, hasSectionCol){
  return rows.map((t,i)=>`<tr>
    <td class="text-muted" style="white-space:nowrap">${t.date}</td>
    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(t.description)}">${esc(t.description)}</td>
    <td class="fw7 ${t.amount<0?'text-red':'text-green'}" style="white-space:nowrap">${t.amount<0?'-':'+'}${fmt(Math.abs(t.amount))}</td>
    ${hasSectionCol?`<td class="text-muted" style="font-size:11px;white-space:nowrap">${t.section||'--'}</td>`:''}
    <td><select class="form-input" style="padding:3px 8px;font-size:11px;height:auto" onchange="_pdfPendingRows[${i}].category=this.value">${catOpts.replace(`value="${t.category}"`,`value="${t.category}" selected`)}</select></td>
    <td style="text-align:center"><input type="checkbox" ${t.include?'checked':''} onchange="_pdfPendingRows[${i}].include=this.checked"></td>
  </tr>`).join('');
}

function pdfFlipSigns(){
  const flip=!!($('pdf-flip-sign')&&$('pdf-flip-sign').checked);
  _pdfPendingRows.forEach(t=>{t.amount=flip?-Math.abs(t.amount):Math.abs(t.amount);});
  const tbody=$('pdf-preview-rows'); if(!tbody) return;
  const catOpts=CATS.map(c=>`<option value="${c}">${c}</option>`).join('');
  tbody.innerHTML=_pdfPreviewRows(_pdfPendingRows.slice(0,10),catOpts,_pdfPendingRows.some(t=>t.section));
}

function importPDFTransactions(){
  const toImport=_pdfPendingRows.filter(t=>t.include);
  if(!toImport.length){showSaveToast('No transactions selected');return;}
  const acctLabel=_pdfPendingAccount||'PDF Import';
  let added=0,skipped=0;
  toImport.forEach(t=>{
    const dup=S.transactions.some(x=>x.description===t.description&&Math.abs(x.amount-t.amount)<0.01&&x.date===t.date);
    if(dup){skipped++;return;}
    S.transactions.push({id:uid(),date:t.date,description:t.description,amount:t.amount,category:t.category,override:false,account:acctLabel,source:'pdf'});
    added++;
  });
  const{subSuggs,billSuggs}=detectRecurring();
  S.subSuggestions=subSuggs; S.billSuggestions=billSuggs;
  rebuildArchivedMonths();
  if(S.transactions.some(t=>t.incomeType&&t.amount>0)) S.paySchedule=detectPaySchedule();
  save(); renderBudget();
  closeModal('m-pdf-preview');
  showUploadSummary(added,skipped,null,null);
}
</script>
</body>
</html>
