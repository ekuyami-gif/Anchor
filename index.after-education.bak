    <div class="tour-nav">
      <button class="tour-prev" id="tt-prev-btn" onclick="tourPrev()">← Prev</button>
      <span class="tour-counter" id="tt-counter"></span>
      <div class="tour-nav-btns">
        <button class="tour-skip" onclick="endTour()">Skip</button>
        <button class="btn btn-primary btn-sm" onclick="tourNext()" id="tt-next-btn">Next →</button>
      </div>
    </div>
  </div>
  <div id="tour-confetti"></div>
</div>

