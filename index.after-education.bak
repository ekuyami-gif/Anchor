<div class="overlay" id="m-bank">
  <div class="modal">
    <div class="modal-title">Import Transactions</div>
    <div class="form-group">
      <label class="form-label">Bank / Format</label>
      <select class="form-input" id="f-bank-format">
        <option value="auto">Auto-detect</option>
