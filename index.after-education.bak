  {id:'sofi',label:'SoFi'},{id:'capitalone',label:'Capital One'},{id:'creditone',label:'Credit One'},
  {id:'paypal',label:'PayPal'},{id:'cashapp',label:'Cash App'},{id:'coinbase',label:'Coinbase'},
  {id:'cryptocom',label:'Crypto.com'},{id:'webull',label:'Webull',pdfOnly:true},{id:'auto',label:'Other / Auto'},
];
const UPLOAD_TYPES=[
  {id:'checking',label:'Checking'},{id:'savings',label:'Savings'},{id:'credit_card',label:'Credit Card'},
  {id:'investment',label:'Investment'},{id:'',label:'Not sure'},
];
const _UFMT={
  bofa:{checking:'bofa',savings:'bofa',credit_card:'bofa-cc',investment:'auto','':'bofa'},
  sofi:{checking:'sofi',savings:'sofi',credit_card:'sofi',investment:'auto','':'sofi'},
  creditone:{credit_card:'creditone',checking:'creditone','':'creditone',savings:'auto',investment:'auto'},
  paypal:{checking:'paypal','':'paypal',savings:'auto',credit_card:'auto',investment:'auto'},
  cashapp:{checking:'cashapp','':'cashapp',savings:'auto',credit_card:'auto',investment:'auto'},
  coinbase:{investment:'coinbase','':'coinbase',checking:'auto',savings:'auto',credit_card:'auto'},
  cryptocom:{investment:'cryptocom','':'cryptocom',checking:'auto',savings:'auto',credit_card:'auto'},
};
function getUploadFmt(bank,acctType){return(_UFMT[bank]||{})[acctType]||'auto';}
const _UBNAME={bofa:'BofA',chase:'Chase',wellsfargo:'Wells Fargo',sofi:'SoFi',capitalone:'Capital One',creditone:'Credit One',paypal:'PayPal',cashapp:'Cash App',coinbase:'Coinbase',cryptocom:'Crypto.com',webull:'Webull'};
const _UTYPE={checking:'Checking',savings:'Savings',credit_card:'Credit Card',investment:'Portfolio'};
function getUploadNamePrefill(bank,acctType){const b=_UBNAME[bank]||'';const t=_UTYPE[acctType]||'';return[b,t].filter(Boolean).join(' ');}
const _UHOWTO={
  bofa:['Log in at bankofamerica.com','Select your account','Click "Download" near Transaction History','Set date range (up to 18 months)','Select CSV format','Click Download, then upload here'],
  chase:['Log in at chase.com','Select your account','Click "Download account activity"','Set date range','Choose CSV format','Click Download, then upload here'],
  wellsfargo:['Log in at wellsfargo.com','Select account','Click "Download Account Activity"','Set date range','Select "Comma-Separated Values (CSV)"','Download and upload here'],
  sofi:['Log in at sofi.com','Go to your account','Click "Statements" or "Transaction History"','Select date range','Click "Export" or "Download CSV"','Upload that file here'],
  capitalone:['Log in at capitalone.com','Select account','Click "Download Transactions"','Choose date range and CSV format','Download and upload here'],
  creditone:['Log in at creditonebank.com','Go to Account Activity','Click Download/Export','Select CSV format and download'],
  paypal:['Log in at paypal.com','Go to Activity → Statements → Custom','Set date range','Click Download and choose CSV'],
  cashapp:['Open Cash App','Tap profile icon → Documents → Account Statements','Select month','Download CSV and upload here'],
  coinbase:['Log in at coinbase.com','Go to Taxes or Reports','Click Generate Report → Transaction History','Select CSV format and download'],
  cryptocom:['Log in at crypto.com','Go to Accounts → Transaction History','Click Export','Select date range and CSV format','Download and upload here'],
  webull:['Log in at webull.com','Go to My Account → Statements','Download your Monthly Statement PDF','Come back here and upload the PDF directly — Anchor will extract your transactions automatically','(Backup option: use tabula.technology to convert to CSV first, then upload the CSV)'],
};
function getUploadHowToHTML(bank){
  const steps=_UHOWTO[bank];
  if(!steps) return `<p style="font-size:12px;line-height:1.9;color:var(--muted);margin:0">Most banks offer CSV export under <strong>Account Activity</strong>, <strong>Statements</strong>, or <strong>Transaction History</strong>.<br>Look for a <strong>Download</strong> or <strong>Export</strong> button. When asked for format, always choose <strong>CSV</strong>.<br>Anchor will auto-detect your bank's format.</p>`;
  return `<ol style="margin:0;padding-left:20px;font-size:12px;line-height:2.1;color:var(--muted)">${steps.map(s=>`<li>${s}</li>`).join('')}</ol>`;
}
function openUploadModal(ctx,preCardId){
  uploadCtx=ctx||'budget';
  uploadCCPreCardId=preCardId||null;
  uploadBank='auto';
  uploadAcctType=ctx==='cc'?'credit_card':ctx==='invest'?'investment':'';
  renderUploadModal();
  openModal('m-upload');
}
function renderUploadModal(){
  const grid=$('upload-bank-grid');
  if(grid) grid.innerHTML=UPLOAD_BANKS.map(b=>`<div class="upload-bank-card${uploadBank===b.id?' selected':''}" onclick="setUploadBank('${b.id}')">${esc(b.label)}${b.pdfOnly?'<span class="pdf-badge">PDF</span>':''}</div>`).join('');
  const typeWrap=$('upload-type-wrap');
  if(typeWrap){
    typeWrap.style.display=uploadCtx==='invest'?'none':'block';
    const typeBtns=$('upload-type-btns');
    if(typeBtns) typeBtns.innerHTML=UPLOAD_TYPES.map(t=>`<button class="upload-type-btn${uploadAcctType===t.id?' selected':''}" onclick="setUploadAcctType('${t.id}')">${t.label}</button>`).join('');
  }
  const nameWrap=$('upload-name-wrap');
  if(nameWrap){
    nameWrap.style.display=uploadCtx==='cc'?'none':'block';
    const inp=$('f-upload-name');
    if(inp){inp.placeholder=getUploadNamePrefill(uploadBank,uploadAcctType)||'e.g. BofA Checking';inp.value='';}
    const dl=$('upload-acct-suggestions');
    if(dl){
      const accts=[...new Set(S.transactions.map(t=>t.account).filter(Boolean))].sort();
      dl.innerHTML=accts.map(a=>`<option value="${esc(a)}">`).join('');
    }
  }
  const lbl=$('upload-howto-label');
  const body=$('upload-howto-body');
  const bankMeta=UPLOAD_BANKS.find(b=>b.id===uploadBank)||{};
  const bankLabel=bankMeta.label||'your bank';
  if(lbl) lbl.textContent=bankMeta.pdfOnly?`📄 How to download your ${bankLabel} PDF →`:`📋 How to export your CSV from ${bankLabel} →`;
  if(body) body.innerHTML=getUploadHowToHTML(uploadBank);
}
function setUploadBank(bank){uploadBank=bank;renderUploadModal();}
function setUploadAcctType(type){uploadAcctType=type;renderUploadModal();}
function triggerUploadFile(){
  const rawName=($('f-upload-name')||{}).value||'';
  const name=rawName.trim()||getUploadNamePrefill(uploadBank,uploadAcctType)||'';
  pendingAccountTypedName=name;
  pendingAccountMode='new';
  pendingAccountMatchName=null;

  if(uploadCtx==='budget'&&name){
    const match=findMatchingAccount(name);
    if(match){
      if(match.name===name){
        // Exact match — silently update existing account
        pendingAccountMode='update';
        pendingAccountMatchName=match.name;
      } else {
        // Fuzzy match — ask the user
        pendingAccountMatchName=match.name;
        showAccountMatchModal(name,match);
        return;
      }
    }
  }
  closeModal('m-upload');
  _doOpenFilePicker();
}

function showAccountMatchModal(typedName,match){
  $('m-acct-match-typed').textContent=typedName;
  $('m-acct-match-existing').textContent=match.name;
  $('m-acct-match-count').textContent=match.txCount+' transaction'+(match.txCount!==1?'s':'');
  $('m-acct-match-rename-to').textContent=typedName;
  openModal('m-acct-match');
}

function selectAccountMatchMode(mode){
  pendingAccountMode=mode;
  if(mode==='rename'){
    S.transactions.forEach(t=>{if(t.account===pendingAccountMatchName) t.account=pendingAccountTypedName;});
    if(S.balanceHistory&&S.balanceHistory[pendingAccountMatchName]){
      S.balanceHistory[pendingAccountTypedName]=S.balanceHistory[pendingAccountMatchName];
      delete S.balanceHistory[pendingAccountMatchName];
    }
    save();
  }
  closeModal('m-acct-match');
  closeModal('m-upload');
  _doOpenFilePicker();
}

function _doOpenFilePicker(){
  const inp=document.createElement('input');
  inp.type='file'; inp.accept='.csv,.pdf';
  inp.onchange=e=>{
    const file=e.target.files[0]; if(!file) return;
    const isPDF=file.name.toLowerCase().endsWith('.pdf');
    const fmt=getUploadFmt(uploadBank,uploadAcctType);
    const name=pendingAccountMode==='update'?pendingAccountMatchName:pendingAccountTypedName;
    pendingAccountMode=null; pendingAccountMatchName=null; pendingAccountTypedName=null;
    if(isPDF){openPDFFlow(file,uploadCtx,uploadBank,name);return;}
    if(uploadCtx==='budget'){
      pendingFile=file;
      $('f-bank-format').value=fmt;
      $('f-bank-account').value=name||'';
      doParse();
    } else if(uploadCtx==='cc'){
      pendingCCFile=file;
      const sel=$('f-cc-card-select');
      sel.innerHTML='<option value="_new">+ Create new card from this statement</option>';
      S.cards.forEach(c=>{sel.innerHTML+=`<option value="${c.id}">${esc(c.name)}</option>`;});
      if(uploadCCPreCardId) sel.value=uploadCCPreCardId;
      toggleNewCardName();
      if(name) $('f-cc-newname').value=name;
      $('f-cc-fmt').value=(fmt==='bofa-cc')?'bofa-cc':'auto';
      openModal('m-cc-upload');
    } else if(uploadCtx==='invest'){
      pendingInvestFile=file;
      const investFmts=['coinbase','cryptocom','webull','fidelity','generic'];
      $('f-invest-fmt').value=investFmts.includes(fmt)?fmt:'auto';
      $('f-invest-acct').value=name||'';
      doParseInvest();
    }
  };
  inp.click();
}

function parseCSV(e){
  const f=e.target.files[0]; if(!f) return;
  pendingFile=f;
  if($('csvFile')) $('csvFile').value='';
  $('f-bank-format').value='auto';
  $('f-bank-account').value='';
  openModal('m-bank');
}

function doParse(){
  const f=pendingFile; if(!f) return;
  const forceFmt=$('f-bank-format').value;
  const account=$('f-bank-account').value.trim();
  closeModal('m-bank');
  pendingFile=null;

  Papa.parse(f,{
    header:false, skipEmptyLines:true,
    complete(res){
      const raw=res.data;
      if(!raw.length) return alert('No data found in CSV.');

      // Scan for real header row: first row that has "date" AND ("description"/"memo"/"payee")
      // This skips BofA's 5-row summary block (and any other pre-header content)
      let hi=-1;
      for(let i=0;i<Math.min(raw.length,20);i++){
        const cells=raw[i].map(c=>String(c).trim().toLowerCase());
        if(cells.some(c=>c==='date')&&cells.some(c=>/^(description|memo|payee|narration)$/.test(c))){
          hi=i; break;
        }
      }
      if(hi<0){
        return alert('Could not find a header row with Date + Description/Memo/Payee columns in this file. Try picking a specific bank format from the dropdown instead of Auto-detect.');
      }
      const headers=raw[hi].map(c=>String(c).trim());
      const rows=raw.slice(hi+1).map(r=>{
        const obj={};
        headers.forEach((h,i)=>{ obj[h]=String(r[i]||'').trim(); });
        return obj;
      });

      if(!rows.length) return alert('No transaction rows found in CSV.');
      const fmt=forceFmt==='auto'?detectFormat(headers):forceFmt;
      const acctLabel=account||(fmt==='auto'?'Imported':fmt.toUpperCase());

      const{dateKey,descKey,amtKey,balKey,typeKey,statusKey,confidence}=getRowFields(rows,fmt);
      if(!dateKey||!descKey||!amtKey){
        return alert(`Could not identify the Date/Description/Amount columns for this file (detected format: ${fmt}). Try selecting a specific bank format instead of Auto-detect.`);
      }

      // Parse into a pending preview list — nothing is written to S.transactions
      // until the user reviews and confirms in the preview modal.
      const pending=[]; let skippedRows=0;
      rows.forEach(row=>{
        if(fmt==='sofi'&&statusKey){
          const status=String(row[statusKey]||'').trim();
          if(status!=='Posted') return;
        }
        let desc=String(row[descKey]||'').trim();
        if(fmt==='sofi') desc=desc.replace(/Zelle[Â\xa0®\xc2]+[®\xae]?/g,'Zelle');
        if(isSummaryRow(desc)){skippedRows++;return;}
        const rawAmt=String(row[amtKey]||'').replace(/[$,\s]/g,'');
        const amount=parseFloat(rawAmt);
        if(isNaN(amount)||amount===0){skippedRows++;return;}
        const date=String(row[dateKey]||'').trim();
        if(!date){skippedRows++;return;}

        const txType=typeKey?String(row[typeKey]||'').trim():'';
        const category=fmt==='sofi'&&txType?sofiCat(txType,desc):autoCat(desc);
        const prow={date,description:desc,amount,category,account:acctLabel,include:true};

        if(fmt==='sofi'){
          if(isSofiInternalXfer(desc)) prow.internalXfer=true;
          else{ const it=sofiIncomeType(txType,desc,amount); if(it) prow.incomeType=it; }
        } else {
          const it=universalIncomeType(txType,desc,amount,fmt);
          if(it) prow.incomeType=it;
        }
        if(balKey&&row[balKey]){
          const bal=parseFloat(String(row[balKey]).replace(/[$,\s]/g,''));
          if(!isNaN(bal)) prow.balance=bal;
        }
        const isDup=S.transactions.some(t=>t.description===prow.description&&t.amount===prow.amount&&t.date===prow.date);
        prow.isDup=isDup;
        if(isDup) prow.include=false;
        pending.push(prow);
      });

      if(!pending.length){
        return alert('No valid transactions found in this file.'+(skippedRows?` ${skippedRows} row(s) were skipped (summary rows, missing date/amount, or non-Posted status).`:' Check that this is a transaction export, not an account summary.'));
      }

      _csvPendingRows=pending;
      _csvPendingKind='bank';
      _csvPendingMeta={acctLabel,fmt,confidence,skippedRows};
      showCSVPreview();
    },
    error(){alert('Failed to parse CSV.')}
  });
}

// PREVIEW — bank/checking CSV
function _csvBankPreviewRows(rows){
  const catOpts=CATS.map(c=>`<option value="${c}">${c}</option>`).join('');
  return rows.map((t,i)=>`<tr>
    <td class="text-muted" style="white-space:nowrap">${esc(t.date)}</td>
    <td style="max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(t.description)}">${esc(t.description)}${t.isDup?' <span class="badge fs10" style="background:var(--surface3);color:var(--muted)">dup</span>':''}</td>
    <td class="fw7 ${t.amount<0?'text-red':'text-green'}" style="white-space:nowrap">${t.amount<0?'-':'+'}${fmt(Math.abs(t.amount))}</td>
    <td><select class="form-input" style="padding:3px 8px;font-size:11px;height:auto" onchange="_csvPendingRows[${i}].category=this.value">${catOpts.replace(`value="${t.category}"`,`value="${t.category}" selected`)}</select></td>
    <td style="text-align:center"><input type="checkbox" ${t.include?'checked':''} onchange="_csvPendingRows[${i}].include=this.checked"></td>
  </tr>`).join('');
}
function showCSVPreview(){
  const body=$('csv-preview-body'), actions=$('csv-preview-actions');
  const rows=_csvPendingRows, meta=_csvPendingMeta;
  const dupCount=rows.filter(r=>r.isDup).length;
  const deposits=rows.filter(t=>t.amount>0).reduce((s,t)=>s+t.amount,0);
  const withdrawals=rows.filter(t=>t.amount<0).reduce((s,t)=>s+Math.abs(t.amount),0);
  const lowConf=meta.confidence!=null&&meta.confidence<0.6&&!['bofa','bofa-cc','sofi','cashapp','paypal'].includes(meta.fmt);
  const preview=rows.slice(0,10);
  body.innerHTML=`
    <div style="margin-bottom:14px">
      <div class="fw7 mb2" style="font-size:15px">${esc(meta.acctLabel)}</div>
      <div class="text-muted fs12">${rows.length} transaction${rows.length!==1?'s':''} extracted${meta.skippedRows?` · ${meta.skippedRows} row(s) skipped`:''}</div>
    </div>
    ${lowConf?`<div class="pdf-warning">Column detection confidence is low for this file (unrecognized format) — double-check Date/Description/Amount look right below, or re-import with a specific bank format selected.</div>`:''}
    ${dupCount?`<div class="pdf-warning">${dupCount} row${dupCount!==1?'s':''} match existing transactions and are unchecked by default — they'll be skipped unless you re-check them.</div>`:''}
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px">
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Transactions</div><div class="stat-value" style="font-size:18px">${rows.length}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Deposits</div><div class="stat-value text-green" style="font-size:18px">${deposits?fmt(deposits):'--'}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Withdrawals</div><div class="stat-value text-red" style="font-size:18px">${withdrawals?fmt(withdrawals):'--'}</div></div>
    </div>
    <div class="fw7 mb8 fs13">Preview <span class="text-muted fw4 fs11">(first ${preview.length} of ${rows.length})</span></div>
    <div class="tbl-wrap" style="max-height:220px;overflow-y:auto;margin-bottom:8px;border:1px solid var(--border);border-radius:var(--r-sm)">
      <table class="pdf-preview-tbl">
        <thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Category</th><th style="text-align:center">Include</th></tr></thead>
        <tbody id="csv-preview-rows">${_csvBankPreviewRows(preview)}</tbody>
      </table>
    </div>
    ${rows.length>10?`<div class="text-muted fs12 mb6">+ ${rows.length-10} more will also be imported (default selection shown above applies)</div>`:''}`;
  actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-csv-preview')">Cancel</button>
    <button class="btn btn-primary" onclick="importBankCSV()">Import ${rows.filter(r=>r.include).length} Transactions</button>`;
  openModal('m-csv-preview');
}

// COMMIT — bank/checking CSV (runs the same post-import pipeline the old direct-commit doParse used)
function importBankCSV(){
  const meta=_csvPendingMeta;
  const toImport=_csvPendingRows.filter(r=>r.include);
  if(!toImport.length){closeModal('m-csv-preview');showSaveToast('No transactions selected');return;}
  let added=0,skipped=0;
  const balByDate={};
  toImport.forEach(prow=>{
    const dup=S.transactions.some(t=>t.description===prow.description&&t.amount===prow.amount&&t.date===prow.date);
    if(dup){skipped++;return;}
    const tx={id:uid(),date:prow.date,description:prow.description,amount:prow.amount,category:prow.category,override:false,account:prow.account};
    if(prow.internalXfer) tx.internalXfer=true;
    if(prow.incomeType) tx.incomeType=prow.incomeType;
    S.transactions.push(tx);
    added++;
    if(tx.category==='Credit Card Payments'&&tx.amount<0) matchCCPaymentToCard(tx.description,tx.amount,tx.date);
    if(prow.balance!=null){
      const nd=normalizeDate(prow.date);
      if(nd) balByDate[nd]=prow.balance;
    }
  });

  if(Object.keys(balByDate).length){
    if(!S.balanceHistory[meta.acctLabel]) S.balanceHistory[meta.acctLabel]=[];
    Object.entries(balByDate).forEach(([date,balance])=>{
      const i=S.balanceHistory[meta.acctLabel].findIndex(e=>e.date===date);
      if(i>=0) S.balanceHistory[meta.acctLabel][i].balance=balance;
      else S.balanceHistory[meta.acctLabel].push({date,balance});
    });
    S.balanceHistory[meta.acctLabel].sort((a,b)=>a.date.localeCompare(b.date));
  }

  let nwUpdate=null;
  if(Object.keys(balByDate).length){
    const lastBalDate=Object.keys(balByDate).sort().pop();
    nwUpdate=autoUpdateNWFromCSV(meta.acctLabel,balByDate[lastBalDate]);
  }
  const{subSuggs,billSuggs}=detectRecurring();
  S.subSuggestions=subSuggs;
  S.billSuggestions=billSuggs;
  rebuildArchivedMonths();
  const vaultSync=syncVirtualAccounts();
  let incomeStats=null;
  const newIncome=S.transactions.filter(t=>t.incomeType&&t.amount>0);
  if(newIncome.length){
    S.paySchedule=detectPaySchedule();
    const newInternal=S.transactions.filter(t=>t.internalXfer);
    const incTotal=newIncome.reduce((a,t)=>a+t.amount,0);
    incomeStats={total:incTotal,count:newIncome.length,internalCount:newInternal.length};
  }
  const recatCount=recatForNewCats();
  detectCrossAccountDuplicates();
  autoClassifyNeedsReview();
  const _ps=detectPaySchedule();
  if(_ps){S.paySchedule=_ps;}
  DataStore.sync('csv-upload');
  closeModal('m-csv-preview');
  showUploadSummary(added,skipped,nwUpdate,incomeStats,recatCount,vaultSync);
}

// Cross-account duplicate detection: finds mirror transactions between accounts
// (e.g. bank pays CC → bank side negative, CC side positive isPayment) and marks both internalXfer
function detectCrossAccountDuplicates(){
  const tx=S.transactions;
  const xferCats=new Set(['Credit Card Payments','Transfers']);
  const candidates=tx.filter(t=>!t.internalXfer&&xferCats.has(t.category)&&t.amount&&t.date);
  candidates.forEach(t=>{
    if(t.internalXfer) return;
    const nd=normalizeDate(t.date); if(!nd) return;
    const mirror=tx.find(u=>{
      if(u.id===t.id||u.account===t.account||u.internalXfer) return false;
      if(Math.abs(u.amount+t.amount)>0.02) return false; // opposite signs, same abs value
      const und=normalizeDate(u.date); if(!und) return false;
      const dayDiff=Math.abs(new Date(nd)-new Date(und))/(86400000);
      return dayDiff<=1&&(xferCats.has(u.category)||u.isPayment);
    });
    if(mirror){ t.internalXfer=true; mirror.internalXfer=true; }
  });
}

function rebuildArchivedMonths(){
  const fresh={};
  S.transactions.forEach(t=>{
    const nd=normalizeDate(t.date); if(!nd) return;
    const mo=nd.slice(0,7);
    const key=`${mo}|${t.account||'Unknown'}`;
    if(!fresh[key]) fresh[key]={importedAt:(S.archivedMonths[key]||{}).importedAt||new Date().toISOString(),count:0};
    fresh[key].count++;
  });
  S.archivedMonths=fresh;
}

function openEditTx(id){
  const t=S.transactions.find(x=>x.id===id); if(!t) return;
  editTxId=id;
  $('m-tx-info').textContent=`${t.description||'—'}  ·  ${fmt(t.amount)}`;
  $('f-tx-cat').value=t.category;
  $('f-tx-remember').checked=false;
  $('f-tx-kw').value=extractKeyword(t.description);
  $('f-tx-kw-wrap').style.display='none';
  openModal('m-tx');
}
function saveTxCat(){
  const t=S.transactions.find(x=>x.id===editTxId); if(!t) return;
  const cat=$('f-tx-cat').value;
  t.category=cat; t.override=true;

  if($('f-tx-remember').checked){
    const kw=$('f-tx-kw').value.trim().toLowerCase();
    if(kw){
      if(!S.merchantRules) S.merchantRules={};
      S.merchantRules[kw]=cat;
      // Apply to all existing non-overridden transactions sharing this keyword
      S.transactions.forEach(tx=>{
        if(tx.id!==t.id&&!tx.override&&tx.description&&tx.description.toLowerCase().includes(kw)){
          tx.category=cat;
        }
      });
    }
  }
  save(); closeModal('m-tx'); renderBudget();
}

// ── MERCHANT MEMORY ───────────────────────────────────────────────────────────
function openMerchantsModal(){ renderMerchantsBody(); openModal('m-merchants') }

function renderMerchantsBody(){
  const rules=S.merchantRules||{};
  const keys=Object.keys(rules).sort();
  $('m-merchants-body').innerHTML=keys.length===0
    ?'<div class="text-muted fs12 mb16">No rules saved yet. Edit a transaction and check "Remember this merchant."</div>'
    :`<div class="tbl-wrap" style="max-height:240px;overflow-y:auto;margin-bottom:16px">
       <table>
         <thead><tr><th>Keyword</th><th>Category</th><th></th></tr></thead>
         <tbody>
           ${keys.map(kw=>`<tr>
             <td class="fw7">${esc(kw)}</td>
             <td><span class="badge" style="background:${CAT_CLR[rules[kw]]}22;color:${CAT_CLR[rules[kw]]}">${rules[kw]}</span></td>
             <td><button class="btn btn-danger btn-xs" onclick="deleteMerchantRule('${esc(kw)}')">Remove</button></td>
           </tr>`).join('')}
         </tbody>
       </table>
     </div>`;
}

function deleteMerchantRule(kw){
  delete S.merchantRules[kw]; save(); renderMerchantsBody();
}

function addMerchantRule(){
  const kw=$('f-merch-kw').value.trim().toLowerCase();
  const cat=$('f-merch-cat').value;
  if(!kw) return alert('Keyword required.');
  if(!S.merchantRules) S.merchantRules={};
  S.merchantRules[kw]=cat;
  // Apply immediately to existing non-overridden transactions
  S.transactions.forEach(t=>{
    if(!t.override&&t.description&&t.description.toLowerCase().includes(kw)) t.category=cat;
  });
  save(); $('f-merch-kw').value=''; renderMerchantsBody();
  if(activeTab==='budget') renderBudget();
}
function deleteTx(id){ S.transactions=S.transactions.filter(x=>x.id!==id); save(); renderBudget() }
async function clearTx(){ if(!await appConfirm('Clear all transactions?',{danger:true,confirmText:'Clear'})) return; S.transactions=[]; save(); renderBudget() }

function openBudgetModal(){
  _bModalMode=S.budgetMode||'dollar';
  $('f-budget').value=S.budgetTarget||'';
  $('f-budget-cycle').value=S.budgetCycle||'monthly';
  $('f-budget-pct').value=S.budgetTargetPct||'';
  $('f-income-override').value=S.monthlyIncome||'';
  setBudgetMode(_bModalMode);
  openModal('m-budget');
}

function setBudgetMode(mode){
  _bModalMode=mode;
  const isPct=mode==='percentage';
  $('btn-mode-dollar').className='btn btn-sm '+(isPct?'btn-ghost':'btn-primary');
  $('btn-mode-pct').className='btn btn-sm '+(isPct?'btn-primary':'btn-ghost');
  $('budget-income-row').style.display=isPct?'':'none';
  $('budget-dollar-row').style.display=isPct?'none':'';
  $('budget-pct-row').style.display=isPct?'':'none';
  $('budget-framework-row').style.display=isPct?'':'none';
  $('budget-alloc-tracker').style.display=isPct?'':'none';
  $('budget-cat-label').innerHTML=isPct
    ?'Category Budgets <span style="font-weight:400;color:var(--dim)">(% of income · optional)</span>'
    :'Category Budgets <span style="font-weight:400;color:var(--dim)">(monthly · optional)</span>';
  renderCatBudgetInputs(mode);
  if(isPct){updateIncomeDisplay();updateAllocTracker();}
  updateBudgetHint();
}

function getEffectiveModalIncome(){
  const override=parseFloat(($('f-income-override')||{}).value)||0;
  if(override>0)return override;
  return getMonthlyIncomeBase().amount;
}

function updateIncomeDisplay(){
  const el=$('budget-income-display'); if(!el)return;
  const inc=getMonthlyIncomeBase();
  const override=parseFloat(($('f-income-override')||{}).value)||0;
  const effective=override>0?override:inc.amount;
  if(inc.source==='detected'&&!override){
    el.innerHTML=`<span class="text-green fw7">${fmt(inc.amount)}/mo</span> <span class="text-muted fs11">avg of last ${inc.months} months (auto-detected)</span>`;
  } else if(effective>0){
    el.innerHTML=`<span class="text-accent fw7">${fmt(effective)}/mo</span> <span class="text-muted fs11">${override>0?'manual override':'manually set'}</span>`;
  } else {
    el.innerHTML=`<span style="color:var(--yellow);font-size:12px">No income data detected — enter your expected monthly income below</span>`;
  }
  updateBudgetHint();
  renderCatBudgetInputs(_bModalMode);
  updateAllocTracker();
}

function updateBudgetHint(){
  const el=$('f-budget-hint'); if(!el)return;
  const isPct=_bModalMode==='percentage';
  if(isPct){
    const pctVal=parseFloat(($('f-budget-pct')||{}).value)||0;
    const inc=getEffectiveModalIncome();
    if(pctVal>0&&inc>0){
      el.textContent=`= ${fmt(Math.round(pctVal/100*inc))}/mo based on ${fmt(inc)} monthly income`;
      el.style.color='var(--accent)';
    } else if(pctVal>0){
      el.textContent='Enter your expected monthly income above to see the dollar equivalent';
      el.style.color='var(--yellow)';
    } else {
      el.textContent='';
    }
  } else {
    const cycle=($('f-budget-cycle')||{}).value||S.budgetCycle;
    const amt=parseFloat(($('f-budget')||{}).value)||0;
    el.textContent=cycle==='annual'&&amt>0?`= ${fmt(amt/12)}/month · ${fmt(amt)}/year total`:'';
    el.style.color='var(--accent)';
  }
}

function applyBudgetPresetPct(val){
  const el=$('f-budget-pct'); if(el){el.value=val;}
  updateBudgetHint();
}

function renderCatBudgetInputs(mode){
  const isPct=mode==='percentage';
  const inc=getEffectiveModalIncome();
  const catCols=CATS.filter(c=>c!=='Transfers');
  $('f-cat-budgets').innerHTML=catCols.map(cat=>{
    const existingDollar=(S.catBudgets||{})[cat]||'';
    const existingPct=(S.catBudgetPcts||{})[cat]||'';
    const recPct=CAT_REC_PCT[cat]||'';
    if(isPct){
      const equiv=existingPct>0&&inc>0?`= ${fmt(Math.round(existingPct/100*inc))}/mo`:'';
      return `<div class="form-group">
        <label class="form-label" style="display:flex;align-items:center;gap:5px">
          <span class="dot" style="background:${CAT_CLR[cat]}"></span>${CAT_ICON[cat]||''} ${cat}
          ${recPct?`<span class="text-muted fw4 fs11" style="margin-left:auto">${recPct} suggested</span>`:''}
        </label>
        <div style="position:relative">
          <input class="form-input" id="f-catb-${cat}" placeholder="${(recPct.split('–')[0]||'0').replace(/[^0-9]/g,'')}" type="number" min="0" max="100" step="0.5"
            value="${existingPct}" oninput="updateCatHint('${cat}')" style="padding-right:28px">
          <span style="position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:12px">%</span>
        </div>
        <div id="cat-hint-${cat}" style="font-size:11px;color:var(--accent);margin-top:3px;min-height:14px">${equiv}</div>
      </div>`;
    } else {
      return `<div class="form-group">
        <label class="form-label" style="display:flex;align-items:center;gap:5px">
          <span class="dot" style="background:${CAT_CLR[cat]}"></span>${CAT_ICON[cat]||''} ${cat}
          ${cat==='Charity'?'<span class="text-muted fw4 fs11">&nbsp;~2–5% suggested</span>':''}
        </label>
        <input class="form-input" id="f-catb-${cat}" placeholder="—" type="number" min="0" value="${existingDollar}">
      </div>`;
    }
  }).join('');
}

function updateCatHint(cat){
  const el=$('cat-hint-'+cat); if(!el)return;
  const inc=getEffectiveModalIncome();
  const v=parseFloat(($('f-catb-'+cat)||{}).value)||0;
  el.textContent=v>0&&inc>0?`= ${fmt(Math.round(v/100*inc))}/mo`:'';
  updateAllocTracker();
}

function updateAllocTracker(){
  const barEl=$('alloc-bar'),sumEl=$('alloc-summary'),warnEl=$('alloc-warning');
  if(!barEl)return;
  const catCols=CATS.filter(c=>c!=='Transfers');
  let total=0;
  const parts=catCols.map(cat=>{const v=parseFloat(($('f-catb-'+cat)||{}).value)||0;total+=v;return{cat,v};});
  const over=total>100;
  barEl.innerHTML=parts.filter(p=>p.v>0).map(p=>{
    const w=Math.min(p.v/Math.max(total,100)*100,100);
    return `<div style="width:${w}%;background:${CAT_CLR[p.cat]};transition:width .15s" title="${p.cat}: ${p.v}%"></div>`;
  }).join('')+(total<100?`<div style="width:${100-Math.min(total,100)}%;background:var(--surface3)"></div>`:'');
  if(sumEl)sumEl.innerHTML=over
    ?`<span style="color:var(--red);font-weight:700">${total.toFixed(1)}% allocated — over by ${(total-100).toFixed(1)}%</span>`
    :`<span>Total allocated: <b>${total.toFixed(1)}%</b> · <span style="color:${total<100?'var(--green)':'var(--accent)'}">${(100-total).toFixed(1)}% unallocated</span></span>`;
  if(warnEl)warnEl.innerHTML=over
    ?`<span style="color:var(--red)">⚠ Over-allocated by ${(total-100).toFixed(1)}% — adjust categories below</span>`
    :total>0&&total<80
    ?`<span style="color:var(--yellow)">${(100-total).toFixed(1)}% unallocated — add more categories or leave as buffer</span>`
    :'';
}

function applyFrameworkPreset(key){
  const preset=BUDGET_FRAMEWORK[key]; if(!preset)return;
  CATS.filter(c=>c!=='Transfers').forEach(cat=>{
    const el=$('f-catb-'+cat); if(!el)return;
    el.value=preset[cat]||'';
    updateCatHint(cat);
  });
  updateAllocTracker();
  const pctEl=$('f-budget-pct'); if(pctEl){pctEl.value=80; updateBudgetHint();}
}

function saveBudget(){
  const isPct=_bModalMode==='percentage';
  S.budgetMode=isPct?'percentage':'dollar';
  const incOverride=parseFloat(($('f-income-override')||{}).value)||0;
  S.monthlyIncome=incOverride;
  if(isPct){
    S.budgetTargetPct=parseFloat($('f-budget-pct').value)||0;
    S.budgetCycle='monthly';
    const inc=getMonthlyIncomeBase();
    const effective=incOverride>0?incOverride:inc.amount;
    if(effective>0&&S.budgetTargetPct>0)S.budgetTarget=Math.round(S.budgetTargetPct/100*effective);
    if(!S.catBudgetPcts)S.catBudgetPcts={};
    if(!S.catBudgets)S.catBudgets={};
    CATS.filter(c=>c!=='Transfers').forEach(cat=>{
      const el=$('f-catb-'+cat); if(!el)return;
      const v=parseFloat(el.value)||0;
      if(v>0){
        S.catBudgetPcts[cat]=v;
        if(effective>0)S.catBudgets[cat]=Math.round(v/100*effective);
        else delete S.catBudgets[cat];
      } else {
        delete S.catBudgetPcts[cat];
        delete S.catBudgets[cat];
      }
    });
  } else {
    S.budgetTarget=parseFloat($('f-budget').value)||0;
    S.budgetCycle=$('f-budget-cycle').value;
    if(!S.catBudgets)S.catBudgets={};
    CATS.filter(c=>c!=='Transfers').forEach(cat=>{
      const el=$('f-catb-'+cat); if(!el)return;
      const v=parseFloat(el.value)||0;
      if(v>0)S.catBudgets[cat]=v; else delete S.catBudgets[cat];
    });
  }
  save(); closeModal('m-budget'); renderBudget();
}

function _spendingHTML(){
  const accounts=[...new Set(S.transactions.map(t=>t.account).filter(Boolean))];
  const allTx=(txAccFilter?S.transactions.filter(t=>t.account===txAccFilter):S.transactions).filter(t=>txInRange(t));
  const expenses=allTx.filter(t=>t.amount<0&&!isExcludedFromSpend(t));
  const investedTotal=allTx.filter(t=>t.amount<0&&t.category==='Investments').reduce((a,t)=>a+Math.abs(t.amount),0);
  const ccPayTotal=allTx.filter(t=>t.amount<0&&t.category==='Credit Card Payments').reduce((a,t)=>a+Math.abs(t.amount),0);
  const incomeTx=allTx.filter(t=>t.amount>0&&!t.internalXfer&&!t.isPayment);
  const spent=expenses.reduce((a,t)=>a+Math.abs(t.amount),0);
  const totalIncome=incomeTx.reduce((a,t)=>a+t.amount,0);
  const netFlow=totalIncome-spent;
  const hasIncome=incomeTx.length>0;
  const effBudget=getEffectiveBudget();
  const rangeMonths=getRangeMonths();
  const monthlyBudget=getMonthlyBudget();
  const bPct=effBudget>0?Math.min(spent/effBudget*100,100):0;
  const remaining=Math.max(0,effBudget-spent);
  const byCat={};CATS.forEach(c=>byCat[c]=0);
  expenses.forEach(t=>{byCat[t.category]=(byCat[t.category]||0)+Math.abs(t.amount)});
  const byIncSrc={};
  incomeTx.forEach(t=>{const s=t.incomeType||'Other';byIncSrc[s]=(byIncSrc[s]||0)+t.amount;});
  const sorted=[...allTx].sort((a,b)=>{const na=normalizeDate(a.date)||a.date,nb=normalizeDate(b.date)||b.date;return nb.localeCompare(na)});
  const _incBase=getMonthlyIncomeBase();
  const budgetSubLine=S.budgetMode==='percentage'&&S.budgetTargetPct
    ?`${S.budgetTargetPct}% of income · ${fmt(monthlyBudget)}/mo${rangeMonths>1?` · ×${rangeMonths} months`:''}`
    :S.budgetCycle==='annual'&&S.budgetTarget
    ?`${fmt(S.budgetTarget)}/yr = ${fmt(monthlyBudget)}/mo${rangeMonths>1?` · ×${rangeMonths} months`:''}`
    :rangeMonths>1?`${fmt(monthlyBudget)}/mo × ${rangeMonths} months`:`${fmt(monthlyBudget)}/mo`;
  return `
  ${hasIncome?`<div class="card mb16" style="border-left:4px solid var(--green)">
    <div class="card-title mb12">Income vs Expenses</div>
    <div class="${hasIncome?'g4':'g3'} mb12" style="gap:10px">
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center">
        <div class="text-green fw8" style="font-size:20px">${fmt(totalIncome)}</div><div class="text-muted fs11 mt6">Total Income</div>
      </div>
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center">
        <div class="text-red fw8" style="font-size:20px">${fmt(spent)}</div><div class="text-muted fs11 mt6">Total Expenses</div>
      </div>
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center">
        <div class="${netFlow>=0?'text-green':'text-red'} fw8" style="font-size:20px">${netFlow>=0?'+':''}${fmt(netFlow)}</div><div class="text-muted fs11 mt6">Net Cash Flow</div>
      </div>
      ${netFlow>=0&&totalIncome>0?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center">
        <div class="fw8 text-accent" style="font-size:20px">${pct(spent/totalIncome*100)}</div><div class="text-muted fs11 mt6">Expense Ratio</div>
      </div>`:''}
    </div>
    ${Object.keys(byIncSrc).length>0?`<div class="fs12 fw7 mb8">Income Sources</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      ${Object.entries(byIncSrc).sort((a,b)=>b[1]-a[1]).map(([src,amt])=>{
        const p=totalIncome>0?(amt/totalIncome*100):0;
        return `<div><div class="flex-sb fs12 mb6"><span class="flex gap6"><span class="dot" style="background:${INCOME_SRC_CLR[src]||'#6b7280'}"></span>${src}</span><span class="fw7 text-green">${fmt(amt)}</span></div><div class="bar-wrap"><div class="bar-fill" style="width:${p}%;background:${INCOME_SRC_CLR[src]||'#6b7280'}"></div></div></div>`;
      }).join('')}
    </div>`:''}
  </div>`:''}
  ${(investedTotal>0||ccPayTotal>0)?`<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;padding:10px;background:var(--surface2);border-radius:var(--r-sm);align-items:center">
    <span class="text-muted fs12">Excluded from spending:</span>
    ${investedTotal>0?`<span class="fw7 fs13" style="color:#00D4AA">📈 Invested: ${fmt(investedTotal)}</span>`:''}
    ${ccPayTotal>0?`<span class="fw7 fs13" style="color:#378ADD">💳 Debt Payments: ${fmt(ccPayTotal)}</span>`:''}
    <span class="text-muted fs11" style="margin-left:auto">
      <label style="cursor:pointer;display:flex;gap:4px;align-items:center">
        <input type="checkbox" ${S.includeInvestmentsInSpend?'checked':''} onchange="S.includeInvestmentsInSpend=this.checked;save();renderBudget()" style="accent-color:#00D4AA">
        <span>Include investments</span>
      </label>
      <label style="cursor:pointer;display:flex;gap:4px;align-items:center;margin-top:3px">
        <input type="checkbox" ${S.includeCCPaymentsInSpend?'checked':''} onchange="S.includeCCPaymentsInSpend=this.checked;save();renderBudget()" style="accent-color:#378ADD">
        <span>Include card payments</span>
      </label>
    </span>
  </div>`:''}
  <div class="g3 mb16">
    <div class="stat"><div class="stat-label">Total Spent</div><div class="stat-value text-red">${fmt(spent)}</div><div class="stat-sub">${expenses.length} expenses${txAccFilter?' · '+txAccFilter:''}</div></div>
    <div class="stat"><div class="stat-label">Budget Target</div><div class="stat-value">${effBudget?fmt(effBudget):'—'}</div><div class="stat-sub">${budgetSubLine}<br><button class="btn btn-ghost btn-xs" style="margin-top:4px" onclick="openBudgetModal()">Edit</button></div></div>
    <div class="stat"><div class="stat-label">Remaining</div><div class="stat-value ${remaining>0?'text-green':'text-red'}">${effBudget?fmt(remaining):'—'}</div><div class="stat-sub">${effBudget?pct(bPct)+' of budget used':'No budget set'}</div></div>
  </div>
  ${effBudget?`<div class="card mb16">
    <div class="flex-sb mb8"><div class="card-title">Budget Progress</div><span class="badge ${bPct<80?'badge-green':bPct<100?'badge-yellow':'badge-red'}">${pct(bPct)}</span></div>
    <div class="bar-wrap bar-wrap-md"><div class="bar-fill ${bPct<80?'bar-green':bPct<100?'bar-yellow':'bar-red'}" style="width:${bPct}%"></div></div>
    ${bPct>=100?'<div class="text-red fs12 mt8">Over budget!</div>':bPct>=80?'<div class="text-yellow fs12 mt8">Approaching budget limit.</div>':''}
  </div>`:''}
  <div class="card mb16">
    <div class="flex-sb mb12"><div class="card-title">Where your money went</div><span class="badge badge-purple">Flow</span></div>
    <div id="money-flow"></div>
  </div>
  <div class="g2 mb16">
    <div class="card"><div class="card-title mb16">Spending by Category</div><div class="chart-wrap" style="height:240px"><canvas id="budget-chart"></canvas></div></div>
    <div class="card">
      <div class="flex-sb mb16">
        <div class="card-title">Category Breakdown</div>
        <button class="btn btn-ghost btn-xs" onclick="openBudgetModal()" title="Set category budgets">Set Targets</button>
      </div>
      ${CATS.map(cat=>{
        const amt=byCat[cat]||0; if(!amt) return '';
        const p=spent>0?(amt/spent)*100:0;
        const catTarget=getEffectiveCatBudget(cat);
        const cp=catTarget>0?amt/catTarget*100:0;
        const barCls=catTarget>0?(cp>=100?'bar-red':cp>=80?'bar-yellow':'bar-green'):'';
        const badge=catTarget>0?(cp>=100
          ?`<span class="badge badge-red" style="font-size:10px">+${fmt(amt-catTarget)}</span>`
          :cp>=80
          ?`<span class="badge badge-yellow" style="font-size:10px">${pct(cp)}</span>`
          :`<span class="badge badge-green" style="font-size:10px">${pct(cp)}</span>`):'';
        const catPctTarget=S.budgetMode==='percentage'?(S.catBudgetPcts||{})[cat]:0;
        const incAmt=_incBase.amount;
        const spentPctInc=incAmt>0?((amt/incAmt)*100).toFixed(1):null;
        const pctLabel=catPctTarget&&incAmt>0
          ?`<span class="text-muted fs11" style="font-weight:400">· ${spentPctInc}% of ${catPctTarget}% target</span>`:'';
        return `<div class="mb16">
          <div class="flex-sb fs12 mb8">
            <span class="flex gap6"><span class="dot" style="background:${CAT_CLR[cat]}"></span>${cat}</span>
            <span class="fw7 flex gap6 align-center">${fmt(amt)}${catTarget?`<span class="text-muted" style="font-weight:400">/ ${fmt(catTarget)}</span>`:`<span class="text-muted" style="font-weight:400">${pct(p)}</span>`}${badge}</span>
          </div>
          ${pctLabel?`<div class="fs11 text-muted mb4">${pctLabel}</div>`:''}
          ${catTarget
            ?`<div class="bar-wrap" title="${fmt(amt)} of ${fmt(catTarget)} (${cp.toFixed(1)}%)"><div class="bar-fill ${barCls}" style="width:${Math.min(cp,100)}%"></div></div>`
            :`<div class="bar-wrap"><div class="bar-fill" style="width:${p}%;background:${CAT_CLR[cat]}"></div></div>`}
        </div>`;
      }).join('')}
    </div>
  </div>
  <div class="card">
    <div class="card-header" style="flex-wrap:wrap;gap:10px">
      <div class="card-title">Transactions (${allTx.length}${txAccFilter?' — '+txAccFilter:''})</div>
      <div class="flex gap8" style="flex-wrap:wrap">
        ${accounts.length>1?`<select class="form-input btn-sm" style="width:auto;padding:5px 28px 5px 10px" onchange="txAccFilter=this.value;renderBudget()"><option value="">All accounts</option>${accounts.map(a=>`<option value="${esc(a)}" ${a===txAccFilter?'selected':''}>${esc(a)}</option>`).join('')}</select>`:''}
        <button class="btn btn-ghost btn-sm" onclick="openMerchantsModal()">Merchant Rules</button>
        <button class="btn btn-danger btn-sm" onclick="clearTx()">Clear All</button>
      </div>
    </div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Category</th>${accounts.length>1?'<th>Account</th>':''}<th>Actions</th></tr></thead>
      <tbody>${sorted.map(t=>{
        const isInc=t.incomeType||t.category==='Income';
        const isInt=t.internalXfer;
        const clr=isInc?CAT_CLR.Income:(CAT_CLR[t.category]||CAT_CLR.Other);
        const lbl=isInt?'Internal Transfer':isInc?(t.incomeType||'Income'):t.category;
        const badgeBg=isInt?'var(--surface3)':clr+'22';
        const badgeClr=isInt?'var(--muted)':clr;
        return `<tr${isInt?' style="opacity:.65"':''}>
        <td class="text-muted" style="white-space:nowrap">${t.date||'—'}</td>
        <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(t.description)}">${esc(t.description)}</td>
        <td class="${t.amount<0?'text-red':'text-green'} fw7">${fmt(t.amount)}</td>
        <td><span class="badge" style="background:${badgeBg};color:${badgeClr}">${t.override?'✏ ':''}${lbl}</span></td>
        ${accounts.length>1?`<td><span class="badge badge-muted fs11">${esc(t.account||'')}</span></td>`:''}
        <td><div class="flex gap6"><button class="btn btn-ghost btn-xs" onclick="openEditTx('${t.id}')">Edit</button><button class="btn btn-danger btn-xs" onclick="deleteTx('${t.id}')">✕</button></div></td>
      </tr>`;}).join('')}</tbody>
    </table></div>
  </div>`;
}

function _trendsHTML(){
  const allRange=S.transactions.filter(t=>txInRange(t));
  const filtered=allRange.filter(t=>t.amount<0&&!t.internalXfer);
  const incFiltered=allRange.filter(t=>t.amount>0&&!t.internalXfer&&!t.isPayment);
  const byMonth={};
  filtered.forEach(t=>{
    const nd=normalizeDate(t.date);if(!nd)return;
    const mo=nd.slice(0,7);
    if(!byMonth[mo]){byMonth[mo]={total:0,income:0};CATS.forEach(c=>byMonth[mo][c]=0);}
    byMonth[mo].total+=Math.abs(t.amount);
    byMonth[mo][t.category]=(byMonth[mo][t.category]||0)+Math.abs(t.amount);
  });
  incFiltered.forEach(t=>{
    const nd=normalizeDate(t.date);if(!nd)return;
    const mo=nd.slice(0,7);
    if(!byMonth[mo]){byMonth[mo]={total:0,income:0};CATS.forEach(c=>byMonth[mo][c]=0);}
    byMonth[mo].income=(byMonth[mo].income||0)+t.amount;
  });
  const months=Object.keys(byMonth).sort();
  if(!months.length) return '<div class="empty"><div class="empty-icon">📊</div><div>No transaction data for the selected range.</div></div>';
  const hasIncome=months.some(m=>byMonth[m].income>0);
  let bigMoM=null;
  for(let i=1;i<months.length;i++){
    const d=byMonth[months[i]].total-byMonth[months[i-1]].total;
    if(!bigMoM||Math.abs(d)>Math.abs(bigMoM.delta)) bigMoM={from:months[i-1],to:months[i],delta:d};
  }
  const avgTotal=months.reduce((a,m)=>a+byMonth[m].total,0)/months.length;
  const avgIncome=hasIncome?months.reduce((a,m)=>a+(byMonth[m].income||0),0)/months.length:0;
  const netFlows=months.map(m=>(byMonth[m].income||0)-byMonth[m].total);
  const catAvg={};CATS.forEach(c=>{catAvg[c]=months.reduce((a,m)=>a+(byMonth[m][c]||0),0)/months.length});
  return `
  ${months.length===1?'<div class="alert alert-info">ℹ Import more months to see trend analysis.</div>':''}
  ${bigMoM&&months.length>1?`<div class="card mb16"><div class="card-title mb16">Month-over-Month Insights</div><div class="${hasIncome?'g4':'g3'}">
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="${bigMoM.delta>0?'text-red':'text-green'} fw8" style="font-size:20px">${bigMoM.delta>0?'+':''}${fmt(bigMoM.delta)}</div><div class="text-muted fs11 mt8">Biggest swing (${bigMoM.from} → ${bigMoM.to})</div></div>
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw8" style="font-size:20px">${fmt(avgTotal)}</div><div class="text-muted fs11 mt8">Avg monthly spending</div></div>
    ${hasIncome?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="text-green fw8" style="font-size:20px">${fmt(avgIncome)}</div><div class="text-muted fs11 mt8">Avg monthly income</div></div>`:''}
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="text-accent fw8" style="font-size:20px">${months.length}</div><div class="text-muted fs11 mt8">Months of data</div></div>
  </div></div>`:''}
  <div class="g2 mb16">
    <div class="card"><div class="card-title mb16">Monthly ${hasIncome?'Income vs Expenses':'Spending'} Trend</div><div class="chart-wrap" style="height:240px"><canvas id="trends-total-chart"></canvas></div></div>
    <div class="card"><div class="card-title mb16">${hasIncome?'Net Cash Flow per Month':'Spending by Category per Month'}</div><div class="chart-wrap" style="height:240px"><canvas id="${hasIncome?'trends-netflow':'trends-cat'}-chart"></canvas></div></div>
  </div>
  ${!hasIncome?`<div class="card mb16"><div class="card-title mb16">Spending by Category per Month</div><div class="chart-wrap" style="height:240px"><canvas id="trends-cat-chart"></canvas></div></div>`:''}
  <div class="card"><div class="card-title mb16">Average Monthly ${hasIncome?'Income & ':''}Spend by Category</div>
    ${hasIncome?`<div class="mb12 flex-sb fs12"><span class="flex gap6"><span class="dot" style="background:var(--green)"></span>Income</span><span class="fw7 text-green">${fmt(avgIncome)}/mo</span></div>`:''}
    ${CATS.map(cat=>{const avg=catAvg[cat]||0;if(!avg)return '';const p=avgTotal>0?(avg/avgTotal)*100:0;return `<div class="mb12"><div class="flex-sb fs12 mb6"><span class="flex gap6"><span class="dot" style="background:${CAT_CLR[cat]}"></span>${cat}</span><span class="fw7">${fmt(avg)}/mo <span class="text-muted">${pct(p)}</span></span></div><div class="bar-wrap"><div class="bar-fill" style="width:${p}%;background:${CAT_CLR[cat]}"></div></div></div>`;}).join('')}
  </div>`;
}

function getAccountType(acctName){
  const n=(acctName||'').toLowerCase();
  if(/credit|cashback|cash.?back|visa|mastercard|amex|discover|\bcard\b/.test(n)) return 'credit_card';
  if(/savings|save\b|vault|emergency/.test(n)) return 'savings';
  if(/invest|brokerage|portfolio|\betf\b|stock/.test(n)) return 'investment';
  return 'checking';
}
function getAcctTerms(type){
  if(type==='credit_card') return {debit:'Charges',credit:'Payments',badge:'Credit Card',badgeClr:'#ec4899'};
  if(type==='savings') return {debit:'Withdrawals',credit:'Deposits',badge:'Savings',badgeClr:'#14b8a6'};
  if(type==='investment') return {debit:'Withdrawals',credit:'Contributions',badge:'Investment',badgeClr:'#8b5cf6'};
  return {debit:'Spending',credit:'Money In',badge:'Checking',badgeClr:'#3b82f6'};
}

// ── ACCOUNT MATCHING ──────────────────────────────────────────────────────────
const _CHK_WORDS=['checking','checkings','chequing','chk'];
const _SAV_WORDS=['savings','saving','save','sav'];
function _acctType(n){return _CHK_WORDS.some(w=>n.includes(w))?'chk':_SAV_WORDS.some(w=>n.includes(w))?'sav':'other';}
function _normAcct(name){return(name||'').toLowerCase().trim().replace(/\bcheckings\b/g,'checking').replace(/\s+/g,' ');}

function findMatchingAccount(typedName){
  if(!typedName) return null;
  const existing=[...new Set(S.transactions.map(t=>t.account).filter(Boolean))];
  const nt=_normAcct(typedName);
  for(const acct of existing){
    const na=_normAcct(acct);
    if(na===nt) return{name:acct,txCount:S.transactions.filter(t=>t.account===acct).length};
    const tw=nt.split(/\s+/),aw=na.split(/\s+/);
    if(tw[0]&&aw[0]&&(tw[0]===aw[0]||tw[0].startsWith(aw[0])||aw[0].startsWith(tw[0]))){
      const tt=_acctType(nt),at=_acctType(na);
      if(tt!=='other'&&tt===at) return{name:acct,txCount:S.transactions.filter(t=>t.account===acct).length};
    }
  }
  return null;
}

// ── ACCOUNT DELETE ────────────────────────────────────────────────────────────
function deleteAccount(idx){
  const acctName=_accountsList[idx]; if(!acctName) return;
  const txCount=S.transactions.filter(t=>t.account===acctName).length;
  const hasBH=!!(S.balanceHistory&&S.balanceHistory[acctName]);
  const hasAsset=(S.assets||[]).some(a=>a.name===acctName);
  $('m-acct-delete-body').innerHTML=`
    <p class="mb12">Permanently remove <strong>${esc(acctName)}</strong>?</p>
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;margin-bottom:16px;font-size:13px">
      <div>• ${txCount} transaction${txCount!==1?'s':''}</div>
      ${hasBH?'<div>• Balance history</div>':''}
      ${hasAsset?'<div>• Linked net worth asset</div>':''}
    </div>
    <p class="text-muted fs12">This cannot be undone.</p>`;
  $('m-acct-delete-btn').onclick=()=>_doDeleteAccount(acctName);
  openModal('m-acct-delete');
}

function _doDeleteAccount(acctName){
  S.transactions=S.transactions.filter(t=>t.account!==acctName);
  if(S.balanceHistory) delete S.balanceHistory[acctName];
  if(S.assets) S.assets=S.assets.filter(a=>a.name!==acctName);
  (S.goals||[]).forEach(g=>{if(g.linkedAccount===acctName){g.linkedAccount=null;g.note='Linked account deleted — update progress manually';}});
  DataStore.sync('account-deleted');
  closeModal('m-acct-delete');
  renderBudget();
  showSaveToast(acctName+' deleted');
}

// ── ACCOUNT MERGE ─────────────────────────────────────────────────────────────
function _accountsAreSimilar(a,b){
  const na=_normAcct(a),nb=_normAcct(b);
  if(na===nb) return true;
  const aw=na.split(/\s+/),bw=nb.split(/\s+/);
  if(aw[0]&&bw[0]&&(aw[0]===bw[0]||aw[0].startsWith(bw[0])||bw[0].startsWith(aw[0]))){
    const ta=_acctType(na),tb=_acctType(nb);
    if(ta!=='other'&&ta===tb) return true;
  }
  return false;
}

function openMergeAccountsModal(){
  const accounts=[...new Set(S.transactions.map(t=>t.account).filter(Boolean))];
  _mergePairs=[];
  for(let i=0;i<accounts.length;i++) for(let j=i+1;j<accounts.length;j++) if(_accountsAreSimilar(accounts[i],accounts[j])) _mergePairs.push([accounts[i],accounts[j]]);
  if(!_mergePairs.length){$('m-merge-body').innerHTML='<p class="text-muted fs13 mb4">No duplicate accounts detected.</p>';openModal('m-merge-accounts');return;}
  $('m-merge-body').innerHTML=_mergePairs.map((pair,idx)=>{
    const c0=S.transactions.filter(t=>t.account===pair[0]).length;
    const c1=S.transactions.filter(t=>t.account===pair[1]).length;
    return `<div style="background:var(--surface2);border-radius:var(--r);padding:14px;margin-bottom:12px">
      <div class="fw7 fs13 mb8">Possible duplicate pair</div>
      <div class="mb4"><span class="fw7">${esc(pair[0])}</span> <span class="text-muted fs12">(${c0} transaction${c0!==1?'s':''})</span></div>
      <div class="mb10"><span class="fw7">${esc(pair[1])}</span> <span class="text-muted fs12">(${c1} transaction${c1!==1?'s':''})</span></div>
      <div style="display:flex;align-items:center;gap:8px">
        <label class="fs12 text-muted" style="flex-shrink:0">Keep name:</label>
        <select class="form-input" style="flex:1;padding:6px 10px;font-size:13px" id="merge-keep-${idx}">
          <option value="${esc(pair[0])}">${esc(pair[0])}</option>
          <option value="${esc(pair[1])}">${esc(pair[1])}</option>
        </select>
        <button class="btn btn-primary btn-sm" onclick="doMergeAccounts(${idx})">Merge</button>
      </div>
    </div>`;
  }).join('');
  openModal('m-merge-accounts');
}

function doMergeAccounts(idx){
  const pair=_mergePairs[idx]; if(!pair) return;
  const keepEl=$('merge-keep-'+idx);
  const keepName=keepEl?keepEl.value:pair[0];
  const removeName=keepName===pair[0]?pair[1]:pair[0];
  let merged=0,dupes=0;
  const keepTx=S.transactions.filter(t=>t.account===keepName);
  S.transactions.forEach(t=>{
    if(t.account!==removeName) return;
    const dup=keepTx.some(k=>k.date===t.date&&Math.abs(k.amount-t.amount)<0.01&&k.description===t.description);
    if(dup){dupes++;t._rm=true;}else{t.account=keepName;merged++;}
  });
  S.transactions=S.transactions.filter(t=>!t._rm);
  if(S.balanceHistory&&S.balanceHistory[removeName]){
    if(!S.balanceHistory[keepName]) S.balanceHistory[keepName]=[];
    S.balanceHistory[removeName].forEach(e=>{if(!S.balanceHistory[keepName].find(k=>k.date===e.date)) S.balanceHistory[keepName].push(e);});
    S.balanceHistory[keepName].sort((a,b)=>a.date.localeCompare(b.date));
    delete S.balanceHistory[removeName];
  }
  (S.goals||[]).forEach(g=>{if(g.linkedAccount===removeName) g.linkedAccount=keepName;});
  (S.assets||[]).forEach(a=>{if(a.name===removeName) a.name=keepName;});
  DataStore.sync('account-merged');
  closeModal('m-merge-accounts');
  renderBudget();
  showSaveToast(`Merged ${merged} tx into "${keepName}"${dupes?`. ${dupes} duplicates removed`:'.'}`);
}

// ── CARD DELETE CONFIRMATION ───────────────────────────────────────────────────
function deleteCardConfirm(id){
  const c=S.cards.find(x=>x.id===id); if(!c) return;
  const txCount=S.transactions.filter(t=>t.account===c.name&&t.source==='cc-csv').length;
  $('m-card-delete-body').innerHTML=`
    <p class="mb12">Permanently remove <strong>${esc(c.name)}</strong>?</p>
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;margin-bottom:16px;font-size:13px">
      <div>• Balance: ${fmt(c.balance||0)}</div>
      ${txCount?`<div>• ${txCount} imported transaction${txCount!==1?'s':''}</div>`:''}
      <div>• Interest history and payment records</div>
      <div>• Linked net worth liability</div>
    </div>
    <p class="text-muted fs12">This cannot be undone.</p>`;
  $('m-card-delete-btn').onclick=()=>_doDeleteCard(id);
  openModal('m-card-delete');
}

function _doDeleteCard(id){
  const c=S.cards.find(x=>x.id===id); if(!c) return;
  const name=c.name;
  S.cards=S.cards.filter(x=>x.id!==id);
  S.transactions=S.transactions.filter(t=>!(t.account===name&&t.source==='cc-csv'));
  syncCardLiabilities();
  DataStore.sync('card-deleted');
  closeModal('m-card-delete');
  renderCards();
  showSaveToast(name+' deleted');
}

function _accountsHTML(){
  const accounts=[...new Set(S.transactions.map(t=>t.account).filter(Boolean))];
  _accountsList=accounts;
  if(!accounts.length) return '<div class="empty"><div class="empty-icon">🏦</div><div>No account data. Import CSVs and assign account labels.</div></div>';

  // Transfer flow: group internalXfer transactions by month
  const xferTx=S.transactions.filter(t=>t.internalXfer&&txInRange(t));
  const xferByMonth={};
  xferTx.forEach(t=>{const nd=normalizeDate(t.date);if(!nd)return;const mo=nd.slice(0,7);if(!xferByMonth[mo])xferByMonth[mo]={in:0,out:0};if(t.amount>0)xferByMonth[mo].in+=t.amount;else xferByMonth[mo].out+=Math.abs(t.amount);});
  const xferMonths=Object.keys(xferByMonth).sort().slice(-6);
  const xferHTML=xferTx.length?`<div class="card mb16">
    <div class="card-title mb10">Transfer Flow (Internal)</div>
    <div class="text-muted fs12 mb10">Transfers between SoFi accounts and Emergency Fund Vault — excluded from spending totals.</div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Month</th><th>Moved In</th><th>Moved Out</th><th>Net</th></tr></thead>
      <tbody>${xferMonths.map(mo=>{const{in:i,out:o}=xferByMonth[mo];const net=i-o;return `<tr><td>${mo}</td><td class="text-green">${i>0?fmt(i):'—'}</td><td class="text-red">${o>0?fmt(o):'—'}</td><td class="${net>=0?'text-green':'text-red'} fw7">${net>=0?'+':''}${fmt(net)}</td></tr>`;}).join('')}</tbody>
    </table></div>
  </div>`:'';

  const mergeHdr=`<div class="flex-sb mb12"><div class="fw7 fs13">${accounts.length} Account${accounts.length!==1?'s':''}</div><button class="btn btn-ghost btn-xs" onclick="openMergeAccountsModal()">Merge duplicates</button></div>`;
  return mergeHdr+xferHTML+accounts.map((acct,acctIdx)=>{
    const acctType=getAccountType(acct);
    const terms=getAcctTerms(acctType);
    const allAcctTx=S.transactions.filter(t=>t.account===acct);
    const rangeTx=allAcctTx.filter(t=>txInRange(t));
    // Savings accounts: include internal transfers (To/From Checking is real savings activity)
    // Checking/CC: exclude internal transfers to avoid double-counting with other accounts
    const isSavingsAcct=acctType==='savings';
    const expenses=rangeTx.filter(t=>t.amount<0&&(isSavingsAcct||!t.internalXfer));
    const income=rangeTx.filter(t=>t.amount>0&&(isSavingsAcct||!t.internalXfer));
    const internalCount=rangeTx.filter(t=>t.internalXfer).length;
    const totalDebits=expenses.reduce((a,t)=>a+Math.abs(t.amount),0);
    const totalCredits=income.reduce((a,t)=>a+t.amount,0);
    const bh=(S.balanceHistory||{})[acct]||[];
    const latestBal=bh.length?bh[bh.length-1].balance:null;
    const highBal=bh.length?Math.max(...bh.map(e=>e.balance)):null;
    const lowBal=bh.length?Math.min(...bh.map(e=>e.balance)):null;
    const byCat={};expenses.forEach(t=>{byCat[t.category]=(byCat[t.category]||0)+Math.abs(t.amount)});
    const topCats=Object.entries(byCat).sort((a,b)=>b[1]-a[1]).slice(0,3);
    // For credit cards, check if there's a matching card in S.cards for utilization
    let utilHTML='';
    if(acctType==='credit_card'){
      const matchCard=(S.cards||[]).find(c=>acct.toLowerCase().includes((c.name||'').toLowerCase().split(/\s+/)[0])||((c.name||'').toLowerCase().includes(acct.toLowerCase().split(/\s+/)[0])));
      if(matchCard&&matchCard.limit>0){
        const util=Math.round((matchCard.balance||0)/matchCard.limit*100);
        utilHTML=`<div class="mt8"><div class="flex-sb fs12 mb4"><span class="text-muted">Utilization</span><span class="fw7 ${utilTxt(util)}">${util}% — <span style="cursor:pointer;text-decoration:underline;color:var(--accent)" onclick="go('cards')">Manage card</span></span></div><div class="bar-wrap"><div class="bar-fill ${utilCls(util)}" style="width:${Math.min(util,100)}%"></div></div></div>`;
      }
    }
    // Interest earned for savings
    let interestHTML='';
    if(acctType==='savings'){
      const intEarned=rangeTx.filter(t=>t.incomeType==='Interest').reduce((a,t)=>a+t.amount,0);
      if(intEarned>0) interestHTML=`<div class="flex-sb fs12 mt8"><span class="text-muted">Interest earned (period)</span><span class="fw7 text-green">${fmt(intEarned)}</span></div>`;
    }
    return `<div class="card mb16">
      <div class="card-header">
        <div class="flex gap8 align-center flex-wrap">
          <div class="card-title">${esc(acct)}</div>
          <span class="badge fs11" style="background:${terms.badgeClr}22;color:${terms.badgeClr}">${terms.badge}</span>
        </div>
        <div style="display:flex;align-items:center;gap:12px">
          ${latestBal!==null?`<div style="text-align:right"><div class="fw8 text-green" style="font-size:20px">${fmt(latestBal)}</div><div class="text-muted fs11">Latest Balance</div></div>`:''}
          <button class="btn btn-danger btn-xs" onclick="deleteAccount(${acctIdx})">Delete</button>
        </div>
      </div>
      <div class="text-muted fs12 mb12">${allAcctTx.length} total transactions</div>
      <div class="${internalCount?'g4':'g3'} mb16">
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="text-red fw8" style="font-size:18px">${fmt(totalDebits)}</div><div class="text-muted fs11 mt8">${terms.debit}</div></div>
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="text-green fw8" style="font-size:18px">${fmt(totalCredits)}</div><div class="text-muted fs11 mt8">${terms.credit}</div></div>
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw8" style="font-size:18px">${rangeTx.length}</div><div class="text-muted fs11 mt8">Transactions</div></div>
        ${internalCount?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="text-muted fw8" style="font-size:18px">${internalCount}</div><div class="text-muted fs11 mt8">Internal Transfers</div></div>`:''}
      </div>
      ${topCats.length?`<div style="font-size:12px;font-weight:600;margin-bottom:10px">Top Categories (range)</div>${topCats.map(([cat,amt])=>{const p=totalDebits>0?(amt/totalDebits)*100:0;return `<div class="mb8"><div class="flex-sb fs12 mb8"><span class="flex gap6"><span class="dot" style="background:${CAT_CLR[cat]}"></span>${cat}</span><span class="fw7">${fmt(amt)}</span></div><div class="bar-wrap"><div class="bar-fill" style="width:${p}%;background:${CAT_CLR[cat]}"></div></div></div>`;}).join('')}`:''}
      ${utilHTML}${interestHTML}
      ${latestBal!==null&&bh.length>1?`<div class="divider"></div><div class="flex gap16 fs12 text-muted flex-wrap"><span>Balance history:</span><span>High: <span class="fw7 text-green">${fmt(highBal)}</span></span><span>Low: <span class="fw7 ${lowBal<0?'text-red':'text-yellow'}">${fmt(lowBal)}</span></span></div>`:''}
    </div>`;
  }).join('')+(()=>{
    const vaultAccts=(AnchorDB.virtualAccounts||[]).filter(v=>v.type==='savings-vault'&&(v.balance>0||v.transactionCount>0));
    if(!vaultAccts.length) return '';
    return vaultAccts.map(v=>{
      const vd=getVaultData(v.name);
      const moKeys=Object.keys(vd.monthlyFlow).sort().slice(-6);
      return `<div class="card mb16" style="border-left:3px solid var(--teal)">
        <div class="card-header">
          <div class="flex gap8 align-center flex-wrap">
            <div class="card-title">${esc(v.name)}</div>
            <span class="badge fs10" style="background:rgba(0,212,170,.15);color:var(--teal);padding:2px 7px">↻ virtual · SoFi</span>
            <span class="badge fs11" style="background:var(--surface3);color:var(--muted)">Savings Vault</span>
          </div>
          <div style="text-align:right">
            <div class="fw8 text-green" style="font-size:20px">${fmt(v.balance)}</div>
            <div class="text-muted fs11">Reconstructed balance</div>
          </div>
        </div>
        <div class="text-muted fs12 mb12">${v.transactionCount} vault transaction${v.transactionCount!==1?'s':''} · last activity ${v.lastUpdated||'—'} · <span style="color:var(--accent);cursor:pointer;text-decoration:underline" data-v="${esc(v.name)}" onclick="openVaultLedger(this.dataset.v)">How is this calculated?</span> · <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="go('goals')">View in Goals →</span></div>
        ${moKeys.length?`<div class="fs12 fw6 mb6">Monthly vault flow</div>
        <div class="tbl-wrap fs12"><table>
          <thead><tr><th>Month</th><th>Net Flow</th></tr></thead>
          <tbody>${moKeys.map(mo=>{const fl=vd.monthlyFlow[mo];return `<tr><td>${mo}</td><td class="${fl>=0?'text-green':'text-red'} fw6">${fl>=0?'+':''}${fmt(fl)}</td></tr>`;}).join('')}</tbody>
        </table></div>`:''}
        <div class="text-muted fs11 mt8">⚠ Not included in Net Worth total — already part of SoFi Savings balance.</div>
      </div>`;
    }).join('');
  })();
}

function _incomeTimelineHTML(){
  const srcs=(AnchorDB.income.sources||[]).filter(s=>s.isManual&&s.status!=='archived');
  if(srcs.length<2) return '';
  const today=new Date();
  const maxAgo=new Date(today);maxAgo.setFullYear(today.getFullYear()-2);
  const startDates=srcs.map(s=>s.startDate?new Date(s.startDate+'T12:00:00'):null).filter(Boolean);
  const tlStart=startDates.length?new Date(Math.min(...startDates,maxAgo)):maxAgo;
  const totalMs=today-tlStart;
  if(totalMs<30*86400000) return '';
  const TYPE_COLORS={salary:'var(--accent)',hourly:'#0ea5e9',freelance:'var(--yellow)',contract:'#f97316',rental:'var(--green)',benefits:'#14b8a6',other:'var(--muted)'};
  const rows=srcs.map(src=>{
    const sDate=src.startDate?new Date(src.startDate+'T12:00:00'):tlStart;
    const eDate=src.endDate?new Date(src.endDate+'T12:00:00'):today;
    const cStart=sDate<tlStart?tlStart:sDate;
    const cEnd=eDate>today?today:eDate;
    const leftPct=Math.max(0,(cStart-tlStart)/totalMs*100);
    const widthPct=Math.max(.5,(cEnd-cStart)/totalMs*100);
    const clr=TYPE_COLORS[src.type]||'var(--muted)';
    const ended=_srcStatus(src)==='ended';
    const mo=src.monthlyNet||0;
    return `<div class="income-tl-row">
      <div class="income-tl-label" title="${esc(src.name||src.type)}">${esc(src.name||src.type)}</div>
      <div class="income-tl-track">
        <div class="income-tl-bar" style="left:${leftPct.toFixed(1)}%;width:${widthPct.toFixed(1)}%;background:${clr};opacity:${ended?.45:.8}"></div>
      </div>
      <div class="income-tl-amt">${mo>0?fmt(mo)+'/mo':''}</div>
    </div>`;
  }).join('');
  // Quarter-year tick marks
  const ticks=[];
  const td=new Date(tlStart.getFullYear(),Math.floor(tlStart.getMonth()/3)*3,1);
  while(td<=today){const pct=(td-tlStart)/totalMs*100;if(pct>=0&&pct<=100)ticks.push({pct,lbl:td.toLocaleDateString('en-US',{month:'short',year:'2-digit'})});td.setMonth(td.getMonth()+3);}
  const tickHtml=`<div style="position:relative;height:18px;margin-left:118px;margin-right:72px;margin-bottom:2px">${ticks.map(t=>`<div style="position:absolute;left:${t.pct.toFixed(1)}%;font-size:9px;color:var(--muted);transform:translateX(-50%)">${t.lbl}</div>`).join('')}</div>`;
  return `<div class="card mt16"><div class="card-title mb12">Income Timeline</div>${tickHtml}<div class="income-tl-wrap">${rows}</div></div>`;
}

function _incomeHTML(){
  const is=S.incomeSettings||{showTransfers:true,showInterest:true,showCashback:true,expectedMonthly:0};
  const allTx=(txAccFilter?S.transactions.filter(t=>t.account===txAccFilter):S.transactions).filter(t=>txInRange(t));
  // Apply income settings filters
  const incomeTx=allTx.filter(t=>{
    if(!(t.amount>0)||t.internalXfer||!t.incomeType) return false;
    if(!is.showTransfers&&(t.incomeType==='Zelle'||t.incomeType==='Transfers')) return false;
    if(!is.showInterest&&t.incomeType==='Interest') return false;
    if(!is.showCashback&&(t.incomeType==='Rewards'||t.incomeType==='Cashback')) return false;
    return true;
  });
  const expenseTx=allTx.filter(t=>t.amount<0&&!t.internalXfer&&!isExcludedFromSpend(t));
  if(!incomeTx.length){
    // Check for untagged recurring income
    const suggestions=detectRecurringIncome();
    return `<div class="empty"><div class="empty-icon">💰</div><div>No income detected yet.<br>Upload any bank CSV — direct deposits, payroll, and interest are auto-detected from any bank.</div></div>
    ${suggestions.length?`<div class="card mt16" style="border-left:4px solid var(--yellow)">
      <div class="card-title mb10">Recurring deposits detected</div>
      ${suggestions.map(s=>`<div style="padding:8px 0;border-bottom:1px solid var(--border)">
        <div class="flex-sb"><div><div class="fw7 fs13">${esc(s.desc)}</div><div class="text-muted fs12">${s.count}x · ~${fmt(s.avgAmount)} · ${s.frequency} · last ${s.lastDate}</div></div>
        <div class="flex gap6"><button class="btn btn-primary btn-xs" data-action="confirm-income-src" data-desc="${esc(s.desc)}">Mark as income</button><button class="btn btn-ghost btn-xs" data-action="dismiss-income-src" data-desc="${esc(s.desc)}">Dismiss</button></div></div>
      </div>`).join('')}
    </div>`:''}`;
  }

  // ── Metrics ────────────────────────────────────────────────────────────────
  const totalIncome=incomeTx.reduce((a,t)=>a+t.amount,0);
  const totalExpenses=expenseTx.reduce((a,t)=>a+Math.abs(t.amount),0);
  const netFlow=totalIncome-totalExpenses;
  const savingsRate=totalIncome>0?(netFlow/totalIncome)*100:0;
  const ytdStart=new Date().getFullYear().toString();
  const ytdIncome=S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&t.incomeType&&t.date&&String(normalizeDate(t.date)).startsWith(ytdStart)).reduce((a,t)=>a+t.amount,0);
  // Average monthly income over last 3 months
  const now=new Date(); const curMo=now.toISOString().slice(0,7);
  const mo3=[0,1,2].map(n=>{const d=new Date(now.getFullYear(),now.getMonth()-n,1);return d.toISOString().slice(0,7);});
  const avg3mo=mo3.map(mo=>S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&t.incomeType&&(normalizeDate(t.date)||'').startsWith(mo)).reduce((a,t)=>a+t.amount,0));
  const avgMonthly3=avg3mo.filter(v=>v>0).length?avg3mo.reduce((a,b)=>a+b,0)/avg3mo.filter(v=>v>0).length:0;

  // ── Income sources detail table ─────────────────────────────────────────────
  const srcDetail={}; // key = incomeType|account
  incomeTx.forEach(t=>{
    const key=(t.incomeType||'Other')+'|'+(t.account||'Unknown');
    if(!srcDetail[key]) srcDetail[key]={type:t.incomeType||'Other',account:t.account||'Unknown',count:0,total:0,lastDate:'',dates:[]};
    srcDetail[key].count++;
    srcDetail[key].total+=t.amount;
    const nd=normalizeDate(t.date)||t.date||'';
    if(nd>srcDetail[key].lastDate) srcDetail[key].lastDate=nd;
    if(nd) srcDetail[key].dates.push(nd);
  });
  const srcRows=Object.values(srcDetail).sort((a,b)=>b.total-a.total);
  // Detect frequency from date intervals
  function detectFreq(dates){
    if(dates.length<2) return 'single';
    const sorted=[...dates].sort();
    const intervals=[];
    for(let i=1;i<sorted.length;i++){
      const d1=new Date(sorted[i-1]+'T12:00:00'),d2=new Date(sorted[i]+'T12:00:00');
      intervals.push(Math.round((d2-d1)/86400000));
    }
    const avg=intervals.reduce((a,b)=>a+b,0)/intervals.length;
    if(avg<9) return 'Weekly';
    if(avg<19) return 'Biweekly';
    if(avg<35) return 'Monthly';
    return 'Irregular';
  }

  // ── By source (chart) ───────────────────────────────────────────────────────
  const bySource={};
  incomeTx.forEach(t=>{const s=t.incomeType||'Other';bySource[s]=(bySource[s]||0)+t.amount;});
  const topSrc=Object.entries(bySource).sort((a,b)=>b[1]-a[1]);

  // ── Monthly breakdown ────────────────────────────────────────────────────────
  const byMonth={};
  S.transactions.filter(t=>!t.internalXfer&&txInRange(t)).forEach(t=>{
    const nd=normalizeDate(t.date); if(!nd) return;
    const mo=nd.slice(0,7);
    if(!byMonth[mo]) byMonth[mo]={income:0,expenses:0};
    if(t.amount>0&&t.incomeType) byMonth[mo].income+=t.amount;
    else if(t.amount<0&&!isExcludedFromSpend(t)) byMonth[mo].expenses+=Math.abs(t.amount);
  });
  const months=Object.keys(byMonth).sort();
  const avgMonthlyIncome=months.filter(m=>byMonth[m].income>0).length?months.reduce((a,m)=>a+byMonth[m].income,0)/months.filter(m=>byMonth[m].income>0).length:0;

  // ── Pay schedule ─────────────────────────────────────────────────────────────
  const ps=S.paySchedule||detectPaySchedule();
  const efData=getEmergencyFundData();

  // ── Recurring income suggestions ─────────────────────────────────────────────
  const suggestions=detectRecurringIncome();

  const curMoIncome=S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&t.incomeType&&(normalizeDate(t.date)||'').startsWith(curMo)).reduce((a,t)=>a+t.amount,0);

  // ── Classification buckets ────────────────────────────────────────────────
  const _isCCPay=desc=>{const dl=(desc||'').toLowerCase();return /payment from sav|payment from chk|payment from checking/i.test(dl)||/mobile banking payment to crd|online payment to\b/i.test(dl)||/\bpayment - thank you\b|\bpayment-thank you\b/i.test(dl);};
  const _allPosTx=(txAccFilter?S.transactions.filter(t=>t.account===txAccFilter):S.transactions).filter(t=>txInRange(t)&&t.amount>0);
  const xferTx=_allPosTx.filter(t=>t.internalXfer).sort((a,b)=>(normalizeDate(b.date)||'').localeCompare(normalizeDate(a.date)||''));
  const ccPayTx=_allPosTx.filter(t=>!t.internalXfer&&!t.incomeType&&_isCCPay(t.description)).sort((a,b)=>(normalizeDate(b.date)||'').localeCompare(normalizeDate(a.date)||''));
  const reviewTx=_allPosTx.filter(t=>!t.internalXfer&&!t.incomeType&&!_isCCPay(t.description)).sort((a,b)=>(normalizeDate(b.date)||'').localeCompare(normalizeDate(a.date)||''));
  const autoNetMonthly=getMonthlyIncomeEstimate()||0;

  const _icfg=AnchorDB.income.configuration;
  const _quizDismissed=AnchorDB.preferences.incomeQuizDismissedAt;
  const _quizSnoozed=_quizDismissed&&(Date.now()-_quizDismissed)<7*24*3600*1000;

  // Determine which state to show
  const _stateB=_icfg.configuredManually;
  const _stateC=!_icfg.configuredManually&&autoNetMonthly>0;
  const _stateA=!_icfg.configuredManually&&!autoNetMonthly;

  const _incomeEntryCard=(()=>{
    if(_stateB){
      // State B — configured
      const src=(_icfg.sources||[])[0];
      const approx=src?.isApproximate;
      return `<div class="card mb16" style="border-left:3px solid var(--green)">
        <div class="flex-sb" style="flex-wrap:wrap;gap:8px;align-items:flex-start">
          <div>
            <div class="fw6 fs14 mb4">Income configured ✓</div>
            <div class="text-muted fs13">~${fmt(_icfg.totalMonthlyNet)}/mo take-home${_icfg.totalMonthlyGross>0?` · ${fmt(_icfg.totalMonthlyGross)}/mo gross`:''}</div>
            ${src?.payFrequency?`<div class="text-muted fs12">${{biweekly:'Biweekly',weekly:'Weekly',semimonthly:'Semi-monthly',monthly:'Monthly'}[src.payFrequency]||src.payFrequency} · ${src.type?{salaried:'Salaried',hourly:'Hourly',self_employed:'Self-employed',multiple:'Multiple sources'}[src.type]||src.type:''}</div>`:''}
            ${approx?`<div class="text-muted fs11 mt2">Based on range selection — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="openIncomeQuiz()">update with exact amount</span></div>`:''}
          </div>
          <div class="flex gap6">
            <button class="btn btn-ghost btn-sm" onclick="openIncomeQuiz()">Retake quiz</button>
            <button class="btn btn-primary btn-sm" onclick="openIncomeConfig()">Edit</button>
          </div>
        </div>
      </div>`;
    }
    if(_stateC){
      // State C — CSV detected but not confirmed
      return `<div class="card mb16" style="border-left:3px solid var(--yellow)">
        <div class="fw6 fs14 mb6">We detected deposits averaging ${fmt(autoNetMonthly)}/mo — is this your income?</div>
        <div class="text-muted fs12 mb12">From your uploaded CSV. Anchor is using this for estimates, but confirming gives you better accuracy.</div>
        <div class="flex gap8">
          <button class="btn btn-primary btn-sm" onclick="_iqConfirmCSVIncome()">Yes, use this</button>
          <button class="btn btn-ghost btn-sm" onclick="openIncomeQuiz()">No, let me set it up</button>
        </div>
      </div>`;
    }
    // State A — nothing configured, show invitation (unless snoozed)
    if(_quizSnoozed) return `<div class="flex-sb mb16" style="flex-wrap:wrap;gap:8px">
      <span class="text-muted fs12">Income not configured — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="openIncomeQuiz()">set up income</span></span>
    </div>`;
    return `<div class="card mb16" style="border:1.5px solid var(--border)">
      <div class="fw6 fs16 mb8">💰 Help Anchor understand your income</div>
      <div class="text-muted fs13 mb12" style="line-height:1.6">Tell us about your income and we'll calculate your debt-to-income ratio, set up percentage budgets, and make your paycheck planner accurate.</div>
      <div class="priv-note mb16">🔒 Your information never leaves your device. No servers. No accounts. No one else sees this.</div>
      <div class="flex gap8">
        <button class="btn btn-primary" onclick="openIncomeQuiz()">Set up my income →</button>
        <button class="btn btn-ghost btn-sm" onclick="dismissIncomeQuiz()">Maybe later</button>
      </div>
    </div>`;
  })();

  // Ended income banner
  const _endedBanner=(()=>{
    const bannerItems=AnchorDB.preferences.endedIncomeBanner||[];
    if(!bannerItems.length) return '';
    const names=bannerItems.map(e=>esc(e.name||'Income')).join(', ');
    return `<div style="background:var(--red)18;border:1px solid var(--red)44;border-radius:var(--r);padding:12px 14px;margin-bottom:16px;display:flex;align-items:flex-start;gap:10px">
      <div style="flex:1"><div class="fw6 fs13" style="color:var(--red);margin-bottom:4px">Income ended: ${names}</div>
      <div class="fs12 text-muted">These sources are no longer counted. Update your income configuration to keep calculations accurate.</div>
      <div class="flex gap8 mt8"><button class="btn btn-primary btn-xs" onclick="openIncomeConfig()">Update income</button><button class="btn btn-ghost btn-xs" onclick="_dismissEndedBanner(null)">Dismiss</button></div></div>
      <button onclick="_dismissEndedBanner(null)" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:16px;padding:0;line-height:1">✕</button>
    </div>`;
  })();
  // Past income section (ended, non-archived)
  const _pastSrcs=(AnchorDB.income.sources||[]).filter(s=>getIncomeStatus(s).status==='ended');
  const _pastSection=_pastSrcs.length?`<div class="card mb16">
    <details>
      <summary style="cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:4px 0">
        <div class="fw6 fs14">Past income sources <span class="badge fs11" style="background:var(--red)22;color:var(--red);padding:1px 7px;margin-left:6px">${_pastSrcs.length}</span></div>
        <span class="text-muted fs12">▼</span>
      </summary>
      <div style="margin-top:10px">
        <div class="fs12 text-muted mb10">These sources have ended and are excluded from income calculations.</div>
        ${_pastSrcs.map(s=>{const ist=getIncomeStatus(s);const dr=_srcDateRange(s);return `<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);gap:8px">
          <div><div class="fs13 fw6">${esc(s.name||s.type)}</div><div class="text-muted fs12">${dr||''} · ${fmt(s.monthlyNet||0)}/mo · ${ist.label}</div></div>
          <div class="flex gap4"><button class="btn btn-ghost btn-xs" style="color:var(--green)" onclick="_reactivateSource('${s.id}')">Reactivate</button><button class="btn btn-ghost btn-xs" onclick="_icArchiveSource('${s.id}');renderBudget()">Archive</button></div>
        </div>`;}).join('')}
      </div>
    </details>
  </div>`:'';

  return `
  ${_endedBanner}
  ${_incomeEntryCard}
  ${ps?`<div class="alert alert-info mb16" style="cursor:pointer" onclick="go('home')">
    💼 <strong>${esc(ps.employer)}</strong> · ${ps.cycle} · ${fmt(ps.avgAmount)}/paycheck · Next: <strong>${ps.nextPayday}</strong> (${ps.daysAway} day${ps.daysAway!==1?'s':''})</div>`:''}

  ${suggestions.length?`<div class="card mb16" style="border-left:4px solid var(--yellow)">
    <div class="card-title mb8">Recurring deposits detected</div>
    <div class="text-muted fs12 mb10">These positive transactions appear regularly but aren't tagged as income yet.</div>
    ${suggestions.map(s=>`<div class="flex-sb" style="padding:8px 0;border-bottom:1px solid var(--border)">
      <div><div class="fw7 fs13">${esc(s.desc)}</div><div class="text-muted fs12">${s.count} deposits · ~${fmt(s.avgAmount)} · ${s.frequency} · last ${s.lastDate}</div></div>
      <div class="flex gap6"><button class="btn btn-primary btn-xs" data-action="confirm-income-src" data-desc="${esc(s.desc)}">Mark as income</button><button class="btn btn-ghost btn-xs" data-action="dismiss-income-src" data-desc="${esc(s.desc)}">Dismiss</button></div>
    </div>`).join('')}
  </div>`:''}

  <div class="g4 mb16">
    <div class="stat"><div class="stat-label">Income This Month</div><div class="stat-value text-green">${fmt(curMoIncome)}</div><div class="stat-sub">${curMo}</div></div>
    <div class="stat"><div class="stat-label">Avg Monthly (3mo)</div><div class="stat-value text-green">${fmt(Math.round(avgMonthly3))}</div><div class="stat-sub">last 3 months${is.expectedMonthly>0?` · target ${fmt(is.expectedMonthly)}`:''}</div></div>
    <div class="stat"><div class="stat-label">Savings Rate</div><div class="stat-value ${savingsRate>=20?'text-green':savingsRate>=10?'text-yellow':'text-red'}">${pct(savingsRate)}</div><div class="stat-sub">${savingsRate>=20?'Excellent':savingsRate>=10?'Good':'Needs improvement'}</div></div>
    <div class="stat"><div class="stat-label">Income YTD</div><div class="stat-value text-green">${fmt(ytdIncome)}</div><div class="stat-sub">${ytdStart} year to date</div></div>
  </div>

  <div class="g2 mb16">
    <div class="card">
      <div class="card-title mb12">Income by Source</div>
      <div id="income-source-chart-wrap" class="chart-wrap mb12" style="height:200px"><canvas id="income-source-chart"></canvas></div>
      ${topSrc.map(([src,amt])=>{const p=totalIncome>0?(amt/totalIncome*100):0;return `<div class="mb8"><div class="flex-sb fs12 mb6"><span class="flex gap6"><span class="dot" style="background:${INCOME_SRC_CLR[src]||'#6b7280'}"></span>${src}</span><span class="fw7 text-green">${fmt(amt)} <span class="text-muted">${pct(p)}</span></span></div><div class="bar-wrap"><div class="bar-fill" style="width:${p}%;background:${INCOME_SRC_CLR[src]||'#6b7280'}"></div></div></div>`;}).join('')}
    </div>
    <div class="card">
      <div class="card-title mb12">Monthly Income vs Expenses</div>
      <div class="chart-wrap mb12" style="height:200px"><canvas id="income-trend-chart"></canvas></div>
      ${months.length?`<div class="fs12 text-muted">Avg monthly income: <span class="fw7 text-green">${fmt(avgMonthlyIncome)}</span></div>`:''}
    </div>
  </div>

  ${months.length>0?`<div class="card mb16">
    <div class="card-title mb12">Net Cash Flow by Month</div>
    <div class="chart-wrap" style="height:160px"><canvas id="income-cashflow-chart"></canvas></div>
    <div class="g3 mt12" style="gap:8px">
      ${months.slice(-3).map(mo=>{const net=byMonth[mo].income-byMonth[mo].expenses;const rate=byMonth[mo].income>0?(net/byMonth[mo].income*100):0;return `<div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;text-align:center"><div class="text-muted fs11 mb4">${mo}</div><div class="fw7 ${net>=0?'text-green':'text-red'} fs12">${net>=0?'+':''}${fmt(net)}</div><div class="text-muted fs11">${pct(rate)} saved</div></div>`;}).join('')}
    </div>
  </div>`:''}

  <div class="card mb16">
    <div class="card-title mb12">Income Sources Detail</div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Source</th><th>Account</th><th>Count</th><th>Total</th><th>Last Date</th><th>Frequency</th></tr></thead>
      <tbody>${srcRows.map(r=>`<tr>
        <td><span class="flex gap6"><span class="dot" style="background:${INCOME_SRC_CLR[r.type]||'#6b7280'}"></span><span class="fw7">${esc(r.type)}</span></span></td>
        <td class="text-muted fs12">${esc(r.account)}</td>
        <td>${r.count}</td>
        <td class="text-green fw7">${fmt(r.total)}</td>
        <td class="text-muted fs12">${r.lastDate}</td>
        <td class="fs12">${detectFreq(r.dates)}</td>
      </tr>`).join('')}</tbody>
    </table></div>
  </div>

  ${efData.balance>0?`<div class="card mb16" style="border-left:4px solid var(--teal)">
    <div class="card-header"><div class="card-title">Emergency Fund Vault</div><div class="fw8 text-green" style="font-size:20px">${fmt(efData.balance)}</div></div>
    <div class="text-muted fs12 mb10">Reconstructed from ${efData.transactions.length} transaction${efData.transactions.length!==1?'s':''}. <span style="cursor:pointer;text-decoration:underline;color:var(--accent)" onclick="go('goals')">Track as a goal →</span></div>
    ${Object.keys(efData.monthlyFlow).sort().slice(-6).map(mo=>{const fl=efData.monthlyFlow[mo];return `<div class="flex-sb fs12" style="padding:5px 0;border-bottom:1px solid var(--border)"><span>${mo}</span><span class="fw7 ${fl>=0?'text-green':'text-red'}">${fl>=0?'+':''}${fmt(fl)}</span></div>`;}).join('')}
  </div>`:''}

  ${ps&&ps.count>=2?`<div class="card mb16">
    <div class="flex-sb mb8">
      <div class="card-title">Paycheck History — ${esc(ps.employer)}</div>
      <div class="flex gap6">
        ${ps.hasSplits?`<span class="badge fs11" style="background:rgba(99,102,241,.15);color:#a5b4fc;padding:2px 7px">Split paycheck</span>`:''}
        <span class="text-muted fs12">~${fmt(ps.avgAmount)} avg</span>
      </div>
    </div>
    ${ps.hasSplits&&ps.avgSplitOffset?`<div class="text-muted fs12 mb10">🏦 SoFi typically releases deposits ${ps.avgSplitOffset} day${ps.avgSplitOffset>1?'s':''} early · official payday is when BofA receives it</div>`:''}
    <div class="tbl-wrap"><table>
      <thead><tr><th>Pay Period</th><th>Total</th><th>Accounts</th><th>vs Avg</th></tr></thead>
      <tbody>${[...(ps.paychecks||[])].reverse().slice(0,10).map((pc,i)=>{
        const diff=pc.totalAmount-ps.avgAmount;
        const pctDiff=ps.avgAmount>0?Math.abs(diff/ps.avgAmount*100):0;
        const acctLabel=pc.type==='split'?pc.accounts.join(' + '):(pc.accounts[0]||'');
        const isSplit=pc.type==='split';
        const mainRow=`<tr style="${isSplit?'cursor:pointer':''};" onclick="${isSplit?`toggleSplitRow(${i})`:''}">
          <td class="fw6">${pc.payPeriodDate}${isSplit?` <span class="text-muted fs11" style="font-weight:400">▾ ${pc.splits.length} accts</span>`:''}</td>
          <td class="text-green fw7">${fmt(pc.totalAmount)}</td>
          <td class="text-muted fs12">${esc(acctLabel)}</td>
          <td class="${Math.abs(diff)<5?'text-muted':diff>0?'text-green':'text-red'} fs12">${diff>=0?'+':''}${fmt(diff)}${pctDiff>=20?` <span class="badge badge-yellow fs10">${diff>0?'Possible bonus':'Low check'}</span>`:''}</td>
        </tr>`;
        const detailRow=isSplit?`<tr id="pc-split-${i}" style="display:none">
          <td colspan="4" style="padding:0 0 8px 0">
            <div style="background:var(--surface2);border-radius:var(--r-sm);padding:8px 12px;margin:2px 0">
              ${pc.splits.map(sp=>`<div class="flex-sb fs12" style="padding:4px 0">
                <span class="flex gap8"><span class="dot" style="background:${sp.isEarly?'#818cf8':'var(--green)'}"></span><span class="fw6">${esc(sp.account||'Unknown')}</span></span>
                <span class="flex gap8"><span class="fw7 ${sp.isEarly?'':'text-green'}">${fmt(sp.amount)}</span><span class="text-muted">${sp.date}${sp.isEarly?` · <span style="color:#a5b4fc">${sp.daysEarly}d early</span>`:' · <span class="text-muted">official payday</span>'}</span></span>
              </div>`).join('')}
              <div class="flex-sb fw7 fs12 mt6" style="border-top:1px solid var(--border);padding-top:6px"><span>Total</span><span class="text-green">${fmt(pc.totalAmount)}</span></div>
            </div>
          </td>
        </tr>`:'';
        return mainRow+detailRow;
      }).join('')}</tbody>
    </table></div>
  </div>`:''}

  ${reviewTx.length?`<div class="card mb16" style="border-left:4px solid var(--yellow)">
    <div class="flex-sb mb10">
      <div><div class="card-title">Needs Review</div><div class="text-muted fs12">Help us categorize these correctly — ${reviewTx.length} positive transaction${reviewTx.length!==1?'s':''} with no classification</div></div>
      <span class="badge badge-yellow" style="font-size:12px;padding:3px 8px">${reviewTx.length}</span>
    </div>
    ${reviewTx.slice(0,20).map(t=>`<div style="display:flex;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);gap:8px">
      <div style="flex:1;min-width:0">
        <div class="fw6 fs13" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(t.description||'Unknown')}</div>
        <div class="text-muted fs11">${normalizeDate(t.date)||t.date||''} · ${esc(t.account||'')}</div>
      </div>
      <div class="fw7 text-green fs13" style="white-space:nowrap;margin-right:8px">${fmt(t.amount)}</div>
      <div style="display:flex;gap:6px;flex-shrink:0">
        <button class="btn btn-primary btn-xs" data-action="review-income" data-tx-id="${t.id}">Income</button>
        <button class="btn btn-ghost btn-xs" data-action="review-exclude" data-tx-id="${t.id}">Transfer/Exclude</button>
      </div>
    </div>`).join('')}
    ${reviewTx.length>20?`<div class="text-muted fs12 mt8 text-center">Showing 20 of ${reviewTx.length} — classify these to see more</div>`:''}
  </div>`:''}

  ${xferTx.length?`<div class="card mb16">
    <details>
      <summary style="cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:4px 0">
        <div><span class="fw6 fs14">Internal Transfers</span><span class="text-muted fs12" style="margin-left:8px">${xferTx.length} excluded · ${fmt(xferTx.reduce((a,t)=>a+t.amount,0))}</span></div>
        <span class="text-muted fs12">▼</span>
      </summary>
      <div class="text-muted fs12 mb8 mt8">Transfers between your own accounts — excluded from income totals.</div>
      <div class="tbl-wrap"><table>
        <thead><tr><th>Date</th><th>Description</th><th>Account</th><th>Amount</th></tr></thead>
        <tbody>${xferTx.slice(0,50).map(t=>`<tr>
          <td class="fs12">${normalizeDate(t.date)||t.date||''}</td>
          <td class="fs12">${esc(t.description||'')}</td>
          <td class="text-muted fs12">${esc(t.account||'')}</td>
          <td class="text-muted fw6 fs12">${fmt(t.amount)}</td>
        </tr>`).join('')}</tbody>
      </table></div>
      ${xferTx.length>50?`<div class="text-muted fs12 mt6">Showing 50 of ${xferTx.length}</div>`:''}
    </details>
  </div>`:''}

  ${ccPayTx.length?`<div class="card mb16">
    <details>
      <summary style="cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:4px 0">
        <div><span class="fw6 fs14">Credit Card Payments</span><span class="text-muted fs12" style="margin-left:8px">${ccPayTx.length} excluded · ${fmt(ccPayTx.reduce((a,t)=>a+t.amount,0))}</span></div>
        <span class="text-muted fs12">▼</span>
      </summary>
      <div class="text-muted fs12 mb8 mt8">Payments from your bank account to a credit card — not counted as income.</div>
      <div class="tbl-wrap"><table>
        <thead><tr><th>Date</th><th>Description</th><th>Account</th><th>Amount</th></tr></thead>
        <tbody>${ccPayTx.slice(0,50).map(t=>`<tr>
          <td class="fs12">${normalizeDate(t.date)||t.date||''}</td>
          <td class="fs12">${esc(t.description||'')}</td>
          <td class="text-muted fs12">${esc(t.account||'')}</td>
          <td class="text-muted fw6 fs12">${fmt(t.amount)}</td>
        </tr>`).join('')}</tbody>
      </table></div>
    </details>
  </div>`:''}

  ${(()=>{const ps2=S.paySchedule||detectPaySchedule();if(!ps2?.hasSplits) return '';const recentSplit=ps2.paychecks?.filter(p=>p.type==='split').slice(-1)[0];if(!recentSplit) return '';return `<div class="card mb16" style="border-left:3px solid #818cf8">
    <div class="flex-sb mb8"><div class="fw6 fs14">Split paycheck detected</div><span class="badge fs11" style="background:rgba(99,102,241,.15);color:#a5b4fc">Auto-detected</span></div>
    <div class="text-muted fs12 mb10">${esc(ps2.employer)} deposits to multiple accounts per paycheck. Both portions are counted as one income event.</div>
    ${recentSplit.splits.map(sp=>`<div class="flex-sb fs13" style="padding:5px 0;border-bottom:1px solid var(--border)">
      <span class="fw6">${esc(sp.account||'Account')}</span>
      <span class="flex gap8"><span class="text-green fw7">${fmt(sp.amount)}</span><span class="text-muted fs12">${sp.isEarly?`<span style="color:#a5b4fc">${sp.daysEarly}d early</span>`:'official payday'}</span></span>
    </div>`).join('')}
    <div class="flex-sb fw7 fs13 mt8"><span>Total per paycheck</span><span class="text-green">${fmt(recentSplit.totalAmount)}</span></div>
    ${ps2.avgSplitOffset?`<div class="text-muted fs11 mt8">SoFi typically releases ${ps2.avgSplitOffset} day${ps2.avgSplitOffset>1?'s':''} early. Official payday is based on the BofA deposit date.</div>`:''}
  </div>`;})()}

  <div class="card mb16">
    <details>
      <summary style="cursor:pointer;font-size:14px;font-weight:600;padding:4px 0;list-style:none;display:flex;justify-content:space-between;align-items:center">Income Settings <span class="text-muted fw4 fs12">▼ configure</span></summary>
      <div style="margin-top:14px">

        <div class="fs12 fw6 mb8" style="text-transform:uppercase;letter-spacing:.06em;color:var(--text-sec)">DTI Calculation Basis</div>
        <div class="g2 mb12" style="gap:8px">
          <label class="dti-basis-opt" data-basis="net" onclick="toggleDtiBasis('net')" style="cursor:pointer;display:block;border:1.5px solid ${(is.dtiIncomeBase||'net')==='net'?'var(--accent)':'var(--border)'};border-radius:var(--r);padding:10px 12px;transition:border-color .15s">
            <input type="radio" name="f-inc-dti-base" value="net" ${(is.dtiIncomeBase||'net')==='net'?'checked':''} style="display:none">
            <div class="fw6 fs13">Actual take-home (net) <span class="badge fs10" style="background:rgba(0,212,170,.15);color:var(--green)">default</span></div>
            <div class="text-muted fs11 mt2">After-tax deposits — your real spendable income</div>
          </label>
          <label class="dti-basis-opt" data-basis="gross" onclick="toggleDtiBasis('gross')" style="cursor:pointer;display:block;border:1.5px solid ${is.dtiIncomeBase==='gross'?'var(--accent)':'var(--border)'};border-radius:var(--r);padding:10px 12px;transition:border-color .15s">
            <input type="radio" name="f-inc-dti-base" value="gross" ${is.dtiIncomeBase==='gross'?'checked':''} style="display:none">
            <div class="fw6 fs13">Bank standard (gross)</div>
            <div class="text-muted fs11 mt2">Pre-tax income — how lenders evaluate borrowing power</div>
          </label>
        </div>
        <div class="text-muted fs11 mb12">ⓘ Banks use gross income for loan reviews. Take-home is your actual spendable money. <strong>Both can be configured simultaneously</strong> — if you enter gross, both DTI values show on the Credit Cards tab.</div>

        <!-- Gross income fields -->
        <div id="f-inc-gross-section" style="display:${is.dtiIncomeBase==='gross'?'block':'none'};background:var(--surface2);border-radius:var(--r);padding:12px;margin-bottom:12px">
          <div class="alert alert-info mb10 fs12" style="padding:8px 10px">Bank standard DTI uses pre-tax income. Check your pay stub or offer letter — Anchor can only see deposits, not gross pay.</div>
          <div class="g2 mb8" style="gap:8px">
            <div class="form-group mb0"><label class="form-label">Annual salary ($)</label><input class="form-input" id="f-inc-salary" type="number" placeholder="e.g. 72000" value="${is.grossSalary||''}" oninput="updateGrossTotal()"></div>
            <div class="form-group mb0"><label class="form-label">Other monthly gross ($)</label><input class="form-input" id="f-inc-other-gross" type="number" placeholder="freelance, rental…" value="${is.grossOther||''}" oninput="updateGrossTotal()"></div>
          </div>
          <div class="g2 mb8" style="gap:8px">
            <div class="form-group mb0"><label class="form-label">Hourly rate ($)</label><input class="form-input" id="f-inc-hourly" type="number" placeholder="0.00" value="${is.grossHourly||''}" oninput="updateGrossTotal()"></div>
            <div class="form-group mb0"><label class="form-label">Hours / week</label><input class="form-input" id="f-inc-hours" type="number" placeholder="40" value="${is.grossHours||40}" oninput="updateGrossTotal()"></div>
          </div>
          <div id="f-inc-gross-total" class="fs12 fw6 mt4">${is.grossMonthly>0?`Total gross: ${fmt(is.grossMonthly)}/mo (${fmt(is.grossMonthly*12)}/yr) — used for DTI only`:'Enter salary or hourly rate above'}</div>
        </div>

        <!-- Net income section -->
        <div id="f-inc-net-section" style="display:${is.dtiIncomeBase==='gross'?'none':'block'};background:var(--surface2);border-radius:var(--r);padding:12px;margin-bottom:12px">
          ${autoNetMonthly>0?`<div class="fs12 mb8">Auto-detected from CSV: <strong class="text-green">${fmt(autoNetMonthly)}/mo</strong> average. Leave override blank to use this.</div>`:'<div class="text-muted fs12 mb8">Upload a bank CSV to auto-detect take-home deposits.</div>'}
          <div class="form-group mb0"><label class="form-label">Monthly take-home override ($) <span class="text-muted fw4 fs11">— leave blank to use auto-detected amount</span></label><input class="form-input" id="f-inc-manual-net" type="number" placeholder="${autoNetMonthly>0?fmt(autoNetMonthly)+' (auto)':'e.g. 3200'}" value="${is.manualMonthlyNet||''}"></div>
        </div>

        <div style="border-top:1px solid var(--border);padding-top:12px;margin-bottom:12px">
          <div class="form-group"><label class="form-label">Expected monthly income (optional — for savings rate display)</label><input class="form-input" id="f-inc-expected" type="number" placeholder="e.g. 4000" value="${is.expectedMonthly||''}"></div>
          <div class="flex gap16 mb12" style="flex-wrap:wrap">
            <label class="flex gap6 align-center fs13" style="cursor:pointer"><input type="checkbox" id="f-inc-transfers" ${is.showTransfers?'checked':''}> Include Zelle/Venmo transfers</label>
            <label class="flex gap6 align-center fs13" style="cursor:pointer"><input type="checkbox" id="f-inc-interest" ${is.showInterest?'checked':''}> Include interest &amp; dividends</label>
            <label class="flex gap6 align-center fs13" style="cursor:pointer"><input type="checkbox" id="f-inc-cashback" ${is.showCashback?'checked':''}> Include cashback &amp; rewards</label>
          </div>
        </div>
        <button class="btn btn-primary btn-sm" onclick="saveIncomeSettings()">Save Settings</button>
      </div>
    </details>
  </div>
  ${_pastSection}
  ${_incomeTimelineHTML()}
  <div class="priv-note mt8">🔒 Your income data is stored locally on this device only. It is never transmitted, never shared, and never used for anything other than your personal calculations. Delete it anytime from Settings → Data.</div>`;
}

function csvGuideHTML(){
  const banks=[
    {name:'Bank of America Checking/Savings',steps:['Log in at bankofamerica.com','Select your account','Click "Download transactions" top right','Set date range (up to 18 months)','Select CSV format, click Download']},
    {name:'Bank of America Credit Card',steps:['Log in at bankofamerica.com','Select credit card account','Click "Download" near transaction history','Choose date range, select CSV, click Download']},
    {name:'SoFi',steps:['Log in at sofi.com','Go to your account','Click "Statements" or "Transaction History"','Select date range','Click Export or Download CSV']},
    {name:'Chase',steps:['Log in at chase.com','Select account','Click "Download account activity"','Select date range, choose CSV, click Download']},
    {name:'Wells Fargo',steps:['Log in at wellsfargo.com','Select account','Click "Download Account Activity"','Set range, select CSV, click Download']},
    {name:'Capital One',steps:['Log in at capitalone.com','Select account','Click "Download Transactions"','Choose date range, select CSV']},
    {name:'Credit One',steps:['Log in at creditonebank.com','Go to Account Activity','Click Download/Export, select CSV']},
    {name:'PayPal',steps:['Log in at paypal.com','Go to Activity → Statements → Custom','Set date range, click Download CSV']},
    {name:'Cash App',steps:['Open Cash App','Tap profile → Documents → Account Statements','Select month, download CSV']},
    {name:'Coinbase',steps:['Log in at coinbase.com','Go to Taxes or Reports','Generate Report → Transaction History → CSV']},
    {name:'Crypto.com',steps:['Log in at crypto.com','Accounts → Transaction History → Export','Set date range, choose CSV']},
    {name:'Webull (PDF — direct upload supported)',steps:['Log in at webull.com','My Account → Statements → Download monthly PDF','Upload the PDF directly to Anchor — no conversion needed','(Backup: use tabula.technology if the PDF has issues)']}
  ];
  return `<div class="csv-guide">
    <button class="csv-guide-toggle" onclick="this.nextElementSibling.classList.toggle('open');this.querySelector('.cg-arrow').textContent=this.nextElementSibling.classList.contains('open')?'▲':'▼'">
      🏦 Not sure how to export your CSV? Here's how <span class="cg-arrow">▼</span>
    </button>
    <div class="csv-guide-body">
      ${banks.map(b=>`<div class="csv-guide-bank">
        <div class="csv-guide-bank-header" onclick="const s=this.nextElementSibling;s.classList.toggle('open');this.querySelector('.cg-ba').textContent=s.classList.contains('open')?'▲':'▼'">${b.name} <span class="cg-ba">▼</span></div>
        <div class="csv-guide-steps"><ol>${b.steps.map(s=>`<li>${s}</li>`).join('')}</ol></div>
      </div>`).join('')}
      <div style="padding:12px 14px;font-size:12px;color:var(--muted)">Don't see your bank? Look for <strong>Download</strong> or <strong>Export</strong> under Account Activity or Transaction History. Always choose CSV format.</div>
    </div>
  </div>`;
}

// ── VAULT LEDGER: shows exactly how a reconstructed vault balance is built ────
function openVaultLedger(name){ window._vlName=name; _renderVaultLedger(); openModal('m-vault-ledger'); }
function _renderVaultLedger(){
  const name=window._vlName||'', d=getVaultData(name);
  const net=d.ledger.reduce((a,x)=>a+x.delta,0);
  const keyOf=x=>(normalizeDate(x.t.date)||'')+'|'+Math.abs(x.t.amount).toFixed(2);
  const accts={}; d.ledger.forEach(x=>{(accts[keyOf(x)]=accts[keyOf(x)]||new Set()).add(x.t.account||'')});
  const ruleTxt={to:'“To …” → into vault',from:'“From …” → out of vault',flip:'no To/From → CSV sign flipped'};
  let flipN=0,dupN=0,negN=0;
  const rows=d.ledger.map(x=>{
    const fl=[];
    if(x.rule==='flip'){fl.push('sign guessed');flipN++;}
    if(accts[keyOf(x)].size>1){fl.push('same date+amount in another account');dupN++;}
    if(x.running<-0.005){fl.push('below $0');negN++;}
    return `<tr><td style="white-space:nowrap">${esc(normalizeDate(x.t.date))}</td><td style="max-width:210px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(x.t.description)}">${esc(x.t.description)}</td><td class="text-muted">${esc(x.t.account||'—')}</td><td class="text-muted">${fmt(x.t.amount)}</td><td class="fs11 text-muted">${ruleTxt[x.rule]}</td><td class="${x.delta>=0?'text-green':'text-red'} fw6">${x.delta>=0?'+':''}${fmt(x.delta)}</td><td class="fw6${x.running<-0.005?' text-red':''}">${fmt(x.running)}</td><td class="fs11 text-yellow">${fl.map(esc).join(' · ')}</td></tr>`;
  }).reverse().join('');
  const notes=[];
  if(!d.opening) notes.push('Anchor assumes this vault held <b>$0</b> before your first CSV row. If it already had money, the balance below is low by exactly that amount. Enter the real balance below to correct it.');
  if(negN) notes.push(`<b>${negN}</b> row${negN>1?'s':''} push the running balance below $0, which is impossible for a real vault. That usually means a missing opening balance or a wrong direction.`);
  if(flipN) notes.push(`<b>${flipN}</b> row${flipN>1?'s have':' has'} no “To/From” in the description, so the direction was guessed from the CSV sign.`);
  if(dupN) notes.push(`<b>${dupN}</b> row${dupN>1?'s share':' shares'} a date and amount with a row in a different account. If that is one transfer exported from two accounts, it is counted twice.`);
  $('vl-title').textContent=name+' — how this balance is built';
  $('vl-body').innerHTML=`
    <div class="text-muted fs12 mb12">Anchor cannot read vault balances from SoFi directly. It rebuilds them from every transaction whose description contains “${esc(name)}”, oldest to newest.</div>
    <div class="g3 mb12" style="gap:10px">
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8" style="font-size:18px">${fmt(d.opening)}</div><div class="text-muted fs11 mt6">Opening balance${d.opening?' (set by you)':' (assumed)'}</div></div>
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 ${net>=0?'text-green':'text-red'}" style="font-size:18px">${net>=0?'+':''}${fmt(net)}</div><div class="text-muted fs11 mt6">Net of ${d.ledger.length} transaction${d.ledger.length!==1?'s':''}</div></div>
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 ${d.raw<-0.005?'text-red':'text-green'}" style="font-size:18px">${fmt(d.raw)}</div><div class="text-muted fs11 mt6">Reconstructed balance${d.raw<-0.005?' (shown as $0.00)':''}</div></div>
    </div>
    ${notes.length?`<div class="alert-info mb12" style="font-size:12px;line-height:1.6;border-radius:var(--r-sm);padding:10px 12px">${notes.map(n=>`<div>• ${n}</div>`).join('')}</div>`:''}
    <div class="flex gap8 mb16" style="align-items:flex-end;flex-wrap:wrap">
      <div style="flex:1;min-width:200px"><label class="dlg-label" for="vl-actual">Balance SoFi shows for this vault today</label>
        <div class="dlg-field has-prefix"><span class="dlg-prefix">$</span><input class="form-input" id="vl-actual" type="text" inputmode="decimal" placeholder="0.00" autocomplete="off"></div></div>
      <button class="btn btn-primary" onclick="vaultMatchActual()">Match to SoFi</button>
      ${d.opening?'<button class="btn btn-ghost" onclick="vaultClearOpening()">Reset to $0 start</button>':''}
    </div>
    <div class="tbl-wrap fs12" style="max-height:340px;overflow:auto"><table>
      <thead><tr><th>Date</th><th>Description</th><th>Account</th><th>CSV amount</th><th>Rule used</th><th>Effect</th><th>Running</th><th>Flags</th></tr></thead>
      <tbody>${rows||'<tr><td colspan="8" class="text-muted">No transactions mention this vault.</td></tr>'}</tbody>
    </table></div>
    <div class="text-muted fs11 mt8">Newest first. “Match to SoFi” sets the opening balance so the reconstructed balance equals the number you type; the transactions themselves are never changed.</div>`;
}
function _vaultRefresh(){ try{syncVirtualAccounts();}catch(_){} save(); _renderVaultLedger(); try{ if(activeTab==='networth')renderNW(); else if(activeTab==='goals')renderGoals(); else if(activeTab==='home')renderHome(); }catch(_){} }
function vaultMatchActual(){
  const name=window._vlName||'', v=parseFloat(String($('vl-actual').value).replace(/[$,\s]/g,''));
  if(isNaN(v)||v<0){ appAlert('Enter the balance SoFi shows for this vault, for example 224.53.'); return; }
  const net=getVaultData(name).ledger.reduce((a,x)=>a+x.delta,0);
  AnchorDB.vaultOpening=AnchorDB.vaultOpening||{};
  AnchorDB.vaultOpening[name.toLowerCase()]=Math.round((v-net)*100)/100;
  _vaultRefresh();
}
async function vaultClearOpening(){
  if(!await appConfirm('Go back to assuming this vault started at $0?',{confirmText:'Reset'})) return;
  if(AnchorDB.vaultOpening) delete AnchorDB.vaultOpening[(window._vlName||'').toLowerCase()];
  _vaultRefresh();
}

// ── IN-APP DIALOGS (replace native prompt / confirm / alert) ─────────────────
let _dlgQueue=Promise.resolve();
function _appDlg(cfg){
  const job=()=>new Promise(resolve=>{
    const ov=$('app-dlg'),titleEl=$('app-dlg-title'),body=$('app-dlg-body'),acts=$('app-dlg-actions');
    const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const prevFocus=document.activeElement;
    const inp=cfg.input;
    let done=false,obs=null;
    titleEl.textContent=cfg.title||'';
    titleEl.style.display=cfg.title?'':'none';
    body.innerHTML=(cfg.message?`<div class="dlg-msg">${esc(cfg.message)}</div>`:'')
      +(inp?`${inp.label?`<label class="dlg-label" for="app-dlg-input">${esc(inp.label)}</label>`:''}<div class="dlg-field${inp.prefix?' has-prefix':''}">${inp.prefix?`<span class="dlg-prefix">${esc(inp.prefix)}</span>`:''}<input class="form-input" id="app-dlg-input" type="text" autocomplete="off" inputmode="${esc(inp.inputmode||'text')}" placeholder="${esc(inp.placeholder||'')}" value="${esc(inp.value)}"></div><div class="dlg-err" id="app-dlg-err" role="alert"></div>`:'');
    acts.innerHTML='';
    function finish(v){
      if(done) return; done=true;
      document.removeEventListener('keydown',onKey,true);
      if(obs) obs.disconnect();
      ov.onclick=null; ov.classList.remove('open');
      try{ if(prevFocus&&prevFocus.focus) prevFocus.focus(); }catch(_){}
      resolve(v);
    }
    function cancel(){ finish(cfg.cancelValue); }
    function submit(){
      if(!inp){ finish(cfg.okValue); return; }
      const el=$('app-dlg-input'), v=el.value.trim();
      const err=inp.validate?inp.validate(v):'';
      if(err){ $('app-dlg-err').textContent=err; el.focus(); return; }
      finish(v);
    }
    function onKey(e){
      if(e.key==='Escape'){ e.preventDefault(); e.stopPropagation(); cancel(); return; }
      if(e.key==='Enter'&&!(e.target&&e.target.tagName==='BUTTON')){ e.preventDefault(); submit(); return; }
      if(e.key==='Tab'){
        const f=[...ov.querySelectorAll('input,button')].filter(x=>!x.disabled&&x.offsetParent!==null);
        if(!f.length) return;
        const i=f.indexOf(document.activeElement);
        if(e.shiftKey&&i<=0){ e.preventDefault(); f[f.length-1].focus(); }
        else if(!e.shiftKey&&i===f.length-1){ e.preventDefault(); f[0].focus(); }
      }
    }
    let cancelBtn=null;
    if(!cfg.noCancel){
      cancelBtn=document.createElement('button'); cancelBtn.className='btn btn-ghost';
      cancelBtn.textContent=cfg.cancelText||'Cancel'; cancelBtn.onclick=cancel; acts.appendChild(cancelBtn);
    }
    const okBtn=document.createElement('button'); okBtn.className='btn '+(cfg.danger?'btn-danger':'btn-primary');
    okBtn.textContent=cfg.confirmText||'OK'; okBtn.onclick=submit; acts.appendChild(okBtn);
    ov.onclick=e=>{ if(e.target===ov) cancel(); };
    // the page's global overlay handler can close us on backdrop click; make sure the promise still settles
    obs=new MutationObserver(()=>{ if(!ov.classList.contains('open')) finish(cfg.cancelValue); });
    obs.observe(ov,{attributes:true,attributeFilter:['class']});
    document.addEventListener('keydown',onKey,true);
    ov.classList.add('open');
    setTimeout(()=>{
      const t=inp?$('app-dlg-input'):((cfg.danger&&cancelBtn)?cancelBtn:okBtn);
      if(t){ t.focus(); if(inp&&t.select) t.select(); }
    },30);
  });
  const p=_dlgQueue.then(job,job);   // one dialog at a time, in order
  _dlgQueue=p.catch(()=>{});
  return p;
}
// appConfirm(msg,{danger,confirmText,title}) -> Promise<boolean>
function appConfirm(message,o){ o=o||{}; return _appDlg({title:o.title||'Are you sure?',message,confirmText:o.confirmText||(o.danger?'Delete':'Confirm'),cancelText:o.cancelText||'Cancel',danger:!!o.danger,cancelValue:false,okValue:true}); }
// appAlert(msg) -> Promise<void>
function appAlert(message,o){ o=o||{}; return _appDlg({title:o.title||'Notice',message,confirmText:'OK',noCancel:true,cancelValue:undefined,okValue:undefined}); }
// appPrompt(title,{label,prefix,value,placeholder,inputmode,confirmText,validate}) -> Promise<string|null>
function appPrompt(title,o){ o=o||{}; return _appDlg({title,message:o.message,input:{label:o.label,prefix:o.prefix,value:o.value,placeholder:o.placeholder,inputmode:o.inputmode,validate:o.validate},confirmText:o.confirmText||'Save',cancelText:'Cancel',cancelValue:null}); }
window.alert=function(msg){ appAlert(msg); };   // every existing alert() now shows in-app

// ── MONEY FLOW (Sankey-style: income -> spending categories) ──────────────────
function _moneyFlowData(){
  // Same filters as _spendingHTML so the chart always matches the cards,
  // except merchant refunds: a refund reverses earlier spending, it is not income.
  const allTx=(txAccFilter?S.transactions.filter(t=>t.account===txAccFilter):S.transactions).filter(t=>txInRange(t));
  const expenses=allTx.filter(t=>t.amount<0&&!isExcludedFromSpend(t));
  const credits=allTx.filter(t=>t.amount>0&&!t.internalXfer&&!t.isPayment);
  const refundTx=credits.filter(t=>t.incomeType==='Refund');
  const income=credits.filter(t=>t.incomeType!=='Refund').reduce((a,t)=>a+t.amount,0);
  const byCat={};
  expenses.forEach(t=>{const c=t.category||'Other';byCat[c]=(byCat[c]||0)+Math.abs(t.amount)});
  // Net each refund against the category of the purchase it reverses.
  // Match on merchant (latest purchase from the same merchant, any date), else keyword category, else Other.
  let refunded=0,excess=0;
  if(refundTx.length){
    const lastCat={};
    S.transactions.forEach(x=>{
      if(!(x.amount<0)||x.internalXfer) return;
      const k=normalizeMerchant(x.description); if(!k) return;
      const nd=normalizeDate(x.date)||'';
      if(!lastCat[k]||nd>lastCat[k].d) lastCat[k]={d:nd,c:x.category};
    });
    refundTx.forEach(t=>{
      const clean=(t.description||'').replace(/\b(refund(ed)?|return(ed)?|reversal|credit|reimbursement|from)\b/gi,' ').replace(/\s+/g,' ').trim();
      const hit=lastCat[normalizeMerchant(clean)];
      const cat=(hit&&hit.c)||autoCat(clean)||'Other';
      const have=byCat[cat]||0, take=Math.min(have,t.amount);
      if(take>0) byCat[cat]=have-take;
      refunded+=t.amount; excess+=t.amount-take;   // excess = refund for a purchase outside this range/view
    });
  }
  const spent=Object.values(byCat).reduce((a,b)=>a+b,0);
  const inflow=income+excess;
  let rows=Object.entries(byCat).filter(([,v])=>v>0.005).sort((a,b)=>b[1]-a[1]);
  const MAX=6;
  if(rows.length>MAX){
    const rest=rows.slice(MAX).reduce((a,[,v])=>a+v,0);
    rows=rows.slice(0,MAX);
    rows.push(['Everything else',rest]);
  }
  const ramp=['#6d28d9','#7c3aed','#8b5cf6','#a78bfa','#c4b5fd','#ddd6fe'];
  const categories=rows.map(([label,value],i)=>({label,value,color:label==='Everything else'?'#9ca3af':ramp[Math.min(i,ramp.length-1)]}));
  if(inflow>spent) categories.push({label:'Left over',value:inflow-spent,color:'var(--green)'});
  return {income,spent,categories,total:categories.reduce((a,c)=>a+c.value,0),over:(inflow>0&&spent>inflow)?spent-inflow:0,refunded,excess};
}

function renderMoneyFlow(el,d){
  if(!el) return;
  const card=el.closest('.card');
  if(!d||!d.categories.length||d.total<=0){ if(card) card.style.display='none'; return; }
  if(card) card.style.display='';
  const NS='http://www.w3.org/2000/svg';
  const W=Math.max(el.clientWidth||320,260);
  const labelW=W<420?150:190;
  const nodeW=12,rowH=34,gap=10,pad=10;
  const n=d.categories.length;
  const H=n*(rowH+gap)-gap+pad*2;
  const srcH=H-pad*2;
  const tgtX=W-labelW-nodeW;
  const x0=nodeW,x1=tgtX,midX=(x0+x1)/2;
  const mk=(tag,attrs)=>{const e=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>e.setAttribute(k,v));return e};
  const svg=mk('svg',{viewBox:`0 0 ${W} ${H}`,width:'100%',height:H,role:'img','aria-label':'Where your money went: income flowing into spending categories'});
  svg.appendChild(mk('rect',{x:0,y:pad,width:nodeW,height:srcH,rx:4,style:'fill:var(--accent)'}));
  let cursor=pad;
  d.categories.forEach((c,i)=>{
    const bandH=c.value/d.total*srcH;
    const y0t=cursor,y0b=cursor+bandH;cursor+=bandH;
    const rowY=pad+i*(rowH+gap),y1t=rowY,y1b=rowY+rowH;
    const pctTxt=Math.round(c.value/d.total*100);
    const band=mk('path',{d:`M ${x0} ${y0t} C ${midX} ${y0t}, ${midX} ${y1t}, ${x1} ${y1t} L ${x1} ${y1b} C ${midX} ${y1b}, ${midX} ${y0b}, ${x0} ${y0b} Z`,class:'mf-band','fill-opacity':'.5',style:`fill:${c.color}`});
    const tip=mk('title',{});tip.textContent=`${c.label}: ${fmt(c.value)} (${pctTxt}%)`;band.appendChild(tip);
    svg.appendChild(band);
    svg.appendChild(mk('rect',{x:tgtX,y:rowY,width:nodeW,height:rowH,rx:4,style:`fill:${c.color}`}));
    const lbl=mk('text',{x:tgtX+nodeW+8,y:rowY+15,style:'fill:var(--text);font-size:13px;font-weight:600'});lbl.textContent=c.label;svg.appendChild(lbl);
    const val=mk('text',{x:tgtX+nodeW+8,y:rowY+30,style:'fill:var(--muted);font-size:11px'});val.textContent=`${fmt(c.value)} (${pctTxt}%)`;svg.appendChild(val);
  });
  const base=d.over>0?`Spending ${fmt(d.spent)} · ${fmt(d.over)} over income`:(d.income>0?`Income ${fmt(d.income)}`:`Total spending ${fmt(d.spent)}`);
  const cap=base+(d.refunded>0?` · ${fmt(d.refunded)} in refunds netted against spending`:'');
  el.innerHTML=`<div class="flex gap6 fs12 mb8"><span class="dot" style="background:var(--accent)"></span><span class="text-muted">${cap}</span></div>`;
  el.appendChild(svg);
}

let _mfResizeT=null;
window.addEventListener('resize',()=>{
  clearTimeout(_mfResizeT);
  _mfResizeT=setTimeout(()=>{const e=$('money-flow');if(e&&activeTab==='budget'&&bSub==='spending')renderMoneyFlow(e,_moneyFlowData())},150);
});

function renderBudget(){
  const el=$('budget-body');
  ['budget','trends-total','trends-cat','trends-netflow','income-source','income-trend','income-cashflow'].forEach(k=>killChart(k));
  const hasTx=S.transactions.length>0;
  const hasIncomeTx=S.transactions.some(t=>t.incomeType);
  const hasPDS=!!(S.payScheduleConfig||S.paySchedule||detectPaySchedule());
  const _tabLbl={income:'Income',paycheck:'Paycheck',spending:'Spending',trends:'Trends',accounts:'Accounts'};
  const subTabs=hasIncomeTx
    ?(hasPDS?['spending','income','paycheck','trends','accounts']:['spending','income','trends','accounts'])
    :(hasPDS?['spending','paycheck','trends','accounts']:['spending','trends','accounts']);
  el.innerHTML=renderDateRangeBar()+((hasTx||hasPDS)
    ?`<div class="sub-tabs">${subTabs.map(t=>`<button class="sub-tab${bSub===t?' active':''}" onclick="bSub='${t}';renderBudget()">${_tabLbl[t]||t}</button>`).join('')}</div>`
    +`${bSub==='paycheck'?_paycheckHTML():bSub==='spending'?(hasTx?_spendingHTML():`<div class="upload-zone" id="upload-zone" onclick="openUploadModal('budget')" ondragover="event.preventDefault();this.classList.add('drag')" ondragleave="this.classList.remove('drag')" ondrop="handleDrop(event)"><div style="font-size:36px;margin-bottom:12px;opacity:.4">📂</div><div class="fw7 mb8">Upload a bank statement</div><div class="text-muted fs12">Drag &amp; drop or click · CSV or PDF · Bank of America, SoFi, Chase, Webull and more</div></div>${csvGuideHTML()}`):bSub==='income'?_incomeHTML():bSub==='trends'?_trendsHTML():_accountsHTML()}`
    :`<div class="upload-zone" id="upload-zone" onclick="openUploadModal('budget')" ondragover="event.preventDefault();this.classList.add('drag')" ondragleave="this.classList.remove('drag')" ondrop="handleDrop(event)"><div style="font-size:36px;margin-bottom:12px;opacity:.4">📂</div><div class="fw7 mb8">Upload a bank statement</div><div class="text-muted fs12">Drag &amp; drop or click · CSV or PDF · Bank of America, SoFi, Chase, Webull and more</div></div>${csvGuideHTML()}`);
  if(!hasTx) return;
  setTimeout(()=>{
    if(bSub==='spending'){
      killChart('budget');
      renderMoneyFlow($('money-flow'),_moneyFlowData());
      const ctx=$('budget-chart');if(!ctx)return;
      const expenses=(txAccFilter?S.transactions.filter(t=>t.account===txAccFilter):S.transactions).filter(t=>t.amount<0&&!t.internalXfer&&txInRange(t));
      const spent=expenses.reduce((a,t)=>a+Math.abs(t.amount),0);
      const byCat={};CATS.forEach(c=>byCat[c]=0);expenses.forEach(t=>{byCat[t.category]=(byCat[t.category]||0)+Math.abs(t.amount)});
      const activeCats=CATS.filter(c=>byCat[c]>0);
      CHARTS['budget']=new Chart(ctx,{type:'bar',data:{labels:activeCats,datasets:[{label:'Spending',data:activeCats.map(c=>byCat[c]),backgroundColor:activeCats.map(c=>CAT_CLR[c]+'cc'),borderColor:activeCats.map(c=>CAT_CLR[c]),borderWidth:1,borderRadius:6,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{display:false}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});
    } else if(bSub==='income'){
      // Income source doughnut
      const allTx=(txAccFilter?S.transactions.filter(t=>t.account===txAccFilter):S.transactions).filter(t=>txInRange(t));
      const incomeTx=allTx.filter(t=>t.amount>0&&!t.internalXfer&&t.incomeType);
      const bySource={};incomeTx.forEach(t=>{const s=t.incomeType||'Other';bySource[s]=(bySource[s]||0)+t.amount;});
      const srcKeys=Object.keys(bySource);
      const ic=$('income-source-chart');
      if(ic&&srcKeys.length){killChart('income-source');CHARTS['income-source']=new Chart(ic,{type:'doughnut',data:{labels:srcKeys,datasets:[{data:srcKeys.map(s=>bySource[s]),backgroundColor:srcKeys.map(s=>(INCOME_SRC_CLR[s]||'#6b7280')+'cc'),borderColor:srcKeys.map(s=>INCOME_SRC_CLR[s]||'#6b7280'),borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{font:{size:11},boxWidth:12}},tooltip:{callbacks:{label:c=>c.label+': '+fmt(c.raw)}}}}})}

      // Monthly income vs expenses line chart
      const byMonth={};
      S.transactions.filter(t=>!t.internalXfer&&txInRange(t)).forEach(t=>{const nd=normalizeDate(t.date);if(!nd)return;const mo=nd.slice(0,7);if(!byMonth[mo])byMonth[mo]={income:0,expenses:0};if(t.amount>0&&t.incomeType)byMonth[mo].income+=t.amount;else if(t.amount<0)byMonth[mo].expenses+=Math.abs(t.amount);});
      const months=Object.keys(byMonth).sort();
      const it=$('income-trend-chart');
      if(it&&months.length){killChart('income-trend');CHARTS['income-trend']=new Chart(it,{type:'line',data:{labels:months,datasets:[{label:'Income',data:months.map(m=>byMonth[m].income),borderColor:'#22c55e',backgroundColor:'rgba(34,197,94,.12)',fill:true,tension:.3,pointRadius:4,pointBackgroundColor:'#22c55e'},{label:'Expenses',data:months.map(m=>byMonth[m].expenses),borderColor:'#ef4444',backgroundColor:'rgba(239,68,68,.06)',fill:false,tension:.3,pointRadius:4,pointBackgroundColor:'#ef4444'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{size:11},boxWidth:12}},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{display:false}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});}

      // Cash flow bar chart
      const cf=$('income-cashflow-chart');
      if(cf&&months.length){killChart('income-cashflow');const flows=months.map(m=>byMonth[m].income-byMonth[m].expenses);CHARTS['income-cashflow']=new Chart(cf,{type:'bar',data:{labels:months,datasets:[{label:'Net Flow',data:flows,backgroundColor:flows.map(v=>v>=0?'rgba(34,197,94,.7)':'rgba(239,68,68,.7)'),borderColor:flows.map(v=>v>=0?'#22c55e':'#ef4444'),borderWidth:1,borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>(c.raw>=0?'+':'')+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{display:false}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});}

    } else if(bSub==='trends'){
      const allRange=S.transactions.filter(t=>txInRange(t));
      const filtered=allRange.filter(t=>t.amount<0&&!t.internalXfer);
      const incFiltered=allRange.filter(t=>t.amount>0&&!t.internalXfer&&!t.isPayment);
      const byMonth={};
      filtered.forEach(t=>{const nd=normalizeDate(t.date);if(!nd)return;const mo=nd.slice(0,7);if(!byMonth[mo]){byMonth[mo]={total:0,income:0};CATS.forEach(c=>byMonth[mo][c]=0);}byMonth[mo].total+=Math.abs(t.amount);byMonth[mo][t.category]=(byMonth[mo][t.category]||0)+Math.abs(t.amount);});
      incFiltered.forEach(t=>{const nd=normalizeDate(t.date);if(!nd)return;const mo=nd.slice(0,7);if(!byMonth[mo]){byMonth[mo]={total:0,income:0};CATS.forEach(c=>byMonth[mo][c]=0);}byMonth[mo].income=(byMonth[mo].income||0)+t.amount;});
      const months=Object.keys(byMonth).sort();if(!months.length)return;
      const hasIncome=months.some(m=>byMonth[m].income>0);
      killChart('trends-total');
      const c1=$('trends-total-chart');
      if(c1){
        const datasets=[{label:'Expenses',data:months.map(m=>byMonth[m].total),borderColor:'#ef4444',backgroundColor:'rgba(239,68,68,.1)',fill:true,tension:.3,pointRadius:4,pointBackgroundColor:'#ef4444'}];
        if(hasIncome) datasets.unshift({label:'Income',data:months.map(m=>byMonth[m].income||0),borderColor:'#22c55e',backgroundColor:'rgba(34,197,94,.1)',fill:false,tension:.3,pointRadius:4,pointBackgroundColor:'#22c55e'});
        CHARTS['trends-total']=new Chart(c1,{type:'line',data:{labels:months,datasets},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{size:11},boxWidth:12}},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{display:false}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});
      }
      if(hasIncome){
        killChart('trends-netflow');
        const c2=$('trends-netflow-chart');
        if(c2){
          const flows=months.map(m=>(byMonth[m].income||0)-byMonth[m].total);
          CHARTS['trends-netflow']=new Chart(c2,{type:'bar',data:{labels:months,datasets:[{label:'Net Flow',data:flows,backgroundColor:flows.map(v=>v>=0?'rgba(34,197,94,.7)':'rgba(239,68,68,.7)'),borderColor:flows.map(v=>v>=0?'#22c55e':'#ef4444'),borderWidth:1,borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>(c.raw>=0?'+':'')+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{display:false}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});
        }
      } else {
        killChart('trends-cat');
        const c2=$('trends-cat-chart');if(c2){const ac=CATS.filter(c=>months.some(m=>(byMonth[m][c]||0)>0));CHARTS['trends-cat']=new Chart(c2,{type:'bar',data:{labels:months,datasets:ac.map(cat=>({label:cat,data:months.map(m=>byMonth[m][cat]||0),backgroundColor:CAT_CLR[cat]+'cc',borderColor:CAT_CLR[cat],borderWidth:1,borderRadius:3}))},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{size:10},boxWidth:12}},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{display:false}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});}
      }
    }
  },150);
}

function handleDrop(e){
  e.preventDefault();
  const zone=$('upload-zone'); if(zone) zone.classList.remove('drag');
  const f=e.dataTransfer.files[0]; if(!f) return;
  const lower=f.name.toLowerCase();
  if(lower.endsWith('.pdf')){ openPDFFlow(f,activeTab==='invest'?'invest':'budget','auto',''); return; }
  if(lower.endsWith('.csv')){
    pendingFile=f;
    $('f-bank-format').value='auto';
    $('f-bank-account').value='';
    openModal('m-bank');
  }
}

// ── RECURRING DETECTION ───────────────────────────────────────────────────────
function normalizeMerchant(desc){
  if(!desc) return '';
  let s=desc.toLowerCase()
    .replace(/\d{5,}/g,'')
    .replace(/[*#@!]/g,' ')
    .replace(/\.com\b.*/,'.com')
    .replace(/\s+/g,' ')
    .trim();
  return s.split(/\s+/).slice(0,2).join(' ');
}

function computeNextDate(dateStr,cycle){
  if(!dateStr) return '';
  const d=new Date(dateStr+'T12:00:00');
  if(cycle==='weekly') d.setDate(d.getDate()+7);
  else if(cycle==='monthly') d.setMonth(d.getMonth()+1);
  else if(cycle==='quarterly') d.setMonth(d.getMonth()+3);
  else if(cycle==='semiannual') d.setMonth(d.getMonth()+6);
  else d.setFullYear(d.getFullYear()+1);
  return d.toISOString().split('T')[0];
}

function detectRecurring(){
  const billableCats=new Set(['Bills','Subscriptions','Housing','Other']);
  const txs=S.transactions.filter(t=>t.amount<0&&billableCats.has(t.category));
  const merchantMap={};
  txs.forEach(t=>{
    const nd=normalizeDate(t.date); if(!nd) return;
    const mo=nd.slice(0,7);
    const key=normalizeMerchant(t.description);
    if(!key||key.length<3) return;
    if(!merchantMap[key]) merchantMap[key]=[];
    merchantMap[key].push({...t,normDate:nd,month:mo});
  });
  const existingNames=new Set([...S.subs,...(S.bills||[])].map(x=>normalizeMerchant(x.name)));
  const subSuggs=[],billSuggs=[];
  for(const[key,items] of Object.entries(merchantMap)){
    if(existingNames.has(key)) continue;
    const months=new Set(items.map(t=>t.month));
    if(months.size<2) continue;
    const amounts=items.map(t=>Math.abs(t.amount));
    const avgAmount=amounts.reduce((a,b)=>a+b,0)/amounts.length;
    if(!amounts.every(a=>Math.abs(a-avgAmount)/avgAmount<=0.30)) continue;
    const sortedDates=items.map(t=>t.normDate).sort();
    const intervals=[];
    for(let i=1;i<sortedDates.length;i++){
      const d1=new Date(sortedDates[i-1]+'T12:00:00'),d2=new Date(sortedDates[i]+'T12:00:00');
      intervals.push(Math.round((d2-d1)/86400000));
    }
    const avgInt=intervals.reduce((a,b)=>a+b,0)/intervals.length;
    const cycle=avgInt<10?'weekly':avgInt<45?'monthly':avgInt<100?'quarterly':'annual';
    const cat=items[0].category;
    const isBill=['Bills','Housing'].includes(cat);
    const lastDate=sortedDates[sortedDates.length-1];
    const rawDesc=items.slice().sort((a,b)=>b.normDate.localeCompare(a.normDate))[0].description;
    const displayName=rawDesc.split(/[*#]/)[0].split(/\s+/).slice(0,4).join(' ').trim();
    const sugg={id:uid(),merchant:key,displayName,avgAmount:Math.round(avgAmount*100)/100,cycle,type:isBill?'bill':'subscription',cat,nextDate:computeNextDate(lastDate,cycle),months:months.size,count:items.length};
    if(isBill) billSuggs.push(sugg); else subSuggs.push(sugg);
  }
  return{subSuggs:subSuggs.sort((a,b)=>b.months-a.months),billSuggs:billSuggs.sort((a,b)=>b.months-a.months)};
}

// ── NET WORTH AUTO-UPDATE FROM CSV ────────────────────────────────────────────
function inferAssetType(label){
  const l=label.toLowerCase();
  if(/saving|savings|money market|hysa/.test(l)) return 'savings';
  if(/invest|brokerage|vanguard|fidelity|schwab|roth|401k|ira/.test(l)) return 'investments';
  return 'checking';
}

function autoUpdateNWFromCSV(acctLabel,latestBalance){
  if(latestBalance===null||isNaN(latestBalance)) return null;
  const today=new Date().toISOString().split('T')[0];
  let asset=S.assets.find(a=>a.name.toLowerCase()===acctLabel.toLowerCase()&&!a._investId);
  let oldBalance=null;
  if(asset){ oldBalance=asset.value; asset.value=latestBalance; asset.autoSync=true; asset.syncSource='csv'; asset.lastSynced=today; }
  else{ S.assets.push({id:uid(),name:acctLabel,type:inferAssetType(acctLabel),value:latestBalance,autoSync:true,syncSource:'csv',lastSynced:today}); }
  autoLogNW();
  return{acctLabel,latestBalance,oldBalance};
}

function autoLogNW(){
  const ta=S.assets.reduce((a,x)=>a+(x.value||0),0);
  const tl=S.liabilities.reduce((a,x)=>a+(x.value||0),0);
  const today=new Date().toISOString().split('T')[0];
  const newNW=Math.round((ta-tl)*100)/100;
  const i=S.nwHistory.findIndex(h=>h.date===today);
  if(i>=0){
    // Update same-day entry only if it actually changed
    const e=S.nwHistory[i];
    if(e.nw===newNW&&e.assets===ta&&e.liabs===tl) return;
    S.nwHistory[i]={date:today,nw:newNW,assets:ta,liabs:tl,source:'auto-updated',updatedAt:new Date().toISOString()};
  } else {
    // Only log a new entry if NW changed by more than $10 from last entry
    const sorted=[...S.nwHistory].sort((a,b)=>b.date.localeCompare(a.date));
    const last=sorted[0];
    if(last&&Math.abs((last.nw||0)-newNW)<10) return;
    S.nwHistory.push({date:today,nw:newNW,assets:ta,liabs:tl,source:'auto',createdAt:new Date().toISOString()});
    S.nwHistory.sort((a,b)=>a.date.localeCompare(b.date));
  }
}

function syncCardLiabilities(){
  const today=new Date().toISOString().split('T')[0];
  S.cards.forEach(c=>{
    const balance=c.balance||0;
    let liab=S.liabilities.find(l=>l.autoSync&&l.syncSource==='card'&&l.cardId===c.id);
    if(balance>0){
      if(liab){ liab.name=c.name; if(liab.value!==balance){ liab.value=balance; liab.lastSynced=today; } }
      else S.liabilities.push({id:uid(),name:c.name,type:'credit_card',value:balance,autoSync:true,syncSource:'card',cardId:c.id,lastSynced:today});
    } else if(liab){
      S.liabilities=S.liabilities.filter(l=>l.id!==liab.id);
    }
  });
  S.liabilities=S.liabilities.filter(l=>!l.autoSync||l.syncSource!=='card'||S.cards.some(c=>c.id===l.cardId));
  autoLogNW();
}

// ── UPLOAD SUMMARY ────────────────────────────────────────────────────────────
function showUploadSummary(added,skipped,nwUpdate,incomeStats,recatCount,vaultSync){
  const subSuggCount=(S.subSuggestions||[]).length;
  const billSuggCount=(S.billSuggestions||[]).length;
  let html='<div style="line-height:2">';
  html+=`<div><span style="color:var(--green)">✓</span> <strong>${added} transaction${added!==1?'s':''}</strong> added to Budget</div>`;
  if(skipped>0) html+=`<div class="text-muted fs12">ℹ ${skipped} row${skipped!==1?'s':''} skipped (non-Posted / duplicates / empty)</div>`;
  if(incomeStats&&incomeStats.total>0) html+=`<div style="margin-top:4px"><span style="color:var(--green)">↑</span> <strong class="text-green">${fmt(incomeStats.total)}</strong> income detected (${incomeStats.count} transaction${incomeStats.count!==1?'s':''}) — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="closeModal('m-upload-summary');go('budget')">View in Budget</span></div>`;
  if(incomeStats&&incomeStats.internalCount>0) html+=`<div class="text-muted fs12">ℹ ${incomeStats.internalCount} internal transfer${incomeStats.internalCount!==1?'s':''} flagged (excluded from spending totals)</div>`;
  // Vault notifications
  if(vaultSync&&vaultSync.vaults.length){
    const efVault=vaultSync.vaults.find(v=>/emergency fund/i.test(v.name));
    if(efVault) html+=`<div><span style="color:var(--teal)">⊕</span> Emergency Fund Vault: <strong class="text-green">${fmt(efVault.balance)}</strong> (${efVault.transactionCount} vault transactions) — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="closeModal('m-upload-summary');go('goals')">View in Goals</span></div>`;
    vaultSync.newVaults.filter(v=>!/emergency fund/i.test(v.name)).forEach(v=>{
      html+=`<div><span style="color:var(--teal)">⊕</span> New savings vault detected: <strong>${esc(v.name)}</strong> — ${fmt(v.balance)} — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="closeModal('m-upload-summary');openGoalModal()">Create goal →</span></div>`;
    });
  }
  if(subSuggCount>0) html+=`<div style="margin-top:6px"><span style="color:var(--purple)">✦</span> <strong>${subSuggCount} subscription suggestion${subSuggCount!==1?'s':''}</strong> — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="closeModal('m-upload-summary');go('subs')">Review in Subscriptions tab</span></div>`;
  if(billSuggCount>0) html+=`<div><span style="color:#06b6d4">✦</span> <strong>${billSuggCount} bill suggestion${billSuggCount!==1?'s':''}</strong> — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="closeModal('m-upload-summary');go('bills')">Review in Bills tab</span></div>`;
  if(nwUpdate) html+=`<div style="margin-top:6px"><span style="color:var(--green)">↑</span> Net Worth updated: <strong>${esc(nwUpdate.acctLabel)}</strong> → <strong class="text-green">${fmt(nwUpdate.latestBalance)}</strong>${nwUpdate.oldBalance!==null?' (was '+fmt(nwUpdate.oldBalance)+')':''}</div>`;
  if(recatCount>0) html+=`<div style="margin-top:4px"><span style="color:var(--accent)">✦</span> <strong>${recatCount} transaction${recatCount!==1?'s':''}</strong> re-categorized to Investments or Credit Card Payments</div>`;
  html+='</div>';
  $('m-upload-summary-body').innerHTML=html;
  openModal('m-upload-summary');
}

// ── SUGGESTION ACTIONS ────────────────────────────────────────────────────────
function confirmSubSugg(id){
  const sg=(S.subSuggestions||[]).find(x=>x.id===id); if(!sg) return;
  S.subs.push({id:uid(),name:sg.displayName,amount:sg.avgAmount,cycle:sg.cycle,category:'Other',nextBilling:sg.nextDate,paused:false});
  S.subSuggestions=S.subSuggestions.filter(x=>x.id!==id);
  save(); renderSubs();
}
function dismissSubSugg(id){ S.subSuggestions=(S.subSuggestions||[]).filter(x=>x.id!==id); save(); renderSubs(); }
function dismissAllSubSuggs(){ S.subSuggestions=[]; save(); renderSubs(); }

function inferBillCat(cat,name){
  const n=(name||'').toLowerCase();
  if(/t-mobile|at&t|verizon|sprint|boost|metro pcs|cricket|cellular|visible|mint mobile/.test(n)) return 'Phone';
  if(/spectrum|optimum|xfinity|comcast|fios|altice|internet|cable/.test(n)) return 'Internet';
  if(/pseg|con ed|coned|electric|gas|water|utility|utilities/.test(n)) return 'Utilities';
  if(/geico|progressive|allstate|state farm|insurance|oscar|cigna|aetna|metlife/.test(n)) return 'Insurance';
  if(/mortgage|auto loan|student loan|car payment|loan/.test(n)) return 'Loans';
  if(/rent/.test(n)||cat==='Housing') return 'Rent';
  return 'Other';
}
function confirmBillSugg(id){
  const sg=(S.billSuggestions||[]).find(x=>x.id===id); if(!sg) return;
  if(!S.bills) S.bills=[];
  S.bills.push({id:uid(),name:sg.displayName,amount:sg.avgAmount,cycle:sg.cycle,category:inferBillCat(sg.cat,sg.displayName),nextDue:sg.nextDate,paused:false});
  S.billSuggestions=S.billSuggestions.filter(x=>x.id!==id);
  save(); renderBills();
}
function dismissBillSugg(id){ S.billSuggestions=(S.billSuggestions||[]).filter(x=>x.id!==id); save(); renderBills(); }
function dismissAllBillSuggs(){ S.billSuggestions=[]; save(); renderBills(); }

// ── NET WORTH ─────────────────────────────────────────────────────────────────
const ASSET_LABELS={checking:'Checking',savings:'Savings',investments:'Investments',property:'Property',other:'Other'};
const LIAB_LABELS={credit_card:'Credit Card',loan:'Loan',mortgage:'Mortgage',other:'Other'};

function openAssetModal(id){
  editId=id||null;
  const a=id?S.assets.find(x=>x.id===id):null;
  $('m-asset-title').textContent=id?'Edit Asset':'Add Asset';
  $('f-asset-name').value=a?a.name:'';
  $('f-asset-type').value=a?a.type:'checking';
  $('f-asset-value').value=a?a.value:'';
  if(!id) renderAssetChips(); else { const c=$('asset-chips'); if(c) c.innerHTML=''; }
  openModal('m-asset');
}
function saveAsset(){
  const name=$('f-asset-name').value.trim(); if(!name) return alert('Name required.');
  const type=$('f-asset-type').value;
  const value=parseFloat($('f-asset-value').value)||0;
  if(editId){ const a=S.assets.find(x=>x.id===editId); if(a){a.name=name;a.type=type;a.value=value} }
  else S.assets.push({id:uid(),name,type,value});
  save(); closeModal('m-asset'); renderNW(); showSaveToast('Asset saved');
}
async function deleteAsset(id){ if(!await appConfirm('Delete?',{danger:true,confirmText:'Delete'})) return; S.assets=S.assets.filter(x=>x.id!==id); save(); renderNW() }

function openLiabModal(id){
  editId=id||null;
  const l=id?S.liabilities.find(x=>x.id===id):null;
  $('m-liability-title').textContent=id?'Edit Liability':'Add Liability';
  $('f-liab-name').value=l?l.name:'';
  $('f-liab-type').value=l?l.type:'loan';
  $('f-liab-value').value=l?l.value:'';
  if(!id) renderLiabChips(); else { const c=$('liab-chips'); if(c) c.innerHTML=''; }
  openModal('m-liability');
}
function saveLiab(){
  const name=$('f-liab-name').value.trim(); if(!name) return alert('Name required.');
  const type=$('f-liab-type').value;
  const value=parseFloat($('f-liab-value').value)||0;
  if(editId){ const l=S.liabilities.find(x=>x.id===editId); if(l){l.name=name;l.type=type;l.value=value} }
  else S.liabilities.push({id:uid(),name,type,value});
  save(); closeModal('m-liability'); renderNW(); showSaveToast('Liability saved');
}
async function deleteLiab(id){ if(!await appConfirm('Delete?',{danger:true,confirmText:'Delete'})) return; S.liabilities=S.liabilities.filter(x=>x.id!==id); save(); renderNW() }

function logNW(){
  autoLogNW();
  save(); renderNW();
}
function deleteNWEntry(date){ S.nwHistory=S.nwHistory.filter(h=>h.date!==date); save(); renderNW() }
async function clearNW(){ if(!await appConfirm('Clear all net worth history?',{danger:true,confirmText:'Clear'})) return; S.nwHistory=[]; save(); renderNW() }

function renderNW(){
  const el=$('nw-body');
  const assets=S.assets.reduce((a,x)=>a+(x.value||0),0);
  const liabs=S.liabilities.reduce((a,x)=>a+(x.value||0),0);
  const nw=assets-liabs;
  const annualIntCost=S.cards.reduce((a,c)=>a+(c.apr&&c.balance?c.apr/100*c.balance:0),0);
  const curYear=new Date().getFullYear().toString();
  const interestEarnedYTD=S.transactions.filter(t=>t.incomeType==='Interest'&&t.date&&String(t.date).startsWith(curYear)).reduce((a,t)=>a+t.amount,0);

  function daysSince(d){if(!d)return 999;return Math.round((new Date()-new Date(d+'T12:00:00'))/86400000);}
  function syncLabel(d){const ds=daysSince(d);return ds===0?'synced today':ds===1?'synced yesterday':d?'synced '+d:'auto-synced';}

  function assetSection(label,items){
    if(!items.length) return '';
    const sub=items.reduce((a,x)=>a+(x.value||0),0);
    return `<div class="mb12">
      <div class="fs11 fw7 text-muted" style="text-transform:uppercase;letter-spacing:.07em;padding:5px 0 4px;border-bottom:1px solid var(--border);margin-bottom:6px;display:flex;justify-content:space-between">${label}<span style="font-weight:400">${fmt(sub)}</span></div>
      ${items.map(a=>{
        if(a.autoSync) return `<div class="flex-sb" style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)">
          <div><div class="fw7 fs12" style="display:flex;align-items:center;gap:4px"><span style="color:var(--teal);font-size:11px" title="Auto-synced">⟳</span>${esc(a.name)}</div>
          <div class="fs11 text-muted">${syncLabel(a.lastSynced)}</div></div>
          <span class="fw7 text-green">${fmt(a.value)}</span>
        </div>`;
        return `<div class="flex-sb" style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)">
          <div class="fw7 fs12">${esc(a.name)}</div>
          <div class="flex gap6 align-center"><span class="fw7 text-green">${fmt(a.value)}</span>
            <button class="icon-btn" onclick="openAssetModal('${a.id}')">✏</button>
            <button class="icon-btn" onclick="deleteAsset('${a.id}')">🗑</button>
          </div>
        </div>`;
      }).join('')}
    </div>`;
  }

  function liabSection(label,items){
    if(!items.length) return '';
    const sub=items.reduce((a,x)=>a+(x.value||0),0);
    return `<div class="mb12">
      <div class="fs11 fw7 text-muted" style="text-transform:uppercase;letter-spacing:.07em;padding:5px 0 4px;border-bottom:1px solid var(--border);margin-bottom:6px;display:flex;justify-content:space-between">${label}<span style="font-weight:400">${fmt(sub)}</span></div>
      ${items.map(l=>{
        if(l.autoSync){
          const stale=daysSince(l.lastSynced)>30;
          return `<div style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)">
            <div class="flex-sb">
              <div><div class="fw7 fs12" style="display:flex;align-items:center;gap:4px"><span style="color:var(--teal);font-size:11px" title="Auto-synced">⟳</span>${esc(l.name)}</div>
              <div class="fs11 text-muted">${syncLabel(l.lastSynced)}</div></div>
              <span class="fw7 text-red">${fmt(l.value)}</span>
            </div>
            ${stale?`<div class="fs11 mt4" style="color:var(--yellow)">⚠ Balance may be outdated — upload latest statement</div>`:''}
          </div>`;
        }
        return `<div class="flex-sb" style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)">
          <div><div class="fw7 fs12">${esc(l.name)}</div><div class="fs11 text-muted">${LIAB_LABELS[l.type]||l.type}</div></div>
          <div class="flex gap6 align-center"><span class="fw7 text-red">${fmt(l.value)}</span>
            <button class="icon-btn" onclick="openLiabModal('${l.id}')">✏</button>
            <button class="icon-btn" onclick="deleteLiab('${l.id}')">🗑</button>
          </div>
        </div>`;
      }).join('')}
    </div>`;
  }

  const aChecking=S.assets.filter(a=>a.type==='checking');
  const aSavings=S.assets.filter(a=>a.type==='savings');
  const aInvest=S.assets.filter(a=>a.type==='investments');
  const aProp=S.assets.filter(a=>a.type==='property');
  const aOther=S.assets.filter(a=>!['checking','savings','investments','property'].includes(a.type));
  const lCC=S.liabilities.filter(l=>l.autoSync&&l.syncSource==='card');
  const lLoans=S.liabilities.filter(l=>!l.autoSync&&(l.type==='loan'||l.type==='mortgage'));
  const lOther=S.liabilities.filter(l=>!l.autoSync&&l.type!=='loan'&&l.type!=='mortgage');

  el.innerHTML=`
  <div class="${interestEarnedYTD>0?'g4':'g3'} mb16">
    <div class="stat"><div class="stat-label">Total Assets</div><div class="stat-value text-green">${fmt(assets)}</div><div class="stat-sub">${S.assets.length} item${S.assets.length!==1?'s':''}</div></div>
    <div class="stat"><div class="stat-label">Total Liabilities</div><div class="stat-value text-red">${fmt(liabs)}</div><div class="stat-sub">${S.liabilities.length} item${S.liabilities.length!==1?'s':''}</div></div>
    <div class="stat"><div class="stat-label">Net Worth</div><div class="stat-value ${nw>=0?'text-green':'text-red'}">${fmt(nw)}</div><div class="stat-sub">${nw>=0?'Positive – great!':'Negative – work to close gap'}</div></div>
    ${interestEarnedYTD>0?`<div class="stat"><div class="stat-label">Interest Earned YTD</div><div class="stat-value text-green">${fmt(interestEarnedYTD)}</div><div class="stat-sub">${curYear} · from SoFi</div></div>`:''}
  </div>
  ${annualIntCost>0?`<div class="alert alert-warn mb16">⚠ <strong>Interest Impact:</strong> Your credit card balances are projected to cost you <strong>${fmt(Math.round(annualIntCost))}/year</strong> in interest (~${fmt(Math.round(annualIntCost/12))}/mo). Paying off high-APR balances is the fastest way to grow net worth. <span style="cursor:pointer;text-decoration:underline" onclick="go('cards')">View payoff calculator →</span></div>`:''}

  ${(()=>{
    const dti=calcDTIData();
    const dtiClr=dti.dtiPercent===null?'var(--muted)':dti.dtiPercent<15?'var(--green)':dti.dtiPercent<35?'var(--teal)':dti.dtiPercent<43?'#F97316':'var(--red)';
    const bracketLbl=dti.bracket==='excellent'?'Excellent':dti.bracket==='healthy'?'Healthy':dti.bracket==='concerning'?'Concerning':'Above Stress Threshold';
    const bracketBadgeStyle=`background:${dtiClr}22;color:${dtiClr};padding:3px 10px`;
    if(!dti.monthlyIncome) return `<div class="card mb16" style="padding:16px;text-align:center;color:var(--muted);font-size:13px">📊 <strong>Debt-to-Income Ratio</strong> — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="go('budget')">Add income data to see DTI analysis →</span></div>`;
    const alreadyHealthy=dti.dtiPercent!==null&&dti.dtiPercent<35;
    // Payoff impact commentary
    const topCard=S.cards.filter(c=>c.balance>0).sort((a,b)=>b.balance-a.balance)[0];
    const topCardMin=topCard?Math.max(25,topCard.balance*0.02):0;
    const targetPmtDiff=dti.targetPaymentsForHealthy?dti.monthlyDebtPayments-dti.targetPaymentsForHealthy:0;
    const nwGain12=topCard?topCardMin*12:0;
    return `<div class="card mb16">
      <div class="fw7 fs14 mb12">Debt-to-Income Ratio &amp; Payoff Impact</div>
      <div class="flex-sb mb6" style="flex-wrap:wrap;gap:8px">
        <div>
          <div class="stat-label mb4">DEBT-TO-INCOME RATIO</div>
          <div style="display:flex;align-items:baseline;gap:8px">
            <span style="font-size:26px;font-weight:700;color:${dtiClr}">${dti.dtiPercent!==null?dti.dtiPercent.toFixed(1)+'%':'—'}</span>
            <span class="badge fs11" style="${bracketBadgeStyle}">${bracketLbl}</span>
          </div>
          <div class="text-muted fs12 mt4">${fmt(dti.monthlyDebtPayments)} debt payments ÷ ${fmt(dti.monthlyIncome)} income</div>
        </div>
      </div>
      <div style="position:relative;height:10px;background:var(--surface2);border-radius:5px;margin:12px 0 6px">
        <div style="position:absolute;left:0;top:0;height:100%;width:${Math.min(dti.dtiPercent||0,100)}%;background:${dtiClr};border-radius:5px;transition:width .4s"></div>
        <div style="position:absolute;left:35%;top:-5px;height:20px;width:2px;background:var(--yellow)" title="35% — healthy threshold"></div>
        <div style="position:absolute;left:43%;top:-5px;height:20px;width:2px;background:var(--red)" title="43% — stress threshold"></div>
      </div>
      <div class="flex gap6 mb12" style="flex-wrap:wrap">
        <span class="badge fs10" style="background:rgba(0,212,170,.12);color:var(--green)">Under 35% healthy</span>
        <span class="badge fs10" style="background:rgba(249,115,22,.12);color:#F97316">35–43% concerning</span>
        <span class="badge fs10" style="background:rgba(255,77,109,.12);color:var(--red)">Over 43% stress</span>
      </div>
      <div style="border-top:1px solid var(--border);padding-top:14px;margin-top:4px">
        ${alreadyHealthy?`<div style="display:flex;align-items:center;gap:10px;color:var(--green)">
          <span style="font-size:20px">✓</span>
          <div><div class="fw6 fs13">Your DTI of ${dti.dtiPercent.toFixed(1)}% is in the healthy range</div>
          <div class="text-muted fs12">Maintain current debt payments and income levels to keep it here.</div></div>
        </div>`:`<div>
          <div class="fw6 fs13 mb10">To reach healthy DTI (under 35%) you need to:</div>
          <div class="g2" style="gap:10px">
            <div style="background:rgba(0,212,170,.08);border:1px solid rgba(0,212,170,.25);border-radius:var(--r);padding:12px">
              <div class="stat-label mb4">REDUCE MONTHLY DEBT TO</div>
              <div class="fw8 text-green" style="font-size:18px">${fmt(dti.targetPaymentsForHealthy)}</div>
              <div class="text-muted fs12 mt4">Save ${fmt(Math.round(targetPmtDiff))} in monthly minimums</div>
              ${topCard?`<div class="fs11 mt8" style="color:var(--green)">→ Paying off ${esc(topCard.name)} would free up ~${fmt(Math.round(topCardMin))}/mo</div>`:''}
            </div>
            <div style="background:rgba(108,99,255,.08);border:1px solid rgba(108,99,255,.25);border-radius:var(--r);padding:12px">
              <div class="stat-label mb4">OR INCREASE INCOME TO</div>
              <div class="fw8" style="font-size:18px;color:var(--accent)">${fmt(dti.targetIncomeForHealthy)}</div>
              <div class="text-muted fs12 mt4">+${fmt(Math.round(dti.targetIncomeForHealthy-dti.monthlyIncome))} more than current income</div>
            </div>
          </div>
        </div>`}
      </div>
      ${topCard&&!alreadyHealthy?`<div class="fs12 text-muted mt12" style="padding-top:10px;border-top:1px solid var(--border)">
        📈 At current DTI, you're paying ${fmt(Math.round(dti.monthlyDebtPayments))}/mo in minimums.
        Paying off ${esc(topCard.name)} would free up ~${fmt(Math.round(topCardMin))}/mo and add ~${fmt(Math.round(nwGain12))} to your net worth over 12 months.
      </div>`:''}
    </div>`;
  })()}

  <div class="g2 mb16">
    <div class="card">
      <div class="card-header mb12"><div class="card-title">Assets</div><button class="btn btn-primary btn-sm" onclick="openAssetModal()">+ Add</button></div>
      ${!S.assets.length?'<div class="empty" style="padding:16px 0"><div class="text-muted fs12">Upload a bank CSV to auto-populate, or click + Add.</div></div>':''}
      ${assetSection('Cash & Checking',aChecking)}
      ${assetSection('Savings',aSavings)}
      ${(()=>{
        const vaultAccts=(AnchorDB.virtualAccounts||[]).filter(v=>v.type==='savings-vault'&&v.balance>0);
        if(!vaultAccts.length) return '';
        const sub=vaultAccts.reduce((a,v)=>a+v.balance,0);
        return `<div class="mb12">
          <div class="fs11 fw7 text-muted" style="text-transform:uppercase;letter-spacing:.07em;padding:5px 0 4px;border-bottom:1px solid var(--border);margin-bottom:6px;display:flex;justify-content:space-between">Savings Vaults<span style="font-weight:400">${fmt(sub)}</span></div>
          ${vaultAccts.map(v=>`<div class="flex-sb" style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)">
            <div>
              <div class="fw7 fs12" style="display:flex;align-items:center;gap:4px">
                <span style="color:var(--teal);font-size:11px" title="Reconstructed from transactions">↻</span>${esc(v.name)}
                <span class="badge fs10" style="background:var(--surface3);color:var(--muted);padding:1px 5px">virtual</span>
              </div>
              <div class="fs11 text-muted">${v.transactionCount} vault tx · updated ${v.lastUpdated||'—'} · <span style="color:var(--accent);cursor:pointer;text-decoration:underline" data-v="${esc(v.name)}" onclick="openVaultLedger(this.dataset.v)">how?</span></div>
            </div>
            <span class="fw7 text-green">${fmt(v.balance)}</span>
          </div>`).join('')}
          <div class="fs11 text-muted mt4" style="padding-top:4px">⚠ Virtual accounts are display-only and not included in NW total to avoid double-counting with SoFi Savings.</div>
        </div>`;
      })()}
      ${assetSection('Investments',aInvest)}
      ${assetSection('Property',aProp)}
      ${assetSection('Other',aOther)}
      ${S.assets.length?`<div class="flex-sb fw7 fs13" style="padding-top:8px;border-top:1px solid var(--border)"><span>Total Assets</span><span class="text-green">${fmt(assets)}</span></div>`:''}
    </div>
    <div class="card">
      <div class="card-header mb12"><div class="card-title">Liabilities</div><button class="btn btn-primary btn-sm" onclick="openLiabModal()">+ Add</button></div>
      ${!S.liabilities.length?'<div class="empty" style="padding:16px 0"><div class="text-muted fs12">Add a card with a balance in Credit Cards to auto-populate.</div></div>':''}
      ${liabSection('Credit Card Debt',lCC)}
      ${liabSection('Loans',lLoans)}
      ${liabSection('Other Debt',lOther)}
      ${S.liabilities.length?`<div class="flex-sb fw7 fs13" style="padding-top:8px;border-top:1px solid var(--border)"><span>Total Liabilities</span><span class="text-red">${fmt(liabs)}</span></div>`:''}
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Net Worth History</div>
      <div class="flex gap8">
        <span class="text-muted fs12">${S.nwHistory.length} entries</span>
        <button class="btn btn-primary btn-sm" onclick="logNW()">Log Today</button>
        ${S.nwHistory.length>0?`<button class="btn btn-danger btn-sm" onclick="clearNW()">Clear</button>`:''}
      </div>
    </div>
    ${S.nwHistory.length<2
      ?`<div class="empty" style="padding:28px"><div class="text-muted fs12">Log your net worth at least twice to see a trend chart.<br>Click "Log Today" to create the first entry.</div></div>`
      :`<div class="chart-wrap mb16" style="height:220px"><canvas id="nw-chart"></canvas></div>`}
    ${S.nwHistory.length>0?`
    <div class="divider"></div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Date</th><th>Net Worth</th><th>Assets</th><th>Liabilities</th><th></th></tr></thead>
      <tbody>${[...S.nwHistory].reverse().map(h=>`<tr>
        <td>${h.date}</td>
        <td class="${h.nw>=0?'text-green':'text-red'} fw7">${fmt(h.nw)}</td>
        <td class="text-green">${fmt(h.assets)}</td>
        <td class="text-red">${fmt(h.liabs)}</td>
        <td><button class="btn btn-danger btn-xs" onclick="deleteNWEntry('${h.date}')">✕</button></td>
      </tr>`).join('')}</tbody>
    </table></div>`:''}
  </div>

  ${(()=>{
    const balAccts=Object.keys(S.balanceHistory||{});
    if(!balAccts.length) return '';
    return `<div class="card mt16">
      <div class="card-header"><div class="card-title">Balance History</div><span class="text-muted fs12">${balAccts.length} account${balAccts.length!==1?'s':''} · from CSV imports</span></div>
      <div class="chart-wrap mb16" style="height:220px"><canvas id="bal-hist-chart"></canvas></div>
      <div class="divider"></div>
      <div class="g${Math.min(balAccts.length,3)} mt8">
        ${balAccts.map(acct=>{const bh=S.balanceHistory[acct];const cur=bh[bh.length-1].balance;const hi=Math.max(...bh.map(e=>e.balance));const lo=Math.min(...bh.map(e=>e.balance));return `<div><div class="fw7 fs12 mb8">${esc(acct)}</div><div class="text-green fw8" style="font-size:18px">${fmt(cur)}</div><div class="text-muted fs11">current</div><div class="flex gap12 mt8 fs11 text-muted"><span>High: <span class="fw7 text-green">${fmt(hi)}</span></span><span>Low: <span class="fw7 ${lo<0?'text-red':'text-yellow'}">${fmt(lo)}</span></span></div></div>`;}).join('')}
      </div>
    </div>`;
  })()}

  ${(()=>{
    const sofiAccts=Object.keys(S.balanceHistory||{}).filter(k=>/sofi/i.test(k));
    if(!sofiAccts.length&&!S.transactions.some(t=>t.incomeType)) return '';
    const efData=getEmergencyFundData();
    const nwYr=new Date().getFullYear().toString();
    const interestYTD=S.transactions.filter(t=>t.incomeType==='Interest'&&String(normalizeDate(t.date)||'').startsWith(nwYr)).reduce((a,t)=>a+t.amount,0);
    const sofiTotals=sofiAccts.map(a=>{const bh=S.balanceHistory[a];return{name:a,balance:bh[bh.length-1].balance,prev:bh.length>1?bh[bh.length-2].balance:null,history:bh};});
    const combinedSofi=sofiTotals.reduce((a,x)=>a+x.balance,0)+efData.balance;
    const growthRates=[];
    sofiTotals.forEach(({history})=>{if(history.length>=2){const dates=history.map(e=>e.date).sort();const byMo={};dates.forEach(d=>{const mo=d.slice(0,7);const e=history.find(x=>x.date===d);if(e)byMo[mo]=e.balance;});const mos=Object.keys(byMo).sort();for(let i=1;i<mos.length;i++){const rate=byMo[mos[i]]-byMo[mos[i-1]];if(rate!==0)growthRates.push(rate);};}});
    const avgMonthlyGrowth=growthRates.length?growthRates.reduce((a,b)=>a+b,0)/growthRates.length:0;
    const proj6=combinedSofi+avgMonthlyGrowth*6;
    const proj12=combinedSofi+avgMonthlyGrowth*12;
    return `<div class="card mt16" style="border-left:4px solid var(--teal)">
      <div class="card-title mb12">SoFi Account Summary</div>
      <div class="g${Math.min(sofiTotals.length+(efData.balance>0?1:0),4)} mb16">
        ${sofiTotals.map(a=>{const chg=a.prev!==null?a.balance-a.prev:null;return `<div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw7 fs11 text-muted mb6">${esc(a.name)}</div><div class="fw8 text-green" style="font-size:20px">${fmt(a.balance)}</div>${chg!==null?`<div class="fs11 ${chg>=0?'text-green':'text-red'} mt4">${chg>=0?'+':''}${fmt(chg)} last period</div>`:''}</div>`;}).join('')}
        ${efData.balance>0?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw7 fs11 text-muted mb6">Emergency Fund</div><div class="fw8 text-green" style="font-size:20px">${fmt(efData.balance)}</div><div class="fs11 text-muted mt4">reconstructed · <span style="color:var(--accent);cursor:pointer;text-decoration:underline" data-v="Emergency Fund Vault" onclick="openVaultLedger(this.dataset.v)">how?</span></div></div>`:''}
      </div>
      <div class="g3 mb12" style="gap:8px">
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 text-green" style="font-size:18px">${fmt(combinedSofi)}</div><div class="text-muted fs11 mt6">Combined SoFi Total</div></div>
        ${interestYTD>0?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 text-yellow" style="font-size:18px">${fmt(interestYTD)}</div><div class="text-muted fs11 mt6">Interest Earned YTD</div></div>`:''}
        ${avgMonthlyGrowth!==0?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 ${avgMonthlyGrowth>=0?'text-green':'text-red'}" style="font-size:18px">${avgMonthlyGrowth>=0?'+':''}${fmt(avgMonthlyGrowth)}</div><div class="text-muted fs11 mt6">Avg Monthly Growth</div></div>`:''}
      </div>
      ${avgMonthlyGrowth>0?`<div class="fs12 fw7 mb8">Savings Projection (at current rate)</div>
      <div class="g2" style="gap:8px">
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 text-green" style="font-size:16px">${fmt(proj6)}</div><div class="text-muted fs11 mt4">6-month projection</div></div>
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8 text-green" style="font-size:16px">${fmt(proj12)}</div><div class="text-muted fs11 mt4">12-month projection</div></div>
      </div>`:''}
    </div>`;
  })()}
  <div class="priv-note mt16">🔒 Net worth data is stored locally on this device only — never transmitted or shared.</div>`;

  setTimeout(()=>{
    if(S.nwHistory.length>=2){
      killChart('nw');
      const ctx=$('nw-chart');if(ctx){
        CHARTS['nw']=new Chart(ctx,{type:'line',data:{labels:S.nwHistory.map(h=>h.date),datasets:[{label:'Net Worth',data:S.nwHistory.map(h=>h.nw),borderColor:'#6366f1',backgroundColor:'rgba(99,102,241,.12)',fill:true,tension:.3,pointRadius:4,pointBackgroundColor:'#6366f1'},{label:'Assets',data:S.nwHistory.map(h=>h.assets),borderColor:'#10b981',borderDash:[5,4],tension:.3,pointRadius:3,fill:false},{label:'Liabilities',data:S.nwHistory.map(h=>h.liabs),borderColor:'#ef4444',borderDash:[5,4],tension:.3,pointRadius:3,fill:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{size:11}}},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11}},grid:{color:_cGrid()}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});
      }
    }
    const balAccts=Object.keys(S.balanceHistory||{});
    if(balAccts.length){
      killChart('bal-hist');
      const ctx=$('bal-hist-chart');if(ctx){
        const allDates=[...new Set(balAccts.flatMap(a=>S.balanceHistory[a].map(e=>e.date)))].sort();
        const colors=['#6366f1','#10b981','#f97316','#8b5cf6','#ec4899','#14b8a6'];
        const datasets=balAccts.map((acct,i)=>{const map=Object.fromEntries(S.balanceHistory[acct].map(e=>[e.date,e.balance]));return{label:acct,data:allDates.map(d=>map[d]??null),borderColor:colors[i%colors.length],backgroundColor:colors[i%colors.length]+'22',fill:false,tension:.3,pointRadius:3,spanGaps:true};});
        CHARTS['bal-hist']=new Chart(ctx,{type:'line',data:{labels:allDates,datasets},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{size:11}}},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.raw)}}},scales:{x:{ticks:{font:{size:11},maxTicksLimit:12},grid:{color:_cGrid()}},y:{ticks:{font:{size:11},callback:v=>'$'+v.toLocaleString()},grid:{color:_cGrid()}}}}});
      }
    }
  },150);
}

// ── GOALS ─────────────────────────────────────────────────────────────────────
function openGoalModal(id){
  editId=id||null;
  const g=id?S.goals.find(x=>x.id===id):null;
  $('m-goal-title').textContent=id?'Edit Goal':'Add Goal';
  $('f-goal-name').value=g?g.name:'';
  $('f-goal-target').value=g?g.target:'';
  $('f-goal-current').value=g?g.current:'';
  $('f-goal-date').value=g?g.targetDate:'';
  if(!id) renderGoalChips(); else { const c=$('goal-chips'); if(c) c.innerHTML=''; }
  openModal('m-goal');
}
function saveGoal(){
  const name=$('f-goal-name').value.trim(); if(!name) return alert('Goal name required.');
  const target=parseFloat($('f-goal-target').value)||0;
  const current=parseFloat($('f-goal-current').value)||0;
  const targetDate=$('f-goal-date').value;
  if(editId){ const g=S.goals.find(x=>x.id===editId); if(g){g.name=name;g.target=target;g.current=current;g.targetDate=targetDate} }
  else S.goals.push({id:uid(),name,target,current,targetDate});
  save(); closeModal('m-goal'); renderGoals(); showSaveToast('Goal saved');
}
async function deleteGoal(id){ if(!await appConfirm('Delete this goal?',{danger:true,confirmText:'Delete'})) return; S.goals=S.goals.filter(x=>x.id!==id); save(); renderGoals() }

function monthsLeft(dateStr){
  if(!dateStr) return null;
  const t=new Date(dateStr), now=new Date();
  return Math.max(0,(t.getFullYear()-now.getFullYear())*12+(t.getMonth()-now.getMonth()));
}

function addPayoffGoal(cardId){
  const card=S.cards.find(c=>c.id===cardId);
  if(!card) return;
  const name=`Pay off ${card.name}`;
  if(S.goals.find(g=>g.name===name)) return;
  S.goals.push({id:uid(),name,target:card.balance,current:0,targetDate:''});
  save(); renderGoals();
}

function renderGoals(){
  const el=$('goals-body');
  const highAprCards=S.cards.filter(c=>(c.apr||0)>20&&c.balance>0).sort((a,b)=>b.apr-a.apr);
  const ungoaled=highAprCards.filter(c=>!S.goals.find(g=>g.name===`Pay off ${c.name}`));

  let bannerHtml='';
  if(ungoaled.length>0){
    bannerHtml=`<div class="card mb16" style="border-left:4px solid var(--red)">
      <div class="card-title mb8">⚠ High APR Card${ungoaled.length>1?'s':''} — Suggested Goal${ungoaled.length>1?'s':''}</div>
      <div class="text-muted fs12 mb10">Cards with APR above 20% are costing you money every month. Paying them off is one of the best financial moves you can make.</div>
      ${ungoaled.map(c=>{
        const monthlyInt=c.apr/100/12*c.balance;
        return `<div class="flex-sb" style="padding:8px 0;border-top:1px solid var(--border);align-items:center">
          <div><div class="fw7 fs12">${esc(c.name)}</div><div class="fs11 text-red">${c.apr}% APR · ${fmt(c.balance)} balance · ~${fmt(Math.round(monthlyInt))}/mo interest</div></div>
          <button class="btn btn-primary btn-sm" onclick="addPayoffGoal('${c.id}')">Add Goal</button>
        </div>`;
      }).join('')}
    </div>`;
  }

  if(!S.goals.length){
    el.innerHTML=bannerHtml+`<div class="empty"><div class="empty-icon">🎯</div><div>No goals set yet.<br>Click "+ Add Goal" to get started.</div></div>`;
    return;
  }
  el.innerHTML=bannerHtml+S.goals.map(g=>{
    const progress=g.target>0?Math.min(g.current/g.target*100,100):0;
    const remaining=Math.max(0,g.target-g.current);
    const months=monthsLeft(g.targetDate);
    const monthly=months!==null&&months>0?remaining/months:null;
    const done=progress>=100;
    const overdue=months===0&&!done&&g.targetDate;

    return `<div class="card">
      <div class="flex-sb mb16">
        <div>
          <div style="font-size:17px;font-weight:800">${esc(g.name)}</div>
          ${g.targetDate?`<div class="text-muted fs12">Target: ${g.targetDate}${months!==null?' · '+months+' month'+(months!==1?'s':'')+' away':''}</div>`:''}
        </div>
        <div class="flex gap8">
          ${done?'<span class="badge badge-green">✓ Complete</span>':''}
          ${overdue?'<span class="badge badge-red">Overdue</span>':''}
          <button class="btn btn-ghost btn-sm" onclick="openGoalModal('${g.id}')">Edit</button>
          <button class="btn btn-danger btn-sm" onclick="deleteGoal('${g.id}')">Delete</button>
        </div>
      </div>

      <div class="flex-sb fs12 mb8">
        <span>${fmt(g.current)} saved</span>
        <span class="text-muted">of ${fmt(g.target)}</span>
      </div>
      <div class="bar-wrap bar-wrap-md">
        <div class="bar-fill" style="width:${progress}%;background:${done?'var(--green)':'linear-gradient(90deg,var(--accent),var(--purple))'}"></div>
      </div>

      <div class="g3 mt16">
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center">
          <div class="text-accent fw8" style="font-size:20px">${pct(progress)}</div>
          <div class="text-muted fs11 mt8">Complete</div>
        </div>
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center">
          <div class="fw8" style="font-size:20px">${fmt(remaining)}</div>
          <div class="text-muted fs11 mt8">Remaining</div>
        </div>
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center">
          ${monthly!==null
            ?`<div class="fw8" style="font-size:20px">${fmt(monthly)}</div><div class="text-muted fs11 mt8">Needed/month</div>`
            :overdue
              ?`<div class="text-red fw8" style="font-size:16px">Overdue</div><div class="text-muted fs11 mt8">Past target date</div>`
              :`<div class="text-muted fw8" style="font-size:20px">—</div><div class="text-muted fs11 mt8">No date set</div>`}
        </div>
      </div>
      ${(()=>{
        if(!g.vaultLinked) return '';
        const vaultEntry=(AnchorDB.virtualAccounts||[]).find(v=>v.id===g.vaultId);
        const vaultName=vaultEntry?vaultEntry.name:'Emergency Fund Vault';
        const vaultData=getVaultData(vaultName);
        if(!vaultData.transactions.length) return '';
        const nameEsc=vaultName.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
        const toRe=new RegExp('\\bto\\s+'+nameEsc,'i');
        const fromRe=new RegExp('\\bfrom\\s+'+nameEsc,'i');
        let running=0;
        const txWithRunning=vaultData.transactions.map(t=>{
          const desc=t.description||'';
          let delta;
          if(toRe.test(desc)) delta=Math.abs(t.amount);
          else if(fromRe.test(desc)) delta=-Math.abs(t.amount);
          else delta=-t.amount;
          running+=delta;
          return{...t,delta,runningBal:running};
        });
        const totalContrib=Object.values(vaultData.monthlyFlow).filter(v=>v>0).reduce((a,b)=>a+b,0);
        const moWithContrib=Object.values(vaultData.monthlyFlow).filter(v=>v>0).length||1;
        const avgMonthly=totalContrib/moWithContrib;
        const fundsNeeded=Math.max(0,g.target-g.current);
        const moToFund=fundsNeeded>0&&avgMonthly>0?Math.ceil(fundsNeeded/avgMonthly):null;
        return `<div class="mt16" style="border-top:1px solid var(--border);padding-top:16px">
          <div class="flex-sb mb10">
            <div class="fw7 fs13">↻ Vault Transaction History</div>
            <span class="badge badge-muted fs10">from ${esc(vaultName)} transactions</span>
          </div>
          <div class="g3 mb12" style="gap:8px">
            <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;text-align:center"><div class="fw7 text-green">${fmt(avgMonthly)}/mo</div><div class="text-muted fs11">Avg contribution</div></div>
            <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;text-align:center"><div class="fw7">${vaultData.transactions.length}</div><div class="text-muted fs11">Vault transactions</div></div>
            <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;text-align:center">${moToFund!==null?`<div class="fw7 text-accent">${moToFund} mo</div><div class="text-muted fs11">Est. fully funded</div>`:`<div class="fw7 text-green">✓</div><div class="text-muted fs11">Fully funded</div>`}</div>
          </div>
          <div class="tbl-wrap fs12">
            <table>
              <thead><tr><th>Date</th><th>Description</th><th>Change</th><th>Running Balance</th></tr></thead>
              <tbody>
                ${txWithRunning.slice(-10).reverse().map(t=>`<tr>
                  <td class="text-muted">${t.date||'—'}</td>
                  <td>${esc(t.description||'')}</td>
                  <td class="${t.delta>=0?'text-green':'text-red'}">${t.delta>=0?'+':'−'}${fmt(Math.abs(t.delta))}</td>
                  <td class="fw7">${fmt(Math.max(0,t.runningBal))}</td>
                </tr>`).join('')}
              </tbody>
            </table>
          </div>
          ${vaultData.transactions.length>10?`<div class="text-muted fs11 mt6 text-center">Showing last 10 of ${vaultData.transactions.length} vault transactions</div>`:''}
        </div>`;
      })()}
    </div>`;
  }).join('');
}

// ── SUBSCRIPTIONS ─────────────────────────────────────────────────────────────
const SUB_CLR={Streaming:'#8b5cf6',Software:'#3b82f6',Fitness:'#10b981',Finance:'#f59e0b',Other:'#6b7280'};
const CYCLE_LBL={weekly:'Weekly',monthly:'Monthly',quarterly:'Quarterly',annual:'Annual'};

function openSubModal(id){
  editId=id||null;
  const s=id?S.subs.find(x=>x.id===id):null;
  $('m-sub-title').textContent=id?'Edit Subscription':'Add Subscription';
  $('f-sub-name').value=s?s.name:'';
  $('f-sub-amount').value=s?s.amount:'';
  $('f-sub-cycle').value=s?s.cycle:'monthly';
  $('f-sub-cat').value=s?s.category:'Streaming';
  $('f-sub-date').value=s?s.nextBilling:'';
  if(!id) renderSubChips(); else { const c=$('sub-chips'); if(c) c.innerHTML=''; }
  openModal('m-sub');
}
function saveSub(){
  const name=$('f-sub-name').value.trim(); if(!name) return alert('Service name required.');
  const amount=parseFloat($('f-sub-amount').value)||0;
  const cycle=$('f-sub-cycle').value;
  const category=$('f-sub-cat').value;
  const nextBilling=$('f-sub-date').value;
  if(editId){ const s=S.subs.find(x=>x.id===editId); if(s){s.name=name;s.amount=amount;s.cycle=cycle;s.category=category;s.nextBilling=nextBilling} }
  else S.subs.push({id:uid(),name,amount,cycle,category,nextBilling,paused:false});
  save(); closeModal('m-sub'); renderSubs(); showSaveToast('Subscription saved');
}
async function deleteSub(id){ if(!await appConfirm('Delete subscription?',{danger:true,confirmText:'Delete'})) return; S.subs=S.subs.filter(x=>x.id!==id); save(); renderSubs() }
function togglePause(id){ const s=S.subs.find(x=>x.id===id); if(s){ s.paused=!s.paused; DataStore.sync('sub-pause'); } renderSubs(); }

function renderSubs(){
  const el=$('subs-body');
  const subSuggs=S.subSuggestions||[];
  if(!S.subs.length&&!subSuggs.length){
    el.innerHTML=`<div class="empty"><div class="empty-icon">🔄</div><div>No subscriptions added yet.<br>Click "+ Add Subscription" to get started.</div></div>`;
    return;
  }
  const active=S.subs.filter(s=>!s.paused);
  const paused=S.subs.filter(s=>s.paused);
  const burn=active.reduce((a,s)=>a+toMonthly(s.amount,s.cycle),0);
  const soon=S.subs.filter(s=>!s.paused&&daysUntil(s.nextBilling)<=7);

  // Category breakdown
  const byCat={};
  active.forEach(s=>{ byCat[s.category]=(byCat[s.category]||0)+toMonthly(s.amount,s.cycle) });

  const sorted=[...S.subs].sort((a,b)=>{
    if(a.paused!==b.paused) return a.paused?1:-1;
    return daysUntil(a.nextBilling)-daysUntil(b.nextBilling);
  });

  el.innerHTML=`
  ${soon.length>0?`<div class="alert alert-warn">⚡ <strong>${soon.length} subscription${soon.length!==1?'s':''}</strong> billing within the next 7 days: ${soon.map(s=>esc(s.name)).join(', ')}</div>`:''}
  ${subSuggs.length>0?`<div class="card mb16" style="border-left:3px solid var(--purple)">
    <div class="flex-sb mb12">
      <div><div class="fw7" style="color:var(--purple)">✦ ${subSuggs.length} Recurring Transaction${subSuggs.length!==1?'s':''} Detected</div>
      <div class="text-muted fs12">These merchants appear consistently each month with similar amounts. Add as subscriptions?</div></div>
      <button class="btn btn-ghost btn-xs" onclick="dismissAllSubSuggs()">Dismiss All</button>
    </div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Merchant</th><th>Avg Amount</th><th>Cycle</th><th>Months Seen</th><th>Next Est.</th><th></th></tr></thead>
      <tbody>${subSuggs.map(sg=>`<tr>
        <td class="fw7">${esc(sg.displayName)}</td>
        <td class="fw7">${fmt(sg.avgAmount)}</td>
        <td class="text-muted">${CYCLE_LBL[sg.cycle]||sg.cycle}</td>
        <td class="text-muted">${sg.months}×</td>
        <td class="text-muted fs12">${sg.nextDate||'—'}</td>
        <td><div class="flex gap6">
          <button class="btn btn-primary btn-xs" onclick="confirmSubSugg('${sg.id}')">Add</button>
          <button class="btn btn-ghost btn-xs" onclick="dismissSubSugg('${sg.id}')">Dismiss</button>
        </div></td>
      </tr>`).join('')}</tbody>
    </table></div>
  </div>`:''}

  <div class="g3 mb16">
    <div class="stat"><div class="stat-label">Monthly Burn</div><div class="stat-value text-red">${fmt(burn)}</div><div class="stat-sub">${fmt(burn*12)}/year</div></div>
    <div class="stat"><div class="stat-label">Active</div><div class="stat-value">${active.length}</div><div class="stat-sub">${paused.length} paused / considering cancellation</div></div>
    <div class="stat"><div class="stat-label">Billing Soon</div><div class="stat-value ${soon.length>0?'text-yellow':''}">${soon.length}</div><div class="stat-sub">within 7 days</div></div>
  </div>

  ${Object.keys(byCat).length>0?`
  <div class="card mb16">
    <div class="card-title mb16">Monthly Cost by Category</div>
    <div class="flex" style="flex-wrap:wrap;gap:10px">
      ${Object.entries(byCat).sort((a,b)=>b[1]-a[1]).map(([cat,amt])=>`
        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:10px 14px;display:flex;align-items:center;gap:8px">
          <span class="dot" style="background:${SUB_CLR[cat]}"></span>
          <span class="fs12 fw7">${cat}</span>
          <span style="color:${SUB_CLR[cat]};font-weight:800">${fmt(amt)}/mo</span>
        </div>`).join('')}
    </div>
  </div>`:'' }

  <div class="card">
    <div class="card-header"><div class="card-title">All Subscriptions</div><span class="text-muted fs12">Active first, sorted by billing date</span></div>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Service</th><th>Category</th><th>Amount</th><th>Cycle</th><th>Monthly</th><th>Next Billing</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          ${sorted.map(s=>{
            const d=daysUntil(s.nextBilling);
            const dStr=!s.nextBilling?'—':d<=0?'Today':d===1?'Tomorrow':d+' days';
            const billSoon=!s.paused&&d<=7&&d>=0;
            const adjBill=s.nextBilling?getActualPayday(s.nextBilling):null;const billDiffers=adjBill&&adjBill!==s.nextBilling;
            return `<tr style="${s.paused?'opacity:.5':''}">
              <td>
                <div class="flex gap8">
                  <span class="dot" style="background:${SUB_CLR[s.category]}"></span>
                  <span class="fw7">${esc(s.name)}</span>
                  ${billSoon?'<span class="badge badge-yellow" style="font-size:10px">Soon</span>':''}
                </div>
              </td>
              <td><span class="badge" style="background:${SUB_CLR[s.category]}22;color:${SUB_CLR[s.category]}">${s.category}</span></td>
              <td class="fw7">${fmt(s.amount)}</td>
              <td class="text-muted">${CYCLE_LBL[s.cycle]||s.cycle}</td>
              <td class="fw7">${fmt(toMonthly(s.amount,s.cycle))}</td>
              <td class="${billSoon?'text-yellow':'text-muted'}">
                ${dStr}
                ${s.nextBilling?`<br><span class="fs11">${adjBill||s.nextBilling}</span>${billDiffers?`<br><span class="fs10 text-muted">Sched: ${s.nextBilling}</span>`:''}`:``}
              </td>
              <td><span class="badge ${s.paused?'badge-yellow':'badge-green'}">${s.paused?'⏸ Paused':'▶ Active'}</span></td>
              <td>
                <div class="flex gap6" style="flex-wrap:wrap">
                  <button class="btn btn-ghost btn-xs" onclick="togglePause('${s.id}')">${s.paused?'Resume':'Pause'}</button>
                  <button class="btn btn-ghost btn-xs" onclick="openSubModal('${s.id}')">Edit</button>
                  <button class="btn btn-danger btn-xs" onclick="deleteSub('${s.id}')">Delete</button>
                </div>
              </td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>
  </div>`;
}

// ── BILLS ─────────────────────────────────────────────────────────────────────
const BILL_CAT_CLR={Phone:'#f59e0b',Internet:'#3b82f6',Utilities:'#10b981',Insurance:'#8b5cf6',Loans:'#ef4444',Rent:'#f97316',Other:'#6b7280'};

function openBillModal(id){
  editId=id||null;
  const b=id?(S.bills||[]).find(x=>x.id===id):null;
  $('m-bill-title').textContent=id?'Edit Bill':'Add Bill';
  $('f-bill-name').value=b?b.name:'';
  $('f-bill-amount').value=b?b.amount:'';
  $('f-bill-cycle').value=b?b.cycle:'monthly';
  $('f-bill-cat').value=b?b.category:'Phone';
  $('f-bill-date').value=b?b.nextDue:'';
  if(!id) renderBillChips(); else { const c=$('bill-chips'); if(c) c.innerHTML=''; }
  openModal('m-bill');
}
function saveBill(){
  const name=$('f-bill-name').value.trim(); if(!name) return alert('Bill name required.');
  const amount=parseFloat($('f-bill-amount').value)||0;
  const cycle=$('f-bill-cycle').value;
  const category=$('f-bill-cat').value;
  const nextDue=$('f-bill-date').value;
  if(!S.bills) S.bills=[];
  if(editId){ const b=S.bills.find(x=>x.id===editId); if(b){b.name=name;b.amount=amount;b.cycle=cycle;b.category=category;b.nextDue=nextDue;} }
  else S.bills.push({id:uid(),name,amount,cycle,category,nextDue,paused:false});
  save(); closeModal('m-bill'); renderBills(); showSaveToast('Bill saved');
}
async function deleteBill(id){ if(!await appConfirm('Delete this bill?',{danger:true,confirmText:'Delete'})) return; S.bills=S.bills.filter(x=>x.id!==id); save(); renderBills(); }
function toggleBillPause(id){ const b=(S.bills||[]).find(x=>x.id===id); if(b){ b.paused=!b.paused; DataStore.sync('bill-pause'); } renderBills(); }

function renderBills(){
  const el=$('bills-body');
  if(!el) return;
  const bills=S.bills||[];
  const billSuggs=S.billSuggestions||[];
  if(!bills.length&&!billSuggs.length){
    el.innerHTML=`<div class="empty"><div class="empty-icon">📋</div><div>No bills added yet.<br>Click "+ Add Bill" to track recurring charges, or import a CSV to auto-detect them.</div></div>`;
    return;
  }
  const active=bills.filter(b=>!b.paused);
  const paused=bills.filter(b=>b.paused);
  const burn=active.reduce((a,b)=>a+toMonthly(b.amount,b.cycle),0);
  const soon=bills.filter(b=>{if(b.paused)return false;const d=daysUntil(b.nextDue);return d>=0&&d<=7;});
  const byCat={};
  active.forEach(b=>{byCat[b.category]=(byCat[b.category]||0)+toMonthly(b.amount,b.cycle);});
  const sorted=[...bills].sort((a,b)=>{if(a.paused!==b.paused)return a.paused?1:-1;return daysUntil(a.nextDue)-daysUntil(b.nextDue);});

  el.innerHTML=`
  ${soon.length>0?`<div class="alert alert-warn">⚡ <strong>${soon.length} bill${soon.length!==1?'s':''}</strong> due within the next 7 days: ${soon.map(b=>esc(b.name)).join(', ')}</div>`:''}

  ${billSuggs.length>0?`<div class="card mb16" style="border-left:3px solid #06b6d4">
    <div class="flex-sb mb12">
      <div><div class="fw7" style="color:#06b6d4">✦ ${billSuggs.length} Recurring Bill${billSuggs.length!==1?'s':''} Detected</div>
      <div class="text-muted fs12">These fixed charges appear every month. Add them as tracked bills?</div></div>
      <button class="btn btn-ghost btn-xs" onclick="dismissAllBillSuggs()">Dismiss All</button>
    </div>
    <div class="tbl-wrap"><table>
      <thead><tr><th>Merchant</th><th>Avg Amount</th><th>Cycle</th><th>Months Seen</th><th>Next Est.</th><th></th></tr></thead>
      <tbody>${billSuggs.map(sg=>`<tr>
        <td class="fw7">${esc(sg.displayName)}</td>
        <td class="fw7">${fmt(sg.avgAmount)}</td>
        <td class="text-muted">${CYCLE_LBL[sg.cycle]||sg.cycle}</td>
        <td class="text-muted">${sg.months}×</td>
        <td class="text-muted fs12">${sg.nextDate||'—'}</td>
        <td><div class="flex gap6">
          <button class="btn btn-primary btn-xs" onclick="confirmBillSugg('${sg.id}')">Add</button>
          <button class="btn btn-ghost btn-xs" onclick="dismissBillSugg('${sg.id}')">Dismiss</button>
        </div></td>
      </tr>`).join('')}</tbody>
    </table></div>
  </div>`:''}

  ${bills.length>0?`
  <div class="g3 mb16">
    <div class="stat"><div class="stat-label">Monthly Burden</div><div class="stat-value text-red">${fmt(burn)}</div><div class="stat-sub">${fmt(burn*12)}/year</div></div>
    <div class="stat"><div class="stat-label">Active Bills</div><div class="stat-value">${active.length}</div><div class="stat-sub">${paused.length} paused</div></div>
    <div class="stat"><div class="stat-label">Due Soon</div><div class="stat-value ${soon.length>0?'text-yellow':''}">${soon.length}</div><div class="stat-sub">within 7 days</div></div>
  </div>
  ${Object.keys(byCat).length>0?`<div class="card mb16">
    <div class="card-title mb16">Monthly Cost by Category</div>
    <div class="flex" style="flex-wrap:wrap;gap:10px">
      ${Object.entries(byCat).sort((a,b)=>b[1]-a[1]).map(([cat,amt])=>`
        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);padding:10px 14px;display:flex;align-items:center;gap:8px">
          <span class="dot" style="background:${BILL_CAT_CLR[cat]||'#6b7280'}"></span>
          <span class="fs12 fw7">${cat}</span>
          <span style="color:${BILL_CAT_CLR[cat]||'#6b7280'};font-weight:800">${fmt(amt)}/mo</span>
        </div>`).join('')}
    </div>
  </div>`:''}
  <div class="card">
    <div class="card-header"><div class="card-title">All Bills</div><span class="text-muted fs12">Active first, sorted by due date</span></div>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Bill</th><th>Category</th><th>Amount</th><th>Cycle</th><th>Monthly</th><th>Next Due</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          ${sorted.map(b=>{
            const d=daysUntil(b.nextDue);
            const dStr=!b.nextDue?'—':d<=0?'Due today!':d===1?'Tomorrow':d+' days';
            const adjDue=b.nextDue?getActualPayday(b.nextDue):null;const dueDiffers=adjDue&&adjDue!==b.nextDue;
            const dueSoon=!b.paused&&d>=0&&d<=7;
            return `<tr style="${b.paused?'opacity:.5':''}">
              <td>
                <div class="flex gap8">
                  <span class="dot" style="background:${BILL_CAT_CLR[b.category]||'#6b7280'}"></span>
                  <span class="fw7">${esc(b.name)}</span>
                  ${dueSoon?'<span class="badge badge-yellow" style="font-size:10px">Soon</span>':''}
                </div>
              </td>
              <td><span class="badge" style="background:${BILL_CAT_CLR[b.category]||'#6b7280'}22;color:${BILL_CAT_CLR[b.category]||'#6b7280'}">${b.category}</span></td>
              <td class="fw7">${fmt(b.amount)}</td>
              <td class="text-muted">${CYCLE_LBL[b.cycle]||b.cycle}</td>
              <td class="fw7">${fmt(toMonthly(b.amount,b.cycle))}</td>
              <td class="${dueSoon?'text-yellow':'text-muted'}">${dStr}${b.nextDue?`<br><span class="fs11">${adjDue||b.nextDue}</span>${dueDiffers?`<br><span class="fs10 text-muted">Sched: ${b.nextDue}</span>`:''}`:''}</td>
              <td><span class="badge ${b.paused?'badge-yellow':'badge-green'}">${b.paused?'⏸ Paused':'▶ Active'}</span></td>
              <td><div class="flex gap6" style="flex-wrap:wrap">
                <button class="btn btn-ghost btn-xs" onclick="toggleBillPause('${b.id}')">${b.paused?'Resume':'Pause'}</button>
                <button class="btn btn-ghost btn-xs" onclick="openBillModal('${b.id}')">Edit</button>
                <button class="btn btn-danger btn-xs" onclick="deleteBill('${b.id}')">Delete</button>
              </div></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>
  </div>`:''}`;
}

// ── DATA SUMMARY ──────────────────────────────────────────────────────────────
function openDataSummary(){
  const months=Object.keys(S.archivedMonths||{});
  const accounts=[...new Set(S.transactions.map(t=>t.account).filter(Boolean))];
  let storageKB=0;
  try{storageKB=(localStorage.getItem('anchor_db')||localStorage.getItem('findash2')||'').length/1024;}catch(_){}
  const balAccts=Object.keys(S.balanceHistory||{});
  $('m-datasummary-body').innerHTML=`
  <div class="g4 mb16">
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw8" style="font-size:22px">${S.transactions.length}</div><div class="text-muted fs12 mt8">Transactions</div></div>
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw8" style="font-size:22px">${months.length}</div><div class="text-muted fs12 mt8">Months Archived</div></div>
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw8" style="font-size:22px">${accounts.length}</div><div class="text-muted fs12 mt8">Accounts</div></div>
    <div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center"><div class="fw8" style="font-size:22px">${storageKB.toFixed(1)}</div><div class="text-muted fs12 mt8">KB Used</div></div>
  </div>
  ${months.length?`<div class="divider"></div>
  <div style="font-size:13px;font-weight:600;margin-bottom:8px">Archived Months</div>
  <div style="max-height:200px;overflow-y:auto" class="tbl-wrap"><table>
    <thead><tr><th>Month</th><th>Account</th><th>Transactions</th></tr></thead>
    <tbody>${[...months].sort().map(k=>{const[mo,acct]=k.split('|');return `<tr><td class="fw7">${mo}</td><td class="text-muted">${esc(acct)}</td><td>${(S.archivedMonths[k]||{}).count||0}</td></tr>`;}).join('')}</tbody>
  </table></div>`:''}
  <div class="divider"></div>
  <div class="text-muted fs12">Merchant rules: ${Object.keys(S.merchantRules||{}).length} · Balance history: ${balAccts.length} account${balAccts.length!==1?'s':''} · Cards: ${S.cards.length} · Goals: ${S.goals.length} · Subscriptions: ${S.subs.length} · Bills: ${(S.bills||[]).length} · Investments: ${(S.investments||[]).length}</div>`;
  openModal('m-datasummary');
}

async function clearAllData(){
  if(!await appConfirm('Permanently delete ALL data — transactions, cards, goals, subscriptions, settings? This cannot be undone.',{danger:true,confirmText:'Delete everything'})) return;
  if(!await appConfirm('Are you absolutely sure? This will wipe everything.',{danger:true,confirmText:'Delete everything'})) return;
  DataStore._reset();
  localStorage.removeItem('anchor_db');
  localStorage.removeItem('findash2');
  save();
  closeModal('m-datasummary');
  go(activeTab);
}

// ── INVESTMENTS ───────────────────────────────────────────────────────────────
const INVEST_TYPE_LBL={crypto:'Crypto',stocks:'Stocks & ETFs','401k':'401(k)',roth:'Roth IRA',trad_ira:'Traditional IRA',brokerage:'Brokerage',mixed:'Mixed Portfolio',metals:'Precious Metals',bonds:'Bonds',realestate:'Real Estate',other:'Other'};
const INVEST_TYPE_CLR={crypto:'#f59e0b',stocks:'#3b82f6','401k':'#6366f1',roth:'#8b5cf6',trad_ira:'#a78bfa',brokerage:'#22c55e',mixed:'#ec4899',metals:'#d4af37',bonds:'#10b981',realestate:'#f97316',other:'#6b7280'};
const INVEST_PLATFORM_LBL={coinbase:'Coinbase',cryptocom:'Crypto.com',webull:'Webull',fidelity:'Fidelity',vanguard:'Vanguard',robinhood:'Robinhood',etrade:'E*Trade',schwab:'Schwab',kraken:'Kraken',binance:'Binance',other:'Other'};

let _investUpdateId=null;
let _webullPending=null;

function _latestInvEntry(inv){
  if(!inv.history||!inv.history.length) return null;
  return inv.history.reduce((a,b)=>a.date>=b.date?a:b);
}
function _syncInvValue(inv){
  if(!inv.history||!inv.history.length) return;
  inv.history.sort((a,b)=>a.date.localeCompare(b.date));
  inv.value=inv.history[inv.history.length-1].value;
}

function openInvestModal(id){
  editId=id||null;
  const inv=id?(S.investments||[]).find(x=>x.id===id):null;
  $('m-invest-title').textContent=id?'Edit Investment Account':'Add Investment Account';
  $('f-invest-name').value=inv?inv.name:'';
  $('f-invest-platform').value=inv&&inv.platform?inv.platform:'';
  $('f-invest-type').value=inv&&inv.investType?inv.investType:'crypto';
  $('f-invest-value').value=inv?inv.value:'';
  $('f-invest-cost').value=inv&&inv.costBasis?inv.costBasis:'';
  $('f-invest-notes').value=inv&&inv.notes?inv.notes:'';
  if(!id) renderInvestChips(); else { const c=$('invest-chips'); if(c) c.innerHTML=''; }
  openModal('m-invest');
}

function saveInvest(){
  const name=$('f-invest-name').value.trim(); if(!name) return alert('Account name required.');
  const platform=$('f-invest-platform').value;
  const investType=$('f-invest-type').value;
  const value=parseFloat($('f-invest-value').value)||0;
  const costBasis=parseFloat($('f-invest-cost').value)||0;
  const notes=$('f-invest-notes').value.trim();
  if(!S.investments) S.investments=[];
  if(editId){
    const inv=S.investments.find(x=>x.id===editId);
    if(inv){
      const wasValue=inv.value;
      inv.name=name;inv.platform=platform;inv.investType=investType;inv.value=value;inv.costBasis=costBasis;inv.notes=notes;
      if(value!==wasValue&&value>0){
        if(!inv.history) inv.history=[];
        const today=new Date().toISOString().split('T')[0];
        const ei=inv.history.findIndex(e=>e.date===today);
        if(ei>=0) inv.history[ei].value=value; else inv.history.push({date:today,value});
        _syncInvValue(inv);
      }
    }
  } else {
    const today=new Date().toISOString().split('T')[0];
    const history=value>0?[{date:today,value}]:[];
    S.investments.push({id:uid(),name,platform,investType,value,costBasis,notes,history});
  }
  syncInvestToAssets();
  save(); closeModal('m-invest'); renderInvest(); showSaveToast('Investment account saved');
}

async function deleteInvest(id){
  if(!await appConfirm('Delete this investment account?',{danger:true,confirmText:'Delete'})) return;
  S.investments=S.investments.filter(x=>x.id!==id);
  syncInvestToAssets();
  save(); renderInvest();
}

function syncInvestToAssets(){
  const today=new Date().toISOString().split('T')[0];
  S.assets=S.assets.filter(a=>a._investId===undefined);
  (S.investments||[]).forEach(inv=>{
    const latest=_latestInvEntry(inv);
    const val=latest?latest.value:(inv.value||0);
    S.assets.push({id:'inv_'+inv.id,_investId:inv.id,name:inv.name,type:'investments',value:val,autoSync:true,syncSource:'invest',lastSynced:today});
  });
}

function calcInvestMoM(){
  const invs=S.investments||[];
  let currentTotal=0,priorTotal=0,hasPrior=false;
  invs.forEach(inv=>{
    const latest=_latestInvEntry(inv);
    if(!latest){currentTotal+=inv.value||0;return;}
    currentTotal+=latest.value;
    if(!inv.history||inv.history.length<2) return;
    // Find entry closest to 30 days before the latest entry's own date
    const latestMs=new Date(latest.date).getTime();
    const targetMs=latestMs-30*24*60*60*1000;
    const others=inv.history.filter(e=>e.date!==latest.date);
    if(!others.length) return;
    const prior=others.reduce((best,e)=>
      Math.abs(new Date(e.date).getTime()-targetMs)<Math.abs(new Date(best.date).getTime()-targetMs)?e:best
    );
    priorTotal+=prior.value;
    hasPrior=true;
  });
  if(!hasPrior||currentTotal===0) return null;
  const change=currentTotal-priorTotal;
  const changePct=priorTotal>0?((currentTotal/priorTotal-1)*100):null;
  return {current:currentTotal,prior:priorTotal,change,changePct};
}

function buildPortfolioChartData(invs){
  if(!invs.length) return null;
  const dateSet=new Set();
  invs.forEach(inv=>(inv.history||[]).forEach(e=>dateSet.add(e.date)));
  const dates=[...dateSet].sort();
  if(dates.length<2) return null;
  const datasets=invs.filter(inv=>(inv.history||[]).length>=2).map(inv=>({
    label:inv.name,
    data:dates.map(d=>{
      const entries=(inv.history||[]).filter(e=>e.date<=d);
      return entries.length?entries[entries.length-1].value:null;
    }),
    borderColor:INVEST_TYPE_CLR[inv.investType]||'#6366f1',
    backgroundColor:'transparent',tension:.3,pointRadius:2,fill:false,borderWidth:2,spanGaps:true
  }));
  const combinedData=dates.map(d=>{
    let total=0;
    invs.forEach(inv=>{
      const entries=(inv.history||[]).filter(e=>e.date<=d);
      if(entries.length) total+=entries[entries.length-1].value;
    });
    return total;
  });
  datasets.unshift({label:'Total Portfolio',data:combinedData,borderColor:'#6C63FF',backgroundColor:'rgba(108,99,255,0.08)',tension:.3,pointRadius:2,fill:true,borderWidth:3,spanGaps:true,order:-1});
  return {labels:dates,datasets};
}

function openUpdateValueModal(id){
  const inv=(S.investments||[]).find(x=>x.id===id); if(!inv) return;
  _investUpdateId=id;
  $('m-invest-update-title').textContent='Update: '+inv.name;
  const _latestForModal=_latestInvEntry(inv);
  $('f-update-value').value=_latestForModal?_latestForModal.value:(inv.value||'');
  $('f-update-date').value=new Date().toISOString().split('T')[0];
  $('f-update-note').value='';
  openModal('m-invest-update');
}

function saveUpdateValue(){
  const inv=(S.investments||[]).find(x=>x.id===_investUpdateId); if(!inv) return;
  const value=parseFloat($('f-update-value').value);
  if(isNaN(value)||value<0) return alert('Enter a valid value.');
  const date=$('f-update-date').value||new Date().toISOString().split('T')[0];
  const note=$('f-update-note').value.trim();
  if(!inv.history) inv.history=[];
  const entry={date,value};
  if(note) entry.note=note;
  const ei=inv.history.findIndex(e=>e.date===date);
  if(ei>=0) inv.history[ei]=entry; else inv.history.push(entry);
  _syncInvValue(inv);
  syncInvestToAssets();
  autoLogNW();
  save(); closeModal('m-invest-update'); renderInvest(); showSaveToast('Value updated');
}

function openValueHistoryModal(id){
  const inv=(S.investments||[]).find(x=>x.id===id); if(!inv) return;
  $('m-invest-history-title').textContent=inv.name+' — Value History';
  const hist=[...(inv.history||[])].sort((a,b)=>b.date.localeCompare(a.date));
  $('invest-history-body').innerHTML=
    (hist.length>=2?'<div class="chart-wrap mb16" style="height:160px"><canvas id="history-modal-chart"></canvas></div>':'')+
    (hist.length===0?'<div class="text-muted fs12" style="text-align:center;padding:24px 0">No history entries yet.</div>':
    '<table class="invest-history-tbl"><thead><tr><th>Date</th><th>Value</th><th>Note</th><th></th></tr></thead><tbody>'+
    hist.map(e=>'<tr><td>'+e.date+'</td><td class="fw7 text-green">'+fmt(e.value)+'</td><td class="text-muted">'+esc(e.note||'')+'</td><td><span class="invest-history-del" onclick="deleteHistoryEntry(\''+id+'\',\''+e.date+'\')">Remove</span></td></tr>').join('')+
    '</tbody></table>');
  openModal('m-invest-history');
  if(hist.length>=2){
    setTimeout(()=>{
      const ctx=$('history-modal-chart'); if(!ctx) return;
      const sorted=[...hist].sort((a,b)=>a.date.localeCompare(b.date));
      const color=INVEST_TYPE_CLR[inv.investType]||'#6366f1';
      new Chart(ctx,{type:'line',data:{labels:sorted.map(e=>e.date),datasets:[{data:sorted.map(e=>e.value),borderColor:color,backgroundColor:color+'22',fill:true,tension:.3,pointRadius:3,pointBackgroundColor:color}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>fmt(c.raw)}}},scales:{x:{ticks:{font:{size:10},maxTicksLimit:6}},y:{ticks:{font:{size:10},callback:v=>'$'+v.toLocaleString()},grid:{color:'rgba(255,255,255,0.05)'}}}}});
    },100);
  }
}

function deleteHistoryEntry(invId,date){
  const inv=(S.investments||[]).find(x=>x.id===invId); if(!inv||!inv.history) return;
  inv.history=inv.history.filter(e=>e.date!==date);
  _syncInvValue(inv);
  syncInvestToAssets();
  save(); openValueHistoryModal(invId); renderInvest();
}

function detectWebullSummary(rows){
  for(let i=0;i<Math.min(rows.length,5);i++){
    const r=rows[i];
    if(r.some(c=>/Assets Held In Webull/i.test(String(c)))) return true;
    if(r.some(c=>/Total\(Combined Assets\)/i.test(String(c)))) return true;
  }
  return false;
}

function _parseWebullDate(str){
  const m=/(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+(\d{1,2})[,\s]+(\d{4})/i.exec(str||'');
  if(!m) return '';
  const months={jan:'01',feb:'02',mar:'03',apr:'04',may:'05',jun:'06',jul:'07',aug:'08',sep:'09',oct:'10',nov:'11',dec:'12'};
  const mo=months[m[1].toLowerCase()]||'01';
  return m[3]+'-'+mo+'-'+m[2].padStart(2,'0');
}

function parseWebullSummary(rows,acctName){
  let priorLabel='',currentLabel='',priorDate='',currentDate='';
  let priorTotal=null,currentTotal=null;
  const breakdown=[];
  const row0=rows[0]||[];
  for(let i=0;i<row0.length;i++){
    const cell=String(row0[i]||'');
    if(/Prior Month:/i.test(cell)){priorLabel=cell.replace(/Prior Month:\s*/i,'').trim();priorDate=_parseWebullDate(priorLabel);}
    if(/Current Month:/i.test(cell)){currentLabel=cell.replace(/Current Month:\s*/i,'').trim();currentDate=_parseWebullDate(currentLabel);}
  }
  for(let i=1;i<rows.length;i++){
    const r=rows[i]; if(!r||!r.length) continue;
    const label=String(r[0]||'').trim();
    if(/Total\(Combined Assets\)/i.test(label)){
      priorTotal=parseFloat(String(r[1]||'').replace(/[,$+]/g,''));
      currentTotal=parseFloat(String(r[4]||r[3]||'').replace(/[,$+]/g,''));
    } else if(label&&!/(Assets Held|Total|Long|Short|Change)/i.test(label)){
      const pv=parseFloat(String(r[1]||'').replace(/[,$+\-]/g,''));
      const cv=parseFloat(String(r[4]||r[3]||'').replace(/[,$+\-]/g,''));
      if(!isNaN(pv)||!isNaN(cv)) breakdown.push({label,prior:isNaN(pv)?null:pv,current:isNaN(cv)?null:cv});
    }
  }
  return {acctName,priorDate,currentDate,priorLabel,currentLabel,priorTotal,currentTotal,breakdown};
}

function showWebullConfirm(data){
  _webullPending=data;
  const chg=data.currentTotal!==null&&data.priorTotal!==null?data.currentTotal-data.priorTotal:null;
  const chgPct=chg!==null&&data.priorTotal>0?((data.currentTotal/data.priorTotal-1)*100):null;
  $('webull-confirm-body').innerHTML=
    '<div class="g2 mb16">'+
    '<div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center">'+
    '<div class="text-muted fs11 mb6">'+(data.priorLabel||'Prior Month')+'</div>'+
    '<div class="fw8" style="font-size:20px">'+(data.priorTotal!==null?fmt(data.priorTotal):'&mdash;')+'</div></div>'+
    '<div style="background:var(--surface2);border-radius:var(--r-sm);padding:14px;text-align:center">'+
    '<div class="text-muted fs11 mb6">'+(data.currentLabel||'Current Month')+'</div>'+
    '<div class="fw8 text-green" style="font-size:20px">'+(data.currentTotal!==null?fmt(data.currentTotal):'&mdash;')+'</div>'+
    (chg!==null?'<div class="fs12 mt4 '+(chg>=0?'text-green':'text-red')+'">'+(chg>=0?'+':'')+fmt(chg)+(chgPct!==null?' ('+pct(chgPct)+')':"")+'</div>':'')+
    '</div></div>'+
    (data.breakdown.length?
    '<div class="mb16"><table style="width:100%;font-size:12px;border-collapse:collapse">'+
    '<thead><tr><th style="text-align:left;padding:6px 8px;color:var(--dim)">Asset</th>'+
    '<th style="text-align:right;padding:6px 8px;color:var(--dim)">'+(data.priorLabel||'Prior')+'</th>'+
    '<th style="text-align:right;padding:6px 8px;color:var(--dim)">'+(data.currentLabel||'Current')+'</th></tr></thead><tbody>'+
    data.breakdown.map(b=>'<tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px">'+esc(b.label)+'</td>'+
    '<td style="padding:6px 8px;text-align:right">'+(b.prior!==null?fmt(b.prior):'&mdash;')+'</td>'+
    '<td style="padding:6px 8px;text-align:right;font-weight:700">'+(b.current!==null?fmt(b.current):'&mdash;')+'</td></tr>').join('')+
    '</tbody></table></div>':'')+
    '<div class="text-muted fs12">This will update your <strong>'+esc(data.acctName||'Webull')+'</strong> account value'+(data.currentDate?' and log a history entry for '+data.currentDate:'')+'.</div>';
  openModal('m-webull-confirm');
}

function applyWebullSummary(){
  const data=_webullPending; if(!data) return;
  if(!S.investments) S.investments=[];
  let inv=S.investments.find(x=>(x.name||'').toLowerCase().includes('webull'));
  if(!inv){
    inv={id:uid(),name:data.acctName||'Webull',platform:'webull',investType:'stocks',value:0,costBasis:0,notes:'',history:[]};
    S.investments.push(inv);
  }
  if(!inv.history) inv.history=[];
  if(data.priorDate&&data.priorTotal!==null){
    const ei=inv.history.findIndex(e=>e.date===data.priorDate);
    if(ei>=0) inv.history[ei].value=data.priorTotal; else inv.history.push({date:data.priorDate,value:data.priorTotal,note:'Webull statement'});
  }
  if(data.currentDate&&data.currentTotal!==null){
    const ei=inv.history.findIndex(e=>e.date===data.currentDate);
    if(ei>=0) inv.history[ei].value=data.currentTotal; else inv.history.push({date:data.currentDate,value:data.currentTotal,note:'Webull statement'});
  }
  _syncInvValue(inv);
  syncInvestToAssets();
  autoLogNW();
  _webullPending=null;
  save(); closeModal('m-webull-confirm'); renderInvest();
  showSaveToast('Webull portfolio updated');
}

function parseInvestCSV(e){
  const f=e.target.files[0]; if(!f) return;
  if($('investCsvFile')) $('investCsvFile').value='';
  if(f.name.toLowerCase().endsWith('.pdf')){
    openPDFFlow(f,'invest','auto','');
    return;
  }
  pendingInvestFile=f;
  $('f-invest-fmt').value='auto';
  $('f-invest-acct').value='';
  openModal('m-invest-bank');
}

function detectInvestFormat(headers){
  const h=headers.map(x=>x.toLowerCase().trim());
  if(h.some(x=>x==='asset')&&h.some(x=>x==='quantity')) return 'generic';
  if(h.some(x=>x==='currency')&&h.some(x=>/transaction type/i.test(x))&&h.some(x=>x.includes('native'))) return 'cryptocom';
  if(h.some(x=>x==='asset')&&h.some(x=>x==='type')&&!h.some(x=>x.includes('native'))) return 'coinbase';
  if(h.some(x=>/symbol|ticker/.test(x))&&h.some(x=>/market value|current value/.test(x))) return 'holdings';
  if(h.some(x=>/trade date|activity type/.test(x))) return 'txhistory';
  return 'generic';
}

function inferInvestType(desc){
  const d=(desc||'').toUpperCase();
  const cryptoTokens=['BTC','ETH','SOL','ADA','DOGE','XRP','LTC','MATIC','AVAX','DOT','USDC','USDT','LINK','UNI','SHIB'];
  if(cryptoTokens.some(t=>d.includes(t))) return 'crypto';
  const stockTokens=['SPY','VTI','QQQ','AAPL','MSFT','AMZN','GOOG','TSLA','NVDA','META','AMD','VOO'];
  if(stockTokens.some(t=>d.includes(t))) return 'stocks';
  if(/GOLD|SILVER|PLATINUM|GLD|SLV/.test(d)) return 'metals';
  return 'stocks';
}

function doParseInvest(){
  const f=pendingInvestFile; if(!f) return;
  const forceFmt=$('f-invest-fmt').value;
  const acctLabel=$('f-invest-acct').value.trim()||'Imported Portfolio';
  closeModal('m-invest-bank');
  pendingInvestFile=null;

  Papa.parse(f,{header:false,skipEmptyLines:true,complete(res){
    const raw=res.data; if(!raw.length) return alert('No data found.');
    // Webull portfolio summary detection — already has its own review/confirm modal
    if(forceFmt==='auto'||forceFmt==='webull'){
      if(detectWebullSummary(raw)){
        const data=parseWebullSummary(raw,acctLabel==='Imported Portfolio'?'Webull':acctLabel);
        if(data.currentTotal!==null){ showWebullConfirm(data); return; }
      }
    }
    let hi=-1;
    for(let i=0;i<Math.min(raw.length,10);i++){
      const cells=raw[i].map(c=>String(c).trim().toLowerCase());
      if(cells.some(c=>/date|time|timestamp/.test(c))&&cells.length>2){hi=i;break;}
    }
    if(hi<0){
      return alert('Could not find a header row with a Date/Time/Timestamp column in this file. Try picking a specific platform format from the dropdown instead of Auto-detect.');
    }
    const headers=raw[hi].map(c=>String(c).trim());
    const rows=raw.slice(hi+1).map(r=>{const obj={};headers.forEach((h,i)=>{obj[h]=String(r[i]||'').trim();});return obj;});
    if(!rows.length) return alert('No data rows found.');
    const fmt2=forceFmt==='auto'?detectInvestFormat(headers):forceFmt;

    const keys=Object.keys(rows[0]);
    const find=fn=>keys.find(k=>fn(k.toLowerCase().trim()));
    const byDate={}; // later rows win on same-date collision, matching prior behavior
    rows.forEach(row=>{
      let balance=null,dateStr='',desc='';
      if(fmt2==='coinbase'){
        dateStr=row[find(k=>/timestamp|date/.test(k))]||'';
        desc=(row[find(k=>k==='asset')]||'')+(row[find(k=>/notes|transaction type/.test(k))]||'');
        balance=parseFloat((row[find(k=>/subtotal|balance|total/.test(k))]||'').replace(/[$,]/g,''));
      } else if(fmt2==='cryptocom'){
        dateStr=row[find(k=>/timestamp|date/.test(k))]||'';
        desc=row[find(k=>/transaction type|description/.test(k))]||'';
        balance=parseFloat((row[find(k=>/native.*amount|amount.*native/i.test(k)?k:'')] ||row[find(k=>/balance/i.test(k)?k:'')] ||'').replace(/[$,]/g,''));
      } else {
        dateStr=row[find(k=>/date/.test(k))]||'';
        desc=(row[find(k=>/asset|symbol|description/.test(k))]||'');
        balance=parseFloat((row[find(k=>/balance|value|total/.test(k))]||'').replace(/[$,]/g,''));
      }
      const nd=normalizeDate(dateStr);
      if(nd&&!isNaN(balance)&&balance!==null){
        byDate[nd]={date:nd,value:balance,desc,include:true};
      }
    });
    const pending=Object.values(byDate).sort((a,b)=>a.date.localeCompare(b.date));
    if(!pending.length){
      return alert(`Could not find any recognizable date/balance rows in this file (detected format: ${fmt2}). Try a different platform format from the dropdown, or confirm the file has Date and Balance/Value columns.`);
    }

    _csvPendingRows=pending;
    _csvPendingKind='invest';
    _csvPendingMeta={acctLabel,fmt2};
    showInvestCSVPreview();
  },error(){alert('Failed to parse CSV.')}});
}

// PREVIEW — investment CSV (portfolio balance history)
function _csvInvestPreviewRows(rows){
  return rows.map(r=>`<tr>
    <td class="text-muted" style="white-space:nowrap">${esc(r.date)}</td>
    <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(r.desc)}">${esc(r.desc)||'—'}</td>
    <td class="fw7" style="white-space:nowrap">${fmt(r.value)}</td>
    <td style="text-align:center"><input type="checkbox" ${r.include?'checked':''} onchange="_csvPendingRows[${r._i}].include=this.checked"></td>
  </tr>`).join('');
}
function showInvestCSVPreview(){
  const body=$('csv-preview-body'), actions=$('csv-preview-actions');
  const rows=_csvPendingRows, meta=_csvPendingMeta; // already sorted ascending by date
  const latest=rows[rows.length-1];
  const existing=(S.investments||[]).find(x=>x.name.toLowerCase()===meta.acctLabel.toLowerCase());
  const startIdx=Math.max(0,rows.length-10);
  const preview=rows.slice(startIdx).map((r,idx)=>({...r,_i:startIdx+idx})).reverse();
  body.innerHTML=`
    <div style="margin-bottom:14px">
      <div class="fw7 mb2" style="font-size:15px">${esc(meta.acctLabel)}</div>
      <div class="text-muted fs12">${rows.length} balance entr${rows.length!==1?'ies':'y'} found${existing?' · updating existing account':' · will create a new account'}</div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:12px">
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Latest Value</div><div class="stat-value text-green" style="font-size:18px">${latest?fmt(latest.value):'--'}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">As Of</div><div class="stat-value" style="font-size:14px;margin-top:4px">${latest?latest.date:'--'}</div></div>
    </div>
    <div class="fw7 mb8 fs13">Preview <span class="text-muted fw4 fs11">(most recent ${preview.length} of ${rows.length})</span></div>
    <div class="tbl-wrap" style="max-height:220px;overflow-y:auto;margin-bottom:8px;border:1px solid var(--border);border-radius:var(--r-sm)">
      <table class="pdf-preview-tbl">
        <thead><tr><th>Date</th><th>Note</th><th>Value</th><th style="text-align:center">Include</th></tr></thead>
        <tbody>${_csvInvestPreviewRows(preview)}</tbody>
      </table>
    </div>
    <div class="text-muted fs11">Only checked rows are saved as history entries; the most recent checked entry sets the account's current value.</div>`;
  actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-csv-preview')">Cancel</button>
    <button class="btn btn-primary" onclick="importInvestCSV()">Import ${rows.filter(r=>r.include).length} Entries</button>`;
  openModal('m-csv-preview');
}

// COMMIT — investment CSV (creates the account here, not at parse time, so
// cancelling the preview never leaves a phantom zero-value account behind)
function importInvestCSV(){
  const meta=_csvPendingMeta;
  const toImport=_csvPendingRows.filter(r=>r.include);
  if(!toImport.length){closeModal('m-csv-preview');showSaveToast('No entries selected');return;}

  if(!S.investments) S.investments=[];
  let inv=S.investments.find(x=>x.name.toLowerCase()===meta.acctLabel.toLowerCase());
  if(!inv){
    inv={id:uid(),name:meta.acctLabel,platform:meta.fmt2==='coinbase'?'coinbase':meta.fmt2==='cryptocom'?'cryptocom':meta.fmt2==='webull'?'webull':meta.fmt2==='fidelity'?'fidelity':'',investType:'mixed',value:0,costBasis:0,notes:'',history:[]};
    S.investments.push(inv);
  }
  if(!inv.history) inv.history=[];
  toImport.forEach(r=>{
    const ei=inv.history.findIndex(e=>e.date===r.date);
    if(ei>=0) inv.history[ei].value=r.value; else inv.history.push({date:r.date,value:r.value});
    if(r.desc&&(!inv.investType||inv.investType==='mixed')){
      const t=inferInvestType(r.desc);
      if(t!=='stocks') inv.investType=t;
    }
  });
  _syncInvValue(inv);
  syncInvestToAssets();
  autoLogNW();
  save(); renderInvest();
  closeModal('m-csv-preview');
  alert('Investment CSV imported. '+meta.acctLabel+' updated to '+fmt(inv.value||0)+'.');
}

function renderInvest(){
  const el=$('invest-body'); if(!el) return;
  const invs=S.investments||[];
  const totalValue=invs.reduce((a,x)=>a+((_latestInvEntry(x)||{value:x.value||0}).value),0);
  const totalCost=invs.reduce((a,x)=>a+(x.costBasis||0),0);
  const totalGain=totalValue-totalCost;
  const mom=calcInvestMoM();

  if(invs.length===0){
    el.innerHTML='<div class="empty"><div class="empty-icon">&#x1F4C8;</div><div>No investment accounts added yet.<br>Click &quot;+ Add Account&quot; to get started, or upload a CSV from your broker.</div></div>';
    return;
  }

  const statsHTML='<div class="invest-stat-grid mb16">'+
    '<div class="stat"><div class="stat-label">Total Portfolio</div><div class="stat-value text-green">'+fmt(totalValue)+'</div><div class="stat-sub">'+invs.length+' account'+(invs.length!==1?'s':'')+'</div></div>'+
    '<div class="stat"><div class="stat-label">Cost Basis</div><div class="stat-value">'+(totalCost?fmt(totalCost):'&mdash;')+'</div><div class="stat-sub">'+(totalCost?'Amount invested':'Not set')+'</div></div>'+
    '<div class="stat"><div class="stat-label">Total Return</div><div class="stat-value '+(totalCost?(totalGain>=0?'text-green':'text-red'):'')+'">'+
    (totalCost?(totalGain>=0?'+':'')+fmt(totalGain):'&mdash;')+'</div><div class="stat-sub">'+
    (totalCost&&totalValue?pct((totalValue/totalCost-1)*100)+' return':'Set cost basis')+'</div></div>'+
    '<div class="stat"><div class="stat-label">MoM Change</div><div class="stat-value '+(mom?(mom.change>=0?'text-green':'text-red'):'')+'">'+
    (mom?(mom.change>=0?'+':'')+fmt(mom.change):'&mdash;')+'</div><div class="stat-sub">'+
    (mom&&mom.changePct!==null?pct(mom.changePct)+' vs 30d ago':'No history yet')+'</div></div>'+
    '</div>';

  const chartData=buildPortfolioChartData(invs);
  const chartHTML=chartData?
    '<div class="card mb16"><div class="flex-sb mb12"><div class="card-title">Portfolio Value</div><div class="text-muted fs11">All accounts combined</div></div>'+
    '<div class="invest-portfolio-chart"><canvas id="invest-portfolio-chart"></canvas></div></div>':'';

  const cardsHTML='<div class="g'+Math.min(invs.length,2)+' mb16">'+
    invs.map(inv=>{
      const sortedHist=inv.history?[...inv.history].sort((a,b)=>a.date.localeCompare(b.date)):[];
      const latestEntry=sortedHist.length?sortedHist[sortedHist.length-1]:null;
      const currentVal=latestEntry?latestEntry.value:(inv.value||0);
      const asOfDate=latestEntry?latestEntry.date:'';
      const gain=currentVal-(inv.costBasis||0);
      const gainPct=inv.costBasis>0?((currentVal/inv.costBasis-1)*100):null;
      const hasMeta=inv.platform||inv.notes;
      const prevEntry=sortedHist.length>=2?sortedHist[sortedHist.length-2]:null;
      const invChange=latestEntry&&prevEntry?latestEntry.value-prevEntry.value:null;
      return '<div class="card">'+
        '<div class="card-header mb10"><div>'+
        '<div class="flex gap8" style="align-items:center;margin-bottom:4px">'+
        '<span class="dot" style="background:'+(INVEST_TYPE_CLR[inv.investType]||'#6b7280')+'"></span>'+
        '<span class="fw7" style="font-size:15px">'+esc(inv.name)+'</span>'+
        '<span class="badge" style="background:'+(INVEST_TYPE_CLR[inv.investType]||'#6b7280')+'22;color:'+(INVEST_TYPE_CLR[inv.investType]||'#6b7280')+'">'+(INVEST_TYPE_LBL[inv.investType]||inv.investType)+'</span>'+
        '</div>'+
        (hasMeta?'<div class="text-muted fs12">'+(inv.platform?INVEST_PLATFORM_LBL[inv.platform]||inv.platform:'')+(inv.platform&&inv.notes?' &middot; ':'')+esc(inv.notes||'')+'</div>':'')+
        '</div><div class="flex gap6">'+
        '<button class="btn btn-ghost btn-xs" onclick="openInvestModal(\''+inv.id+'\')">Edit</button>'+
        '<button class="btn btn-danger btn-xs" onclick="deleteInvest(\''+inv.id+'\')">Delete</button>'+
        '</div></div>'+
        '<div class="g3 mb4">'+
        '<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center">'+
        '<div class="text-green fw8" style="font-size:18px">'+fmt(currentVal)+'</div>'+
        '<div class="text-muted fs11 mt4">Current Value</div>'+
        (asOfDate?'<div style="font-size:10px;color:var(--dim);margin-top:2px">as of '+asOfDate+'</div>':'')+
        '</div>'+
        '<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="fw8" style="font-size:18px">'+(inv.costBasis?fmt(inv.costBasis):'&mdash;')+'</div><div class="text-muted fs11 mt4">Cost Basis</div></div>'+
        '<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;text-align:center"><div class="'+(gainPct!==null?(gainPct>=0?'text-green':'text-red'):'')+' fw8" style="font-size:18px">'+(gainPct!==null?(gainPct>=0?'+':'')+pct(gainPct):'&mdash;')+'</div><div class="text-muted fs11 mt4">Return</div></div>'+
        '</div>'+
        (invChange!==null?'<div class="fs12 text-muted mb6" style="text-align:right">Last change: <span class="'+(invChange>=0?'text-green':'text-red')+'">'+(invChange>=0?'+':'')+fmt(invChange)+'</span></div>':'')+
        (inv.history&&inv.history.length>1?'<div class="invest-sparkline"><canvas id="invest-spark-'+inv.id+'"></canvas></div>':'')+
        '<div class="invest-card-actions">'+
        '<button class="btn btn-primary btn-sm" onclick="openUpdateValueModal(\''+inv.id+'\')">+ Update Value</button>'+
        '<button class="btn btn-ghost btn-sm" onclick="openValueHistoryModal(\''+inv.id+'\')">View History'+(inv.history&&inv.history.length?' <span style="opacity:.6">('+inv.history.length+')</span>':'')+' </button>'+
        '</div>'+
        '</div>';
    }).join('')+
    '</div>';

  el.innerHTML=statsHTML+chartHTML+cardsHTML;

  setTimeout(()=>{
    if(chartData){
      killChart('invest-portfolio');
      const ctx=$('invest-portfolio-chart'); if(ctx){
        CHARTS['invest-portfolio']=new Chart(ctx,{
          type:'line',data:chartData,
          options:{responsive:true,maintainAspectRatio:false,
            plugins:{legend:{position:'bottom',labels:{font:{size:11},boxWidth:12}},tooltip:{callbacks:{label:c=>c.dataset.label+': '+fmt(c.raw)}}},
            scales:{x:{ticks:{font:{size:10},maxTicksLimit:8},grid:{color:'rgba(255,255,255,0.04)'}},y:{ticks:{font:{size:10},callback:v=>'$'+v.toLocaleString()},grid:{color:'rgba(255,255,255,0.04)'}}}}
        });
      }
    }
    invs.forEach(inv=>{
      if(!inv.history||inv.history.length<2) return;
      const key='invest-spark-'+inv.id;
      killChart(key);
      const ctx=$(key); if(!ctx) return;
      const color=INVEST_TYPE_CLR[inv.investType]||'#6366f1';
      CHARTS[key]=new Chart(ctx,{
        type:'line',
        data:{labels:inv.history.map(e=>e.date),datasets:[{data:inv.history.map(e=>e.value),borderColor:color,backgroundColor:color+'22',fill:true,tension:.3,pointRadius:0}]},
        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{enabled:false}},scales:{x:{display:false},y:{display:false}}}
      });
    });
  },150);
}


