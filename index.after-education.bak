  </div>
</div>

<!-- MODAL: Log Credit Score -->
<div class="overlay" id="m-credit-score">
  <div class="modal" style="max-width:400px">
    <div class="modal-title">Log Credit Score</div>
    <div class="priv-note mb12">🔒 Stored locally only — never shared or transmitted</div>
    <div class="form-group"><label class="form-label">Score (300–850)</label><input class="form-input" id="f-cs-score" type="number" min="300" max="850" placeholder="e.g. 720"></div>
    <div class="form-group"><label class="form-label">Date</label><input class="form-input" id="f-cs-date" type="date"></div>
    <div class="form-group"><label class="form-label">Note (optional)</label><input class="form-input" id="f-cs-note" type="text" placeholder="e.g. After paying down BofA"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-credit-score')">Cancel</button>
      <button class="btn btn-primary" onclick="saveCreditScore()">Save</button>
    </div>
  </div>
</div>

<!-- MODAL: Upload Summary -->
<div class="overlay" id="m-upload-summary">
  <div class="modal" style="max-width:480px">
    <div class="modal-title">Import Complete</div>
    <div id="m-upload-summary-body" style="line-height:1.9;font-size:14px"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-upload-summary');go('budget')">View Budget</button>
      <button class="btn btn-primary" onclick="closeModal('m-upload-summary')">Done</button>
    </div>
  </div>
</div>

<!-- MODAL: PDF Import Preview -->
<div class="overlay" id="m-pdf-preview">
  <div class="modal" style="max-width:640px">
