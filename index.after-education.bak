</div>

<!-- Vault ledger (how a vault balance is reconstructed) -->
<div class="overlay" id="m-vault-ledger">
  <div class="modal" style="max-width:900px" onclick="event.stopPropagation()">
    <div class="flex-sb mb12"><div class="modal-title" style="margin:0" id="vl-title">Vault ledger</div><button class="btn btn-ghost btn-sm" onclick="closeModal('m-vault-ledger')">Close</button></div>
    <div id="vl-body"></div>
  </div>
</div>
<!-- In-app dialogs (replace native prompt / confirm / alert) -->
<div class="overlay" id="app-dlg" role="dialog" aria-modal="true" aria-labelledby="app-dlg-title">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-title" id="app-dlg-title"></div>
    <div id="app-dlg-body"></div>
    <div class="modal-actions" id="app-dlg-actions"></div>
  </div>
</div>

<script>
// ── GLOBALS ──────────────────────────────────────────────────────────────────
Chart.defaults.color = '#718096';
Chart.defaults.borderColor = '#1E1E2E';
Chart.defaults.font.family = "-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif";
try{ if(typeof pdfjsLib!=='undefined') pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js'; }catch(e){}

const CHARTS = {};
let editId = null, editTxId = null, activeTab = 'home';
let pendingFile = null, pendingInvestFile = null, pendingCCFile = null, txAccFilter = '';
let _csvPendingRows=[], _csvPendingKind='bank', _csvPendingMeta=null;
let uploadCtx='budget', uploadBank='auto', uploadAcctType='', uploadCCPreCardId=null;
let pendingAccountMode=null, pendingAccountMatchName=null, pendingAccountTypedName=null;
let _accountsList=[], _mergePairs=[];
let drPreset = 'all', drCustomStart = '', drCustomEnd = '';
let bSub = 'spending'; // budget sub-tab
let _bModalMode = 'dollar'; // tracks mode during Set Budget modal session

// ── GLOBAL DATA STORE ─────────────────────────────────────────────────────────
const AnchorDB = {
  // Primary collections
  transactions:  [],
  creditCards:   [],
  subscriptions: [],
  bills:         [],
  goals:         [],
  investments:   [],
  merchantRules: {},

  // Organized sub-objects
  netWorth: { manualAssets:[], manualLiabilities:[], history:[] },
  budget:   { monthlyTarget:3000, cycle:'monthly', categoryTargets:{}, budgetMode:'dollar', monthlyTargetPct:0, categoryPcts:{}, manualMonthlyIncome:0, includeInvestmentsInSpend:false, includeCCPaymentsInSpend:false },
  income:   { sources:[], history:[], configuration:{
    dtiIncomeBase:'net', sources:[],
    bonusHistory:[], monthlyBonusAverage:0,
    totalMonthlyGross:0, totalMonthlyNet:0, totalDTIEligible:0,
    configuredAt:null, configuredManually:false
  }},
  payday:   { schedule:null, config:null, earlyDepositDays:1, history:[] },
  preferences: {
    theme:'dark', onboardingComplete:false, tourComplete:false,
    financialProfile:null, quizAnswers:{}, lastFeedbackShown:0,
    dismissedInsights:{}, dismissedAlerts:[], dismissedPaydayBanners:{},
    confirmedIncomeNames:{}, dismissedIncomeSuggestions:[],
    incomeSettings:{showTransfers:true,showInterest:true,showCashback:true,expectedMonthly:0},
    scoreSetupComplete:false, scoreSetupCompletedAt:null, scoreSetupProgress:null
  },
  // Legacy fields that don't map cleanly to a domain object
  _internal: {
    emergencyFundGoalId:null, subSuggestions:[], billSuggestions:[],
    balanceHistory:{}, archivedMonths:{}, confirmedEmployer:null
  },
  virtualAccounts: [],
  creditScoreHistory: [],
  waitlist: [],
  meta: { version:'0.1.0', schemaVersion:1, lastSaved:null },

  // Computed fields — refreshed by DataStore.recalculate(), never trust a stale value
  totalUtilization:    null,
  totalMonthlySubBurn: 0,
  totalMonthlyBillBurn:0,
  totalPortfolioValue: 0,
  currentNetWorth:     0
};

// ── BACKWARD-COMPAT FIELD MAP ──────────────────────────────────────────────────
// Maps every old S field name → getter/setter on AnchorDB's new structure.
// Fields not listed here (transactions, goals, bills, investments, merchantRules)
// exist verbatim on AnchorDB and fall through the proxy unchanged.
const _COMPAT = {
  cards:            [d=>d.creditCards,                       (d,v)=>{d.creditCards=v}],
  subs:             [d=>d.subscriptions,                     (d,v)=>{d.subscriptions=v}],
  assets:           [d=>d.netWorth.manualAssets,             (d,v)=>{d.netWorth.manualAssets=v}],
  liabilities:      [d=>d.netWorth.manualLiabilities,        (d,v)=>{d.netWorth.manualLiabilities=v}],
  nwHistory:        [d=>d.netWorth.history,                  (d,v)=>{d.netWorth.history=v}],
  budgetTarget:     [d=>d.budget.monthlyTarget,              (d,v)=>{d.budget.monthlyTarget=v}],
  budgetCycle:      [d=>d.budget.cycle,                      (d,v)=>{d.budget.cycle=v}],
  catBudgets:       [d=>d.budget.categoryTargets,            (d,v)=>{d.budget.categoryTargets=v}],
  budgetMode:       [d=>d.budget.budgetMode||'dollar',       (d,v)=>{d.budget.budgetMode=v}],
  budgetTargetPct:  [d=>d.budget.monthlyTargetPct||0,        (d,v)=>{d.budget.monthlyTargetPct=v}],
  catBudgetPcts:    [d=>d.budget.categoryPcts||{},           (d,v)=>{d.budget.categoryPcts=v}],
  monthlyIncome:            [d=>d.budget.manualMonthlyIncome||0,              (d,v)=>{d.budget.manualMonthlyIncome=v}],
  includeInvestmentsInSpend:[d=>d.budget.includeInvestmentsInSpend||false,    (d,v)=>{d.budget.includeInvestmentsInSpend=v}],
  includeCCPaymentsInSpend: [d=>d.budget.includeCCPaymentsInSpend||false,     (d,v)=>{d.budget.includeCCPaymentsInSpend=v}],
  theme:            [d=>d.preferences.theme,                 (d,v)=>{d.preferences.theme=v}],
  onboardDone:      [d=>d.preferences.onboardingComplete,    (d,v)=>{d.preferences.onboardingComplete=v}],
  tourDone:         [d=>d.preferences.tourComplete,          (d,v)=>{d.preferences.tourComplete=v}],
  userProfile:      [d=>d.preferences.financialProfile,      (d,v)=>{d.preferences.financialProfile=v}],
  quizAnswers:      [d=>d.preferences.quizAnswers,           (d,v)=>{d.preferences.quizAnswers=v}],
  lastFeedbackShown:[d=>d.preferences.lastFeedbackShown,     (d,v)=>{d.preferences.lastFeedbackShown=v}],
  dismissedInsights:[d=>d.preferences.dismissedInsights,     (d,v)=>{d.preferences.dismissedInsights=v}],
  dismissedAlerts:  [d=>d.preferences.dismissedAlerts,       (d,v)=>{d.preferences.dismissedAlerts=v}],
  dismissedPaydayBanners:      [d=>d.preferences.dismissedPaydayBanners,      (d,v)=>{d.preferences.dismissedPaydayBanners=v}],
  confirmedIncomeNames:        [d=>d.preferences.confirmedIncomeNames,        (d,v)=>{d.preferences.confirmedIncomeNames=v}],
  dismissedIncomeSuggestions:  [d=>d.preferences.dismissedIncomeSuggestions,  (d,v)=>{d.preferences.dismissedIncomeSuggestions=v}],
  incomeSettings:   [d=>d.preferences.incomeSettings,        (d,v)=>{d.preferences.incomeSettings=v}],
  paySchedule:      [d=>d.payday.schedule,                   (d,v)=>{d.payday.schedule=v}],
  payScheduleConfig:[d=>d.payday.config,                     (d,v)=>{d.payday.config=v}],
  earlyDepositDays: [d=>d.payday.earlyDepositDays,           (d,v)=>{d.payday.earlyDepositDays=v}],
  paydayHistory:    [d=>d.payday.history,                    (d,v)=>{d.payday.history=v}],
  emergencyFundGoalId:[d=>d._internal.emergencyFundGoalId,   (d,v)=>{d._internal.emergencyFundGoalId=v}],
  subSuggestions:   [d=>d._internal.subSuggestions,          (d,v)=>{d._internal.subSuggestions=v}],
  billSuggestions:  [d=>d._internal.billSuggestions,         (d,v)=>{d._internal.billSuggestions=v}],
  balanceHistory:   [d=>d._internal.balanceHistory,          (d,v)=>{d._internal.balanceHistory=v}],
  archivedMonths:   [d=>d._internal.archivedMonths,          (d,v)=>{d._internal.archivedMonths=v}],
  confirmedEmployer:[d=>d._internal.confirmedEmployer,       (d,v)=>{d._internal.confirmedEmployer=v}],
  incomeConfig:    [d=>d.income.configuration,               (d,v)=>{d.income.configuration=v}],
};

// S is a transparent proxy over AnchorDB, translating legacy field names on the fly.
// All existing code using S.cards, S.subs, S.nwHistory, etc. continues to work.
const S = new Proxy(AnchorDB, {
  get(t, k){ return _COMPAT[k] ? _COMPAT[k][0](t) : t[k]; },
  set(t, k, v){ _COMPAT[k] ? _COMPAT[k][1](t,v) : (t[k]=v); return true; }
});

// ── DATA STORE MANAGER ─────────────────────────────────────────────────────────
const DataStore = {
  _syncTimer: null,

  save(){
    AnchorDB.meta.lastSaved = new Date().toISOString();
    localStorage.setItem('anchor_db', JSON.stringify(AnchorDB));
  },

  load(){
    // Prefer new anchor_db format
    const newRaw = localStorage.getItem('anchor_db');
    if(newRaw){
      try{
        this._deepMerge(AnchorDB, JSON.parse(newRaw));
        this._corrections();
        return;
      }catch(e){ console.error('[AnchorDB] load error:', e); }
    }
    // Migrate from legacy findash2
    const legRaw = localStorage.getItem('findash2');
    if(legRaw){
      try{
        const leg = JSON.parse(legRaw);
        // Use proxy's set handler to translate old field names into new AnchorDB paths
        Object.entries(leg).forEach(([k,v])=>{ if(v!==undefined) S[k]=v; });
        this._corrections();
        this.save();
        console.log('[AnchorDB] Migrated from findash2 → anchor_db');
      }catch(e){ console.error('[AnchorDB] Migration error:', e); }
    }
  },

  // Recursively merge source into target (no clobber of sub-objects)
  _deepMerge(target, source){
    if(!source||typeof source!=='object') return;
    Object.keys(source).forEach(k=>{
      if(source[k]!==null&&typeof source[k]==='object'&&!Array.isArray(source[k])&&
         target[k]!==null&&typeof target[k]==='object'&&!Array.isArray(target[k])){
        this._deepMerge(target[k], source[k]);
      } else {
        target[k]=source[k];
      }
    });
  },

  // Data corrections that run after every load (idempotent)
  _corrections(){
    const tx=AnchorDB.transactions;
    tx.forEach(t=>{
      if(t.source==='cc-csv'){
        if(t.desc!==undefined&&!t.description) t.description=t.desc;
        if(t.amount>0&&!t.incomeType&&!t.isPayment) t.amount=-t.amount;
      }
      if(t.category==='Other'&&t.description&&!t.incomeType){
        const nc=autoCat(t.description); if(nc!=='Other') t.category=nc;
      }
    });
    // Backfill CC payments from card.payments arrays
    AnchorDB.creditCards.forEach(card=>{
      (card.payments||[]).forEach(p=>{
        const dup=tx.find(t=>t.date===p.date&&t.amount===p.amount&&t.account===card.name&&t.isPayment);
        if(!dup) tx.push({id:uid(),date:p.date,description:'Payment',amount:p.amount,category:'Transfers',account:card.name,source:'cc-csv',isPayment:true});
      });
    });
    // Null-guards for sub-objects that may be missing in old saves
    const p=AnchorDB.preferences, i=AnchorDB._internal, pd=AnchorDB.payday;
    if(!p.dismissedPaydayBanners) p.dismissedPaydayBanners={};
    if(!p.confirmedIncomeNames) p.confirmedIncomeNames={};
    if(!p.dismissedIncomeSuggestions) p.dismissedIncomeSuggestions=[];
    if(p.incomeQuizDismissedAt===undefined) p.incomeQuizDismissedAt=null;
    if(!p.incomeSettings) p.incomeSettings={showTransfers:true,showInterest:true,showCashback:true,expectedMonthly:0};
    if(!i.balanceHistory) i.balanceHistory={};
    if(!i.archivedMonths) i.archivedMonths={};
    if(!i.subSuggestions) i.subSuggestions=[];
    if(!i.billSuggestions) i.billSuggestions=[];
    if(!pd.history) pd.history=[];
    if(!AnchorDB.budget.categoryPcts) AnchorDB.budget.categoryPcts={};
    if(!AnchorDB.virtualAccounts) AnchorDB.virtualAccounts=[];
    if(!AnchorDB.creditScoreHistory) AnchorDB.creditScoreHistory=[];
    if(!AnchorDB.waitlist) AnchorDB.waitlist=[];
    if(AnchorDB.preferences.scoreSetupComplete===undefined) AnchorDB.preferences.scoreSetupComplete=false;
    if(AnchorDB.preferences.scoreSetupProgress===undefined) AnchorDB.preferences.scoreSetupProgress=null;
    if(!AnchorDB.income) AnchorDB.income={sources:[],history:[],configuration:{dtiIncomeBase:'net',sources:[],bonusHistory:[],monthlyBonusAverage:0,totalMonthlyGross:0,totalMonthlyNet:0,totalDTIEligible:0,configuredAt:null,configuredManually:false}};
    if(!AnchorDB.income.configuration) AnchorDB.income.configuration={dtiIncomeBase:'net',sources:[],bonusHistory:[],monthlyBonusAverage:0,totalMonthlyGross:0,totalMonthlyNet:0,totalDTIEligible:0,configuredAt:null,configuredManually:false};
    if(!Array.isArray(AnchorDB.income.sources)) AnchorDB.income.sources=[];
    // Migrate legacy incomeSettings into income.configuration
    const _legIS=p.incomeSettings;
    if(_legIS&&!AnchorDB.income.configuration.configuredManually){
      if(_legIS.dtiIncomeBase) AnchorDB.income.configuration.dtiIncomeBase=_legIS.dtiIncomeBase;
      if(_legIS.grossMonthly>0) AnchorDB.income.configuration.totalMonthlyGross=_legIS.grossMonthly;
      if(_legIS.manualMonthlyNet>0) AnchorDB.income.configuration.totalMonthlyNet=_legIS.manualMonthlyNet;
    }
  },

  // Recalculate all derived/computed fields. Call after any data mutation.
  recalculate(){
    // Step 1: raw balances
    this._recalcUtilization();
    this._recalcSubBurn();
    this._recalcBillBurn();
    this._recalcInvestTotals();
    this._recalcPercentageBudgets();
    // Step 2: net worth (depends on balances)
    this._recalcNetWorth();
  },

  _recalcUtilization(){
    let tBal=0, tLim=0;
    AnchorDB.creditCards.forEach(c=>{
      c.utilizationPercent = c.limit>0 ? (c.balance/c.limit)*100 : 0;
      tBal+=c.balance||0; tLim+=c.limit||0;
    });
    AnchorDB.totalUtilization = tLim>0 ? (tBal/tLim)*100 : null;
  },

  _recalcSubBurn(){
    const cy={weekly:52/12,monthly:1,quarterly:1/3,'semi-annual':1/6,annual:1/12};
    AnchorDB.subscriptions.forEach(s=>{
      s.monthlyEquivalent=(s.isPaused||s.isCancelled)?0:s.amount*(cy[s.billingCycle]||1);
    });
    AnchorDB.totalMonthlySubBurn=AnchorDB.subscriptions
      .filter(s=>!s.isPaused&&!s.isCancelled)
      .reduce((a,s)=>a+(s.monthlyEquivalent||0),0);
  },

  _recalcBillBurn(){
    const cy={weekly:52/12,monthly:1,quarterly:1/3,'semi-annual':1/6,annual:1/12};
    AnchorDB.bills.forEach(b=>{
      b.monthlyEquivalent=b.isPaused?0:b.amount*(cy[b.billingCycle||'monthly']||1);
    });
    AnchorDB.totalMonthlyBillBurn=AnchorDB.bills
      .filter(b=>!b.isPaused)
      .reduce((a,b)=>a+(b.monthlyEquivalent||0),0);
  },

  _recalcInvestTotals(){
    AnchorDB.totalPortfolioValue=AnchorDB.investments.reduce((sum,inv)=>{
      const h=inv.history||inv.valueHistory||[];
      if(!h.length) return sum+(inv.value||inv.currentValue||0);
      return sum+h.reduce((a,b)=>a.date>=b.date?a:b).value;
    },0);
  },

  _recalcNetWorth(){
    const assets=AnchorDB.netWorth.manualAssets.reduce((s,a)=>s+(a.value||0),0);
    const liabs=AnchorDB.netWorth.manualLiabilities.reduce((s,l)=>s+(l.value||0),0);
    const ccDebt=AnchorDB.creditCards.reduce((s,c)=>s+(c.balance||0),0);
    AnchorDB.currentNetWorth=assets+AnchorDB.totalPortfolioValue-liabs-ccDebt;
  },

  _recalcPercentageBudgets(){
    const bud=AnchorDB.budget;
    if(!bud.budgetMode||bud.budgetMode==='dollar') return;
    const netIncome=typeof getMonthlyIncomeEstimate==='function'?getMonthlyIncomeEstimate():0;
    if(!netIncome||netIncome<=0) return;
    if(bud.budgetMode==='percentage'&&bud.monthlyTargetPct>0){
      bud.monthlyTarget=Math.round((bud.monthlyTargetPct/100)*netIncome);
    }
    const pcts=bud.categoryPcts||{};
    Object.keys(pcts).forEach(cat=>{
      if(pcts[cat]>0){
        if(!bud.categoryTargets) bud.categoryTargets={};
        bud.categoryTargets[cat]=Math.round((pcts[cat]/100)*netIncome);
      }
    });
  },

  // sync = recalculate + save + notify (debounced 50ms to batch rapid mutations)
  sync(source='unknown'){
    this.recalculate();
    this.save();
    clearTimeout(this._syncTimer);
    this._syncTimer=setTimeout(()=>{
      window.dispatchEvent(new CustomEvent('anchorSync',{detail:{source,ts:Date.now()}}));
    },50);
    console.log('[AnchorDB] synced:',source);
  },

  // Full data export (backup)
  export(){
    return JSON.stringify(AnchorDB, null, 2);
  },

  // Full data import — detects legacy S format vs new AnchorDB format automatically
  importData(jsonStr){
    try{
      const data=JSON.parse(jsonStr);
      this._reset();
      // New format has creditCards or netWorth; legacy has cards or subs
      if(data.creditCards||data.netWorth){
        this._deepMerge(AnchorDB, data);
      } else {
        Object.entries(data).forEach(([k,v])=>{ if(v!==undefined) S[k]=v; });
      }
      this._corrections();
      return true;
    }catch(e){ console.error('[AnchorDB] importData failed:',e); return false; }
  },

  // Reset all collections to empty defaults (used before importing)
  _reset(){
    AnchorDB.transactions=[];AnchorDB.creditCards=[];AnchorDB.subscriptions=[];
    AnchorDB.bills=[];AnchorDB.goals=[];AnchorDB.investments=[];AnchorDB.merchantRules={};
    AnchorDB.netWorth={manualAssets:[],manualLiabilities:[],history:[]};
    AnchorDB.budget={monthlyTarget:3000,cycle:'monthly',categoryTargets:{}};
    AnchorDB.income={sources:[],history:[],configuration:{dtiIncomeBase:'net',sources:[],bonusHistory:[],monthlyBonusAverage:0,totalMonthlyGross:0,totalMonthlyNet:0,totalDTIEligible:0,configuredAt:null,configuredManually:false}};
    AnchorDB.payday={schedule:null,config:null,earlyDepositDays:1,history:[]};
    AnchorDB.preferences={theme:'dark',onboardingComplete:false,tourComplete:false,
      financialProfile:null,quizAnswers:{},lastFeedbackShown:0,
      dismissedInsights:{},dismissedAlerts:[],dismissedPaydayBanners:{},
      confirmedIncomeNames:{},dismissedIncomeSuggestions:[],
      incomeSettings:{showTransfers:true,showInterest:true,showCashback:true,expectedMonthly:0},
      scoreSetupComplete:false,scoreSetupCompletedAt:null,scoreSetupProgress:null};
    AnchorDB._internal={emergencyFundGoalId:null,subSuggestions:[],billSuggestions:[],
      balanceHistory:{},archivedMonths:{},confirmedEmployer:null};
  }
};

function save(){ DataStore.save(); }
function load(){ DataStore.load(); }

// ── UTILS ─────────────────────────────────────────────────────────────────────
const $ = id => document.getElementById(id);
const uid = () => Math.random().toString(36).slice(2)+Date.now().toString(36);
const esc = s => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const fmt = n => new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n||0);
const pct = n => (n||0).toFixed(1)+'%';

function daysUntil(d){
  if(!d) return 999;
  const t=new Date(d), now=new Date();
  t.setHours(0,0,0,0); now.setHours(0,0,0,0);
  return Math.round((t-now)/864e5);
}

function toMonthly(amount,cycle){
  return (amount||0)*({weekly:52/12,monthly:1,quarterly:1/3,semiannual:1/6,annual:1/12}[cycle]||1);
}

function utilCls(p){ return p<30?'bar-green':p<50?'bar-yellow':p<75?'bar-orange':'bar-red' }
function utilTxt(p){ return p<30?'text-green':p<50?'text-yellow':p<75?'text-orange':'text-red' }

function killChart(k){ if(CHARTS[k]){ CHARTS[k].destroy(); CHARTS[k]=null } }

// ── DATE UTILS ────────────────────────────────────────────────────────────────
const _MN=['january','february','march','april','may','june','july','august','september','october','november','december'];
const _MA=['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];

function normalizeDate(s){
  if(!s||!s.trim()) return '';
  s=s.trim();
  if(/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0,10);
  let m=/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
  if(m) return `${m[3]}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`;
  m=/^(\d{1,2})\/(\d{1,2})\/(\d{2})$/.exec(s);
  if(m) return `${parseInt(m[3])>50?'19':'20'}${m[3]}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`;
  m=/^([A-Za-z]+)\s+(\d{1,2})[,\s]+(\d{4})$/.exec(s);
  if(m){const i=[..._MN,..._MA].indexOf(m[1].toLowerCase());const mn=i>=0?(i%12)+1:0;if(mn)return `${m[3]}-${String(mn).padStart(2,'0')}-${m[2].padStart(2,'0')}`;}
  m=/^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/.exec(s);
  if(m){const i=[..._MN,..._MA].indexOf(m[2].toLowerCase());const mn=i>=0?(i%12)+1:0;if(mn)return `${m[3]}-${String(mn).padStart(2,'0')}-${m[1].padStart(2,'0')}`;}
  return '';
}

function getDateRange(){
  const now=new Date(); now.setHours(23,59,59,999);
  const y=now.getFullYear(), mo=now.getMonth();
  if(drPreset==='this-month') return {start:new Date(y,mo,1),end:now};
  if(drPreset==='last-month') return {start:new Date(y,mo-1,1),end:new Date(y,mo,0,23,59,59,999)};
  if(drPreset==='3mo') return {start:new Date(y,mo-2,1),end:now};
  if(drPreset==='6mo') return {start:new Date(y,mo-5,1),end:now};
  if(drPreset==='ytd') return {start:new Date(y,0,1),end:now};
  if(drPreset==='last-year') return {start:new Date(y-1,0,1),end:new Date(y-1,11,31,23,59,59,999)};
  if(drPreset==='custom') return {start:drCustomStart?new Date(drCustomStart+'T00:00:00'):null,end:drCustomEnd?new Date(drCustomEnd+'T23:59:59'):null};
  return {start:null,end:null};
}

function txInRange(t){
  const {start,end}=getDateRange();
  if(!start&&!end) return true;
  const nd=normalizeDate(t.date);
  if(!nd) return true;
  const d=new Date(nd+'T12:00:00');
  if(start&&d<start) return false;
  if(end&&d>end) return false;
  return true;
}

function renderDateRangeBar(){
  const ps=[{id:'all',l:'All Time'},{id:'this-month',l:'This Month'},{id:'last-month',l:'Last Month'},{id:'3mo',l:'3 Mo'},{id:'6mo',l:'6 Mo'},{id:'ytd',l:'YTD'},{id:'last-year',l:'Last Year'},{id:'custom',l:'Custom'}];
  return `<div class="dr-bar">
    <span class="text-muted fw7" style="font-size:11px;white-space:nowrap;margin-right:2px">Range:</span>
    ${ps.map(p=>`<button class="dr-preset${drPreset===p.id?' active':''}" onclick="setDrPreset('${p.id}')">${p.l}</button>`).join('')}
    <div id="dr-custom" style="display:${drPreset==='custom'?'flex':'none'};gap:6px;align-items:center;flex-wrap:wrap">
      <input class="form-input" type="date" id="dr-start" value="${drCustomStart}" style="width:138px;padding:4px 10px;font-size:12px" onchange="drCustomStart=this.value;renderBudget()">
      <span class="text-muted fs12">–</span>
      <input class="form-input" type="date" id="dr-end" value="${drCustomEnd}" style="width:138px;padding:4px 10px;font-size:12px" onchange="drCustomEnd=this.value;renderBudget()">
    </div>
  </div>`;
}

function setDrPreset(p){ drPreset=p; renderBudget(); }

// ── BUDGET MATH ───────────────────────────────────────────────────────────────
function getMonthlyIncomeBase(){
  const incomeTx=S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&!t.isPayment&&t.incomeType);
  if(incomeTx.length>0){
    const byMonth={};
    incomeTx.forEach(t=>{const nd=normalizeDate(t.date);if(!nd)return;const mo=nd.slice(0,7);byMonth[mo]=(byMonth[mo]||0)+t.amount;});
    const months=Object.keys(byMonth).sort().slice(-3);
    if(months.length>0){const avg=months.reduce((a,m)=>a+byMonth[m],0)/months.length;if(avg>0)return{amount:Math.round(avg),source:'detected',months:months.length};}
  }
  if(S.monthlyIncome>0)return{amount:S.monthlyIncome,source:'manual'};
  return{amount:0,source:'none'};
}

function getMonthlyBudget(){
  if(S.budgetMode==='percentage'){
    if(!S.budgetTargetPct)return 0;
    const inc=getMonthlyIncomeBase();
    return inc.amount>0?Math.round(S.budgetTargetPct/100*inc.amount):0;
  }
  if(!S.budgetTarget)return 0;
  return S.budgetCycle==='annual'?S.budgetTarget/12:S.budgetTarget;
}

function getRangeMonths(){
  const {start,end}=getDateRange();
  if(!start&&!end){
    const mos=new Set();
    S.transactions.filter(t=>t.amount<0).forEach(t=>{const nd=normalizeDate(t.date);if(nd)mos.add(nd.slice(0,7));});
    return Math.max(mos.size,1);
  }
  if(start&&end){
    return Math.max((end.getFullYear()-start.getFullYear())*12+(end.getMonth()-start.getMonth())+1,1);
  }
  return 1;
}

function getEffectiveBudget(){ return getMonthlyBudget()*getRangeMonths(); }

function getEffectiveCatBudget(cat){
  if(S.budgetMode==='percentage'){
    const p=(S.catBudgetPcts||{})[cat]||0;
    if(!p)return 0;
    const inc=getMonthlyIncomeBase();
    return inc.amount>0?Math.round(p/100*inc.amount)*getRangeMonths():0;
  }
  const m=(S.catBudgets||{})[cat]||0;
  return m>0?m*getRangeMonths():0;
}

// ── TABS ──────────────────────────────────────────────────────────────────────
function go(tab){
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  $('tab-'+tab).classList.add('active');
  const order=['home','cards','budget','networth','goals','subs','bills','invest','insights'];
  document.querySelectorAll('.nav-tab')[order.indexOf(tab)].classList.add('active');
  activeTab = tab;
  ({home:renderHome,cards:renderCards,budget:renderBudget,networth:renderNW,goals:renderGoals,subs:renderSubs,bills:renderBills,invest:renderInvest,insights:renderInsights})[tab]();
}

// ── MODALS ────────────────────────────────────────────────────────────────────
function openModal(id){ $(id).classList.add('open') }
function closeModal(id){ $(id).classList.remove('open') }
function showSaveToast(msg){ const t=document.createElement('div'); t.className='toast-msg'; t.textContent='✓ '+msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2500); }
document.addEventListener('click', e=>{
  if(e.target.classList.contains('overlay')) e.target.classList.remove('open');
});

// ── EXPORT / IMPORT ───────────────────────────────────────────────────────────
function exportJSON(){
  const b=new Blob([DataStore.export()],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(b);
  a.download='anchor-'+new Date().toISOString().split('T')[0]+'.json';
  a.click(); URL.revokeObjectURL(a.href);
}
let _pendingImportData=null;
function importJSON(e){
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=ev=>{
    try{
      const data=JSON.parse(ev.target.result);
      _pendingImportData=ev.target.result;
      // Build preview
      const txCount=(data.transactions||[]).length;
      const cardCount=(data.creditCards||data.cards||[]).length;
      const goalCount=(data.goals||[]).length;
      const billCount=(data.bills||[]).length;
      const subCount=(data.subscriptions||data.subs||[]).length;
      const investCount=(data.investments||[]).length;
      const exportedAt=data.meta?.lastSaved||data.exportedAt||null;
      const ver=data.meta?.version||data.version||'unknown';
      const html=`<div style="line-height:2">
        <div><strong>Version:</strong> ${esc(ver)} ${exportedAt?`· backed up ${exportedAt.slice(0,10)}`:''}</div>
        <div style="margin-top:8px;font-weight:600;color:var(--text-sec);font-size:12px;text-transform:uppercase;letter-spacing:.06em">This backup contains:</div>
        ${txCount?`<div>✓ ${txCount} transaction${txCount!==1?'s':''}</div>`:''}
        ${cardCount?`<div>✓ ${cardCount} credit card${cardCount!==1?'s':''}</div>`:''}
        ${goalCount?`<div>✓ ${goalCount} goal${goalCount!==1?'s':''}</div>`:''}
        ${billCount?`<div>✓ ${billCount} bill${billCount!==1?'s':''}</div>`:''}
        ${subCount?`<div>✓ ${subCount} subscription${subCount!==1?'s':''}</div>`:''}
        ${investCount?`<div>✓ ${investCount} investment${investCount!==1?'s':''}</div>`:''}
        ${!txCount&&!cardCount&&!goalCount?`<div class="text-muted fs12">⚠ Backup appears empty or uses an unsupported format.</div>`:''}
      </div>`;
      $('m-import-preview-body').innerHTML=html;
      openModal('m-import-preview');
    }catch(_){ alert('Invalid JSON file — could not parse.'); }
  };
  r.readAsText(f); e.target.value='';
}
function confirmImport(){
  if(!_pendingImportData){ closeModal('m-import-preview'); return; }
  if(!DataStore.importData(_pendingImportData)){ alert('Import failed — data could not be loaded.'); return; }
  _pendingImportData=null;
  DataStore.sync('import');
  closeModal('m-import-preview');
  go(activeTab);
}

// ── THEME ─────────────────────────────────────────────────────────────────────
function _cGrid(){ return document.documentElement.getAttribute('data-theme')==='light'?'rgba(0,0,0,0.06)':'rgba(255,255,255,0.05)'; }
function _cText(){ return document.documentElement.getAttribute('data-theme')==='light'?'#374151':'#6B7280'; }

function applyTheme(t){
  document.documentElement.setAttribute('data-theme',t);
  const btn=$('theme-toggle');
  if(btn) btn.textContent=t==='light'?'🌙':'☀️';
  // Update Chart.js global defaults so new charts pick up correct colors
  if(typeof Chart!=='undefined'){
    Chart.defaults.color=_cText();
    Chart.defaults.borderColor=_cGrid();
  }
}
function toggleTheme(){
  S.theme=S.theme==='dark'?'light':'dark';
  applyTheme(S.theme);
  // Destroy all live charts — active tab re-render will recreate them with new theme
  Object.keys(CHARTS).forEach(k=>{ if(CHARTS[k]){ CHARTS[k].destroy(); CHARTS[k]=null; } });
  const renders={home:renderHome,cards:renderCards,budget:renderBudget,
    networth:renderNW,goals:renderGoals,subs:renderSubs,bills:renderBills,
    invest:renderInvest,insights:renderInsights};
  if(renders[activeTab]) renders[activeTab]();
  save();
}

// ── SPLASH ────────────────────────────────────────────────────────────────────
function skipSplash(){
  const s=$('splash'); if(!s||s.dataset.done) return;
  s.dataset.done='1'; s.classList.add('hiding');
  setTimeout(()=>{ s.style.display='none'; afterSplash(); },500);
}
function afterSplash(){
  if(!localStorage.getItem('anch_priv_done')) $('privacy-banner').style.display='flex';
  if(!S.onboardDone) showOnboard();
  _checkEndedIncomes();
}

// ── PRIVACY ───────────────────────────────────────────────────────────────────
function dismissPrivacy(){
  $('privacy-banner').style.display='none';
  localStorage.setItem('anch_priv_done','1');
}

// ── INCOME STATUS ENGINE ──────────────────────────────────────────────────────

const _MO_NAMES=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function getIncomeStatus(src){
  if(!src) return {status:'unknown',label:'Unknown',color:'var(--muted)',includeInCalculations:false};
  if(src.status==='archived') return {status:'archived',label:'Archived',color:'var(--muted)',includeInCalculations:false};
  const today=new Date();today.setHours(12,0,0,0);
  const start=src.startDate?new Date(src.startDate+'T12:00:00'):null;
  const end=src.endDate?new Date(src.endDate+'T12:00:00'):null;
  // UPCOMING — hasn't started yet
  if(start&&start>today){
    const d=Math.ceil((start-today)/86400000);
    return {status:'upcoming',label:`Starts in ${d} day${d===1?'':'s'}`,
      color:'#f59e0b',includeInCalculations:false,reason:'Income not yet started',daysUntil:d,startDate:src.startDate};
  }
  // ENDED — past end date
  if(end&&end<today){
    const d=Math.ceil((today-end)/86400000);
    return {status:'ended',label:d===1?'Ended yesterday':`Ended ${d} days ago`,
      color:'var(--red)',includeInCalculations:false,reason:'Income has ended',daysAgo:d,endDate:src.endDate};
  }
  // ENDING SOON — ends within 30 days
  if(end){
    const d=Math.ceil((end-today)/86400000);
    if(d<=30) return {status:'ending-soon',label:`Ends in ${d} day${d===1?'':'s'}`,
      color:'#f59e0b',includeInCalculations:true,
      warning:`This income ends ${end.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}`,
      daysLeft:d,endDate:src.endDate};
  }
  // SEASONAL — check current month
  if(src.isSeasonal&&src.activeMonths&&src.activeMonths.length){
    const mo=today.getMonth();
    if(src.activeMonths.includes(mo)) return {status:'seasonal-active',label:'Seasonal — currently active',color:'var(--green)',includeInCalculations:true};
    const next=src.activeMonths.find(m=>m>mo)??src.activeMonths[0];
    return {status:'seasonal-inactive',label:`Seasonal — resumes ${_MO_NAMES[next]}${next<=mo?' (next year)':''}`,
      color:'#3b82f6',includeInCalculations:false,reason:'Outside active season',nextMonth:next};
  }
  return {status:'active',label:'Active',color:'var(--green)',includeInCalculations:true};
}

function _srcStatus(src){return getIncomeStatus(src).status;}

function _srcMonthlyActive(src){
  return getIncomeStatus(src).includeInCalculations?(src.monthlyNet||0):0;
}

function _getActiveSources(){
  return (AnchorDB.income.sources||[]).filter(s=>getIncomeStatus(s).includeInCalculations);
}

function _srcTypeColor(type){
  return {salary:'var(--accent)',hourly:'#0ea5e9',freelance:'var(--yellow)',contract:'#f97316',rental:'var(--green)',benefits:'#14b8a6',other:'var(--muted)'}[type||'other']||'var(--muted)';
}

function _srcTypeBadge(type){
  const lbl={salary:'Salary',hourly:'Hourly',freelance:'Freelance',contract:'Contract',rental:'Rental',benefits:'Benefits',other:'Other'}[type||'other']||(type||'Other');
  const clr=_srcTypeColor(type);
  return `<span style="font-size:10px;font-weight:700;color:${clr};text-transform:uppercase;letter-spacing:.04em;border:1px solid ${clr}33;background:${clr}18;border-radius:100px;padding:1px 7px">${lbl}</span>`;
}

function _srcStatusBadge(src){
  const st=getIncomeStatus(src);
  const dot=`<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:${st.color};margin-right:3px;vertical-align:middle"></span>`;
  return `<span style="font-size:11px;font-weight:600;color:${st.color}">${dot}${st.label}</span>`;
}

function _srcDateRange(src){
  const fmt2=d=>d?new Date(d+'T12:00:00').toLocaleDateString('en-US',{month:'short',year:'numeric'}):null;
  const s=fmt2(src.startDate),e=fmt2(src.endDate);
  return s||e?`${s||'?'} – ${e||'present'}`:null;
}

function _computeMonthlyNet(src){
  const mult={weekly:52/12,biweekly:26/12,semimonthly:2,monthly:1}[src.payFreq||'biweekly']||(26/12);
  switch(src.type){
    case 'salary':
    case 'contract': return Math.round((src.paycheckAmount||0)*mult);
    case 'hourly':   return Math.round((src.hourlyRate||0)*(src.hoursPerWeek||40)*52/12*0.78);
    case 'freelance':return src.monthlyAvg||0;
    case 'rental':   return src.monthlyRent||0;
    case 'benefits': return src.monthlyBenefits||0;
    default:         return src.monthlyOther||src.monthlyNet||0;
  }
}

function getActiveMonthlyIncome(){
  const manual=(AnchorDB.income.sources||[]).filter(s=>s.isManual);
  if(manual.length) return manual.filter(s=>getIncomeStatus(s).includeInCalculations).reduce((t,s)=>t+(s.monthlyNet||0),0);
  return getMonthlyIncomeEstimate()||0;
}

function getYTDIncome(){
  const yearStart=new Date(new Date().getFullYear(),0,1);
  const today=new Date();
  const manual=(AnchorDB.income.sources||[]).filter(s=>s.isManual&&s.status!=='archived');
  if(!manual.length) return 0;
  return Math.round(manual.reduce((tot,src)=>{
    const ss=src.startDate?new Date(Math.max(new Date(src.startDate+'T12:00:00'),yearStart)):yearStart;
    const se=src.endDate?new Date(Math.min(new Date(src.endDate+'T12:00:00'),today)):today;
    if(ss>se) return tot;
    if(src.isSeasonal&&src.activeMonths&&src.activeMonths.length){
      let mo=0;const d=new Date(ss.getFullYear(),ss.getMonth(),1);
      while(d<=se){if(src.activeMonths.includes(d.getMonth()))mo++;d.setMonth(d.getMonth()+1);}
      return tot+(src.monthlyNet||0)*mo;
    }
    return tot+(src.monthlyNet||0)*((se-ss)/86400000/30.44);
  },0));
}

function _checkEndedIncomes(){
  const today=new Date().toISOString().split('T')[0];
  const newlyEnded=(AnchorDB.income.sources||[]).filter(s=>
    s.isManual&&s.status!=='archived'&&!s._endedNotified&&s.endDate&&s.endDate<today);
  if(!newlyEnded.length) return;
  newlyEnded.forEach(s=>{s._endedNotified=true;});
  if(!AnchorDB.preferences.endedIncomeBanner) AnchorDB.preferences.endedIncomeBanner=[];
  newlyEnded.forEach(s=>AnchorDB.preferences.endedIncomeBanner.push({id:s.id,name:s.name||s.type,endDate:s.endDate}));
  save(); updateBellBadge();
}

function _dismissEndedBanner(id){
  if(!AnchorDB.preferences.endedIncomeBanner) return;
  AnchorDB.preferences.endedIncomeBanner=id
    ?AnchorDB.preferences.endedIncomeBanner.filter(e=>e.id!==id)
    :[];
  save(); renderBudget();
}

function _reactivateSource(id){
  const src=(AnchorDB.income.sources||[]).find(s=>s.id===id);
  if(!src) return;
  src.endDate=''; src.hasEndDate=false; delete src._endedNotified;
  if(AnchorDB.preferences.endedIncomeBanner)
    AnchorDB.preferences.endedIncomeBanner=AnchorDB.preferences.endedIncomeBanner.filter(e=>e.id!==id);
  _icSyncToSettings(); save(); renderBudget(); renderHome();
}

function _icSyncToSettings(){
  const srcs=(AnchorDB.income.sources||[]).filter(s=>s.isManual&&getIncomeStatus(s).includeInCalculations);
  if(!srcs.length) return;
  const totalNet=srcs.reduce((t,s)=>t+(s.monthlyNet||0),0);
  const totalGross=srcs.reduce((t,s)=>{
    const n=s.monthlyNet||0;
    if(s.type==='rental') return t+Math.round(n*.75);
    if(s.type==='benefits') return t+Math.round(n*1.25);
    return t+(s.monthlyGross||n);
  },0);
  S.incomeSettings={...(S.incomeSettings||{}),manualMonthlyNet:totalNet,grossMonthly:totalGross>totalNet?totalGross:(S.incomeSettings?.grossMonthly||0)};
  AnchorDB.income.configuration={...AnchorDB.income.configuration,totalMonthlyNet:totalNet,totalDTIEligible:totalGross||totalNet,configuredManually:true,configuredAt:new Date().toISOString()};
  _syncIncomeConfigFromSettings();
}

// ── FINANCIAL HEALTH SCORE ────────────────────────────────────────────────────

// Returns true only when auto-detected income is reliable enough for DTI.
function _dtiIncomeReliable(){
  // Manually configured income is always trusted
  const cfg=AnchorDB.income.configuration;
  if(cfg.configuredManually&&(cfg.totalMonthlyNet>0||cfg.totalMonthlyGross>0)) return {ok:true,reason:'manual'};

  // Auto-detected: need sufficient salary transactions
  const salaryTx=S.transactions.filter(t=>t.incomeType==='Salary'&&t.amount>0);
  if(salaryTx.length<4) return {ok:false,reason:`Only ${salaryTx.length} payroll deposits detected — need at least 4`};

  // Need at least 3 months of transaction data overall
  const txDates=S.transactions.map(t=>normalizeDate(t.date)).filter(Boolean).sort();
  const earliest=txDates[0],latest=txDates[txDates.length-1];
  const monthsOfData=earliest&&latest?
    (new Date(latest).getFullYear()-new Date(earliest).getFullYear())*12+
    (new Date(latest).getMonth()-new Date(earliest).getMonth())+1:0;
  if(monthsOfData<3) return {ok:false,reason:`Only ${monthsOfData} month${monthsOfData===1?'':'s'} of data — need at least 3`};

  // Intervals must be consistent (within 20% of each other)
  const sorted=salaryTx.map(t=>normalizeDate(t.date)).filter(Boolean).sort();
  const intervals=[];
  for(let i=1;i<sorted.length;i++){
    intervals.push(Math.round((new Date(sorted[i])-new Date(sorted[i-1]))/86400000));
  }
  if(intervals.length>=2){
    const avgInterval=intervals.reduce((a,b)=>a+b,0)/intervals.length;
    const maxDev=Math.max(...intervals.map(x=>Math.abs(x-avgInterval)));
    if(maxDev>avgInterval*0.4) return {ok:false,reason:'Paycheck timing is too irregular for reliable DTI'};
  }

  // Amounts must be consistent (no single deposit >3x average)
  const amounts=salaryTx.map(t=>t.amount);
  const avgAmt=amounts.reduce((a,b)=>a+b,0)/amounts.length;
  if(avgAmt<200) return {ok:false,reason:'Detected income under $200/mo — data appears incomplete'};
  if(Math.max(...amounts)>avgAmt*3) return {ok:false,reason:'Income amounts are too inconsistent for reliable DTI'};

  return {ok:true,reason:'auto'};
}

// Returns months-of-data count from transaction date range.
function _monthsOfTxData(){
  const dates=S.transactions.map(t=>normalizeDate(t.date)).filter(Boolean).sort();
  if(dates.length<2) return dates.length>0?1:0;
  const d0=new Date(dates[0]),d1=new Date(dates[dates.length-1]);
  return Math.max(1,(d1.getFullYear()-d0.getFullYear())*12+(d1.getMonth()-d0.getMonth())+1);
}

function calcHealthScore(){
  const hasCards=S.cards&&S.cards.length>0;
  const hasTx=S.transactions&&S.transactions.length>0;
  const hasBills=S.bills&&S.bills.length>0;
  const hasSubs=S.subscriptions&&S.subscriptions.length>0;
  const hasInv=S.investments&&S.investments.length>0;
  const hasAssets=S.assets&&S.assets.length>0;
  const hasAnyData=hasCards||hasTx||hasBills||hasSubs||hasInv||hasAssets;
  if(!hasAnyData) return {score:null,label:'',color:'',breakdown:[],hasData:false,componentCount:0,totalComponents:6};

  const breakdown=[];
  const now=new Date();
  const curMo=now.toISOString().slice(0,7);
  const dayOfMonth=now.getDate();

  // ── 1. Credit utilization (25pts) ─────────────────────────────────────────
  if(hasCards){
    const tLim=S.cards.reduce((a,c)=>a+(c.limit||0),0);
    const tBal=S.cards.reduce((a,c)=>a+(c.balance||0),0);
    const util=tLim>0?(tBal/tLim)*100:0;
    const uPts=util<10?25:util<30?20:util<50?12:util<75?5:0;
    breakdown.push({label:'Credit Utilization',score:uPts,max:25,detail:tLim>0?pct(util)+' utilized':'No credit limit set',hasData:true});
  } else {
    breakdown.push({label:'Credit Utilization',score:null,max:25,detail:'Add a credit card',hasData:false,isNoData:true,addLink:"go('cards')"});
  }

  // ── 2. DTI (20pts) — only with reliable income ────────────────────────────
  const _dtiD=calcDTIData();
  const _dtiRel=_dtiIncomeReliable();
  if(!_dtiRel.ok){
    // Auto income exists but is unreliable — show specific reason
    const isConfigured=AnchorDB.income.configuration.configuredManually;
    breakdown.push({label:'Debt-to-Income Ratio',score:null,max:20,
      detail:isConfigured?'Income configured but insufficient data':_dtiRel.reason,
      hasData:false,isInsufficient:true,
      addLink:"closeModal('m-health');openIncomeConfig()"});
  } else if(_dtiD.dtiPercent!==null){
    const dti=_dtiD.dtiPercent;
    const dtiPts=dti<15?20:dti<25?16:dti<35?12:dti<43?6:0;
    const dtiBarClr=dti<15?'#00D4AA':dti<25?'var(--teal)':dti<35?'#FFB547':dti<43?'#F97316':'#FF4D6D';
    const basisLbl=_dtiD.activeBasis==='gross'?'bank standard':'take-home';
    breakdown.push({label:'Debt-to-Income Ratio',score:dtiPts,max:20,
      detail:dti.toFixed(1)+'% DTI ('+basisLbl+')',hasData:true,barColor:dtiBarClr});
  } else {
    // Income is reliable but no debt → no credit cards or bills to compute DTI
    breakdown.push({label:'Debt-to-Income Ratio',score:null,max:20,
      detail:'Add a credit card or loan bill to calculate DTI',hasData:false,isNoData:true,
      addLink:"closeModal('m-health');go('cards')"});
  }

  // ── 3. Budget adherence (20pts) ───────────────────────────────────────────
  const mb=getMonthlyBudget();
  if(!mb){
    breakdown.push({label:'Budget Adherence',score:null,max:20,detail:'Set a monthly budget target',hasData:false,isNoData:true,addLink:"closeModal('m-health');openBudgetModal()"});
  } else if(dayOfMonth<10){
    breakdown.push({label:'Budget Adherence',score:null,max:20,detail:`Check back after the 10th (day ${dayOfMonth} of month)`,hasData:false,isInsufficient:true});
  } else {
    // Need enough transactions for the current month
    const requiredTx=Math.floor(dayOfMonth/2);
    const thisMonthTx=S.transactions.filter(t=>{
      if(!t.date||(normalizeDate(t.date)||'').slice(0,7)!==curMo) return false;
      if(t.amount>=0||t.internalXfer||isExcludedFromSpend(t)) return false;
      return true;
    });
    if(thisMonthTx.length<requiredTx){
      breakdown.push({label:'Budget Adherence',score:null,max:20,
        detail:`Need more data — ${thisMonthTx.length} of ~${requiredTx} expected transactions this month`,
        hasData:false,isInsufficient:true,addLink:"closeModal('m-health');openUploadModal('budget')"});
    } else {
      const spent=thisMonthTx.reduce((s,t)=>s+Math.abs(t.amount),0);
      // By day 15+, if spending < 5% of budget, data is likely incomplete
      const expectedMin=(dayOfMonth/30)*mb*0.05;
      if(dayOfMonth>15&&spent<expectedMin){
        breakdown.push({label:'Budget Adherence',score:null,max:20,
          detail:'Spending data appears incomplete — upload more statements',
          hasData:false,isInsufficient:true,addLink:"closeModal('m-health');openUploadModal('budget')"});
      } else {
        const ratio=spent/mb;
        const bPts=ratio<=1?20:ratio<=1.1?15:ratio<=1.25?8:0;
        const detail=ratio<=1?`${fmt(spent)} of ${fmt(mb)} budget`:`${((ratio-1)*100).toFixed(0)}% over budget`;
        breakdown.push({label:'Budget Adherence',score:bPts,max:20,detail,hasData:true});
      }
    }
  }

  // ── 4. Emergency fund (15pts) ─────────────────────────────────────────────
  const efGoal=S.emergencyFundGoalId?S.goals.find(g=>g.id===S.emergencyFundGoalId):null;
  const efBal=efGoal?efGoal.current:0;
  if(!efBal){
    breakdown.push({label:'Emergency Fund',score:null,max:15,detail:'Link a savings account or set up an EF goal',hasData:false,isNoData:true,addLink:"closeModal('m-health');go('goals')"});
  } else {
    const moData=_monthsOfTxData();
    if(moData<3){
      breakdown.push({label:'Emergency Fund',score:null,max:15,
        detail:`Need ${3-moData} more month${3-moData===1?'':'s'} of transaction data for accurate calculation`,
        hasData:false,isInsufficient:true,addLink:"closeModal('m-health');openUploadModal('budget')"});
    } else {
      // Use multi-month average expenses for reliable coverage calculation
      const allExpenses=S.transactions.filter(t=>t.amount<0&&!t.internalXfer&&!isExcludedFromSpend(t));
      const totalExp=allExpenses.reduce((s,t)=>s+Math.abs(t.amount),0);
      const avgMonthlyExp=totalExp/moData;
      if(avgMonthlyExp<200){
        breakdown.push({label:'Emergency Fund',score:null,max:15,
          detail:'Expense data appears incomplete — upload more bank statements',
          hasData:false,isInsufficient:true,addLink:"closeModal('m-health');openUploadModal('budget')"});
      } else {
        const efMonths=efBal/avgMonthlyExp;
        const efPts=efMonths>=6?15:efMonths>=3?10:efMonths>=1?5:0;
        breakdown.push({label:'Emergency Fund',score:efPts,max:15,
          detail:`${efMonths.toFixed(1)} months coverage (${fmt(efBal)} ÷ ${fmt(Math.round(avgMonthlyExp))}/mo avg expenses)`,
          hasData:true});
      }
    }
  }

  // ── 5. Bill payment (10pts) ───────────────────────────────────────────────
  if(hasBills){
    const overdue=(S.bills||[]).filter(b=>!b.paused&&daysUntil(b.nextDue)<0).length;
    const bPay=overdue===0?10:overdue===1?5:0;
    breakdown.push({label:'Bill Payment',score:bPay,max:10,detail:overdue===0?'No overdue bills':overdue+' overdue',hasData:true});
  } else {
    breakdown.push({label:'Bill Payment',score:null,max:10,detail:'Add your bills',hasData:false,isNoData:true,addLink:"closeModal('m-health');go('bills')"});
  }

  // ── 6. Debt load (10pts) ──────────────────────────────────────────────────
  if(hasCards){
    const highApr=S.cards.filter(c=>(c.apr||0)>20&&c.balance>0);
    const dPts=highApr.length===0?10:highApr.length===1?5:0;
    breakdown.push({label:'Debt Load',score:dPts,max:10,detail:highApr.length===0?'No high-APR debt':highApr.length+' high-APR card(s) with balances',hasData:true});
  } else {
    breakdown.push({label:'Debt Load',score:null,max:10,detail:'Add credit cards',hasData:false,isNoData:true,addLink:"closeModal('m-health');go('cards')"});
  }

  // Scale to available (scored) points only
  const activeComponents=breakdown.filter(b=>b.score!==null);
  const componentCount=activeComponents.length;
  const availMax=activeComponents.reduce((a,b)=>a+b.max,0);
  const rawScore=activeComponents.reduce((a,b)=>a+b.score,0);
  const score=availMax>0?Math.round((rawScore/availMax)*100):0;

  const label=score>=80?'Excellent':score>=60?'Good':score>=40?'Fair':'Poor';
  const color=score>=70?'var(--green)':score>=40?'var(--yellow)':'var(--red)';
  return {score,label,color,breakdown,hasData:true,componentCount,totalComponents:6};
}

function gaugeHTML(score,color,label){
  const r=42,cx=60,cy=60,circ=2*Math.PI*r;
  const arc=circ*0.75,gap=circ*0.25;
  if(score===null){
    // Empty state: grey ring, dash center
    return `<svg class="gauge-svg" viewBox="0 0 120 120" width="160" height="160">
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--surface3)" stroke-width="9" stroke-dasharray="${arc} ${gap}" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-225 ${cx} ${cy})"/>
      <text x="${cx}" y="${cy+2}" text-anchor="middle" dominant-baseline="middle" fill="var(--dim)" font-size="28" font-weight="700" font-family="Inter,sans-serif">—</text>
    </svg>`;
  }
  const filled=arc*(score/100);
  return `<svg class="gauge-svg" viewBox="0 0 120 120" width="160" height="160">
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--surface3)" stroke-width="9" stroke-dasharray="${arc} ${gap}" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-225 ${cx} ${cy})"/>
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="9" stroke-dasharray="${filled} ${circ-filled}" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-225 ${cx} ${cy})" style="transition:stroke-dasharray .5s ease"/>
    <text x="${cx}" y="${cy-2}" text-anchor="middle" dominant-baseline="middle" fill="var(--text)" font-size="24" font-weight="700" font-family="Inter,sans-serif">${score}</text>
    <text x="${cx}" y="${cy+20}" text-anchor="middle" fill="var(--text-sec)" font-size="11" font-family="Inter,sans-serif" font-weight="600" letter-spacing="2">${label.toUpperCase()}</text>
  </svg>`;
}

function _scoreReliabilityBadge(componentCount,totalComponents,breakdown){
  const missingReasons=(breakdown||[]).filter(b=>!b.hasData&&b.isInsufficient);
  const noData=(breakdown||[]).filter(b=>!b.hasData&&b.isNoData);
  if(componentCount>=totalComponents){
    return '<span style="font-size:11px;color:var(--text-sec)"><span style="color:#00D4AA">●</span> Complete score — all 6 components active</span>';
  }
  const msg=missingReasons.length>0
    ?`Score based on <strong>${componentCount} of ${totalComponents}</strong> components — add income data and more statements for a complete score.`
    :`Score based on <strong>${componentCount} of ${totalComponents}</strong> components — add more accounts to complete your score.`;
  const dotClr=componentCount>=4?'var(--yellow)':'var(--red)';
  return `<span style="font-size:11px;color:var(--text-sec);line-height:1.5"><span style="color:${dotClr}">●</span> ${msg}</span>`;
}

// ── SCORE SETUP JOURNEY ──────────────────────────────────────────────────────

let _sjState=null;

function _shouldShowJourney(){
  if(AnchorDB.preferences.scoreSetupComplete) return false;
  const skip=localStorage.getItem('anchor_score_journey_skip');
  if(skip&&(Date.now()-parseInt(skip))<7*24*60*60*1000) return false;
  const h=calcHealthScore();
  return !h.hasData||h.breakdown.some(b=>b.score===null);
}

function openScoreJourney(){
  const prog=AnchorDB.preferences.scoreSetupProgress;
  if(prog&&prog.step&&prog.step<4&&prog.effectiveSteps){
    _sjState=prog;
    const lbls={1:'Income setup',2:'Income verification',3:'Budget setup'};
    $('sj-content').innerHTML=`
      <div style="text-align:center;padding:40px 0 24px">
        <div style="font-size:36px;margin-bottom:16px">📍</div>
        <div style="font-size:19px;font-weight:800;margin-bottom:8px">Continue where you left off?</div>
        <div style="color:var(--text-sec);font-size:14px;line-height:1.6;margin-bottom:28px">
          You started setting up your score.<br>Pick up at: <strong>${lbls[prog.step]||'Step '+prog.step}</strong>
        </div>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <button class="btn btn-primary" onclick="_sjRender(${prog.step})">Continue</button>
          <button class="btn btn-ghost" onclick="_sjStartFresh()">Start over</button>
        </div>
      </div>`;
    _sjOpen(); return;
  }
  _sjStartFresh();
}

function _sjStartFresh(){
  _sjState={
    step:1, effectiveSteps:_sjEffectiveSteps(), sources:[_sjNewSource()],
    budget:{mode:S.budgetMode||'dollar',amount:S.budgetTarget||0,pct:S.budgetTargetPct||0},
    verificationChoice:null, reconChoice:null, detectedMonthly:0, _rev:null
  };
  _sjRender(1); _sjOpen();
}

function _sjEffectiveSteps(){
  return (S.paySchedule&&S.paySchedule.avgAmount>0)?[1,2,3,4]:[1,3,4];
}

function _sjNewSource(){
  const y1=new Date();y1.setFullYear(y1.getFullYear()-1);
  return {id:uid(),type:'salary',name:'',paycheckAmount:0,payFreq:'biweekly',
    showGross:false,grossSalary:0,nextPayday:'',earlyDays:1,monthlyDay:15,
    hourlyRate:0,hoursPerWeek:40,monthlyAvg:0,isConsistent:true,
    monthlyRent:0,benefitType:'social_security',monthlyBenefits:0,monthlyOther:0,
    startDate:y1.toISOString().split('T')[0],endDate:'',hasEndDate:false,
    isSeasonal:false,activeMonths:[],isRenewable:false,renewalReminderDays:30,
    isManual:true,createdAt:new Date().toISOString()};
}

function _sjOpen(){$('m-score-journey').style.display='block';document.body.style.overflow='hidden';}
function _sjClose(){$('m-score-journey').style.display='none';document.body.style.overflow='';}

function _sjSkip(){
  localStorage.setItem('anchor_score_journey_skip',Date.now());
  _sjClose(); showHealthBreakdownDirect();
}

function _sjRender(step){
  if(!_sjState) return _sjStartFresh();
  _sjState.step=step;
  AnchorDB.preferences.scoreSetupProgress={
    step,effectiveSteps:_sjState.effectiveSteps,sources:_sjState.sources,
    budget:_sjState.budget,verificationChoice:_sjState.verificationChoice,
    reconChoice:_sjState.reconChoice,detectedMonthly:_sjState.detectedMonthly
  };
  save();
  const el=$('sj-content'); if(!el) return;
  if(step===1) el.innerHTML=_sjStep1HTML();
  else if(step===2) el.innerHTML=_sjStep2HTML();
  else if(step===3) el.innerHTML=_sjStep3HTML();
  else if(step===4){el.innerHTML=_sjStep4HTML();setTimeout(_sjAnimateStep4,100);}
  $('m-score-journey').scrollTop=0;
}

function _sjBack(step){
  if(step===4){AnchorDB.preferences.scoreSetupComplete=false;AnchorDB.preferences.scoreSetupCompletedAt=null;}
  const steps=_sjState.effectiveSteps, pos=steps.indexOf(step);
  if(pos>0) _sjRender(steps[pos-1]);
}

function _sjAdvance(step){
  const steps=_sjState.effectiveSteps, pos=steps.indexOf(step);
  if(pos<steps.length-1) _sjRender(steps[pos+1]);
}

function _sjHeader(step,showBack){
  const steps=_sjState?_sjState.effectiveSteps:[1,3,4];
  const pos=steps.indexOf(step), display=pos+1, total=steps.length;
  const pct=Math.round((display-1)/total*100);
  return `
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
      ${showBack?`<button class="btn btn-ghost btn-sm" onclick="_sjBack(${step})" style="padding:6px 10px">← Back</button>`:'<div style="min-width:80px"></div>'}
      <div class="fs11 fw6" style="letter-spacing:.08em;text-transform:uppercase;color:var(--text-sec)">Step ${display} of ${total}</div>
      <button onclick="_sjSkip()" style="background:none;border:none;color:var(--muted);font-size:12px;cursor:pointer;padding:4px 8px">Skip for now</button>
    </div>
    <div class="sj-progress-bar"><div class="sj-progress-fill" style="width:${pct}%"></div></div>`;
}

// ── Step 1: Income Setup ─────────────────────────────────────────────────────

function _sjStep1HTML(){
  const srcs=_sjState.sources;
  return `
    ${_sjHeader(1,false)}
    <div style="text-align:center;margin-bottom:24px">
      <div style="font-size:22px;font-weight:800;margin-bottom:6px">Let's set up your income</div>
      <div style="color:var(--text-sec);font-size:14px;line-height:1.5">This powers your debt-to-income ratio and budget calculations.</div>
    </div>
    <div class="sj-privacy">🔒 This stays on your device only — never shared, never stored elsewhere</div>
    <div id="sj-income-sources">${srcs.map((s,i)=>_sjIncomeCardHTML(s,i)).join('')}</div>
    <button onclick="_sjAddSource()" style="display:block;width:100%;padding:10px;margin-bottom:16px;border:1.5px dashed var(--border);border-radius:var(--r);background:transparent;color:var(--text-sec);font-size:13px;cursor:pointer">+ Add another income source</button>
    <div class="sj-monthly-total" id="sj-totals">${_sjTotalsHTML()}</div>
    <div style="padding-top:8px">
      <button class="btn btn-primary" style="width:100%;padding:14px;font-size:15px" onclick="_sjSaveStep1()">Continue →</button>
      <div style="text-align:center;margin-top:12px">
        <button onclick="_sjAdvance(1)" style="background:none;border:none;color:var(--muted);font-size:13px;cursor:pointer;text-decoration:underline">Skip income setup</button>
      </div>
    </div>`;
}

function _sjIncomeCardHTML(src,idx){
  const types=[{id:'salary',icon:'💼',label:'Salary'},{id:'hourly',icon:'⏰',label:'Hourly'},
    {id:'freelance',icon:'💻',label:'Freelance'},{id:'contract',icon:'📋',label:'Contract'},
    {id:'rental',icon:'🏠',label:'Rental'},{id:'benefits',icon:'🏛️',label:'Benefits'},
    {id:'other',icon:'➕',label:'Other'}];
  const canDel=_sjState.sources.length>1;
  return `<div class="sj-income-card" id="sj-card-${idx}">
    ${canDel?`<button onclick="_sjRemoveSource(${idx})" style="position:absolute;top:10px;right:12px;background:none;border:none;color:var(--muted);cursor:pointer;font-size:20px;line-height:1;padding:0">×</button>`:''}
    ${_sjState.sources.length>1?`<div class="fs11 fw6 mb8" style="text-transform:uppercase;letter-spacing:.06em;color:var(--text-sec)">Income source #${idx+1}</div>`:''}
    <div class="sj-type-pills">${types.map(t=>`<button class="sj-type-pill${src.type===t.id?' active':''}" onclick="_sjSetType(${idx},'${t.id}')">${t.icon} ${t.label}</button>`).join('')}</div>
    ${_sjTypeFields(src,idx)}
    ${_sjDateFieldsHTML(src,idx)}
  </div>`;
}

function _sjTypeFields(src,idx){
  const i=idx;
  const freqBtns=['weekly','biweekly','semimonthly','monthly'].map(f=>{
    const lbl={weekly:'Weekly',biweekly:'Every 2 weeks',semimonthly:'Twice a month',monthly:'Monthly'}[f];
    return `<button class="sj-type-pill${src.payFreq===f?' active':''}" style="font-size:12px;padding:5px 10px" onclick="_sjSetFreq(${i},'${f}')">${lbl}</button>`;
  }).join('');

  if(src.type==='salary'){
    const mo=_sjSourceMonthly(src);
    const grossMo=src.grossSalary>0?Math.round(src.grossSalary/12):0;
    return `
      <div class="form-group mb8"><label class="form-label">Employer name <span class="text-muted fw4 fs11">(optional)</span></label>
        <input class="form-input" type="text" placeholder="e.g. Fairleigh Dickinson" value="${esc(src.name||'')}" oninput="_sjField(${i},'name',this.value)"></div>
      <div class="form-group mb8"><label class="form-label">Take-home per paycheck <span class="text-muted fw4 fs11">after taxes</span></label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.paycheckAmount||''}" oninput="_sjField(${i},'paycheckAmount',+this.value);_sjRefreshTotals()"></div>
      <div class="form-group mb8"><label class="form-label">Pay frequency</label>
        <div class="sj-type-pills" style="margin-bottom:0">${freqBtns}</div></div>
      ${mo>0?`<div class="fs13 fw7 mb12" style="color:var(--green)">= ~${fmt(mo)}/month take-home</div>`:''}
      <label class="flex gap8 align-center fs13 mb8" style="cursor:pointer">
        <input type="checkbox" ${src.showGross?'checked':''} onchange="_sjField(${i},'showGross',this.checked);_sjRefreshCard(${i})">
        I know my gross salary (for bank-standard DTI)
      </label>
      ${src.showGross?`<div class="form-group mb8"><label class="form-label">Annual salary (gross)</label>
        <input class="form-input" type="number" placeholder="e.g. 72000" value="${src.grossSalary||''}" oninput="_sjField(${i},'grossSalary',+this.value)">
        <div class="fs11 text-muted mt2">Used for bank-standard DTI${grossMo>0?' · ~'+fmt(grossMo)+'/mo gross':''}</div></div>`:''}
      <details><summary class="fs12 text-muted" style="cursor:pointer">Pay date settings (optional)</summary>
        <div style="padding-top:10px">
          ${src.payFreq==='biweekly'?`<div class="form-group mb8"><label class="form-label">Next payday</label>
            <input class="form-input" type="date" value="${src.nextPayday||''}" oninput="_sjField(${i},'nextPayday',this.value)">
            <div class="fs11 text-muted mt2">We'll calculate all future paydays from this</div></div>`:''}
          ${src.payFreq==='monthly'?`<div class="form-group mb8"><label class="form-label">Day of month (1–28)</label>
            <input class="form-input" type="number" min="1" max="28" placeholder="15" value="${src.monthlyDay||''}" oninput="_sjField(${i},'monthlyDay',+this.value)"></div>`:''}
          <div class="form-group mb0"><label class="form-label">Bank early deposit</label>
            <div class="sj-type-pills" style="margin-bottom:4px">
              ${[0,1,2,3].map(d=>`<button class="sj-type-pill${src.earlyDays===d?' active':''}" style="font-size:11px;padding:4px 8px" onclick="_sjField(${i},'earlyDays',${d})">${d===0?'Same day':d+'d early'}</button>`).join('')}
            </div>
            <div class="fs11 text-muted">If payday falls on a weekend or holiday, Anchor moves it to the previous business day.</div>
          </div>
        </div>
      </details>`;
  }

  if(src.type==='hourly'){
    const mo=_sjSourceMonthly(src);
    return `
      <div class="form-group mb8"><label class="form-label">Employer name <span class="text-muted fw4 fs11">(optional)</span></label>
        <input class="form-input" type="text" placeholder="e.g. Company Inc." value="${esc(src.name||'')}" oninput="_sjField(${i},'name',this.value)"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
        <div class="form-group mb0"><label class="form-label">Hourly rate ($)</label>
          <input class="form-input" type="number" placeholder="0.00" value="${src.hourlyRate||''}" oninput="_sjField(${i},'hourlyRate',+this.value);_sjRefreshTotals()"></div>
        <div class="form-group mb0"><label class="form-label">Hours/week</label>
          <input class="form-input" type="number" placeholder="40" value="${src.hoursPerWeek||40}" oninput="_sjField(${i},'hoursPerWeek',+this.value);_sjRefreshTotals()"></div>
      </div>
      <div class="form-group mb8"><label class="form-label">Pay frequency</label>
        <div class="sj-type-pills" style="margin-bottom:0">${freqBtns}</div></div>
      ${mo>0?`<div class="fs13 fw7 mb2" style="color:var(--green)">~${fmt(mo)}/month take-home estimate</div>
        <div class="fs11 text-muted mb8">Estimate assumes ~22% effective tax rate</div>`:''}`;
  }

  if(src.type==='freelance'){
    return `
      <div class="form-group mb8"><label class="form-label">Source name <span class="text-muted fw4 fs11">(optional)</span></label>
        <input class="form-input" type="text" placeholder="e.g. Consulting, Etsy shop" value="${esc(src.name||'')}" oninput="_sjField(${i},'name',this.value)"></div>
      <div class="form-group mb8"><label class="form-label">Average monthly income ($)</label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.monthlyAvg||''}" oninput="_sjField(${i},'monthlyAvg',+this.value);_sjRefreshTotals()">
        <div class="fs11 text-muted mt2">After business expenses, before personal taxes</div></div>
      <label class="flex gap8 align-center fs13 mb4" style="cursor:pointer">
        <input type="checkbox" ${src.isConsistent!==false?'checked':''} onchange="_sjField(${i},'isConsistent',this.checked)">
        Income is consistent month to month
      </label>
      ${src.isConsistent===false?`<div class="fs11 text-muted">Estimate based on last 12 months average</div>`:''}`;
  }

  if(src.type==='rental'){
    const rent=src.monthlyRent||0;
    return `
      <div class="form-group mb8"><label class="form-label">Property description <span class="text-muted fw4 fs11">(optional)</span></label>
        <input class="form-input" type="text" placeholder="e.g. 2BR Apartment" value="${esc(src.name||'')}" oninput="_sjField(${i},'name',this.value)"></div>
      <div class="form-group mb8"><label class="form-label">Monthly rent received ($)</label>
        <input class="form-input" type="number" placeholder="0.00" value="${rent||''}" oninput="_sjField(${i},'monthlyRent',+this.value);_sjRefreshTotals()"></div>
      <div class="fs12 text-muted mb8">75% counted toward DTI (standard bank calculation)</div>
      ${rent>0?`<div class="fs13 fw6" style="color:var(--text-sec)">DTI-eligible: ~${fmt(Math.round(rent*.75))}/mo</div>`:''}`;
  }

  if(src.type==='benefits'){
    const amt=src.monthlyBenefits||0;
    const bTypes=[{id:'social_security',label:'Social Security'},{id:'disability',label:'Disability'},{id:'va',label:'VA Benefits'},{id:'other',label:'Other'}];
    return `
      <div class="form-group mb8"><label class="form-label">Benefit type</label>
        <div class="sj-type-pills" style="margin-bottom:0">${bTypes.map(b=>`<button class="sj-type-pill${src.benefitType===b.id?' active':''}" style="font-size:12px;padding:5px 10px" onclick="_sjField(${i},'benefitType','${b.id}')">${b.label}</button>`).join('')}</div></div>
      <div class="form-group mb8"><label class="form-label">Monthly amount ($)</label>
        <input class="form-input" type="number" placeholder="0.00" value="${amt||''}" oninput="_sjField(${i},'monthlyBenefits',+this.value);_sjRefreshTotals()"></div>
      <div class="fs12 text-muted mb4">Tax-free income grossed up 125% for DTI (standard bank calculation)</div>
      ${amt>0?`<div class="fs13 fw6" style="color:var(--text-sec)">DTI-eligible: ~${fmt(Math.round(amt*1.25))}/mo</div>`:''}`;
  }

  if(src.type==='contract'){
    const mo=_sjSourceMonthly(src);
    return `
      <div class="form-group mb8"><label class="form-label">Employer / Client</label>
        <input class="form-input" type="text" placeholder="e.g. Acme Corp" value="${esc(src.name||'')}" oninput="_sjField(${i},'name',this.value)"></div>
      <div class="form-group mb8"><label class="form-label">Take-home per paycheck <span class="text-muted fw4 fs11">after taxes</span></label>
        <input class="form-input" type="number" placeholder="0.00" value="${src.paycheckAmount||''}" oninput="_sjField(${i},'paycheckAmount',+this.value);_sjRefreshTotals()"></div>
      <div class="form-group mb8"><label class="form-label">Pay frequency</label>
        <div class="sj-type-pills" style="margin-bottom:0">${freqBtns}</div></div>
      ${mo>0?`<div class="fs13 fw7 mb12" style="color:var(--green)">= ~${fmt(mo)}/month take-home</div>`:''}
      <label class="flex gap8 align-center fs13 mb4" style="cursor:pointer">
        <input type="checkbox" ${src.isRenewable?'checked':''} onchange="_sjField(${i},'isRenewable',this.checked)">
        Renewable — remind me before this contract ends
      </label>`;
  }

  return `
    <div class="form-group mb8"><label class="form-label">Source description</label>
      <input class="form-input" type="text" placeholder="e.g. Child support, alimony" value="${esc(src.name||'')}" oninput="_sjField(${i},'name',this.value)"></div>
    <div class="form-group mb8"><label class="form-label">Monthly amount ($)</label>
      <input class="form-input" type="number" placeholder="0.00" value="${src.monthlyOther||''}" oninput="_sjField(${i},'monthlyOther',+this.value);_sjRefreshTotals()"></div>`;
}

function _sjSourceMonthly(src){
  const mult={weekly:52/12,biweekly:26/12,semimonthly:2,monthly:1}[src.payFreq||'biweekly']||(26/12);
  switch(src.type){
    case 'salary':
    case 'contract': return Math.round((src.paycheckAmount||0)*mult);
    case 'hourly':   return Math.round((src.hourlyRate||0)*(src.hoursPerWeek||40)*52/12*0.78);
    case 'freelance':return src.monthlyAvg||0;
    case 'rental':   return Math.round((src.monthlyRent||0)*.75);
    case 'benefits': return src.monthlyBenefits||0;
    case 'other':    return src.monthlyOther||0;
  }
  return 0;
}

function _sjTotalMonthlyNet(){
  return Math.round((_sjState.sources||[]).reduce((s,src)=>s+_sjSourceMonthly(src),0));
}

function _sjTotalDTIGross(){
  return Math.round((_sjState.sources||[]).reduce((s,src)=>{
    if(src.type==='salary'&&src.grossSalary>0) return s+Math.round(src.grossSalary/12);
    if(src.type==='benefits') return s+Math.round((src.monthlyBenefits||0)*1.25);
    return s+_sjSourceMonthly(src);
  },0));
}

function _sjTotalsHTML(){
  const net=_sjTotalMonthlyNet(), gross=_sjTotalDTIGross();
  if(!net&&!gross) return `<div class="fs12 text-muted">Enter income amounts above to see your monthly total</div>`;
  return `
    <div style="display:flex;justify-content:space-between;align-items:center">
      <span class="fs13 fw6">Total monthly take-home</span>
      <span class="fs15 fw7" style="color:var(--green)">~${fmt(net)}</span>
    </div>
    ${gross>0&&gross!==net?`<div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px">
      <span class="fs12 text-muted">DTI-eligible (gross)</span>
      <span class="fs13 fw6" style="color:var(--text-sec)">~${fmt(gross)}</span>
    </div>`:''}`;
}

function _sjField(idx,field,value){if(_sjState&&_sjState.sources[idx]!==undefined)_sjState.sources[idx][field]=value;}

function _sjSetType(idx,type){if(!_sjState)return;_sjState.sources[idx].type=type;_sjRefreshCard(idx);}
function _sjSetFreq(idx,freq){if(!_sjState)return;_sjState.sources[idx].payFreq=freq;_sjRefreshCard(idx);}

function _sjRefreshCard(idx){
  const el=$('sj-card-'+idx);
  if(!el||!_sjState)return;
  const tmp=document.createElement('div');
  tmp.innerHTML=_sjIncomeCardHTML(_sjState.sources[idx],idx);
  el.replaceWith(tmp.firstElementChild);
  _sjRefreshTotals();
}

function _sjRefreshTotals(){const el=$('sj-totals');if(el)el.innerHTML=_sjTotalsHTML();}

function _sjAddSource(){
  if(!_sjState)return;
  _sjState.sources.push(_sjNewSource());
  const el=$('sj-income-sources');
  if(el)el.innerHTML=_sjState.sources.map((s,i)=>_sjIncomeCardHTML(s,i)).join('');
  _sjRefreshTotals();
}

function _sjRemoveSource(idx){
  if(!_sjState)return;
  _sjState.sources.splice(idx,1);
  if(!_sjState.sources.length)_sjState.sources.push(_sjNewSource());
  const el=$('sj-income-sources');
  if(el)el.innerHTML=_sjState.sources.map((s,i)=>_sjIncomeCardHTML(s,i)).join('');
  _sjRefreshTotals();
}

function _sjDateFieldsHTML(src,idx){
  const i=idx;
  const mos=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const stBadge=()=>{
    const st=getIncomeStatus(src);
    if(st.status==='active') return '';
    let note='';
    if(st.status==='upcoming') note=`<div class="fs11 mt4" style="color:#f59e0b">Not included in income calculations until this start date arrives.</div>`;
    else if(st.status==='seasonal-inactive') note=`<div class="fs11 mt4" style="color:#3b82f6">Excluded from calculations for inactive months. Active months contribute normally.</div>`;
    else if(st.status==='ending-soon') note=`<div class="fs11 mt4" style="color:#f59e0b">${st.warning||''} — income will stop being counted after that date.</div>`;
    else if(st.status==='ended') note=`<div class="fs11 mt4" style="color:var(--red)">This income is no longer counted. Update or remove this source.</div>`;
    return `<div style="margin-top:6px">${_srcStatusBadge(src)}${note}</div>`;
  };
  return `<div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
      <div class="form-group mb0"><label class="form-label">Start date <span class="text-muted fw4 fs11">(optional)</span></label>
        <input class="form-input" type="date" value="${src.startDate||''}" oninput="_sjField(${i},'startDate',this.value)"></div>
      <div class="form-group mb0" id="sj-end-date-wrap-${i}" style="display:${src.hasEndDate?'block':'none'}">
        <label class="form-label">End date</label>
        <input class="form-input" type="date" value="${src.endDate||''}" oninput="_sjField(${i},'endDate',this.value)"></div>
    </div>
    <label class="flex gap8 align-center fs13 mb8" style="cursor:pointer">
      <input type="checkbox" ${src.hasEndDate?'checked':''} onchange="_sjToggleEndDate(${i},this.checked)">
      This job has an end date
    </label>
    <label class="flex gap8 align-center fs13 mb0" style="cursor:pointer">
      <input type="checkbox" ${src.isSeasonal?'checked':''} onchange="_sjField(${i},'isSeasonal',this.checked);_sjRefreshCard(${i})">
      Seasonal income (not year-round)
    </label>
    ${src.isSeasonal?`<div style="margin-top:8px;padding:10px;background:var(--surface3);border-radius:var(--r-sm)">
      <div class="fs11 fw6 mb8" style="text-transform:uppercase;letter-spacing:.04em;color:var(--text-sec)">Active months:</div>
      <div style="display:flex;gap:4px;flex-wrap:wrap">
        ${mos.map((mo,mi)=>`<label style="display:inline-flex;align-items:center;gap:3px;cursor:pointer;font-size:12px;min-width:38px">
          <input type="checkbox" ${(src.activeMonths||[]).includes(mi)?'checked':''} onchange="_sjToggleMonth(${i},${mi},this.checked)">${mo}</label>`).join('')}
      </div></div>`:''}
    ${stBadge()}
    <div class="fs11 text-muted mt6">Start and end dates let Anchor calculate accurate income for the months you actually worked.</div>
  </div>`;
}

function _sjToggleEndDate(idx,checked){
  _sjField(idx,'hasEndDate',checked);
  if(!checked) _sjField(idx,'endDate','');
  const el=$('sj-end-date-wrap-'+idx);
  if(el) el.style.display=checked?'block':'none';
}

function _sjToggleMonth(idx,mi,checked){
  if(!_sjState||!_sjState.sources[idx]) return;
  const months=[...(_sjState.sources[idx].activeMonths||[])];
  if(checked&&!months.includes(mi)) months.push(mi);
  else if(!checked){const p=months.indexOf(mi);if(p>=0)months.splice(p,1);}
  _sjState.sources[idx].activeMonths=months.sort((a,b)=>a-b);
}

function _sjSaveStep1(){
  if(!_sjState)return;
  const net=_sjTotalMonthlyNet(), gross=_sjTotalDTIGross();
  const primary=_sjState.sources[0];
  const grossSrc=_sjState.sources.find(s=>s.type==='salary'&&s.grossSalary>0);
  if(net>0||gross>0){
    S.incomeSettings={
      ...(S.incomeSettings||{}),
      manualMonthlyNet:net>0?net:(S.incomeSettings?.manualMonthlyNet||0),
      grossMonthly:gross>net?gross:(S.incomeSettings?.grossMonthly||0),
      grossSalary:grossSrc?grossSrc.grossSalary:(S.incomeSettings?.grossSalary||0),
      dtiIncomeBase:gross>net&&gross>0?'gross':'net',
    };
    if(primary.type==='salary'){
      if(primary.nextPayday){if(!AnchorDB.payday.config)AnchorDB.payday.config={};AnchorDB.payday.config.nextPayday=primary.nextPayday;}
      AnchorDB.payday.earlyDepositDays=primary.earlyDays||1;
    }
    _syncIncomeConfigFromSettings();
    // Persist full source objects to canonical sources array
    if(!AnchorDB.income.sources) AnchorDB.income.sources=[];
    const _existIds=new Set(AnchorDB.income.sources.map(s=>s.id));
    _sjState.sources.forEach(src=>{
      const fullSrc={...src,
        monthlyNet:src.type==='rental'?(src.monthlyRent||0):_sjSourceMonthly(src),
        monthlyGross:src.type==='salary'&&src.grossSalary?Math.round(src.grossSalary/12):0,
        isManual:true,lastUpdated:new Date().toISOString()};
      if(_existIds.has(src.id)){const pos=AnchorDB.income.sources.findIndex(s=>s.id===src.id);if(pos>=0)AnchorDB.income.sources[pos]=fullSrc;}
      else AnchorDB.income.sources.push(fullSrc);
    });
    DataStore.sync('journey-step1');
  }
  _sjAdvance(1);
}

// ── Step 2: Income Verification ──────────────────────────────────────────────

function _sjStep2HTML(){
  const ps=S.paySchedule;
  if(!ps||!ps.avgAmount){setTimeout(()=>_sjAdvance(2),50);return '<div style="padding:40px;text-align:center" class="text-muted">Checking deposits…</div>';}
  const freqMult={weekly:52/12,biweekly:26/12,'bi-weekly':26/12,'semi-monthly':2,monthly:1};
  const detMo=Math.round(ps.avgAmount*(freqMult[ps.cycle]||26/12));
  _sjState.detectedMonthly=detMo;
  const amts=(ps.amounts||[]).slice(-8);
  const hi=amts.length?Math.max(...amts):ps.avgAmount;
  const lo=amts.length?Math.min(...amts):ps.avgAmount;
  const variance=hi>0?(hi-lo)/hi:0;
  const barH=36;
  const miniChart=amts.length>1?`
    <div style="display:flex;align-items:flex-end;gap:3px;height:${barH}px;margin:10px 0 4px">
      ${amts.map(a=>`<div style="flex:1;height:${hi>0?Math.max(3,Math.round(a/hi*(barH-2))):3}px;background:${variance>.25?'var(--yellow)':'var(--green)'};border-radius:2px 2px 0 0;opacity:.8"></div>`).join('')}
    </div>
    <div class="fs11 text-muted">Avg: ${fmt(ps.avgAmount)} · High: ${fmt(hi)} · Low: ${fmt(lo)}</div>
    ${variance>.25?`<div class="fs11 mt4" style="color:var(--yellow)">⚠ Paychecks vary — we'll use the average for calculations</div>`:''}` : '';
  return `
    ${_sjHeader(2,true)}
    <div style="text-align:center;margin-bottom:24px">
      <div style="font-size:22px;font-weight:800;margin-bottom:6px">Let's verify your income</div>
      <div style="color:var(--text-sec);font-size:14px">We found these deposits in your accounts.</div>
    </div>
    <div class="sj-income-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px">
        <div><div class="fs15 fw7">${esc(ps.employer||'Detected deposits')}</div>
          <div class="fs12 text-muted">${ps.count} paychecks · ${ps.cycle||'regular'}</div></div>
        <span class="badge" style="background:rgba(108,99,255,.12);color:var(--accent)">${fmt(ps.avgAmount)}/check</span>
      </div>
      ${ps.hasSplits&&ps.splitAccountPcts?`<div style="background:var(--surface3);border-radius:var(--r-sm);padding:10px 12px;margin-bottom:12px">
        <div class="fs12 fw6 mb6">Split paycheck across accounts:</div>
        ${ps.splitAccountPcts.map(sp=>`<div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:2px"><span class="text-muted">${esc(sp.account)}</span><span class="fw6">~${fmt(Math.round(ps.avgAmount*sp.pct))}</span></div>`).join('')}
        <div style="display:flex;justify-content:space-between;font-size:12px;border-top:1px solid var(--border);margin-top:6px;padding-top:6px"><span class="fw6">Total per check</span><span class="fw7 text-green">~${fmt(ps.avgAmount)}</span></div>
      </div>`:''}
      ${miniChart}
      ${(()=>{
        const srcs=_sjState?.sources||[];
        const lastDeposit=ps.lastPaydate||(ps.paychecks?.length?[...ps.paychecks].sort((a,b)=>b.payPeriodDate.localeCompare(a.payPeriodDate))[0]?.payPeriodDate:null);
        if(!lastDeposit||!srcs.length) return '';
        const notes=[];
        srcs.forEach(src=>{
          if(src.endDate&&lastDeposit>src.endDate) notes.push(`<div class="fs11 mt4" style="color:#f59e0b">⚠ Deposits detected after the configured end date for <strong>${esc(src.name||src.type)}</strong> (${src.endDate}). Verify the end date is correct or update it.</div>`);
          if(src.startDate&&src.startDate>lastDeposit) notes.push(`<div class="fs11 mt4" style="color:#3b82f6">ℹ <strong>${esc(src.name||src.type)}</strong> is set to start ${src.startDate}, but deposits were detected before then. You may need to adjust the start date.</div>`);
        });
        return notes.length?`<div style="margin-top:8px">${notes.join('')}</div>`:'';
      })()}
      <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap" id="sj-verify-btns">
        <button class="btn btn-sm btn-primary" onclick="_sjVerify('confirm',${detMo})">✓ This matches my income</button>
        <button class="btn btn-sm btn-ghost" onclick="_sjVerify('deny',${detMo})">✗ Not my income</button>
        <button class="btn btn-sm btn-ghost" onclick="_sjVerify('edit',${detMo})">✎ Edit amount</button>
      </div>
    </div>
    <div id="sj-reconcile" style="margin-top:12px"></div>
    <div style="padding-top:20px">
      <button class="btn btn-primary" style="width:100%;padding:14px" onclick="_sjSaveStep2()">Continue →</button>
    </div>`;
}

function _sjVerify(choice,detMo){
  _sjState.verificationChoice=choice; _sjState.detectedMonthly=detMo;
  const manNet=_sjTotalMonthlyNet()||(S.incomeSettings?.manualMonthlyNet||0);
  const diff=manNet>0&&detMo>0?Math.abs(detMo-manNet)/Math.max(detMo,manNet):1;
  const btns=$('sj-verify-btns');
  if(btns)btns.querySelectorAll('button').forEach((b,i)=>{
    b.className='btn btn-sm '+([choice==='confirm',choice==='deny',choice==='edit'][i]?'btn-primary':'btn-ghost');
  });
  const rec=$('sj-reconcile'); if(!rec)return;
  if(choice==='deny'){
    rec.innerHTML=`<div class="fs13 text-muted" style="padding:6px 0">Got it — these won't be counted as your income.</div>`;
    _sjState.reconChoice='manual';
  } else if(choice==='confirm'&&diff<0.2){
    rec.innerHTML=`<div class="sj-privacy" style="background:rgba(0,212,170,.07)">✓ Your configured income (${fmt(manNet)}/mo) matches what we detected. We'll use your configured amount.</div>`;
    _sjState.reconChoice='manual';
  } else if(choice==='confirm'&&manNet>0&&diff>=0.2){
    rec.innerHTML=`<div class="sj-income-card">
      <div class="fs13 fw6 mb10">Your configured income (${fmt(manNet)}/mo) differs from detected (~${fmt(detMo)}/mo). Which should we use?</div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <button class="btn btn-sm btn-ghost" id="rec-manual" onclick="_sjSetRecon('manual')">My configured amount (${fmt(manNet)}/mo)</button>
        <button class="btn btn-sm btn-ghost" id="rec-detected" onclick="_sjSetRecon('detected')">Detected average (~${fmt(detMo)}/mo)</button>
        <button class="btn btn-sm btn-ghost" id="rec-both" onclick="_sjSetRecon('both')">Both — manual for DTI, detected for trends</button>
      </div></div>`;
    _sjState.reconChoice='manual';
  } else {
    rec.innerHTML=`<div class="form-group mb0"><label class="form-label">Correct monthly take-home ($)</label>
      <input class="form-input" type="number" placeholder="${detMo||''}" value="${detMo||''}" oninput="_sjState.detectedMonthly=+this.value"></div>`;
    _sjState.reconChoice='detected';
  }
}

function _sjSetRecon(choice){
  _sjState.reconChoice=choice;
  ['manual','detected','both'].forEach(c=>{const el=$('rec-'+c);if(el)el.className='btn btn-sm '+(c===choice?'btn-primary':'btn-ghost');});
}

function _sjSaveStep2(){
  const choice=_sjState.reconChoice||'manual', detMo=_sjState.detectedMonthly||0;
  if(choice==='detected'&&detMo>0){S.incomeSettings={...(S.incomeSettings||{}),manualMonthlyNet:detMo};_syncIncomeConfigFromSettings();}
  DataStore.sync('journey-step2'); _sjAdvance(2);
}

// ── Step 3: Budget Setup ─────────────────────────────────────────────────────

function _sjStep3HTML(){
  const income=_sjTotalMonthlyNet()||getMonthlyIncomeBase().amount||0;
  const mode=_sjState.budget.mode, amt=_sjState.budget.amount||S.budgetTarget||0, pct=_sjState.budget.pct||S.budgetTargetPct||0;
  const sug=income>0?[{p:50,tip:'Conservative'},{p:60,tip:'Balanced'},{p:70,tip:'Common target'}]:[];
  const fwks=[
    {label:'50/30/20 rule',pct:80,note:'50% needs + 30% wants + 20% savings → 80% for spending'},
    {label:'60/20/20 rule',pct:80,note:'60% needs + 20% wants + 20% savings → 80% for spending'},
    {label:'Custom',pct:null,note:'Set your own percentage'},
  ];
  return `
    ${_sjHeader(3,true)}
    <div style="text-align:center;margin-bottom:24px">
      <div style="font-size:22px;font-weight:800;margin-bottom:6px">Set your monthly budget</div>
      <div style="color:var(--text-sec);font-size:14px">Used to track budget adherence in your health score.</div>
    </div>
    <div style="display:flex;gap:8px;margin-bottom:20px">
      <button id="sj-mode-dollar" class="btn btn-sm ${mode==='dollar'?'btn-primary':'btn-ghost'}" onclick="_sjSetBudgetMode('dollar')">$ Dollar amount</button>
      <button id="sj-mode-pct" class="btn btn-sm ${mode==='pct'?'btn-primary':'btn-ghost'}" onclick="_sjSetBudgetMode('pct')">% of income</button>
    </div>
    <div id="sj-b-dollar" style="display:${mode==='dollar'?'block':'none'}">
      <div class="form-group mb12"><label class="form-label">Monthly spending budget</label>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="fs20 fw7">$</span>
          <input id="sj-b-amt" class="form-input" style="font-size:22px;font-weight:700;flex:1" type="number" placeholder="0" value="${amt||''}" oninput="_sjState.budget.amount=+this.value">
          <span class="fs14 text-muted">/mo</span>
        </div>
        <div class="fs12 text-muted mt4">How much do you aim to spend monthly?</div></div>
      ${income>0?`<div class="fs12 fw6 mb8" style="color:var(--text-sec)">Based on your income of ~${fmt(income)}/mo:</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
          ${sug.map(s=>`<button class="btn btn-ghost btn-sm" onclick="_sjState.budget.amount=${Math.round(income*s.p/100)};$('sj-b-amt').value=${Math.round(income*s.p/100)}" style="border:1px solid var(--border);border-radius:var(--r-sm);font-size:12px">${s.p}% — ${fmt(Math.round(income*s.p/100))} <span class="text-muted">${s.tip}</span></button>`).join('')}
        </div>`:''}
    </div>
    <div id="sj-b-pct" style="display:${mode==='pct'?'block':'none'}">
      <div class="form-group mb12"><label class="form-label">Percentage of income</label>
        <div style="display:flex;align-items:center;gap:8px">
          <input id="sj-b-pct-val" class="form-input" style="font-size:22px;font-weight:700;width:90px" type="number" min="1" max="100" placeholder="0" value="${pct||''}" oninput="_sjState.budget.pct=+this.value;_sjUpdateBudgetPctDisplay()">
          <span class="fs20 fw7">%</span><span class="fs13 text-muted">of income</span>
        </div>
        <div id="sj-b-pct-disp" class="fs13 fw6 mt4 text-green">${income>0&&pct>0?'= ~'+fmt(Math.round(income*pct/100))+'/mo':''}</div></div>
      <div class="fs12 fw6 mb8" style="text-transform:uppercase;letter-spacing:.06em;color:var(--text-sec)">Framework presets</div>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px">
        ${fwks.map(f=>`<button class="btn btn-ghost" onclick="_sjApplyFramework(${f.pct||0})" style="text-align:left;padding:10px 12px;border:1px solid var(--border);border-radius:var(--r-sm)">
          <div class="fw6 fs13">${f.label}</div>
          <div class="fs11 text-muted">${f.note}${f.pct&&income>0?' · '+fmt(Math.round(income*f.pct/100))+'/mo':''}</div>
        </button>`).join('')}
      </div>
    </div>
    <details style="margin:16px 0">
      <summary class="fs13 fw6" style="cursor:pointer;color:var(--text-sec)">Category budgets — optional</summary>
      <div style="padding:12px 0 4px">
        <div class="fs12 text-muted mb10">Set per-category limits. You can change these anytime in Budget settings.</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
          ${['Housing','Food','Transport','Shopping','Bills','Other'].map(cat=>`
            <div class="form-group mb0"><label class="form-label fs11">${cat}</label>
              <div style="display:flex;align-items:center;gap:4px"><span class="fs12">$</span>
                <input class="form-input" type="number" placeholder="0" style="font-size:13px" value="${(S.catBudgets||{})[cat]||''}" oninput="S.catBudgets={...(S.catBudgets||{}),'${cat}':+this.value||undefined}"></div>
            </div>`).join('')}
        </div>
      </div>
    </details>
    <div style="padding-top:8px">
      <button class="btn btn-primary" style="width:100%;padding:14px;font-size:15px" onclick="_sjSaveStep3()">Continue →</button>
      <div style="text-align:center;margin-top:12px">
        <button onclick="_sjAdvance(3)" style="background:none;border:none;color:var(--muted);font-size:13px;cursor:pointer;text-decoration:underline">Skip budget setup</button>
      </div>
    </div>`;
}

function _sjSetBudgetMode(mode){
  _sjState.budget.mode=mode;
  $('sj-b-dollar').style.display=mode==='dollar'?'block':'none';
  $('sj-b-pct').style.display=mode==='pct'?'block':'none';
  $('sj-mode-dollar').className='btn btn-sm '+(mode==='dollar'?'btn-primary':'btn-ghost');
  $('sj-mode-pct').className='btn btn-sm '+(mode==='pct'?'btn-primary':'btn-ghost');
}

function _sjUpdateBudgetPctDisplay(){
  const el=$('sj-b-pct-disp'); if(!el)return;
  const income=_sjTotalMonthlyNet()||getMonthlyIncomeBase().amount||0;
  const pct=_sjState.budget.pct||0;
  el.textContent=income>0&&pct>0?'= ~'+fmt(Math.round(income*pct/100))+'/mo':'';
}

function _sjApplyFramework(spendPct){
  if(!spendPct)return;
  _sjState.budget.pct=spendPct;
  const el=$('sj-b-pct-val'); if(el)el.value=spendPct;
  _sjUpdateBudgetPctDisplay();
}

function _sjSaveStep3(){
  const {mode,amount:amt,pct}=_sjState.budget;
  if(mode==='dollar'&&amt>0){S.budgetMode='dollar';S.budgetTarget=amt;S.budgetCycle='monthly';}
  else if(mode==='pct'&&pct>0){S.budgetMode='percentage';S.budgetTargetPct=pct;}
  DataStore.sync('journey-step3'); _sjAdvance(3);
}

// ── Step 4: Score Reveal ─────────────────────────────────────────────────────

function _sjStep4HTML(){
  AnchorDB.preferences.scoreSetupComplete=true;
  AnchorDB.preferences.scoreSetupCompletedAt=new Date().toISOString();
  AnchorDB.preferences.scoreSetupProgress=null;
  save();
  const h=calcHealthScore();
  _sjState._rev={score:h.score,color:h.color,label:h.label,breakdown:h.breakdown};
  const steps=_sjState.effectiveSteps, pos=steps.indexOf(4), display=pos+1, total=steps.length;
  return `
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
      <button class="btn btn-ghost btn-sm" onclick="_sjBack(4)" style="padding:6px 10px">← Back</button>
      <div class="fs11 fw6" style="letter-spacing:.08em;text-transform:uppercase;color:var(--text-sec)">Step ${display} of ${total}</div>
      <div style="min-width:80px"></div>
    </div>
    <div class="sj-progress-bar"><div class="sj-progress-fill" style="width:100%"></div></div>
    <div style="text-align:center;margin-bottom:20px">
      <div style="font-size:22px;font-weight:800;margin-bottom:4px">Your Financial Health Score</div>
      <div style="color:var(--text-sec);font-size:14px">Based on your setup</div>
    </div>
    <div style="text-align:center;margin-bottom:4px" id="sj-gauge-wrap">${gaugeHTML(0,h.color,'')}</div>
    <div style="text-align:center;margin-bottom:24px">
      <div id="sj-score-num" style="font-size:44px;font-weight:900;color:${h.color};transition:color .5s;line-height:1">0</div>
      <div id="sj-score-lbl" style="font-size:13px;font-weight:700;letter-spacing:.12em;color:var(--text-sec);margin-top:4px;opacity:0;transition:opacity .5s"></div>
    </div>
    <div id="sj-components" style="margin-bottom:20px"></div>
    <div id="sj-insight" style="margin-bottom:24px"></div>
    ${(()=>{
      const upcoming=(_sjState?.sources||[]).filter(s=>getIncomeStatus(s).status==='upcoming');
      const ended=(_sjState?.sources||[]).filter(s=>getIncomeStatus(s).status==='ended');
      const items=[...upcoming.map(s=>{const st=getIncomeStatus(s);return`<div class="fs12" style="padding:6px 0;border-bottom:1px solid var(--border)33"><span style="color:#f59e0b;font-weight:600">${esc(s.name||s.type)}</span> starts ${s.startDate} — not yet counted in your score. Score may rise when this income begins.</div>`}),...ended.map(s=>`<div class="fs12" style="padding:6px 0;border-bottom:1px solid var(--border)33"><span style="color:var(--red);font-weight:600">${esc(s.name||s.type)}</span> has ended and is excluded from your score.</div>`)];
      if(!items.length) return '';
      return `<div style="background:var(--surface2);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;margin-bottom:20px"><div class="fs12 fw6 mb8" style="color:var(--text-sec)">Income status note</div>${items.join('')}</div>`;
    })()}
    <div style="display:flex;flex-direction:column;gap:10px">
      <button class="btn btn-primary" style="padding:14px;font-size:15px" onclick="_sjClose();showHealthBreakdownDirect()">View full breakdown</button>
      <button class="btn btn-ghost" style="padding:14px" onclick="_sjClose()">Go to dashboard</button>
      <button class="btn btn-ghost btn-sm" style="color:var(--muted);font-size:12px" disabled>Share my score &nbsp;<span class="badge" style="background:var(--surface3);color:var(--muted);font-size:10px">Anchor Pro</span></button>
    </div>`;
}

function _sjAnimateStep4(){
  if(!_sjState||!_sjState._rev)return;
  const {score,color,label,breakdown}=_sjState._rev;
  setTimeout(()=>{
    const gw=$('sj-gauge-wrap');
    if(gw)gw.innerHTML=gaugeHTML(score,color,'');
    let cur=0;
    const frames=60, dur=1500, inc=score/frames;
    const numEl=$('sj-score-num');
    const timer=setInterval(()=>{
      cur=Math.min(cur+inc,score);
      if(numEl)numEl.textContent=Math.round(cur);
      if(cur>=score){
        clearInterval(timer);
        if(numEl)numEl.textContent=score;
        setTimeout(()=>{
          const lbl=$('sj-score-lbl');
          if(lbl){lbl.textContent=label.toUpperCase();lbl.style.opacity='1';}
          setTimeout(()=>_sjRevealComponents(breakdown),300);
        },200);
      }
    },dur/frames);
  },500);
}

function _sjRevealComponents(breakdown){
  const el=$('sj-components'); if(!el)return;
  el.innerHTML=breakdown.map((b,idx)=>{
    const scored=b.score!==null;
    const clr=!scored?'var(--muted)':b.score===b.max?'var(--green)':b.score>0?'var(--yellow)':'var(--red)';
    const barClr=b.barColor||clr;
    return `<div class="sj-reveal-item" style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border);animation-delay:${idx*180}ms">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span class="fs14 fw6">${b.label}</span>
        <span class="fs13 fw7" style="color:${clr}">${scored?b.score+'/'+b.max+' pts':'— pts'}</span>
      </div>
      <div class="bar-wrap" style="margin-bottom:4px">
        <div class="bar-fill" style="width:${scored?Math.round(b.score/b.max*100):0}%;background:${scored?barClr:'var(--surface3)'}"></div>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="fs11 text-muted">${b.detail||''}</span>
        ${!scored&&b.addLink?`<button class="btn btn-ghost" style="font-size:11px;padding:2px 8px;color:var(--accent)" onclick="${b.addLink}">Fix this →</button>`:''}
      </div>
    </div>`;
  }).join('');
  setTimeout(()=>_sjShowInsight(breakdown),breakdown.length*180+400);
}

function _sjShowInsight(breakdown){
  const el=$('sj-insight'); if(!el||!_sjState||!_sjState._rev)return;
  const score=_sjState._rev.score||0;
  const sorted=breakdown.filter(b=>b.score!==null).sort((a,b)=>a.score/a.max-b.score/b.max);
  const worst=sorted[0];
  let msg='';
  if(worst&&worst.score/worst.max<0.4){
    if(worst.label==='Credit Utilization') msg='💳 Your biggest opportunity: Pay down credit card balances. Getting under 30% utilization could add up to 20 points to your score.';
    else if(worst.label==='Debt Load'){
      const drag=(S.cards||[]).filter(c=>(c.apr||0)>20&&c.balance>0).reduce((s,c)=>s+c.balance*(c.apr||0)/100/12,0);
      msg=`📊 High-APR cards are costing ~${fmt(Math.round(drag))}/month in interest. Paying these off first saves the most and boosts your score.`;
    } else if(worst.label.includes('DTI')) msg='📉 Your debt-to-income ratio has room to improve. Reducing debt payments or growing income will move this the most.';
    else if(worst.label==='Emergency Fund') msg='🛡️ Building your emergency fund is your next high-impact move. Even $500–$1,000 provides meaningful protection.';
  }
  if(!msg){
    if(score>=70) msg='✨ Strong financial health! Keep utilization low and maintain your bill payment streak.';
    else if(score>=40) msg='📈 You\'re in fair shape. Focus on your lowest-scoring component to break into the Good range.';
    else msg='🌱 Your score has room to grow. Reducing credit utilization and paying down high-APR debt give the biggest wins.';
  }
  el.innerHTML=`<div style="background:var(--surface2);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;font-size:13px;line-height:1.6;color:var(--text-sec);animation:sjSlideIn .3s ease both">${msg}</div>`;
}

// ── Journey entry point + direct breakdown ───────────────────────────────────

function showHealthBreakdown(){
  if(_shouldShowJourney()){openScoreJourney();return;}
  showHealthBreakdownDirect();
}

function showHealthBreakdownDirect(){
  const {score,label,color,breakdown,hasData,componentCount,totalComponents}=calcHealthScore();
  if(!hasData){
    const COMPONENT_HINTS=[
      {label:'Credit Utilization',hint:'Add a credit card',link:"closeModal('m-health');go('cards')"},
      {label:'Debt-to-Income Ratio',hint:'Upload a bank CSV',link:"closeModal('m-health');go('budget')"},
      {label:'Budget Adherence',hint:'Set a budget',link:"closeModal('m-health');openBudgetModal()"},
      {label:'Emergency Fund',hint:'Link a savings account',link:"closeModal('m-health');go('goals')"},
      {label:'Bill Payment',hint:'Add your bills',link:"closeModal('m-health');go('bills')"},
      {label:'Debt Load',hint:'Add credit cards',link:"closeModal('m-health');go('cards')"},
    ];
    $('health-breakdown-body').innerHTML=`
      <div style="text-align:center;padding:24px 0 16px">
        <div style="font-size:48px;margin-bottom:12px">📊</div>
        <div style="font-size:1rem;font-weight:600;margin-bottom:8px">Your score will appear once you add your financial accounts.</div>
        <div class="text-muted" style="font-size:0.875rem;margin-bottom:24px">Each component below feeds into your score.</div>
      </div>
      ${COMPONENT_HINTS.map(h=>`
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)">
          <span style="font-size:0.9rem;color:var(--muted)">${h.label}</span>
          <button class="btn btn-ghost btn-xs" onclick="${h.link}">${h.hint} →</button>
        </div>`).join('')}`;
    openModal('m-health');
    return;
  }
  $('health-breakdown-body').innerHTML=`
    <div style="text-align:center;margin-bottom:16px">${gaugeHTML(score,color,label)}</div>
    <div style="text-align:center;margin-bottom:20px">${_scoreReliabilityBadge(componentCount,totalComponents,breakdown)}</div>
    ${breakdown.map(b=>{
      if(!b.hasData){
        // Distinguish: insufficient data (grey "—") vs no data at all (dim "Not yet set up")
        const isInsuf=b.isInsufficient;
        const label_right=isInsuf
          ?`<span style="font-size:0.875rem;font-weight:600;color:var(--muted)">— / ${b.max} pts</span>`
          :`<span style="font-size:0.8rem;color:var(--dim);font-style:italic">Not set up</span>`;
        const actionLabel=b.addLink
          ?(isInsuf?'Fix →':'Set up →')
          :'';
        return `<div style="margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--border);opacity:${isInsuf?'.75':'.5'}">
          <div class="flex-sb mb6">
            <span style="font-size:1rem;font-weight:600">${b.label}</span>
            ${label_right}
          </div>
          <div class="bar-wrap"><div class="bar-fill" style="width:0%;background:${isInsuf?'rgba(108,99,255,.18)':'var(--surface3)'}"></div></div>
          <div style="font-size:0.8rem;margin-top:6px;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span style="color:${isInsuf?'var(--text-sec)':'var(--muted)'}">${b.detail}</span>
            ${b.addLink?`<button class="btn btn-ghost btn-xs" onclick="${b.addLink}" style="${isInsuf?'color:var(--accent)':''}">${actionLabel}</button>`:''}
          </div>
        </div>`;
      }
      const pts_clr=b.score===b.max?'var(--green)':b.score>0?'var(--yellow)':'var(--red)';
      const bar_clr=b.barColor||pts_clr;
      return `<div style="margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--border)">
        <div class="flex-sb mb6">
          <span style="font-size:1rem;font-weight:600">${b.label}</span>
          <span style="font-size:0.95rem;font-weight:600;color:${pts_clr}">${b.score}/${b.max} pts</span>
        </div>
        <div class="bar-wrap"><div class="bar-fill" style="width:${(b.score/b.max*100).toFixed(0)}%;background:${bar_clr}"></div></div>
        <div style="font-size:0.875rem;margin-top:6px" class="text-muted">${b.detail}</div>
      </div>`;
    }).join('')}
    ${AnchorDB.preferences.scoreSetupComplete?`<div style="text-align:center;margin-top:8px">
      <button onclick="closeModal('m-health');AnchorDB.preferences.scoreSetupComplete=false;save();openScoreJourney()" style="background:none;border:none;color:var(--muted);font-size:12px;cursor:pointer;text-decoration:underline">Redo setup →</button>
    </div>`:''}
    ${(()=>{
      const ending=(AnchorDB.income.sources||[]).filter(s=>getIncomeStatus(s).status==='ending-soon');
      const ended=(AnchorDB.income.sources||[]).filter(s=>getIncomeStatus(s).status==='ended');
      const upcoming=(AnchorDB.income.sources||[]).filter(s=>getIncomeStatus(s).status==='upcoming');
      if(!ending.length&&!ended.length&&!upcoming.length) return '';
      const dti=calcDTIData?.()||{};
      const rows=[];
      ending.forEach(s=>{const st=getIncomeStatus(s);const moLost=s.monthlyNet||0;rows.push(`<div class="fs12" style="padding:8px 0;border-bottom:1px solid var(--border)"><span style="color:#f59e0b;font-weight:600">${esc(s.name||s.type)}</span> ends in ${st.daysLeft} day${st.daysLeft===1?'':'s'} — <span style="color:var(--red)">−${fmt(moLost)}/mo</span> income. DTI will increase when this ends.</div>`);});
      ended.forEach(s=>{rows.push(`<div class="fs12" style="padding:8px 0;border-bottom:1px solid var(--border)"><span style="color:var(--red);font-weight:600">${esc(s.name||s.type)}</span> has ended and is excluded from your score. <button class="btn btn-ghost btn-xs" style="margin-left:4px" onclick="closeModal('m-health');openIncomeConfig()">Update income →</button></div>`);});
      upcoming.forEach(s=>{const st=getIncomeStatus(s);rows.push(`<div class="fs12" style="padding:8px 0;border-bottom:1px solid var(--border)"><span style="color:#f59e0b;font-weight:600">${esc(s.name||s.type)}</span> starts in ${st.daysUntil} day${st.daysUntil===1?'':'s'} — not yet counted. Score may improve once this income begins.</div>`);});
      return `<div style="background:var(--surface2);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;margin-top:16px"><div class="fs12 fw6 mb8" style="color:var(--text-sec)">Income lifecycle</div>${rows.join('')}</div>`;
    })()}`;
  openModal('m-health');
}

function showHealthRules(){
  const rules=[
    {label:'Credit Utilization',max:25,rows:[['Under 10%','25'],['10–30%','20'],['30–50%','12'],['50–75%','5'],['Over 75%','0']]},
    {label:'Debt-to-Income Ratio',max:20,note:'DTI measures how much of your monthly income goes toward debt payments. Under 35% is generally considered healthy. Over 43% is the threshold most lenders use to flag financial stress.',rows:[['Under 15%','20'],['15% – 25%','16'],['25% – 35%','12'],['35% – 43%','6'],['Over 43%','0']]},
    {label:'Budget Adherence',max:20,rows:[['Under budget','20'],['0–10% over','15'],['10–25% over','8'],['Over 25% over','0']]},
    {label:'Emergency Fund',max:15,rows:[['6+ months expenses','15'],['3–6 months','10'],['1–3 months','5'],['Under 1 month','0']]},
    {label:'Bill Payment',max:10,rows:[['No overdue bills','10'],['1 overdue','5'],['2+ overdue','0']]},
    {label:'Debt Load',max:10,rows:[['No high-APR debt (>20%)','10'],['1 high-APR card with balance','5'],['Multiple high-APR cards','0']]},
  ];
  $('health-rules-body').innerHTML=`
    <div style="margin-bottom:20px">
      ${rules.map(r=>`
        <div style="margin-bottom:18px">
          <div style="font-size:1rem;font-weight:600;margin-bottom:6px">${r.label} <span style="font-size:0.8rem;font-weight:400;color:var(--muted)">(${r.max} pts max)</span></div>
          <table style="width:100%;border-collapse:collapse;font-size:0.875rem">
            ${r.rows.map((row,i)=>`<tr style="background:${i%2===0?'var(--surface2)':'transparent'}">
              <td style="padding:6px 10px;color:var(--text)">${row[0]}</td>
              <td style="padding:6px 10px;text-align:right;font-weight:600;color:var(--accent)">${row[1]} pts</td>
            </tr>`).join('')}
          </table>
          ${r.note?`<div style="margin-top:8px;padding:8px 10px;background:var(--surface2);border-radius:var(--r-sm);font-size:0.8rem;color:var(--muted);line-height:1.5">${r.note}</div>`:''}
        </div>`).join('')}
    </div>
    <div style="margin-bottom:16px;padding:12px 14px;background:var(--surface2);border-radius:var(--r-sm);font-size:0.875rem">
      <div style="font-weight:600;margin-bottom:6px">Score ranges</div>
      <div style="display:flex;gap:16px;flex-wrap:wrap">
        <span>0–40: <strong style="color:var(--red)">Poor</strong></span>
        <span>41–70: <strong style="color:var(--yellow)">Fair</strong></span>
        <span>71–85: <strong style="color:var(--green)">Good</strong></span>
        <span>86–100: <strong style="color:var(--green)">Excellent</strong></span>
      </div>
    </div>
    <div style="font-size:0.8rem;color:var(--muted);line-height:1.6">Your score updates automatically as you add accounts, upload statements, and reach financial milestones.</div>`;
  closeModal('m-health');
  openModal('m-health-rules');
}

// ── INSIGHTS ENGINE ────────────────────────────────────────────────────────────
function generateInsights(){
  const now=Date.now(); const insights=[];
  const curMo=new Date().toISOString().slice(0,7);
  const prevDate=new Date(); prevDate.setMonth(prevDate.getMonth()-1);
  const prevMo=prevDate.toISOString().slice(0,7);
  const txCur=S.transactions.filter(t=>(t.date||'').slice(0,7)===curMo&&t.amount<0&&!t.internalXfer);
  const txPrev=S.transactions.filter(t=>(t.date||'').slice(0,7)===prevMo&&t.amount<0&&!t.internalXfer);
  const byCat=(txs)=>{ const m={}; txs.forEach(t=>{ m[t.category]=(m[t.category]||0)+Math.abs(t.amount); }); return m; };
  const curCat=byCat(txCur), prevCat=byCat(txPrev);
  // Spending MoM
  CATS.forEach(cat=>{
    const c=curCat[cat]||0, p=prevCat[cat]||0;
    if(p>0&&c>p*1.2&&c-p>30){
      const pctDiff=((c-p)/p*100).toFixed(0);
      insights.push({id:'cat-mom-'+cat,priority:2,icon:'📈',headline:`${cat} spending up ${pctDiff}% vs last month`,detail:`${fmt(c)} this month vs ${fmt(p)} last month (+${fmt(c-p)})`,action:'View Budget',actionFn:`go('budget')`});
    }
  });
  // Top expense category
  const topCat=Object.entries(curCat).sort((a,b)=>b[1]-a[1])[0];
  if(topCat) insights.push({id:'top-cat',priority:3,icon:'💰',headline:`${topCat[0]} is your top expense this month`,detail:`${fmt(topCat[1])} spent so far this month`,action:'View Budget',actionFn:`go('budget')`});
  // Investments & CC payment insights
  const moInvested=txCur.filter(t=>t.category==='Investments').reduce((a,t)=>a+Math.abs(t.amount),0);
  const moCCPaid=txCur.filter(t=>t.category==='Credit Card Payments').reduce((a,t)=>a+Math.abs(t.amount),0);
  if(moInvested>0){
    const invInc=S.transactions.filter(t=>t.amount>0&&!t.internalXfer&&t.incomeType&&(t.date||'').slice(0,7)===curMo).reduce((a,t)=>a+t.amount,0);
    const invPct=invInc>0?((moInvested/invInc)*100).toFixed(1):null;
    insights.push({id:'invested-mo',priority:4,icon:'📈',headline:`You invested ${fmt(moInvested)} this month${invPct?' ('+invPct+'% of income)':''}`,detail:`${S.investments&&S.investments.length>0?S.investments.length+' accounts tracked in Investments tab':'Add platforms in the Investments tab'}`,action:'View Investments',actionFn:`go('invest')`});
  }
  if(moCCPaid>0){
    const totalDebt=S.cards.reduce((a,c)=>a+(c.balance||0),0);
    insights.push({id:'cc-paid-mo',priority:4,icon:'💳',headline:`You paid ${fmt(moCCPaid)} toward credit cards this month`,detail:totalDebt>0?`${fmt(totalDebt)} total remaining debt — keep it up!`:'Debt tracked in Credit Cards tab',action:'View Cards',actionFn:`go('cards')`});
  }
  // Percentage budget insights
  if(S.budgetMode==='percentage'&&S.catBudgetPcts&&Object.keys(S.catBudgetPcts).length>0){
    const incBase=getMonthlyIncomeBase();
    if(incBase.amount>0){
      const totalAllocPct=Object.values(S.catBudgetPcts).reduce((a,v)=>a+v,0);
      if(totalAllocPct>0)insights.push({id:'pct-alloc',priority:4,icon:'📊',headline:`You've allocated ${totalAllocPct.toFixed(0)}% of income to budget categories`,detail:`${(100-totalAllocPct).toFixed(0)}% unallocated — adjust in Set Budget`,action:'Set Budget',actionFn:`openBudgetModal()`});
      Object.entries(S.catBudgetPcts).slice(0,3).forEach(([cat,targetPct])=>{
        const spent_c=curCat[cat]||0;
        const spentPct=((spent_c/incBase.amount)*100).toFixed(1);
        if(spent_c>0){
          if(parseFloat(spentPct)>targetPct*1.1)insights.push({id:'pct-over-'+cat,priority:2,icon:'📈',headline:`${cat} at ${spentPct}% of income — above ${targetPct}% target`,detail:`${fmt(spent_c)} spent vs ${fmt(Math.round(targetPct/100*incBase.amount))} budgeted`,action:'View Budget',actionFn:`go('budget')`});
          else if(parseFloat(spentPct)<=targetPct)insights.push({id:'pct-ok-'+cat,priority:4,icon:'✅',headline:`${cat} at ${spentPct}% of income — within ${targetPct}% budget`,detail:`${fmt(spent_c)} spent · ${fmt(Math.round((targetPct/100*incBase.amount)-spent_c))} remaining`,action:'View Budget',actionFn:`go('budget')`});
        }
      });
    }
  }
  // Credit utilization
  const tLim=S.cards.reduce((a,c)=>a+(c.limit||0),0);
  const tBal=S.cards.reduce((a,c)=>a+(c.balance||0),0);
  const util=tLim>0?(tBal/tLim)*100:0;
  if(util>90) insights.push({id:'util-critical',priority:1,icon:'🚨',headline:`Credit utilization is critically high at ${pct(util)}`,detail:`${fmt(tBal)} of ${fmt(tLim)} used. Pay down balances to protect your score.`,action:'View Cards',actionFn:`go('cards')`});
  else if(util>50) insights.push({id:'util-warn',priority:2,icon:'⚠️',headline:`Credit utilization is ${pct(util)} — aim for under 30%`,detail:`Keeping utilization below 30% significantly helps your credit score.`,action:'View Cards',actionFn:`go('cards')`});
  // Monthly interest
  const totalInt=S.cards.reduce((a,c)=>a+(c.apr&&c.balance?c.apr/100/12*c.balance:0),0);
  if(totalInt>20) insights.push({id:'cc-interest',priority:2,icon:'💸',headline:`You're paying ~${fmt(Math.round(totalInt))}/month in credit card interest`,detail:`${fmt(Math.round(totalInt*12))} projected annually. Paying down high-APR cards first saves the most.`,action:'View Cards',actionFn:`go('cards')`});
  // Debt-to-Income ratio insights — use stable monthly average, not just current month
  const moInc=getMonthlyIncomeEstimate()||0;
  const moExp=txCur.reduce((a,t)=>a+Math.abs(t.amount),0);
  if(moInc>0&&S.cards&&S.cards.length>0){
    const _LP=/student[\s-]*loan|auto[\s-]*loan|car[\s-]*pay(?:ment)?|personal[\s-]*loan|loan[\s-]*pay/i;
    const _ccMin=S.cards.reduce((a,c)=>a+Math.max(25,+(c.balance||0)*0.02),0);
    const _loanTx=S.transactions.filter(t=>t.amount<0&&(t.date||'').slice(0,7)===curMo&&_LP.test(t.description||'')).reduce((a,t)=>a+Math.abs(t.amount),0);
    const _loanBill=(S.bills||[]).filter(b=>!b.paused&&b.category==='Loans').reduce((a,b)=>a+toMonthly(b.amount,b.cycle||'monthly'),0);
    const dtiI=((_ccMin+_loanTx+_loanBill)/moInc)*100;
    if(dtiI>200){
      // Sanity guard — income data likely incomplete, don't show a nonsensical number
    } else if(dtiI>43){
      insights.push({id:'dti-high',priority:1,icon:'🚨',headline:`Debt payments consume ${dtiI.toFixed(1)}% of your income`,detail:`This is above the 43% stress threshold. Focus on paying down high-interest debt first.`,action:'View Cards',actionFn:`go('cards')`});
    } else if(dtiI>35){
      const saveAmt=Math.max(0,(_ccMin+_loanTx+_loanBill)-(moInc*0.35));
      insights.push({id:'dti-warn',priority:2,icon:'⚠️',headline:`DTI of ${dtiI.toFixed(1)}% is approaching the danger zone`,detail:`Reducing debt payments by ${fmt(Math.round(saveAmt))}/mo would bring you to a healthier ratio.`,action:'View Cards',actionFn:`go('cards')`});
    } else if(dtiI<15&&dtiI>0){
      insights.push({id:'dti-excellent',priority:4,icon:'🎉',headline:`Excellent debt-to-income ratio: ${dtiI.toFixed(1)}%`,detail:`Your DTI is well below 15% — you have strong borrowing capacity.`});
    }
  }
  // Bills due soon
  const overdue=(S.bills||[]).filter(b=>!b.paused&&daysUntil(b.nextDue)<0);
  if(overdue.length) insights.push({id:'bills-overdue',priority:1,icon:'🔴',headline:`${overdue.length} overdue bill${overdue.length>1?'s':''}`,detail:overdue.map(b=>b.name).join(', '),action:'View Bills',actionFn:`go('bills')`});
  const dueSoon=(S.bills||[]).filter(b=>!b.paused&&daysUntil(b.nextDue)>=0&&daysUntil(b.nextDue)<=3);
  if(dueSoon.length) insights.push({id:'bills-soon',priority:2,icon:'📅',headline:`${dueSoon.length} bill${dueSoon.length>1?'s':''} due within 3 days`,detail:dueSoon.map(b=>`${b.name} (${fmt(b.amount)})`).join(', '),action:'View Bills',actionFn:`go('bills')`});
  // Subscription billing
  const subSoon=S.subs.filter(s=>!s.paused&&daysUntil(s.nextBilling)>=0&&daysUntil(s.nextBilling)<=7);
  if(subSoon.length){
    const total=subSoon.reduce((a,s)=>a+s.amount,0);
    insights.push({id:'subs-soon',priority:2,icon:'🔄',headline:`${fmt(total)} in subscriptions billing within 7 days`,detail:subSoon.map(s=>s.name).join(', '),action:'View Subscriptions',actionFn:`go('subs')`});
  }
  // Goals ETA
  S.goals.filter(g=>g.target>0&&g.current<g.target).slice(0,2).forEach(g=>{
    const left=g.target-g.current; const mSave=100;
    insights.push({id:'goal-'+g.id,priority:4,icon:'🎯',headline:`${esc(g.name)}: ${fmt(left)} to go`,detail:`${pct(g.target>0?g.current/g.target*100:0)} complete`,action:'View Goals',actionFn:`go('goals')`});
  });
  // Pay schedule
  if(S.paySchedule&&S.paySchedule.nextPayday){
    const d=daysUntil(S.paySchedule.nextPayday);
    if(d<=3) insights.push({id:'payday-soon',priority:4,icon:'💼',headline:`Payday in ${d===0?'today':d+' days'}: ~${fmt(S.paySchedule.avgAmount)}`,detail:`Expected ${S.paySchedule.nextPayday}`});
  }
  // NW change
  if(S.nwHistory.length>=2){
    const latest=S.nwHistory[S.nwHistory.length-1];
    const prev=S.nwHistory[S.nwHistory.length-2];
    const chg=latest.nw-prev.nw; const pctChg=prev.nw!==0?Math.abs(chg/prev.nw*100):0;
    if(chg>0&&pctChg>5) insights.push({id:'nw-up',priority:4,icon:'📊',headline:`Net worth up ${fmt(chg)} vs last entry`,detail:`From ${fmt(prev.nw)} to ${fmt(latest.nw)}`,action:'View Net Worth',actionFn:`go('networth')`});
    else if(chg<0&&pctChg>10) insights.push({id:'nw-down',priority:1,icon:'📉',headline:`Net worth dropped ${fmt(Math.abs(chg))} (${pct(pctChg)})`,detail:`From ${fmt(prev.nw)} to ${fmt(latest.nw)}`,action:'View Net Worth',actionFn:`go('networth')`});
  }
  // Charity giving insight
  const charityMo=S.transactions.filter(t=>t.category==='Charity'&&t.amount<0&&(t.date||'').slice(0,7)===curMo).reduce((a,t)=>a+Math.abs(t.amount),0);
  if(charityMo>0){
    const charityPct=moInc>0?((charityMo/moInc)*100):null;
    insights.push({id:'charity-giving',priority:4,icon:'🤝',headline:`You donated ${fmt(charityMo)} this month`,detail:charityPct!==null?`That's ${pct(charityPct)} of your income — generosity tracked.`:'Giving tracked under Charity category.',action:'View Budget',actionFn:`go('budget')`});
  }
  // Income lifecycle alerts — all non-archived sources with end dates
  (AnchorDB.income.sources||[]).filter(s=>s.status!=='archived').forEach(src=>{
    const st=getIncomeStatus(src);
    const nm=esc(src.name||src.type||'Income source');
    const typeIcon=src.type==='contract'?'📋':'💼';
    if(st.status==='ending-soon'){
      const dtiData=typeof calcDTIData==='function'?calcDTIData():null;
      const moLost=src.monthlyNet||0;
      const dtiNote=dtiData&&dtiData.monthlyDebt&&moLost>0?` DTI will rise from ${pct(dtiData.ratio*100)} to ~${pct((dtiData.monthlyDebt/(Math.max(1,(dtiData.monthlyIncome||1)-moLost))*100))} after.`:'';
      insights.push({id:'income-ending-'+src.id,priority:1,icon:typeIcon,
        headline:`${nm} ends in ${st.daysLeft} day${st.daysLeft===1?'':'s'}`,
        detail:`${st.warning}.${dtiNote} Plan for ${fmt(moLost)}/mo less income.`,
        action:'View Income',actionFn:`openIncomeConfig()`});
      // Contract renewal reminder with localStorage-based snooze
      if(src.isRenewable){
        const snoozeKey=`anchor_renew_snooze_${src.id}`;
        const snoozed=localStorage.getItem(snoozeKey);
        if(!snoozed||(Date.now()-parseInt(snoozed,10))>7*24*3600*1000){
          insights.push({id:'contract-renew-'+src.id,priority:1,icon:'🔄',
            headline:`Is ${nm} being renewed?`,
            detail:`Contract ends in ${st.daysLeft} day${st.daysLeft===1?'':'s'}. Update the end date if you're renewing, or archive if not.`,
            action:'Update',actionFn:`openIncomeConfig();localStorage.setItem('${snoozeKey}',Date.now())`});
        }
      }
    } else if(st.status==='ended'&&st.daysAgo<=60){
      insights.push({id:'income-ended-'+src.id,priority:2,icon:typeIcon,
        headline:`${nm} ended ${st.daysAgo} day${st.daysAgo===1?'':'s'} ago`,
        detail:`This income is no longer counted. Update your sources to keep your health score accurate.`,
        action:'Update Income',actionFn:`openIncomeConfig()`});
    }
  });
  // Filter dismissed (7 days)
  return insights.filter(i=>{
    const ts=S.dismissedInsights[i.id];
    return !ts||(now-ts)>7*24*3600*1000;
  }).sort((a,b)=>a.priority-b.priority);
}

function dismissInsight(id){
  S.dismissedInsights[id]=Date.now(); save(); renderInsights(); renderHome();
}

function insightCardHTML(ins,showDismiss=true){
  const bClass=['','insight-border-urgent','insight-border-warning','insight-border-tip','insight-border-positive'][ins.priority]||'';
  return `<div class="insight-card ${bClass}">
    <div class="insight-icon">${ins.icon}</div>
    <div style="flex:1">
      <div class="insight-headline">${ins.headline}</div>
      <div class="insight-detail">${ins.detail||''}</div>
      ${ins.action?`<div class="insight-action" onclick="${ins.actionFn}">${ins.action} →</div>`:''}
    </div>
    ${showDismiss?`<button class="insight-dismiss" onclick="dismissInsight('${ins.id}')" title="Dismiss for 7 days">✕</button>`:''}
  </div>`;
}

function renderInsights(){
  const el=$('insights-body'); if(!el) return;
  const all=generateInsights();
  if(!all.length){ el.innerHTML=`<div class="empty"><div class="empty-icon">✨</div><div>No insights right now. Upload transactions or add accounts to get personalized analysis.</div></div>`; return; }
  const groups=[{label:'Urgent',items:all.filter(i=>i.priority===1),color:'var(--red)'},{label:'Warnings',items:all.filter(i=>i.priority===2),color:'var(--yellow)'},{label:'Tips',items:all.filter(i=>i.priority===3),color:'var(--accent)'},{label:'Positive',items:all.filter(i=>i.priority===4),color:'var(--green)'}];
  el.innerHTML=groups.filter(g=>g.items.length).map(g=>`<div style="margin-bottom:24px"><div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:${g.color};margin-bottom:10px">${g.label} (${g.items.length})</div>${g.items.map(i=>insightCardHTML(i)).join('')}</div>`).join('');
}

// ── ALERTS ────────────────────────────────────────────────────────────────────
function generateAlerts(){
  const alerts=[];
  const tLim=S.cards.reduce((a,c)=>a+(c.limit||0),0);
  const tBal=S.cards.reduce((a,c)=>a+(c.balance||0),0);
  const util=tLim>0?(tBal/tLim)*100:0;
  if(util>90) alerts.push({id:'alert-util-critical',type:'urgent',icon:'🚨',msg:`Credit utilization critically high: ${pct(util)}`});
  else if(util>50) alerts.push({id:'alert-util-warn',type:'warning',icon:'⚠️',msg:`Credit utilization at ${pct(util)} — aim for under 30%`});
  const overdue=(S.bills||[]).filter(b=>!b.paused&&daysUntil(b.nextDue)<0);
  overdue.forEach(b=>alerts.push({id:'alert-bill-od-'+b.id,type:'urgent',icon:'🔴',msg:`Overdue bill: ${b.name} (${fmt(b.amount)})`}));
  const dueSoon3=(S.bills||[]).filter(b=>!b.paused&&daysUntil(b.nextDue)>=0&&daysUntil(b.nextDue)<=3);
  dueSoon3.forEach(b=>alerts.push({id:'alert-bill-soon-'+b.id,type:'warning',icon:'📅',msg:`${b.name} due in ${daysUntil(b.nextDue)} day${daysUntil(b.nextDue)!==1?'s':''} (${fmt(b.amount)})`}));
  const mb=getMonthlyBudget();
  if(mb>0){
    const curMo=new Date().toISOString().slice(0,7);
    const spent=S.transactions.filter(t=>(t.date||'').slice(0,7)===curMo&&t.amount<0&&!t.internalXfer).reduce((a,t)=>a+Math.abs(t.amount),0);
    const ovr=(spent/mb-1)*100;
    if(ovr>25) alerts.push({id:'alert-budget-over',type:'urgent',icon:'💸',msg:`Budget exceeded by ${pct(ovr)} this month`});
    else if(spent/mb>0.8) alerts.push({id:'alert-budget-80',type:'warning',icon:'📊',msg:`At ${pct(spent/mb*100)} of monthly budget`});
  }
  const subSoon7=S.subs.filter(s=>!s.paused&&daysUntil(s.nextBilling)>=0&&daysUntil(s.nextBilling)<=7);
  if(subSoon7.length){
    const total=subSoon7.reduce((a,s)=>a+s.amount,0);
    alerts.push({id:'alert-subs-7d',type:'warning',icon:'🔄',msg:`${subSoon7.length} subscription${subSoon7.length>1?'s':''} billing in 7 days: ${fmt(total)}`});
  }
  S.cards.filter(c=>c.limit>0&&(c.balance/c.limit*100)<30).forEach(c=>{
    alerts.push({id:'alert-util-good-'+c.id,type:'positive',icon:'✅',msg:`${esc(c.name)} utilization is healthy at ${pct(c.balance/c.limit*100)}`});
  });
  if(S.nwHistory.length>=2){
    const l=S.nwHistory[S.nwHistory.length-1], p=S.nwHistory[S.nwHistory.length-2];
    if(l.nw>p.nw&&S.nwHistory.every(h=>h.nw<=l.nw)) alerts.push({id:'alert-nw-ath',type:'positive',icon:'🏆',msg:`New all-time high net worth: ${fmt(l.nw)}`});
  }
  return alerts.filter(a=>!(S.dismissedAlerts||[]).includes(a.id));
}

function updateBellBadge(){
  const alerts=generateAlerts();
  const urgent=alerts.filter(a=>a.type==='urgent'||a.type==='warning').length;
  const badge=$('bell-badge');
  if(!badge) return;
  if(urgent>0){ badge.textContent=urgent; badge.style.display='flex'; }
  else badge.style.display='none';
}

function openAlertPanel(){
  renderAlertPanel();
  $('alert-panel').classList.add('open');
  $('alert-backdrop').style.display='block';
}
function closeAlertPanel(){
  $('alert-panel').classList.remove('open');
  $('alert-backdrop').style.display='none';
}
function renderAlertPanel(){
  const alerts=generateAlerts();
  const el=$('ap-body'); if(!el) return;
  if(!alerts.length){ el.innerHTML=`<div class="empty" style="padding:32px 16px"><div class="empty-icon">🔔</div><div>No alerts right now. You're all caught up!</div></div>`; return; }
  const groups=[{key:'urgent',label:'Urgent',color:'var(--red)'},{key:'warning',label:'Warnings',color:'var(--yellow)'},{key:'positive',label:'Good News',color:'var(--green)'}];
  el.innerHTML=groups.map(g=>{
    const items=alerts.filter(a=>a.type===g.key);
    if(!items.length) return '';
    return `<div class="ap-group-label" style="color:${g.color}">${g.label}</div>`+
      items.map(a=>`<div class="ap-item"><div style="font-size:18px">${a.icon}</div><div style="flex:1;font-size:13px">${a.msg}</div><button class="ap-dismiss" onclick="dismissAlert('${a.id}')">✕</button></div>`).join('');
  }).join('');
}
function dismissAlert(id){
  if(!S.dismissedAlerts) S.dismissedAlerts=[];
  S.dismissedAlerts.push(id); save(); renderAlertPanel(); updateBellBadge();
}
function dismissAllAlerts(){
  const alerts=generateAlerts();
  alerts.forEach(a=>{ if(!S.dismissedAlerts.includes(a.id)) S.dismissedAlerts.push(a.id); });
  save(); renderAlertPanel(); updateBellBadge();
}

// ── ONBOARDING ────────────────────────────────────────────────────────────────
let _obStep=1;
function showOnboard(){
  const el=$('onboard-overlay'); if(!el) return;
  el.classList.add('open');
}
function obNext(step){
  const cur=$('ob-step-'+_obStep);
  const next=$('ob-step-'+step);
  if(cur) cur.classList.remove('active');
  if(next){ next.classList.add('active'); _obStep=step; }
  const total=10; const prog=$('ob-progress-fill');
  if(prog) prog.style.width=((step-1)/(total-1)*100)+'%';
  if(step===9){
    const profileKey=calcProfile();
    S.userProfile=profileKey; save();
    const el=$('ob-profile-card'); if(el) el.innerHTML=renderProfile(profileKey);
  }
}
function obAnswer(q,val,btn){
  S.quizAnswers[q]=val;
  btn.closest('.ob-tf,.ob-choices').querySelectorAll('.ob-tf-btn,.ob-choice').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  setTimeout(()=>obNext(_obStep+1),400);
}
function calcProfile(){
  const a=S.quizAnswers;
  const sc={rebuilder:0,empire:0,beginner:0,optimizer:0,juggler:0};
  // Q1 — go over budget
  if(a[1]==='true'){sc.rebuilder+=2;sc.juggler+=2;sc.optimizer+=1;}
  else if(a[1]==='false'){sc.beginner+=2;sc.empire+=1;sc.optimizer+=1;}
  // Q2 — financial journey
  if(a[2]==='starting'){sc.beginner+=4;sc.rebuilder+=1;}
  else if(a[2]==='grow'){sc.empire+=4;sc.optimizer+=1;}
  else if(a[2]==='setback'){sc.rebuilder+=4;sc.juggler+=1;}
  else if(a[2]==='discipline'){sc.optimizer+=4;sc.beginner+=1;}
  // Q3 — have debt
  if(a[3]==='true'){sc.rebuilder+=3;sc.juggler+=2;sc.optimizer+=1;}
  else if(a[3]==='false'){sc.empire+=2;sc.beginner+=2;}
  // Q4 — how track finances
  if(a[4]==='none'){sc.beginner+=3;sc.rebuilder+=2;sc.juggler+=1;}
  else if(a[4]==='spreadsheet'){sc.optimizer+=2;sc.empire+=2;}
  else if(a[4]==='banking'){sc.optimizer+=3;sc.juggler+=1;}
  else if(a[4]==='app'){sc.optimizer+=4;sc.empire+=1;}
  // Q5 — biggest goal
  if(a[5]==='debt'){sc.rebuilder+=4;sc.juggler+=1;}
  else if(a[5]==='emergency'){sc.beginner+=3;sc.rebuilder+=1;}
  else if(a[5]==='save'){sc.beginner+=2;sc.optimizer+=1;}
  else if(a[5]==='nw'){sc.empire+=4;}
  // Q6 — know credit utilization
  if(a[6]==='true'){sc.empire+=3;sc.optimizer+=2;}
  else if(a[6]==='false'){sc.rebuilder+=2;sc.beginner+=2;sc.juggler+=1;}
  // Q7 — number of accounts
  if(a[7]==='1-2'){sc.beginner+=3;}
  else if(a[7]==='3-4'){sc.optimizer+=2;sc.empire+=1;}
  else if(a[7]==='5+'){sc.empire+=3;sc.juggler+=1;}
  else if(a[7]==='many'){sc.juggler+=4;sc.rebuilder+=1;}
  // Find winner — juggler requires strong signal (≥6 pts) to win
  const maxScore=Math.max(...Object.values(sc));
  let winners=Object.keys(sc).filter(p=>sc[p]===maxScore);
  if(winners.includes('juggler')&&sc.juggler<6){
    winners=winners.filter(p=>p!=='juggler');
    if(!winners.length){
      const second=Math.max(...Object.values(sc).filter(v=>v<maxScore));
      winners=Object.keys(sc).filter(p=>sc[p]===second);
    }
  }
  // Tiebreaker: most differentiating profiles first
  const tieOrder=['empire','beginner','rebuilder','optimizer','juggler'];
  const winner=winners.length===1?winners[0]:(tieOrder.find(p=>winners.includes(p))||winners[0]);
  console.log('Profile scores:',{...sc,winner});
  return winner;
}
const PROFILES={
  rebuilder:{icon:'🔄',name:'The Rebuilder',color:'var(--yellow)',desc:"You've been through it — and you're ready to take control. Anchor helps you track every dollar, tackle debt strategically, and rebuild your foundation one step at a time.",features:['Debt payoff tracker','Credit card alerts','Budget adherence','Bill tracking']},
  empire:{icon:'📈',name:'The Empire Builder',color:'var(--accent)',desc:"You're playing the long game. You need visibility across everything — accounts, investments, net worth — in one place. Anchor gives you the command center to build seriously.",features:['Net worth tracking','Investments dashboard','Multi-account view','Health score']},
  beginner:{icon:'🌱',name:'The Disciplined Beginner',color:'var(--teal)',desc:"Everyone starts somewhere. You're building habits that will compound for years. Anchor makes it easy to start simple and grow into full financial clarity.",features:['Simple budget setup','Goal tracking','CSV import guide','Auto-categorization']},
  optimizer:{icon:'⚡',name:'The Optimizer',color:'var(--blue)',desc:"You're already ahead of most people — you just need better tools. Anchor goes deeper than any banking app with insights, trend analysis, and a health score that actually means something.",features:['Insights engine','Trend analysis','Financial health score','Subscription audit']},
  juggler:{icon:'🎯',name:'The Juggler',color:'var(--pink)',desc:"A lot of moving parts, not enough visibility. Anchor brings everything into one place so nothing slips through the cracks.",features:['Multi-account dashboard','Bills & subscriptions','Unified alerts','Transaction search']}
};
function renderProfile(profileKey){
  const p=PROFILES[profileKey]||PROFILES.optimizer;
  return `<div class="profile-card">
    <div class="profile-icon">${p.icon}</div>
    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:${p.color};margin-bottom:8px">You are:</div>
    <div class="profile-name" style="color:${p.color}">${p.name}</div>
    <div class="profile-desc">${p.desc}</div>
    <div style="font-size:12px;font-weight:600;color:#A1A1AA;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px">Anchor will help you with:</div>
    <div class="profile-features">${p.features.map(f=>`<div class="profile-feature">✓ ${f}</div>`).join('')}</div>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:16px">
      <button class="btn btn-primary" onclick="obNext(10)">Next →</button>
    </div>
  </div>`;
}
function finishOnboard(){
  const profileKey=calcProfile();
  S.userProfile=profileKey; S.onboardDone=true; save();
  const el=$('onboard-overlay');
  if(el) el.classList.remove('open');
  renderHome();
}
function skipOnboard(){
  S.onboardDone=true; save();
  const el=$('onboard-overlay');
  if(el) el.classList.remove('open');
}
function retakeQuiz(){
  S.quizAnswers={}; S.userProfile=null; S.onboardDone=false; save();
  closeModal('m-settings');
  showOnboard();
}

// ── PRODUCT TOUR ──────────────────────────────────────────────────────────────
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const TOUR_STEPS=[
  {sel:'#hero-el',tab:'home',title:'Your Number',body:"This is your total net worth — all accounts, cards, and investments combined. It updates automatically every time you add data."},
  {sel:'#health-score-section',tab:'home',title:'Financial Health Score',body:"A 0–100 score across 6 factors: credit, savings, budget, emergency fund, bills, and debt. Tap 'View breakdown' to see exactly where to improve."},
  {sel:'#home-insights-section',tab:'home',title:'Smart Insights',body:"Anchor analyzes your data and surfaces the most important action items — overspending alerts, credit wins, savings opportunities."},
  {sel:'#budget-body',tab:'budget',title:'Upload & Auto-Categorize',body:"Drop any bank CSV and Anchor categorizes every transaction automatically. See exactly where your money goes, by category and month."},
  {sel:'#cards-body',tab:'cards',title:'Credit Card Intelligence',body:"Track every card's utilization, balance, APR, and payoff timeline. Anchor tells you which card to pay first to save the most interest."},
  {sel:'#bills-body',tab:'bills',title:'Bills & Subscriptions',body:"Never miss a payment. Anchor detects recurring charges automatically from your uploads and tracks what's due and when."},
  {sel:'#goals-body',tab:'goals',title:'Goal Tracking',body:"Set a goal, pick a target date, and Anchor calculates exactly how much to save each month to get there on time."},
  {sel:'#invest-body',tab:'invest',title:'Investment Tracking',body:"Track crypto, stocks, and all investments alongside your cash and credit. Your complete net worth — in one place."}
];
let _tourStep=0,_tourActive=false;
function startTour(){
  skipOnboard();
  _tourStep=0; _tourActive=true;
  const ov=$('tour-overlay'); if(!ov) return;
  ov.classList.add('active');
  const sp=$('tour-spotlight'), tt=$('tour-tooltip');
  sp.classList.remove('visible'); tt.classList.remove('visible');
  _showTourStep(0);
}
async function _showTourStep(idx){
  if(!_tourActive) return;
  const step=TOUR_STEPS[idx];
  if(!step){ _tourFinish(); return; }
  const sp=$('tour-spotlight'), tt=$('tour-tooltip');
  const ttTitle=$('tt-title'), ttBody=$('tt-body'), ttCounter=$('tt-counter');
  const ttNext=$('tt-next-btn'), ttPrev=$('tt-prev-btn');
  // tab switch
  if(activeTab!==step.tab){
    sp.classList.remove('visible');
    tt.classList.remove('visible');
    await sleep(300);
    go(step.tab);
    await sleep(400);
  }
  // find element
  let el=document.querySelector(step.sel);
  if(!el){
    // skip silently
    _tourStep= idx<TOUR_STEPS.length-1 ? idx+1 : idx;
    if(idx<TOUR_STEPS.length-1){ _showTourStep(_tourStep); } else { _tourFinish(); }
    return;
  }
  // scroll into view, wait
  el.scrollIntoView({behavior:'smooth',block:'center'});
  await sleep(600);
  if(!_tourActive) return;
  el=document.querySelector(step.sel); // re-query after scroll
  const r=el.getBoundingClientRect();
  const pad=8;
  // position spotlight
  sp.style.left=(r.left-pad)+'px';
  sp.style.top=(r.top-pad)+'px';
  sp.style.width=(r.width+pad*2)+'px';
  sp.style.height=(r.height+pad*2)+'px';
  sp.classList.add('visible');
  // update tooltip content
  ttTitle.textContent=step.title;
  ttBody.textContent=step.body;
  ttCounter.textContent=`${idx+1} of ${TOUR_STEPS.length}`;
  ttNext.textContent=idx===TOUR_STEPS.length-1?'Finish ✓':'Next →';
  ttPrev.disabled=(idx===0);
  // smart tooltip position: prefer below, fallback above, clamp to viewport
  const vw=window.innerWidth, vh=window.innerHeight;
  const ttW=316, ttH=180, margin=16;
  let top, left;
  if(r.bottom+ttH+margin<vh){ top=r.bottom+margin; }
  else if(r.top-ttH-margin>0){ top=r.top-ttH-margin; }
  else { top=Math.max(margin,r.bottom+margin); }
  left=r.left;
  left=Math.min(left, vw-ttW-margin);
  left=Math.max(left, margin);
  tt.style.left=left+'px';
  tt.style.top=top+'px';
  tt.classList.add('visible');
}
function showTourStep(idx){ _tourStep=idx; _showTourStep(idx); }
function tourNext(){
  _tourStep++;
  if(_tourStep>=TOUR_STEPS.length){ _tourFinish(); return; }
  _showTourStep(_tourStep);
}
function tourPrev(){
  if(_tourStep<=0) return;
  _tourStep--;
  _showTourStep(_tourStep);
}
function _tourFinish(){
  const confetti=$('tour-confetti');
  if(confetti){
    const colors=['#6C63FF','#00D4AA','#FFB547','#FF4D6D','#FFFFFF','#A78BFA'];
    confetti.innerHTML='';
    for(let i=0;i<24;i++){
      const p=document.createElement('div');
      p.className='conf-piece';
      const dx=(Math.random()-0.5)*300;
      const startX=window.innerWidth*0.3+Math.random()*window.innerWidth*0.4;
      p.style.cssText=`left:${startX}px;--dx:${dx}px;background:${colors[i%colors.length]};animation-delay:${Math.random()*0.5}s;animation-duration:${1.2+Math.random()*0.6}s`;
      confetti.appendChild(p);
    }
    setTimeout(()=>{ if(confetti) confetti.innerHTML=''; },2500);
  }
  setTimeout(endTour,2200);
}
function endTour(){
  _tourActive=false;
  const ov=$('tour-overlay'); if(!ov) return;
  ov.classList.remove('active');
  const sp=$('tour-spotlight'), tt=$('tour-tooltip');
  if(sp) sp.classList.remove('visible');
  if(tt) tt.classList.remove('visible');
  S.onboardDone=true; save();
}
function replayTour(){ endTour(); setTimeout(startTour,400); }

// ── PAYDAY INTELLIGENCE ───────────────────────────────────────────────────────
function _addDays(s,n){return new Date(new Date(s+'T12:00:00').getTime()+n*86400000).toISOString().split('T')[0];}
function getFederalHolidays(y){
  const fix=(m,d)=>{let dt=new Date(y,m-1,d);const dw=dt.getDay();if(dw===6)return new Date(y,m-1,d-1).toISOString().split('T')[0];if(dw===0)return new Date(y,m-1,d+1).toISOString().split('T')[0];return dt.toISOString().split('T')[0];};
  const nth=(m,n,dw)=>{let d=new Date(y,m-1,1),c=0;while(d.getMonth()===m-1){if(d.getDay()===dw&&++c===n)return d.toISOString().split('T')[0];d=new Date(d.getTime()+86400000);}return null;};
  const last=(m,dw)=>{let d=new Date(y,m,0);while(d.getDay()!==dw)d=new Date(d.getTime()-86400000);return d.toISOString().split('T')[0];};
  return[fix(1,1),nth(1,3,1),nth(2,3,1),last(5,1),fix(6,19),fix(7,4),nth(9,1,1),nth(10,2,1),fix(11,11),nth(11,4,4),fix(12,25)].filter(Boolean);
}
function _isHoliday(s){return s?getFederalHolidays(parseInt(s.split('-')[0]||0)).includes(s):false;}
function getActualPayday(s){
  if(!s)return s;
  let d=new Date(s+'T12:00:00');
  const dw=d.getDay();
  if(dw===6)d=new Date(d.getTime()-86400000);
  else if(dw===0)d=new Date(d.getTime()-2*86400000);
  let r=d.toISOString().split('T')[0];
  let guard=0;
  while(guard++<10&&(_isHoliday(r)||new Date(r+'T12:00:00').getDay()===6||new Date(r+'T12:00:00').getDay()===0))r=_addDays(r,-1);
  return r;
}
function calcNextPaydays(n){
  n=n||6;const cfg=S.payScheduleConfig;if(!cfg)return[];
  const today=new Date();today.setHours(12,0,0,0);
  const todayStr=today.toISOString().split('T')[0];
  const early=S.earlyDepositDays||0;
  function mkr(s){const adj=getActualPayday(s);const earlyD=early?_addDays(adj,-early):adj;const dispD=new Date(earlyD+'T12:00:00');return{scheduled:s,adjusted:adj,earlyDate:earlyD,daysAway:Math.round((dispD-today)/86400000),isDifferent:adj!==s||earlyD!==adj};}
  const res=[];
  if(cfg.type==='semimonthly'){
    let yr=today.getFullYear(),mo=today.getMonth();
    for(let i=0;res.length<n&&i<24;i++){
      for(const day of[1,15]){if(res.length>=n)break;const s=`${yr}-${String(mo+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;const r=mkr(s);if(r.earlyDate>=todayStr)res.push(r);}
      if(++mo>11){mo=0;yr++;}
    }
  }else if(cfg.type==='monthly'){
    const dom=Math.min(Math.max(cfg.dayOfMonth||1,1),31);let yr=today.getFullYear(),mo=today.getMonth();
    for(let i=0;res.length<n&&i<18;i++){const last=new Date(yr,mo+1,0).getDate();const day=Math.min(dom,last);const s=`${yr}-${String(mo+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;const r=mkr(s);if(r.earlyDate>=todayStr)res.push(r);if(++mo>11){mo=0;yr++;}}
  }else if(cfg.type==='biweekly'){
    let anchor=new Date((cfg.anchorDate||todayStr)+'T12:00:00');
    while(new Date(anchor.getTime()+14*86400000)<=today)anchor=new Date(anchor.getTime()+14*86400000);
    for(let i=0;res.length<n&&i<30;i++){const s=anchor.toISOString().split('T')[0];const r=mkr(s);if(r.earlyDate>=todayStr)res.push(r);anchor=new Date(anchor.getTime()+14*86400000);}
  }else if(cfg.type==='weekly'){
    const tdow=cfg.dayOfWeek!==undefined?cfg.dayOfWeek:5;let d=new Date(today);
    while(d.getDay()!==tdow)d=new Date(d.getTime()+86400000);
    for(let i=0;res.length<n;i++){res.push(mkr(d.toISOString().split('T')[0]));d=new Date(d.getTime()+7*86400000);}
  }else if(cfg.type==='custom'){
    (cfg.customDates||[]).filter(d=>d>=todayStr).sort().slice(0,n).forEach(s=>res.push(mkr(s)));
  }
  return res.slice(0,n);
}
function getNextPaydayInfo(){
  const dates=calcNextPaydays(1);
  if(!dates.length){
    const ps=S.paySchedule||detectPaySchedule();if(!ps)return null;
    const adj=getActualPayday(ps.nextPayday||'');const early=S.earlyDepositDays||0;const earlyD=early?_addDays(adj,-early):adj;
    const today=new Date();today.setHours(12,0,0,0);
    return{scheduled:ps.nextPayday,adjusted:adj,earlyDate:earlyD,daysAway:Math.round((new Date(earlyD+'T12:00:00')-today)/86400000),amount:ps.avgAmount||0,isDifferent:adj!==(ps.nextPayday||'')||earlyD!==adj};
  }
  const nx=dates[0];const amt=(S.payScheduleConfig&&S.payScheduleConfig.manualAmount)||S.paySchedule?.avgAmount||detectPaySchedule()?.avgAmount||0;
  return{...nx,amount:amt};
}
function getPaydayAmount(){if(S.payScheduleConfig&&S.payScheduleConfig.manualAmount)return S.payScheduleConfig.manualAmount;const ps=S.paySchedule||detectPaySchedule();return ps?ps.avgAmount:0;}

// Returns a stable monthly income estimate for DTI.
// Uses pay schedule × frequency first; falls back to multi-month transaction average.
function getMonthlyIncomeEstimate(){
  // Priority 0: manual net override from income settings
  const _is=S.incomeSettings||{};
  if(_is.manualMonthlyNet>0) return _is.manualMonthlyNet;
  const ps=S.paySchedule||detectPaySchedule();
  if(ps&&ps.avgAmount>0){
    // detectPaySchedule uses 'bi-weekly','weekly','semi-monthly','monthly'
    const mult={'bi-weekly':26/12,'weekly':52/12,'semi-monthly':2,'monthly':1}[ps.cycle]||26/12;
    return Math.round(ps.avgAmount*mult*100)/100;
  }
  // Fallback: average confirmed income across last 6 months that have data
  const monthTotals={};
  S.transactions.forEach(t=>{
    if(!(t.amount>0)||t.internalXfer||!t.incomeType) return;
    const nd=normalizeDate(t.date); if(!nd) return;
    monthTotals[nd.slice(0,7)]=(monthTotals[nd.slice(0,7)]||0)+t.amount;
  });
  const months=Object.keys(monthTotals).sort().filter(mo=>monthTotals[mo]>0);
  if(!months.length) return null;
  const recent=months.slice(-6);
  return Math.round(recent.reduce((a,mo)=>a+monthTotals[mo],0)/recent.length*100)/100;
}

// Returns the shared DTI data object. Supports dual gross/net DTI when both are configured.
function calcDTIData(){
  const curMo=new Date().toISOString().slice(0,7);
  const _LP=/student[\s-]*loan|auto[\s-]*loan|car[\s-]*pay(?:ment)?|personal[\s-]*loan|loan[\s-]*pay|sallie mae|navient|nelnet|ally financial/i;
  const ccMins=S.cards.reduce((a,c)=>a+Math.max(25,+(c.balance||0)*0.02),0);
  const loanTxPmts=S.transactions.filter(t=>t.amount<0&&(t.date||'').slice(0,7)===curMo&&_LP.test(t.description||'')).reduce((a,t)=>a+Math.abs(t.amount),0);
  const loanBillPmts=(S.bills||[]).filter(b=>!b.paused&&b.category==='Loans').reduce((a,b)=>a+toMonthly(b.amount,b.cycle||'monthly'),0);
  const monthlyDebtPayments=Math.round((ccMins+loanTxPmts+loanBillPmts)*100)/100;
  function _makeDTI(income){
    if(!income||income<=0) return null;
    const raw=(monthlyDebtPayments/income)*100;
    if(raw>200) return null;
    const p=Math.round(raw*10)/10;
    const b=p<15?'excellent':p<35?'healthy':p<43?'concerning':'stress';
    return{income,dtiPercent:p,bracket:b,
      targetPaymentsForHealthy:Math.round(income*0.35*100)/100,
      targetIncomeForHealthy:Math.round(monthlyDebtPayments/0.35*100)/100};
  }
  const is=S.incomeSettings||{};
  const netDTI=_makeDTI(getMonthlyIncomeEstimate());
  const grossDTI=_makeDTI(getGrossMonthlyIncome());
  const activeBasis=(is.dtiIncomeBase==='gross'&&grossDTI)?'gross':'net';
  const active=activeBasis==='gross'?grossDTI:netDTI;
  return{
    monthlyDebtPayments, netDTI, grossDTI, activeBasis,
    // Legacy compat fields — always reflect active basis
    monthlyIncome:active?.income||null,
    dtiPercent:active?.dtiPercent||null,
    bracket:active?.bracket||'insufficient',
    targetPaymentsForHealthy:active?.targetPaymentsForHealthy||null,
    targetIncomeForHealthy:active?.targetIncomeForHealthy||null,
    dataQuality:active?'complete':(netDTI||grossDTI?'partial':'insufficient')
  };
}

function getGrossMonthlyIncome(){
  const is=S.incomeSettings||{};
  return is.grossMonthly>0?is.grossMonthly:null;
}
function toggleDtiBasis(val){
  const gs=$('f-inc-gross-section'),ns=$('f-inc-net-section');
  if(gs) gs.style.display=val==='gross'?'block':'none';
  if(ns) ns.style.display=val==='gross'?'none':'block';
  // Visually highlight selected option card
  document.querySelectorAll('.dti-basis-opt').forEach(el=>{
    el.style.borderColor=el.dataset.basis===val?'var(--accent)':'var(--border)';
  });
}
function updateGrossTotal(){
  // Works for both budget-tab inputs (f-inc-*) and income-config modal inputs (f-ic-*)
  const _v=id=>parseFloat(($('f-inc-'+id)||$('f-ic-'+id))?.value||0)||0;
  const salary=_v('salary'), hourly=_v('hourly'), hours=_v('hours')||40, other=_v('other-gross');
  const gross=Math.round((salary/12+hourly*hours*52/12+other)*100)/100;
  const label=gross>0?`<strong>Total gross: ${fmt(gross)}/mo</strong> (${fmt(gross*12)}/yr) — used for DTI only`:'Enter salary or hourly rate above';
  const el1=$('f-inc-gross-total'), el2=$('f-ic-gross-total');
  if(el1) el1.innerHTML=label;
  if(el2) el2.innerHTML=label;
}

// Credit score range helpers
function csRange(score){
  if(score>=800) return{label:'Exceptional',color:'var(--green)'};
  if(score>=740) return{label:'Very Good',color:'var(--teal)'};
  if(score>=670) return{label:'Good',color:'var(--yellow)'};
  if(score>=580) return{label:'Fair',color:'#F97316'};
  return{label:'Poor',color:'var(--red)'};
}
function openCreditScoreModal(){
  const today=new Date().toISOString().split('T')[0];
  $('f-cs-score').value='';
  $('f-cs-date').value=today;
  $('f-cs-note').value='';
  openModal('m-credit-score');
}
function saveCreditScore(){
  const score=parseInt($('f-cs-score').value||'0');
  if(!score||score<300||score>850){alert('Enter a score between 300 and 850.');return;}
  const date=$('f-cs-date').value||new Date().toISOString().split('T')[0];
  const note=($('f-cs-note').value||'').trim();
  if(!AnchorDB.creditScoreHistory) AnchorDB.creditScoreHistory=[];
  AnchorDB.creditScoreHistory.push({date,score,note});
  AnchorDB.creditScoreHistory.sort((a,b)=>a.date.localeCompare(b.date));
  save(); closeModal('m-credit-score'); renderCards();
}
async function deleteCreditScoreEntry(idx){
  if(!await appConfirm('Delete this score entry?',{danger:true,confirmText:'Delete'})) return;
  AnchorDB.creditScoreHistory.splice(idx,1);
  save(); renderCards();
}

// ── WAITLIST ──────────────────────────────────────────────────────────────────
function openWaitlist(plan){
  const planLabel=plan==='premium'?'Anchor Premium':'Anchor Pro';
  $('waitlist-title').textContent='Get early access to '+planLabel;
  $('waitlist-actions').innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-waitlist')">Cancel</button><button class="btn btn-primary" onclick="submitWaitlist()">Join waitlist →</button>`;
  $('waitlist-body').innerHTML=`
    <div class="flex gap8 mb16 align-center">
      <span class="text-muted fs13">Interested in:</span>
      <span class="badge fs12" style="background:rgba(108,99,255,.15);color:#a5b4fc;padding:3px 10px">${planLabel}</span>
    </div>
    <input type="hidden" id="wl-plan" value="${plan}">
    <div class="form-group">
      <label class="form-label">Your email address</label>
      <input class="form-input" id="wl-email" type="email" placeholder="you@example.com" autofocus>
    </div>
    <div class="form-group">
      <label class="form-label">What feature are you most excited about? <span class="text-muted fw4">(optional)</span></label>
      <select class="form-select" id="wl-feature">
        <option value="">— pick one —</option>
        <option value="bank_connect">Direct bank connection (Plaid)</option>
        <option value="brokerage_sync">Brokerage sync (Webull, Coinbase)</option>
        <option value="no_csv">No more CSV uploads — auto-sync</option>
        <option value="bill_negotiation">Bill negotiation service</option>
        <option value="multi_user">Multi-user household sharing</option>
        <option value="ai_insights">AI-powered insights &amp; coaching</option>
        <option value="credit_monitor">Live credit score monitoring</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="priv-note">🔒 Your email stays on your device only. We'll use it solely to notify you when Anchor Pro launches. No spam, ever.</div>`;
  openModal('m-waitlist');
}
function submitWaitlist(){
  const email=($('wl-email').value||'').trim();
  if(!email||!email.includes('@')) return alert('Please enter a valid email address.');
  const plan=$('wl-plan').value||'pro';
  const feature=$('wl-feature').value||'';
  const entry={email,plan,topFeature:feature,signedUpAt:new Date().toISOString(),userId:'beta-user'};
  if(!AnchorDB.waitlist) AnchorDB.waitlist=[];
  // Upsert by email+plan
  const idx=AnchorDB.waitlist.findIndex(w=>w.email===email&&w.plan===plan);
  if(idx>=0) AnchorDB.waitlist[idx]={...AnchorDB.waitlist[idx],...entry};
  else AnchorDB.waitlist.push(entry);
  save();
  // Show success state
  $('waitlist-title').textContent="You're on the list! 🎉";
  $('waitlist-actions').innerHTML='';
  $('waitlist-body').innerHTML=`
    <div style="text-align:center;padding:8px 0 16px">
      <div style="font-size:48px;margin-bottom:12px">🚀</div>
      <div class="fw7 fs15 mb8">We'll email you when Anchor Pro launches.</div>
      <div class="text-muted fs13 mb16">You're one of our first beta users — you'll get a special early-adopter discount when we launch.</div>
      <div class="text-muted fs12" style="background:var(--surface2);border-radius:var(--r-sm);padding:10px">${esc(email)} · ${plan==='premium'?'Anchor Premium':'Anchor Pro'}</div>
    </div>`;
  setTimeout(()=>closeModal('m-waitlist'),3000);
}

// ── SETTINGS ──────────────────────────────────────────────────────────────────
function openSettings(){
  const pdi=getNextPaydayInfo();const cfg=S.payScheduleConfig;
  const TYPE_LBL={biweekly:'Every 2 weeks',semimonthly:'1st & 15th',monthly:'Monthly',weekly:'Weekly',custom:'Custom'};
  const hist=S.paydayHistory||[];const avgHist=hist.length?hist.reduce((a,h)=>a+h.amount,0)/hist.length:0;
  const ytd=hist.filter(h=>h.date&&h.date.startsWith(new Date().getFullYear())).reduce((a,h)=>a+h.amount,0);
  $('settings-body').innerHTML=`
    <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb8" style="font-size:15px">Income Configuration</div>
      <div class="text-muted fs12 mb8">Set your gross and/or take-home income for accurate DTI and savings rate calculations.</div>
      ${(()=>{const cfg=AnchorDB.income.configuration;const is=S.incomeSettings||{};const net=cfg.totalMonthlyNet||is.manualMonthlyNet||getMonthlyIncomeEstimate();const gross=cfg.totalMonthlyGross||is.grossMonthly;return(net||gross)?`<div class="text-muted fs12 mb8">${net?`Take-home: <strong class="text-green">${fmt(net)}/mo</strong>`:''}${net&&gross?' · ':''}${gross?`Gross: <strong>${fmt(gross)}/mo</strong>`:''} · Basis: ${cfg.dtiIncomeBase||'net'}${cfg.configuredViaQuiz?' · via quiz':''}</div>`:'<div class="text-muted fs12 mb8">Not configured — DTI uses auto-detected deposits</div>';})()}
      <div class="flex gap8" style="flex-wrap:wrap">
        <button class="btn btn-primary btn-sm" onclick="closeModal('m-settings');openIncomeQuiz()">Income quiz →</button>
        <button class="btn btn-ghost btn-sm" onclick="closeModal('m-settings');openIncomeConfig()">Enter exact amounts</button>
        ${AnchorDB.income.configuration.configuredManually?`<button class="btn btn-danger btn-sm" onclick="appConfirm('Clear income configuration? DTI will revert to auto-detected estimates.',{danger:true,confirmText:'Clear'}).then(function(ok){if(ok){AnchorDB.income.configuration={dtiIncomeBase:'net',sources:[],bonusHistory:[],monthlyBonusAverage:0,totalMonthlyGross:0,totalMonthlyNet:0,totalDTIEligible:0,configuredAt:null,configuredManually:false};S.incomeSettings={...(S.incomeSettings||{}),manualMonthlyNet:0,grossMonthly:0};DataStore.sync('income-deleted');closeModal('m-settings');}})">Delete income data</button>`:''}
      </div>
    </div>
    <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb8" style="font-size:15px">Product Tour</div>
      <div class="text-muted fs12 mb8">Get a guided walkthrough of every feature in Anchor.</div>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('m-settings');startTour()">🗺️ Replay Tour</button>
    </div>
    <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb8" style="font-size:15px">Financial Profile</div>
      ${S.userProfile&&PROFILES[S.userProfile]?`<div class="text-muted fs12 mb8">Current profile: <strong>${PROFILES[S.userProfile].icon} ${PROFILES[S.userProfile].name}</strong></div>`:'<div class="text-muted fs12 mb8">No profile set yet.</div>'}
      <div class="text-muted fs12 mb10">Retake the 7-question quiz to get a fresh profile assignment with the updated scoring system.</div>
      <button class="btn btn-ghost btn-sm" onclick="retakeQuiz()">🔄 Retake profile quiz</button>
    </div>
    <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb10" style="font-size:15px">Payday Schedule</div>
      ${cfg?`<div style="background:var(--surface2);border-radius:var(--r);padding:12px;margin-bottom:10px">
        <div class="flex-sb"><div><div class="fw7 fs13">${TYPE_LBL[cfg.type]||cfg.type}</div><div class="text-muted fs12">${pdi?`Next: ${pdi.earlyDate} · ~${fmt(pdi.amount||0)}`:'—'}</div></div>
        <button class="btn btn-ghost btn-sm" onclick="closeModal('m-settings');showPaydaySetup()">Edit</button></div>
      </div>`:``}
      <button class="btn btn-primary btn-sm" onclick="closeModal('m-settings');showPaydaySetup()">${cfg?'Reconfigure schedule':'Set up payday schedule'}</button>
    </div>
    <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb8" style="font-size:15px">Early Direct Deposit</div>
      <div class="text-muted fs12 mb8">How early does your bank typically release deposits?</div>
      <select class="form-select" onchange="S.earlyDepositDays=parseInt(this.value);save()" style="max-width:220px">
        <option value="0"${(S.earlyDepositDays===0)?' selected':''}>Same day (scheduled date)</option>
        <option value="1"${(S.earlyDepositDays===undefined||S.earlyDepositDays===1)?' selected':''}>1 day early (default)</option>
        <option value="2"${(S.earlyDepositDays===2)?' selected':''}>2 days early</option>
        <option value="3"${(S.earlyDepositDays===3)?' selected':''}>3 days early</option>
      </select>
    </div>
    ${hist.length>0?`<div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb6" style="font-size:15px">Paycheck History <span class="text-muted fw4 fs12">(${hist.length} confirmed)</span></div>
      <div class="text-muted fs12 mb8">Average: ${fmt(avgHist)} · YTD total: ${fmt(ytd)}</div>
      <div style="max-height:200px;overflow-y:auto">
        <table style="width:100%;font-size:12px;border-collapse:collapse">
          <tbody>${hist.slice().reverse().slice(0,15).map(p=>{const diff=avgHist>0?Math.abs(p.amount-avgHist)/avgHist:0;return`<tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 0">${p.date}</td><td style="text-align:right;font-weight:700;color:var(--green);padding:6px 8px">${fmt(p.amount)}</td><td style="font-size:11px;color:${diff>0.15?'#FFB547':'var(--muted)'}">${diff>0.15?'⚠ unusual':''}</td></tr>`;}).join('')}</tbody>
        </table>
      </div>
    </div>`:''}
    <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div class="fw7 mb8" style="font-size:15px">🔒 Your Data &amp; Privacy</div>
      <div class="text-muted fs12 mb12" style="line-height:1.7">Everything is stored in your browser's local storage on this device. Nothing is on any server. Nothing is transmitted anywhere.<br><br>
        <strong>Anchor stores:</strong> transactions, balances, cards, income (if provided), goals, bills, subscriptions, investments.
      </div>
      <div class="flex gap8" style="flex-wrap:wrap;margin-bottom:10px">
        <button class="btn btn-ghost btn-sm" onclick="closeModal('m-settings');exportJSON()">Export backup first</button>
        <button class="btn btn-ghost btn-sm" onclick="closeModal('m-settings');go('budget','income');setTimeout(()=>{const f=document.querySelector('[onclick*=incomeQuiz],[onclick*=openIncomeConfig]');},200)">View income data</button>
      </div>
      <div class="flex gap8" style="flex-wrap:wrap">
        <button class="btn btn-danger btn-sm" onclick="appConfirm('Delete transaction history? This removes all uploaded CSV data but keeps settings, cards, and goals.',{danger:true,confirmText:'Delete'}).then(function(ok){if(ok){S.transactions=[];S.balanceHistory={};DataStore.sync('tx-deleted');closeModal('m-settings');}})">Delete transactions</button>
        <button class="btn btn-danger btn-sm" onclick="appConfirm('Delete investment data?',{danger:true,confirmText:'Delete'}).then(function(ok){if(ok){S.investments=[];DataStore.sync('invest-deleted');closeModal('m-settings');}})">Delete investments</button>
        <button class="btn btn-danger btn-sm" onclick="closeModal('m-settings');clearAllData()">Clear ALL data</button>
      </div>
    </div>
    <div class="priv-note">🔒 Your data is stored only on this device. Anchor has no servers, no accounts, and no telemetry. Nothing you enter is ever transmitted anywhere.</div>

    <!-- Anchor Pro section -->
    <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--border)">
      <div class="flex-sb mb4">
        <div><div class="fw7" style="font-size:15px">Anchor Pro — Coming Soon</div><div class="text-muted fs12 mt2">More power. Less manual work.</div></div>
        <span class="badge fs11" style="background:rgba(108,99,255,.15);color:#a5b4fc;padding:3px 10px">Current plan: Free (Beta)</span>
      </div>
      ${AnchorDB.waitlist.length>0?`<div class="text-green fs12 mb12 fw6">✓ You've joined the Anchor Pro waitlist — we'll email you at launch.</div>`:''}
      <div class="pro-tier-grid">
        <!-- Free -->
        <div class="pro-tier-card">
          <div class="flex-sb mb6"><div class="fw7 fs14">Anchor Core</div><span class="badge fs10" style="background:rgba(0,212,170,.12);color:var(--green)">Your current plan</span></div>
          <div class="fw7 fs13 mb10" style="color:var(--text-sec)">Free — forever</div>
          <ul class="pro-feat-list">
            <li><span class="pro-feat-icon">✓</span>CSV uploads — all accounts</li>
            <li><span class="pro-feat-icon">✓</span>Full dashboard &amp; all tabs</li>
            <li><span class="pro-feat-icon">✓</span>Financial health score</li>
            <li><span class="pro-feat-icon">✓</span>Paycheck planner</li>
            <li><span class="pro-feat-icon">✓</span>Manual investment tracking</li>
            <li><span class="pro-feat-icon">✓</span>Live crypto prices</li>
            <li><span class="pro-feat-icon">✓</span>Goals, bills &amp; subscriptions</li>
            <li><span class="pro-feat-icon">✓</span>Export &amp; import backup</li>
          </ul>
          <button class="btn btn-ghost btn-sm" disabled style="opacity:.5;width:100%">You're on this plan</button>
        </div>
        <!-- Pro -->
        <div class="pro-tier-card pro-featured">
          <div class="flex-sb mb6"><div class="fw7 fs14">Anchor Pro</div><span class="badge fs10" style="background:rgba(255,181,71,.15);color:var(--yellow)">Coming soon</span></div>
          <div class="fw7 fs13 mb2" style="color:var(--accent)">$7/mo or $60/year</div>
          <div class="text-muted fs11 mb10">~40% off with annual plan</div>
          <ul class="pro-feat-list">
            <li><span class="pro-feat-icon">⚡</span>Direct bank connection (Plaid)</li>
            <li><span class="pro-feat-icon">⚡</span>Brokerage sync (Webull, Coinbase)</li>
            <li><span class="pro-feat-icon">⚡</span>Auto-sync — no more CSV uploads</li>
            <li><span class="pro-feat-icon">⚡</span>AI transaction categorization</li>
            <li><span class="pro-feat-icon">⚡</span>Smart PDF parsing</li>
            <li><span class="pro-feat-icon">⚡</span>Advanced spending insights</li>
            <li><span class="pro-feat-icon">⚡</span>Priority support</li>
            <li><span class="pro-feat-icon">⚡</span>Early access to new features</li>
          </ul>
          <button class="btn btn-primary btn-sm" style="width:100%" onclick="closeModal('m-settings');openWaitlist('pro')">Join the waitlist →</button>
        </div>
        <!-- Premium -->
        <div class="pro-tier-card">
          <div class="flex-sb mb6"><div class="fw7 fs14">Anchor Premium</div><span class="badge fs10" style="background:rgba(108,99,255,.15);color:#a5b4fc">Coming soon</span></div>
          <div class="fw7 fs13 mb2" style="color:var(--text-sec)">$13/mo or $120/year</div>
          <div class="text-muted fs11 mb10">&nbsp;</div>
          <ul class="pro-feat-list">
            <li><span class="pro-feat-icon">💎</span>Everything in Pro</li>
            <li><span class="pro-feat-icon">💎</span>Multi-user &amp; household sharing</li>
            <li><span class="pro-feat-icon">💎</span>Bill negotiation service</li>
            <li><span class="pro-feat-icon">💎</span>Live credit score monitoring</li>
            <li><span class="pro-feat-icon">💎</span>Custom financial reports (PDF)</li>
            <li><span class="pro-feat-icon">💎</span>Financial advisor sharing mode</li>
            <li><span class="pro-feat-icon">💎</span>AI debt payoff coaching</li>
            <li><span class="pro-feat-icon">💎</span>Goal-based investment suggestions</li>
          </ul>
          <button class="btn btn-ghost btn-sm" style="width:100%;border-color:var(--accent);color:var(--accent)" onclick="closeModal('m-settings');openWaitlist('premium')">Join the waitlist →</button>
        </div>
      </div>
    </div>`;
  openModal('m-settings');
}

// ── PAYDAY SETUP WIZARD ───────────────────────────────────────────────────────
let _pdsStep=1,_pdsCfg={type:'biweekly'};
function showPaydaySetup(){
  _pdsStep=1;_pdsCfg=S.payScheduleConfig?{...S.payScheduleConfig}:{type:'biweekly',anchorDate:null};
  _renderPDS();openModal('m-payday-setup');
}
function _renderPDS(){
  const body=$('pds-body');if(!body)return;
  const TODAY=new Date().toISOString().split('T')[0];
  if(_pdsStep===1){
    body.innerHTML=`
      <div class="text-muted fs13 mb12">How often do you get paid?</div>
      <div style="display:grid;gap:8px;margin-bottom:16px">
        ${[['biweekly','Every 2 weeks','Most common — same weekday, every 14 days'],['semimonthly','1st and 15th','Two fixed paydays per month'],['monthly','Once a month','Same day each month'],['weekly','Every week','Same weekday each week'],['custom','Custom / Irregular','Manually enter your next paydays']].map(([v,l,s])=>`
          <button class="ob-choice${_pdsCfg.type===v?' selected':''}" onclick="_pdsCfg.type='${v}';_renderPDS()">
            <div class="ob-choice-label">${l}</div><div class="ob-choice-sub">${s}</div>
          </button>`).join('')}
      </div>
      <div class="modal-actions" style="padding:0">
        <button class="btn btn-ghost" onclick="closeModal('m-payday-setup')">Cancel</button>
        <button class="btn btn-primary" onclick="_pdsStep=2;_renderPDS()">Next →</button>
      </div>`;
  }else if(_pdsStep===2){
    const autoAmt=S.paySchedule?.avgAmount||detectPaySchedule()?.avgAmount||0;
    let cfgHTML='';
    if(_pdsCfg.type==='biweekly')cfgHTML=`<div class="mb12"><label class="form-label">Anchor date (a recent or upcoming payday)</label><input type="date" class="form-input" value="${_pdsCfg.anchorDate||TODAY}" style="max-width:200px" oninput="_pdsCfg.anchorDate=this.value;_renderPDSPrev()"><div class="text-muted fs12 mt4">We'll calculate every 14 days from this date.</div></div>`;
    else if(_pdsCfg.type==='semimonthly')cfgHTML=`<div class="text-muted fs13 mb12">Paydays are the 1st and 15th of each month — no additional configuration needed.</div>`;
    else if(_pdsCfg.type==='monthly')cfgHTML=`<div class="mb12"><label class="form-label">Day of month</label><input type="number" class="form-input" min="1" max="31" value="${_pdsCfg.dayOfMonth||15}" style="max-width:100px" oninput="_pdsCfg.dayOfMonth=parseInt(this.value)||1;_renderPDSPrev()"><div class="text-muted fs12 mt4">If this day doesn't exist in a month, the last valid day is used.</div></div>`;
    else if(_pdsCfg.type==='weekly')cfgHTML=`<div class="mb12"><label class="form-label">Day of week</label><select class="form-select" style="max-width:160px" onchange="_pdsCfg.dayOfWeek=parseInt(this.value);_renderPDSPrev()">${[['Monday',1],['Tuesday',2],['Wednesday',3],['Thursday',4],['Friday',5]].map(([l,v])=>`<option value="${v}"${(_pdsCfg.dayOfWeek||5)===v?' selected':''}>${l}</option>`).join('')}</select></div>`;
    else if(_pdsCfg.type==='custom')cfgHTML=`<div class="mb12"><label class="form-label">Enter your next paydays (at least 2)</label><div id="pds-cdates">${(_pdsCfg.customDates&&_pdsCfg.customDates.length?_pdsCfg.customDates:['','']).map(d=>`<input type="date" class="form-input mb6" style="display:block;max-width:200px" value="${d}" oninput="_pdsCfg.customDates=Array.from(document.querySelectorAll('#pds-cdates input')).map(e=>e.value).filter(Boolean)">`).join('')}</div><button class="btn btn-ghost btn-sm mt6" onclick="(_pdsCfg.customDates=_pdsCfg.customDates||[]).push('');_renderPDS()">+ Add date</button></div>`;
    body.innerHTML=`${cfgHTML}
      <div class="mb12"><label class="form-label">Expected paycheck amount <span class="text-muted fw4">(optional)</span></label>
        <input type="number" class="form-input" value="${_pdsCfg.manualAmount||''}" placeholder="${autoAmt?'From CSV: ~'+Math.round(autoAmt):'e.g. 2500'}" style="max-width:160px" oninput="_pdsCfg.manualAmount=parseFloat(this.value)||null">
        ${autoAmt&&!_pdsCfg.manualAmount?`<div class="text-muted fs12 mt4">Auto-detected from CSV: ~${fmt(autoAmt)}</div>`:''}
      </div>
      <div id="pds-prev" style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;margin-bottom:12px;font-size:12px;color:var(--muted)">Calculating preview…</div>
      <div class="modal-actions" style="padding:0">
        <button class="btn btn-ghost" onclick="_pdsStep=1;_renderPDS()">← Back</button>
        <button class="btn btn-primary" onclick="_pdsStep=3;_renderPDS()">Preview dates →</button>
      </div>`;
    _renderPDSPrev();
  }else if(_pdsStep===3){
    const tmp=S.payScheduleConfig;S.payScheduleConfig={..._pdsCfg};const pds=calcNextPaydays(6);S.payScheduleConfig=tmp;
    const early=S.earlyDepositDays||0;const DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    body.innerHTML=`
      <div class="text-muted fs13 mb12">Weekend and US federal holiday adjustments have been applied. Confirm these look right.</div>
      <div style="margin-bottom:16px">
        ${pds.map((p,i)=>{const d=new Date(p.earlyDate+'T12:00:00');return`
          <div style="display:flex;align-items:center;gap:12px;padding:10px;border-radius:var(--r-sm);background:var(--surface2);margin-bottom:6px">
            <div style="font-size:18px;width:24px;text-align:center">${i===0?'💰':'📅'}</div>
            <div style="flex:1"><div class="fw7 fs14">${DAYS[d.getDay()]}, ${p.earlyDate}</div>
              ${p.isDifferent?`<div class="text-muted fs12">Scheduled: ${p.scheduled}${early?` · ${early}d early deposit`:''}</div>`:``}
            </div>
            ${i===0?`<div class="text-green fw7 fs13">${(_pdsCfg.manualAmount||getPaydayAmount())>0?'~'+fmt(_pdsCfg.manualAmount||getPaydayAmount()):'—'}</div>`:''}
          </div>`}).join('')}
      </div>
      <div style="background:rgba(108,99,255,.1);border-radius:var(--r);padding:10px;font-size:12px;color:var(--muted);margin-bottom:16px">
        We'll remind you 2–3 days before each payday to review your budget.
      </div>
      <div class="modal-actions" style="padding:0">
        <button class="btn btn-ghost" onclick="_pdsStep=2;_renderPDS()">← Back</button>
        <button class="btn btn-primary" onclick="_savePDS()">These look right — save my schedule</button>
      </div>`;
  }
}
function _renderPDSPrev(){const el=$('pds-prev');if(!el)return;const tmp=S.payScheduleConfig;S.payScheduleConfig={..._pdsCfg};const pds=calcNextPaydays(3);S.payScheduleConfig=tmp;el.innerHTML=pds.length?'Preview: '+pds.map(p=>p.earlyDate).join(' · '):'(configure to see preview)';}
function _savePDS(){S.payScheduleConfig={..._pdsCfg};save();closeModal('m-payday-setup');renderHome();const t=document.createElement('div');t.className='toast-msg';t.textContent='Payday schedule saved!';document.body.appendChild(t);setTimeout(()=>t.remove(),2500);}

// ── PAYDAY CONFIRMATION ───────────────────────────────────────────────────────
function _paydayBannerHTML(){
  const pdi=getNextPaydayInfo();if(!pdi||pdi.daysAway>3)return'';
  const dismissed=S.dismissedPaydayBanners[pdi.earlyDate];
  if(dismissed&&Date.now()-dismissed<23*3600000)return''; // dismissed within 23h
  const confirmed=S.paydayHistory.some(h=>h.date===pdi.earlyDate&&h.confirmed);
  if(confirmed){
    const hist=S.paydayHistory.find(h=>h.date===pdi.earlyDate);
    return`<div class="payday-banner payday-confirmed mb16">
      <span class="fw7">✓ Paycheck confirmed — ${fmt(hist?.amount||pdi.amount)} received on ${pdi.earlyDate}</span>
      <button class="btn btn-primary btn-sm" onclick="bSub='paycheck';go('budget')">Allocate funds →</button>
    </div>`;
  }
  const dl=pdi.daysAway<=0?'Today!':pdi.daysAway===1?'Tomorrow':`in ${pdi.daysAway} days`;
  return`<div class="payday-banner mb16">
    <div>
      <div class="fw7 fs14">💰 Payday is ${dl} — ${pdi.earlyDate}</div>
      ${pdi.isDifferent&&pdi.scheduled!==pdi.earlyDate?`<div class="text-muted fs12">Scheduled: ${pdi.scheduled}</div>`:''}
      <div class="text-muted fs12 mt4">Is this still your expected pay date?</div>
    </div>
    <div class="flex gap8 mt10" style="flex-wrap:wrap">
      <button class="btn btn-primary btn-sm" onclick="confirmPayday('${pdi.earlyDate}',${pdi.amount||0})">✓ Confirm</button>
      <button class="btn btn-ghost btn-sm" onclick="showPaydaySetup()">✎ Edit</button>
      <button class="btn btn-ghost btn-sm" onclick="S.dismissedPaydayBanners['${pdi.earlyDate}']=Date.now();save();renderHome()">Remind me tomorrow</button>
    </div>
  </div>`;
}
function confirmPayday(dateStr,amount){
  const hi=(S.paydayHistory||[]).findIndex(h=>h.date===dateStr);
  if(hi>=0){S.paydayHistory[hi].confirmed=true;if(amount)S.paydayHistory[hi].amount=amount;}
  else S.paydayHistory.push({date:dateStr,amount:amount||0,source:'manual',confirmed:true});
  save();renderHome();
}
async function _pdsEditAmount(){
  const cur=getPaydayAmount();
  const num=v=>parseFloat(String(v).replace(/[$,\s]/g,''));
  const v=await appPrompt('Estimated paycheck amount',{label:'Amount per paycheck',prefix:'$',inputmode:'decimal',placeholder:'0.00',value:cur?Math.round(cur):'',confirmText:'Save',
    validate:s=>{const n=num(s);return(isNaN(n)||n<0)?'Enter a valid amount.':'';}});
  if(v===null) return;
  if(!S.payScheduleConfig)S.payScheduleConfig={type:'biweekly'};
  S.payScheduleConfig.manualAmount=num(v);save();renderBudget();
}

// ── PAYCHECK PLANNER ──────────────────────────────────────────────────────────
function _paycheckHTML(){
  const pdi=getNextPaydayInfo();
  if(!pdi)return`<div class="card mt16"><div class="empty"><div class="empty-icon">📅</div><div>No payday schedule configured.<br><button class="btn btn-primary btn-sm mt8" onclick="showPaydaySetup()">Set up payday →</button></div></div></div>`;
  const today=new Date();today.setHours(12,0,0,0);
  const todayStr=today.toISOString().split('T')[0];
  const payDateStr=pdi.earlyDate;const da=pdi.daysAway;const paycheck=pdi.amount||0;
  const DAYS=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const pd=new Date(payDateStr+'T12:00:00');const pdLabel=`${DAYS[pd.getDay()]}, ${payDateStr}`;
  // Pay frequency multiplier — prefer manually-configured schedule, else fall back to the
  // auto-detected cycle (S.paySchedule) so users who never ran "Set Up Payday" still get
  // correct per-check math instead of silently defaulting to monthly.
  const _ppsAuto=S.paySchedule||detectPaySchedule();
  const _ppsCycleMap={'weekly':'weekly','bi-weekly':'biweekly','biweekly':'biweekly','semi-monthly':'semimonthly','semimonthly':'semimonthly','monthly':'monthly'};
  const _ppsActiveCycle=S.payScheduleConfig?.type||_ppsCycleMap[_ppsAuto?.cycle]||'biweekly';
  const payFreq={biweekly:2.17,semimonthly:2,weekly:4.33,monthly:1}[_ppsActiveCycle]||2.17;
  const cycledays={biweekly:14,semimonthly:15,weekly:7,monthly:30}[_ppsActiveCycle]||14;
  // Due items this pay period
  const dueBills=(S.bills||[]).filter(b=>!b.paused&&b.nextDue&&b.nextDue>=todayStr&&b.nextDue<=payDateStr).sort((a,b)=>a.nextDue.localeCompare(b.nextDue));
  const dueSubs=(S.subs||[]).filter(s=>!s.paused&&s.nextBilling&&s.nextBilling>=todayStr&&s.nextBilling<=payDateStr).sort((a,b)=>a.nextBilling.localeCompare(b.nextBilling));
  // Non-billing subs that contribute to this period via prorated accrual
  const accrualSubs=(S.subs||[]).filter(s=>!s.paused&&!(s.nextBilling&&s.nextBilling>=todayStr&&s.nextBilling<=payDateStr)).map(s=>{
    const billing=s.cycle||'monthly';
    let monthly=s.amount||0;
    if(billing==='annual') monthly=(s.amount||0)/12;
    else if(billing==='weekly') monthly=(s.amount||0)*4.33;
    const perCheck=Math.round(monthly/payFreq*100)/100;
    return{...s,billingCycle:billing,perCheck,monthly};
  }).filter(s=>s.perCheck>0);
  const dueCombined=[...dueBills.map(b=>({name:b.name,amount:b.amount,date:b.nextDue,type:'bill'})),...dueSubs.map(s=>({name:s.name,amount:s.amount,date:s.nextBilling,type:'sub'}))].sort((a,b)=>a.date.localeCompare(b.date));
  const committedBills=dueBills.reduce((a,b)=>a+(b.amount||0),0);
  const committedSubs=dueSubs.reduce((a,s)=>a+(s.amount||0),0);
  const accrualSubsTotal=accrualSubs.reduce((a,s)=>a+s.perCheck,0);
  const committed=committedBills+committedSubs;
  // Next pay period items (lookahead)
  const nextPayStr=_addDays(payDateStr,cycledays);
  const nextBills=(S.bills||[]).filter(b=>!b.paused&&b.nextDue&&b.nextDue>payDateStr&&b.nextDue<=nextPayStr);
  const nextSubs=(S.subs||[]).filter(s=>!s.paused&&s.nextBilling&&s.nextBilling>payDateStr&&s.nextBilling<=nextPayStr);
  // Goal contributions
  const goalContribs=(S.goals||[]).filter(g=>!g.done&&g.target).map(g=>{
    const rem=Math.max(0,(g.target||0)-(g.current||0));
    let monthly=g.monthly||0;
    if(!monthly&&g.deadline){const ml=Math.max(1,Math.round((new Date(g.deadline)-today)/2592000000));monthly=rem/ml;}
    const periodic=monthly>0?Math.round(monthly/payFreq):0;
    const pctDone=g.target>0?Math.round((g.current||0)/g.target*100):0;
    const isOnTrack=rem>0&&g.deadline?new Date(g.deadline)>today:true;
    return{...g,monthly,periodic,pctDone,isOnTrack};
  }).filter(g=>g.periodic>0);
  const totalGoals=goalContribs.reduce((a,g)=>a+g.periodic,0);
  // Budget category per-check allocations
  const catBudgets=S.catBudgets||{};
  const catAllocs=CATS.map(cat=>{
    const monthly=catBudgets[cat]||0;
    if(!monthly) return null;
    const periodic=Math.round(monthly/payFreq);
    return{cat,monthly,periodic};
  }).filter(Boolean);
  const totalBudgetAlloc=catAllocs.reduce((a,c)=>a+c.periodic,0);
  const afterCommitted=paycheck-committed;
  const afterGoals=afterCommitted-totalGoals;
  const remaining=afterGoals-totalBudgetAlloc-accrualSubsTotal;
  const totalObl=committed+totalGoals+totalBudgetAlloc+accrualSubsTotal;
  // Allocation bar segments
  const barTotal=Math.max(paycheck,totalObl,1);
  const bPct=Math.min(98,committedBills/barTotal*100).toFixed(1);
  const sPct=Math.min(98,committedSubs/barTotal*100).toFixed(1);
  const aPct=Math.min(98,accrualSubsTotal/barTotal*100).toFixed(1);
  const gPct=Math.min(98,totalGoals/barTotal*100).toFixed(1);
  const bdgPct=Math.min(98,totalBudgetAlloc/barTotal*100).toFixed(1);
  const rPct=Math.max(0,100-parseFloat(bPct)-parseFloat(sPct)-parseFloat(aPct)-parseFloat(gPct)-parseFloat(bdgPct)).toFixed(1);
  // Health check
  let statusCls='',statusTxt='';
  if(paycheck>0){
    const r=totalObl/paycheck;
    const remPct=(remaining/paycheck)*100;
    if(r>1){
      statusCls='payday-danger';
      // Find top reductions
      const suggestions=[];
      if(dueSubs.length) suggestions.push(`Pause ${dueSubs[0].name} (${fmt(dueSubs[0].amount)}) to save ${fmt(dueSubs[0].amount)} this period`);
      if(catAllocs.length) suggestions.push(`Reduce ${catAllocs[0].cat} budget by ~${fmt(Math.round(catAllocs[0].periodic/2))} this check`);
      if(goalContribs.length) suggestions.push(`Skip ${goalContribs[goalContribs.length-1].name} goal contribution (${fmt(goalContribs[goalContribs.length-1].periodic)}) — resume next period`);
      statusTxt=`🔴 Committed expenses (${fmt(totalObl)}) exceed your expected check (${fmt(paycheck)}).${suggestions.length?'<br><span class="fs11 text-muted">Quick wins: '+suggestions.slice(0,2).map(s=>`<br>• ${s}`).join('')+'</span>':''}`;
    } else if(remPct<5){
      statusCls='payday-warn';statusTxt=`⚠️ Check is nearly fully committed — only ${fmt(remaining)} (${pct(remPct)}) buffer remaining. Watch discretionary spending.`;
    } else if(remPct<15){
      statusCls='payday-warn';statusTxt=`⚠️ Tight — ${fmt(remaining)} (${pct(remPct)}) left after all commitments.`;
    } else {
      statusCls='payday-ok';statusTxt=`✅ ${fmt(remaining)} (${pct(remPct)}) available after all commitments.${totalGoals>0?` Consider adding ${fmt(Math.round(remaining*0.5))} to your top goal.`:''}`;
    }
  }
  const srcBadge=(lbl)=>`<span class="badge fs10" style="background:var(--surface3);color:var(--muted);padding:1px 5px">${lbl}</span>`;
  // Ending-soon and upcoming income warnings
  const _endingWarn=(()=>{
    const srcs=AnchorDB.income.sources||[];
    const endingSoon=srcs.filter(s=>getIncomeStatus(s).status==='ending-soon');
    const upcoming=srcs.filter(s=>getIncomeStatus(s).status==='upcoming');
    if(!endingSoon.length&&!upcoming.length) return '';
    const items=[];
    const freq={biweekly:26,weekly:52,semimonthly:24,monthly:12}[S.payScheduleConfig?.type||'biweekly']||26;
    endingSoon.forEach(s=>{
      const st=getIncomeStatus(s);
      const checksLeft=Math.floor(st.daysLeft/(365/freq));
      items.push(`<div class="fs12" style="padding:6px 0;border-bottom:1px solid var(--border)33">
        <span style="color:#f59e0b;font-weight:600">⚠ ${esc(s.name||s.type)}</span> ends in ${st.daysLeft} day${st.daysLeft===1?'':'s'}
        ${checksLeft>0?`<span class="text-muted"> (~${checksLeft} paycheck${checksLeft===1?'':'s'} remaining at this job)</span>`:'<span class="text-muted"> — possibly your last paycheck</span>'}
        <div class="text-muted fs11">Last paycheck from this source: ~${s.endDate}</div>
      </div>`);
    });
    upcoming.forEach(s=>{
      const st=getIncomeStatus(s);
      items.push(`<div class="fs12" style="padding:6px 0;border-bottom:1px solid var(--border)33">
        <span style="color:#3b82f6;font-weight:600">⏳ ${esc(s.name||s.type)}</span> starts in ${st.daysUntil} day${st.daysUntil===1?'':'s'} — not yet included in paycheck planning.
      </div>`);
    });
    return `<div style="background:#f59e0b18;border:1px solid #f59e0b44;border-radius:var(--r);padding:12px 14px;margin-bottom:12px"><div class="fw6 fs12 mb6" style="color:#f59e0b">Income timeline note</div>${items.join('')}</div>`;
  })();
  return`
  ${_endingWarn}
  <div class="alert fs12 mb12" style="background:var(--surface2);border-radius:var(--r-sm);padding:8px 12px;color:var(--text-sec)">Amounts based on estimated take-home pay. DTI calculations may use a different basis — <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="go('cards')">see Credit Cards tab →</span></div>
  <div class="card mb16">
    <div class="flex-sb mb12">
      <div><div class="card-title">Paycheck Planner</div><div class="text-muted fs13">${da<=0?'Today':da===1?'Tomorrow':`In ${da} days`} · ${pdLabel}</div></div>
      <div class="text-right"><div class="fw7 fs18 ${paycheck>0?'text-green':'text-muted'}">${paycheck>0?('~'+fmt(paycheck)):'Amount?'}</div><button class="btn btn-ghost btn-xs mt4" onclick="_pdsEditAmount()">Edit amount</button></div>
    </div>
    ${pdi.isDifferent&&pdi.scheduled!==pdi.earlyDate?`<div class="text-muted fs12 mb6">Scheduled: ${pdi.scheduled} · Early deposit: ${S.earlyDepositDays||1} day${(S.earlyDepositDays||1)>1?'s':''} early</div>`:''}
    ${(()=>{const ps2=S.paySchedule||detectPaySchedule();if(!ps2?.hasSplits||!ps2?.splitAccountPcts||!paycheck) return '';return `<div class="alert fs12 mb10" style="background:var(--surface2);border-radius:var(--r-sm);padding:8px 12px"><span class="fw6">Split deposit:</span> ${ps2.splitAccountPcts.map(sp=>`${esc(sp.account||'Account')}: ~${fmt(Math.round(paycheck*sp.pct))}${sp.pct<0.5?' (early)':''}`).join(' · ')}</div>`})()}
    ${paycheck>0?`<div class="mb6 fw7 fs12">Allocation</div>
    <div class="alloc-bar mb8">
      <div class="alloc-seg" style="width:${bPct}%;background:var(--red)" title="Bills: ${fmt(committedBills)}"></div>
      <div class="alloc-seg" style="width:${sPct}%;background:#FFB547" title="Subs (billing): ${fmt(committedSubs)}"></div>
      <div class="alloc-seg" style="width:${aPct}%;background:#fb923c" title="Subs (accruing): ${fmt(accrualSubsTotal)}"></div>
      <div class="alloc-seg" style="width:${gPct}%;background:var(--accent)" title="Goals: ${fmt(totalGoals)}"></div>
      <div class="alloc-seg" style="width:${bdgPct}%;background:var(--blue)" title="Budget: ${fmt(totalBudgetAlloc)}"></div>
      <div class="alloc-seg" style="width:${rPct}%;background:var(--green)" title="Remaining: ${fmt(remaining)}"></div>
    </div>
    <div class="flex gap12 fs12 mb12" style="flex-wrap:wrap">
      <span><span class="dot" style="background:var(--red)"></span>Bills ${fmt(committedBills)}</span>
      <span><span class="dot" style="background:#FFB547"></span>Subs due ${fmt(committedSubs)}</span>
      ${accrualSubsTotal>0?`<span><span class="dot" style="background:#fb923c"></span>Subs accruing ${fmt(accrualSubsTotal)}</span>`:''}
      ${totalGoals>0?`<span><span class="dot" style="background:var(--accent)"></span>Goals ${fmt(totalGoals)}</span>`:''}
      ${totalBudgetAlloc>0?`<span><span class="dot" style="background:var(--blue)"></span>Budget ${fmt(totalBudgetAlloc)}</span>`:''}
      <span><span class="dot" style="background:var(--green)"></span>Remaining ${fmt(remaining)}</span>
    </div>
    <div class="tbl-wrap fs12">
      <table>
        <thead><tr><th>Section</th><th>Source</th><th>This Period</th><th>% of Check</th></tr></thead>
        <tbody>
          ${committed>0?`<tr><td class="fw7">Bills &amp; Subs</td><td>${srcBadge('from Bills/Subs')}</td><td class="text-red fw7">${fmt(committed)}</td><td class="text-muted">${paycheck>0?pct(committed/paycheck*100):'—'}</td></tr>`:''}
          ${accrualSubsTotal>0?`<tr><td class="fw7">Subs accruing</td><td>${srcBadge('from Subscriptions')}</td><td style="color:#fb923c" class="fw7">${fmt(accrualSubsTotal)}</td><td class="text-muted">${paycheck>0?pct(accrualSubsTotal/paycheck*100):'—'}</td></tr>`:''}
          ${totalGoals>0?`<tr><td class="fw7">Goals</td><td>${srcBadge('from Goals')}</td><td class="text-accent fw7">${fmt(totalGoals)}</td><td class="text-muted">${paycheck>0?pct(totalGoals/paycheck*100):'—'}</td></tr>`:''}
          ${totalBudgetAlloc>0?`<tr><td class="fw7">Budget categories</td><td>${srcBadge('from Budget')}</td><td style="color:var(--blue)" class="fw7">${fmt(totalBudgetAlloc)}</td><td class="text-muted">${paycheck>0?pct(totalBudgetAlloc/paycheck*100):'—'}</td></tr>`:''}
          <tr style="border-top:2px solid var(--border)"><td class="fw7">Remaining</td><td>—</td><td class="${remaining>=0?'text-green':'text-red'} fw7">${fmt(remaining)}</td><td class="${remaining>=0?'text-green':'text-red'}">${paycheck>0?pct(Math.abs(remaining)/paycheck*100):'—'}</td></tr>
        </tbody>
      </table>
    </div>`:''}
    ${statusTxt?`<div class="payday-status ${statusCls} mt12">${statusTxt}</div>`:''}
  </div>
  ${dueCombined.length?`<div class="card mb16">
    <div class="flex-sb mb12"><div class="card-title">Due This Pay Period</div><span class="text-muted fs12">by ${payDateStr}</span></div>
    ${dueCombined.map(item=>{const d=daysUntil(item.date);const nearPay=Math.abs(daysUntil(payDateStr)-d)<=3;return`<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
      <div class="dot" style="background:${item.type==='bill'?'var(--red)':'#FFB547'}"></div>
      <div style="flex:1"><div class="fw7 fs13">${esc(item.name)} ${srcBadge('from '+(item.type==='bill'?'Bills':'Subs'))}</div><div class="text-muted fs12">${item.date} · ${d<=0?'Due today':d===1?'Tomorrow':d+' days'}${nearPay?' · ⚠ Near payday':''}</div></div>
      <div class="fw7 text-red">${fmt(item.amount)}</div>
    </div>`;}).join('')}
    <div class="flex-sb mt10 fw7 fs13"><span>Total committed</span><span class="text-red">${fmt(committed)}</span></div>
  </div>`:`<div class="card mb16"><div class="text-muted fs13">No bills or subscriptions due before your next paycheck.</div></div>`}
  ${accrualSubs.length?`<div class="card mb16">
    <div class="card-header mb4"><div class="card-title">Subscriptions — Accruing This Check</div><span class="text-muted fs12">not billing now, setting aside portion</span></div>
    ${accrualSubs.map(s=>`<div class="flex-sb fs13" style="padding:7px 0;border-bottom:1px solid var(--border)">
      <div><div class="fw7">${esc(s.name)} ${srcBadge('from Subscriptions')}</div><div class="text-muted fs12">${fmt(s.amount)}/${s.billingCycle||'mo'} · next ${s.nextBilling||'unknown'}</div></div>
      <span style="color:#fb923c" class="fw7">${fmt(s.perCheck)}<span class="text-muted fw4 fs11"> /check</span></span>
    </div>`).join('')}
    <div class="flex-sb mt10 fw7 fs13"><span>Total accruing</span><span style="color:#fb923c">${fmt(accrualSubsTotal)}</span></div>
  </div>`:''}
  ${goalContribs.length?`<div class="card mb16">
    <div class="card-header mb4"><div class="card-title">Goal Contributions</div><span class="text-muted fs12">after bills/subs: ${fmt(afterCommitted)}</span></div>
    ${goalContribs.map(g=>`<div class="flex-sb" style="padding:8px 0;border-bottom:1px solid var(--border)">
      <div><div class="fw7 fs13">${esc(g.name)} ${srcBadge('from Goals')}</div><div class="text-muted fs12">~${fmt(g.periodic)}/check · ${g.monthly?fmt(g.monthly)+'/mo':''} ${g.pctDone>0?`· ${g.pctDone}% done`:''}</div></div>
      <div class="text-right"><div class="text-accent fw7 fs13">${fmt(g.periodic)}</div>${!g.isOnTrack?'<div class="text-yellow fs11">Behind</div>':'<div class="text-green fs11">On track</div>'}</div>
    </div>`).join('')}
    <div class="flex-sb mt10 fw7 fs13"><span>After goals</span><span class="${afterGoals>=0?'text-green':'text-red'}">${fmt(afterGoals)}</span></div>
  </div>`:''}
  ${catAllocs.length?`<div class="card mb16">
    <div class="card-header mb4"><div class="card-title">Budget Allocations per Check</div><span class="text-muted fs12 cursor-pointer" onclick="openBudgetModal()" style="cursor:pointer">Edit budgets</span></div>
    <div class="text-muted fs12 mb10">Based on your monthly budget targets ÷ ${S.payScheduleConfig?.type||'pay frequency'}</div>
    ${catAllocs.map(c=>{const pchkPct=paycheck>0?((c.periodic/paycheck)*100).toFixed(1):null;return`<div class="flex-sb fs13" style="padding:6px 0;border-bottom:1px solid var(--border)">
      <span class="flex gap6"><span class="dot" style="background:${CAT_CLR[c.cat]}"></span>${c.cat} ${srcBadge('from Budget')}</span>
      <span class="fw7" style="color:var(--blue)">${fmt(c.periodic)}<span class="text-muted fw4"> /check${pchkPct?' ('+pchkPct+'%)':''}</span></span>
    </div>`;}).join('')}
    <div class="flex-sb mt10 fw7 fs13"><span>Total budget this check</span><span style="color:var(--blue)">${fmt(totalBudgetAlloc)}${paycheck>0?` <span class="text-muted fw4 fs12">(${((totalBudgetAlloc/paycheck)*100).toFixed(1)}% of check)</span>`:''}</span></div>
  </div>`:''}
  ${(()=>{
    const hasCCInBudget=catAllocs.some(c=>c.cat==='Credit Card Payments');
    const cardsWithBalance=(S.cards||[]).filter(c=>(c.balance||0)>0);
    if(hasCCInBudget||!cardsWithBalance.length) return '';
    const ccItems=cardsWithBalance.map(c=>{
      const minPay=Math.max(Math.round((c.balance||0)*0.02),25);
      const pchkPct=paycheck>0?((minPay/paycheck)*100).toFixed(1):null;
      return{name:c.name,balance:c.balance||0,apr:c.apr||0,minPay,pchkPct};
    });
    const totalMin=ccItems.reduce((a,c)=>a+c.minPay,0);
    const totalPct=paycheck>0?((totalMin/paycheck)*100).toFixed(1):null;
    return`<div class="card mb16" style="border-left:3px solid #378ADD">
      <div class="card-header mb4">
        <div class="card-title">💳 Card Payments Due This Period</div>
        <span class="text-muted fs12">estimated minimums · <span style="color:var(--accent);cursor:pointer" onclick="openBudgetModal()">set a budget →</span></span>
      </div>
      <div class="text-muted fs12 mb10">No card payment budget set — suggested minimums based on current balances (2% or $25 min).</div>
      ${ccItems.map(c=>`<div class="flex-sb fs13" style="padding:6px 0;border-bottom:1px solid var(--border)">
        <div><div class="fw7">${esc(c.name)}</div><div class="text-muted fs12">Balance: ${fmt(c.balance)}${c.apr?` · APR: ${c.apr}%`:''}</div></div>
        <span class="fw7" style="color:#378ADD">${fmt(c.minPay)}<span class="text-muted fw4 fs11"> min${c.pchkPct?' ('+c.pchkPct+'%)':''}</span></span>
      </div>`).join('')}
      <div class="flex-sb mt10 fw7 fs13"><span>Total suggested</span><span style="color:#378ADD">${fmt(totalMin)}${totalPct?` <span class="text-muted fw4 fs12">(${totalPct}% of check)</span>`:''}</span></div>
    </div>`;
  })()}
  ${(nextBills.length||nextSubs.length)?`<div class="card mb16" style="border-left:3px solid var(--border)">
    <div class="card-title mb10">Coming Next Period <span class="text-muted fw4 fs12">(${payDateStr} – ${nextPayStr})</span></div>
    ${[...nextBills.map(b=>({name:b.name,amount:b.amount,date:b.nextDue,type:'bill'})),...nextSubs.map(s=>({name:s.name,amount:s.amount,date:s.nextBilling,type:'sub'}))].sort((a,b)=>a.date.localeCompare(b.date)).map(item=>`<div class="flex-sb fs13" style="padding:6px 0;border-bottom:1px solid var(--border);opacity:.8">
      <span class="flex gap8"><span class="dot" style="background:${item.type==='bill'?'var(--red)':'#FFB547'}"></span>${esc(item.name)} <span class="text-muted fs11">${item.date}</span></span>
      <span class="text-muted fw7">${fmt(item.amount)}</span>
    </div>`).join('')}
    <div class="flex-sb mt8 fs12 text-muted"><span>Next period committed</span><span class="fw7">${fmt([...nextBills,...nextSubs].reduce((a,x)=>a+(x.amount||0),0))}</span></div>
  </div>`:''}`;
}
// ── PAYDAY WIDGET (home) ──────────────────────────────────────────────────────
function _paydayWidgetHTML(){
  const pdi=getNextPaydayInfo();
  if(!pdi)return`<div class="stat" style="cursor:pointer;border:1px dashed var(--border)" onclick="showPaydaySetup()"><div class="stat-label">Next Payday</div><div class="stat-value fs14 text-muted">Not set up</div><div class="stat-sub text-accent">Set up schedule →</div></div>`;
  const{earlyDate,daysAway,amount,scheduled,isDifferent}=pdi;
  const confirmed=S.paydayHistory.some(h=>h.date===earlyDate&&h.confirmed);
  const isNear=daysAway>=0&&daysAway<=2;const isSoon=daysAway>2&&daysAway<=7;
  const dl=daysAway===0?'Today!':daysAway===1?'Tomorrow':daysAway<0?'Overdue':`${daysAway} days`;
  const border=isNear?'border:1px solid var(--green)':isSoon?'border:1px solid #FFB547':'';
  return`<div class="stat" style="cursor:pointer;${border}" onclick="bSub='paycheck';go('budget')">
    <div class="stat-label">Next Payday${confirmed?' ✓':''}</div>
    <div class="stat-value ${isNear?'text-green':isSoon?'text-yellow':'text-accent'}">${dl}</div>
    <div class="stat-sub">${amount>0?'~'+fmt(amount)+' · ':''}${earlyDate}${isDifferent&&scheduled!==earlyDate?' *':''}</div>
    ${isNear||isSoon?`<div style="color:var(--accent);font-size:11px;margin-top:4px">Plan this paycheck →</div>`:''}
  </div>`;
}

// ── FEEDBACK ──────────────────────────────────────────────────────────────────
let _fbRating=0;
function setRating(n){
  _fbRating=n;
  document.querySelectorAll('#star-row .star').forEach((s,i)=>{
    s.classList.toggle('active',i<n);
    s.classList.remove('star-hover');
  });
}
function _initStars(){
  const stars=[...document.querySelectorAll('#star-row .star')];
  stars.forEach((s,i)=>{
    s.addEventListener('mouseenter',()=>stars.forEach((st,j)=>st.classList.toggle('star-hover',j<=i)));
    s.addEventListener('mouseleave',()=>stars.forEach(st=>st.classList.remove('star-hover')));
  });
}
function submitFeedback(){
  if(!_fbRating){ alert('Please select a rating.'); return; }
  const cat=$('f-fb-cat').value;
  const text=($('f-fb-text').value||'').trim();
  const profile=S.userProfile||'unknown';
  const subject=encodeURIComponent(`Anchor Feedback: ${cat} (${_fbRating}★)`);
  const body=encodeURIComponent(`Rating: ${_fbRating}/5\nCategory: ${cat}\nProfile: ${profile}\n\n${text}`);
  window.location.href=`mailto:anchor.feedback@gmail.com?subject=${subject}&body=${body}`;
  closeModal('m-feedback');
  S.lastFeedbackShown=Date.now(); save();
}
function checkFeedbackPrompt(){
  const SESSION_KEY='anch_sess_start';
  if(!sessionStorage.getItem(SESSION_KEY)) sessionStorage.setItem(SESSION_KEY,Date.now());
  const elapsed=Date.now()-parseInt(sessionStorage.getItem(SESSION_KEY)||'0');
  const lastShown=S.lastFeedbackShown||0;
  if(elapsed>10*60*1000&&Date.now()-lastShown>3*24*3600*1000){
    setTimeout(()=>{
      const toast=document.createElement('div');
      toast.style.cssText='position:fixed;bottom:80px;right:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 18px;font-size:13px;box-shadow:var(--shadow);z-index:400;animation:fadeIn .3s ease;max-width:280px';
      toast.innerHTML=`Enjoying Anchor? We'd love your feedback 🙏 <button onclick="openModal('m-feedback');this.parentNode.remove()" style="display:block;margin-top:8px;background:none;border:none;color:var(--accent);cursor:pointer;font-family:inherit;padding:0;font-size:13px">Give feedback →</button><button onclick="this.parentNode.remove()" style="position:absolute;top:8px;right:10px;background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px">✕</button>`;
      toast.style.position='fixed';
      document.body.appendChild(toast);
      S.lastFeedbackShown=Date.now(); save();
      setTimeout(()=>{ if(toast.parentNode) toast.remove(); },8000);
    },10*60*1000-elapsed);
  }
}

// ── HOME ──────────────────────────────────────────────────────────────────────
function renderHome(){
  const totalLim=S.cards.reduce((a,c)=>a+(c.limit||0),0);
  const totalBal=S.cards.reduce((a,c)=>a+(c.balance||0),0);
  const util=totalLim>0?(totalBal/totalLim)*100:0;
  const assets=S.assets.reduce((a,x)=>a+(x.value||0),0);
  const liabs=S.liabilities.reduce((a,x)=>a+(x.value||0),0);
  const nw=assets-liabs;
  const curMo=new Date().toISOString().slice(0,7);
  const expenses=S.transactions.filter(t=>t.amount<0&&!t.internalXfer&&(t.date||'').slice(0,7)===curMo);
  const spent=expenses.reduce((a,t)=>a+Math.abs(t.amount),0);
  const monthlyBudget=getMonthlyBudget();
  const bPct=monthlyBudget>0?Math.min(spent/monthlyBudget*100,100):0;
  const activeSubs=S.subs.filter(s=>!s.paused);
  const subBurn=activeSubs.reduce((a,s)=>a+toMonthly(s.amount,s.cycle),0);
  const activeBills=(S.bills||[]).filter(b=>!b.paused);
  const billBurn=activeBills.reduce((a,b)=>a+toMonthly(b.amount,b.cycle),0);
  const sortedCards=[...S.cards].sort((a,b)=>{const pa=a.limit>0?a.balance/a.limit:0,pb=b.limit>0?b.balance/b.limit:0;return pb-pa;});
  const totalMonthlyInt=S.cards.reduce((a,c)=>a+(c.apr&&c.balance?c.apr/100/12*c.balance:0),0);
  const ps=S.paySchedule||detectPaySchedule();
  const upcomingAll=[
    ...activeSubs.map(s=>({name:s.name,date:s.nextBilling,amount:s.amount,type:'sub'})),
    ...activeBills.map(b=>({name:b.name,date:b.nextDue,amount:b.amount,type:'bill'}))
  ].filter(x=>x.date).sort((a,b)=>daysUntil(a.date)-daysUntil(b.date)).slice(0,6);
  // Recent Transactions — filter noise, merge split paychecks
  const _sfSet=new Set();
  if(ps?.hasSplits)(ps.paychecks||[]).filter(pc=>pc.type==='split').forEach(pc=>(pc.splits||[]).forEach(s=>_sfSet.add(`${s.date}|${s.amount}`)));
  const _isVaultTx=t=>/vault/i.test(t.description||'');
  const _isSplitFrag=t=>t.incomeType==='Salary'&&_sfSet.has(`${normalizeDate(t.date)||t.date||''}|${t.amount}`);
  const _baseTx=[...S.transactions].filter(t=>!t.internalXfer&&!_isVaultTx(t)&&Math.abs(t.amount)>=1&&!_isSplitFrag(t))
    .sort((a,b)=>(normalizeDate(b.date)||b.date||'').localeCompare(normalizeDate(a.date)||a.date||''));
  const _mergedPcs=ps?.hasSplits?(ps.paychecks||[]).filter(pc=>pc.type==='split')
    .sort((a,b)=>b.payPeriodDate.localeCompare(a.payPeriodDate)).slice(0,3)
    .map(pc=>({_merged:true,description:`${ps.employer||'Paycheck'} (split)`,amount:pc.totalAmount,date:pc.payPeriodDate,category:'Income',incomeType:'Salary',_splits:pc.splits})):[];
  const recentTx=[..._mergedPcs,..._baseTx].sort((a,b)=>(b.date||'').localeCompare(a.date||'')).slice(0,5);
  const prevNW=S.nwHistory.length>=2?S.nwHistory[S.nwHistory.length-2].nw:null;
  const nwChange=prevNW!==null?nw-prevNW:null;
  const health=calcHealthScore();
  const topInsights=generateInsights();
  const priorityInsight=topInsights[0]||null;
  const invTotal=(S.investments||[]).reduce((a,x)=>a+(x.value||0),0);
  const invMoM=invTotal?calcInvestMoM():null;
  const paydayInfo=getNextPaydayInfo();

  // Paycheck Allocation — planning view (not spending tracker)
  // Period runs from TODAY through the next payday (what's left to cover with the upcoming
  // check), matching the "Full planner" view — not from the last payday, which double-counted
  // bills/subs already due earlier in the prior period. Total also respects a manually-entered
  // paycheck amount override instead of always using the auto-detected average.
  let paycheckAlloc=null;
  const _pcaAmt=paydayInfo?.amount||ps?.avgAmount||0;
  if(ps&&ps.lastPayday&&paydayInfo&&_pcaAmt>0){
    const _payFreqN={biweekly:2.17,weekly:4.33,'bi-weekly':2.17,'semi-monthly':2,semimonthly:2,monthly:1}[ps.cycle||'biweekly']||2.17;
    const _todayD=new Date();_todayD.setHours(12,0,0,0);
    const _perStart=_todayD.toISOString().split('T')[0];
    const _perEnd=paydayInfo.earlyDate||'';
    const _billsDue=(S.bills||[]).filter(b=>!b.paused&&b.nextDue&&b.nextDue>=_perStart&&(_perEnd?b.nextDue<=_perEnd:true)).reduce((a,b)=>a+(b.amount||0),0);
    const _subsDue=(S.subs||[]).filter(s=>!s.paused&&s.nextBilling&&s.nextBilling>=_perStart&&(_perEnd?s.nextBilling<=_perEnd:true)).reduce((a,s)=>a+(s.amount||0),0);
    const _goalCt=(S.goals||[]).filter(g=>!g.done&&g.target).reduce((sum,g)=>{
      const rem=Math.max(0,(g.target||0)-(g.current||0));let mo=g.monthly||0;
      if(!mo&&g.deadline){const ml=Math.max(1,Math.round((new Date(g.deadline)-_todayD)/2592000000));mo=rem/ml;}
      return sum+(mo>0?Math.round(mo/_payFreqN):0);
    },0);
    const _mbgt=getMonthlyBudget();
    const _estSpend=_mbgt>0?Math.round(_mbgt/_payFreqN):0;
    const _remaining=_pcaAmt-_billsDue-_subsDue-_goalCt-_estSpend;
    const _sfmt=d=>d?new Date(d+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'}):'?';
    paycheckAlloc={total:_pcaAmt,billsDue:_billsDue,subsDue:_subsDue,goalContribs:_goalCt,estSpending:_estSpend,hasBudget:_mbgt>0,remaining:_remaining,periodLabel:`${_sfmt(_perStart)} → ${_sfmt(_perEnd)}`};
  }

  const _homeIncomeNudge=(()=>{
    const cfg=AnchorDB.income.configuration;
    if(cfg.configuredManually) return '';
    const hasCards=S.cards.some(c=>c.balance>0);
    if(!hasCards) return '';
    const snoozed=AnchorDB.preferences.incomeQuizDismissedAt&&(Date.now()-AnchorDB.preferences.incomeQuizDismissedAt)<7*24*3600*1000;
    if(snoozed) return '';
    return `<div class="alert mb16" style="background:rgba(108,99,255,.08);border:1px solid rgba(108,99,255,.2);border-radius:var(--r);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <span class="fs13">💡 Add your income for accurate DTI calculations</span>
      <span style="color:var(--accent);cursor:pointer;font-size:13px;font-weight:600;text-decoration:underline" onclick="openIncomeQuiz()">Set up income →</span>
    </div>`;
  })();

  $('home-body').innerHTML=`
  ${_homeIncomeNudge}
  ${_paydayBannerHTML()}

  <!-- ROW 1: Hero -->
  <div class="card h-hero mb16" id="hero-el">
    <div>
      <div class="h-hero-label">Net Worth</div>
      <div class="h-hero-nw ${nw>=0?'text-green':'text-red'}">${fmt(nw)}</div>
      ${nwChange!==null?`<div class="h-hero-change ${nwChange>=0?'text-green':'text-red'}">${nwChange>=0?'▲':'▼'} ${fmt(Math.abs(nwChange))} vs prior entry</div>`:''}
      ${S.userProfile?`<div class="mt8"><span class="profile-badge">${(PROFILES[S.userProfile]||{}).icon||''} ${(PROFILES[S.userProfile]||{}).name||''}</span></div>`:''}
    </div>
    <div class="gauge-wrap" id="health-score-section">
      ${health.hasData===false?`
        ${gaugeHTML(null,'','')}
        <div class="gauge-tip">No data yet</div>
        <div style="font-size:11px;color:var(--text-sec);text-align:center;margin-top:4px;max-width:140px">Add accounts to calculate your financial health score</div>
        <button class="btn btn-ghost btn-sm mt8" onclick="showHealthBreakdown()">Get started →</button>
      `:`
        ${gaugeHTML(health.score,health.color,health.label)}
        <div class="gauge-tip">${health.breakdown.filter(b=>b.hasData&&b.score<b.max).sort((a,b)=>a.score/a.max-b.score/b.max)[0]?'Improve: '+health.breakdown.filter(b=>b.hasData&&b.score<b.max).sort((a,b)=>a.score/a.max-b.score/b.max)[0].label:''}</div>
        <div style="text-align:center;margin-top:4px">${_scoreReliabilityBadge(health.componentCount,health.totalComponents,health.breakdown)}</div>
        <button class="btn btn-secondary btn-sm mt8" onclick="showHealthBreakdown()">View breakdown</button>
        ${_shouldShowJourney()?`<div style="text-align:center;margin-top:8px;font-size:11px;line-height:1.5;color:var(--text-sec)">
          Score based on ${health.componentCount} of ${health.totalComponents} components.<br>
          <span style="color:var(--accent);cursor:pointer;font-weight:600" onclick="openScoreJourney()">Complete setup for a full picture →</span>
        </div>`:''}
      `}
    </div>
  </div>

  <!-- ROW 2: Quick Actions -->
  <div class="h-quick-grid mb16">
    ${paydayInfo?`<button class="h-quick-card" onclick="bSub='paycheck';go('budget')"><div class="h-quick-icon">💰</div><div class="h-quick-label">Plan Paycheck</div></button>`:`<button class="h-quick-card" onclick="showPaydaySetup()"><div class="h-quick-icon">📅</div><div class="h-quick-label">Set Up Payday</div></button>`}
    <button class="h-quick-card" onclick="openUploadModal('budget')"><div class="h-quick-icon">📂</div><div class="h-quick-label">Upload CSV</div></button>
    <button class="h-quick-card" onclick="go('cards');setTimeout(()=>openCardModal(),100)"><div class="h-quick-icon">💳</div><div class="h-quick-label">Add Card</div></button>
    <button class="h-quick-card" onclick="go('goals');setTimeout(()=>openGoalModal(),100)"><div class="h-quick-icon">🎯</div><div class="h-quick-label">Add Goal</div></button>
  </div>

  <!-- ROW 3: Primary Metrics -->
  <div class="h-metric-grid mb16">
    <div class="h-metric-card" style="cursor:pointer" onclick="go('cards')">
      <div class="h-hero-label">Credit Utilization</div>
      ${totalLim>0?`
        <div class="fw7 fs22 ${utilTxt(util)}">${pct(util)}</div>
        <div class="text-muted fs12 mt4">${fmt(totalBal)} of ${fmt(totalLim)}</div>
        <div class="h-metric-bar"><div class="h-metric-bar-fill ${utilCls(util)}" style="width:${Math.min(util,100)}%"></div></div>
      `:`<div class="fw7 fs22 text-muted">—</div><div class="text-muted fs12 mt4">No cards added</div>`}
    </div>
    <div class="h-metric-card" style="cursor:pointer" onclick="go('budget')">
      <div class="h-hero-label">Monthly Spending</div>
      <div class="fw7 fs22 ${bPct<80?'text-green':bPct<100?'text-yellow':'text-red'}">${fmt(spent)}</div>
      ${(()=>{const isPct=S.budgetMode==='percentage'&&S.budgetTargetPct;const inc=getMonthlyIncomeBase();const spentPct=inc.amount>0?((spent/inc.amount)*100).toFixed(1):null;if(isPct&&inc.amount>0)return`<div class="text-muted fs12 mt4">${S.budgetTargetPct}% income budgeted · ${spentPct}% used</div>`;return`<div class="text-muted fs12 mt4">${monthlyBudget?pct(bPct)+' of '+fmt(monthlyBudget)+' budget':'No budget set'}</div>`;})()}
      ${monthlyBudget?`<div class="h-metric-bar"><div class="h-metric-bar-fill" style="width:${bPct}%;background:${bPct<80?'var(--green)':bPct<100?'var(--yellow)':'var(--red)'}"></div></div>`:''}
    </div>
    <div class="h-metric-card" style="cursor:pointer" onclick="${paydayInfo?`bSub='paycheck';go('budget')`:`showPaydaySetup()`}">
      <div class="h-hero-label">Next Payday</div>
      ${paydayInfo?`
        <div class="fw7 fs22 text-accent">${paydayInfo.daysAway===0?'Today':paydayInfo.daysAway===1?'Tomorrow':paydayInfo.daysAway+' days'}</div>
        <div class="text-muted fs12 mt4">${paydayInfo.earlyDate}${paydayInfo.amount?` · ~${fmt(paydayInfo.amount)}`:''}${paydayInfo.isDifferent?' <span class="badge badge-purple" style="font-size:10px">Early</span>':''}</div>
      `:`<div class="fw7 fs22 text-muted">—</div><div class="text-muted fs12 mt4">Set up pay schedule →</div>`}
    </div>
  </div>

  <!-- ROW 4: Secondary Metrics -->
  <div class="h-metric-grid mb16">
    <div class="h-metric-card" style="cursor:pointer" onclick="go('bills')">
      <div class="h-hero-label">Bills &amp; Subs</div>
      <div class="fw7 fs22" style="color:var(--teal)">${fmt(billBurn+subBurn)}/mo</div>
      <div class="text-muted fs12 mt4">${activeBills.length} bill${activeBills.length!==1?'s':''} · ${activeSubs.length} sub${activeSubs.length!==1?'s':''}</div>
    </div>
    <div class="h-metric-card" style="cursor:pointer" onclick="go('invest')">
      <div class="h-hero-label">Portfolio Value</div>
      ${invTotal>0?`
        <div class="fw7 fs22 text-green">${fmt(invTotal)}</div>
        <div class="text-muted fs12 mt4">${invMoM?`<span class="${invMoM.change>=0?'text-green':'text-red'}">${invMoM.change>=0?'+':''}${fmt(invMoM.change)} MoM</span>`:'View portfolio →'}</div>
      `:`<div class="fw7 fs22 text-muted">—</div><div class="text-muted fs12 mt4">No investments tracked</div>`}
    </div>
    <div class="h-metric-card" style="cursor:pointer" onclick="go('cards')">
      <div class="h-hero-label">CC Interest/mo</div>
      ${totalMonthlyInt>0?`
        <div class="fw7 fs22 text-red">${fmt(Math.round(totalMonthlyInt))}</div>
        <div class="text-muted fs12 mt4">${fmt(Math.round(totalMonthlyInt*12))}/yr projected</div>
      `:`<div class="fw7 fs22 ${S.cards.length?'text-green':'text-muted'}">—</div><div class="text-muted fs12 mt4">${S.cards.length?'No interest owed':'Add a card to track'}</div>`}
    </div>
  </div>

  <!-- ROW 5: Priority Insight Banner -->
  ${priorityInsight?`<div class="card mb16 h-insight" style="border-left-color:${priorityInsight.priority<=1?'var(--red)':priorityInsight.priority<=2?'var(--yellow)':'var(--accent)'}">
    <div class="h-insight-left">
      <div class="h-insight-icon">${priorityInsight.icon||'💡'}</div>
      <div>
        <div class="h-insight-headline">${esc(priorityInsight.headline)}</div>
        ${priorityInsight.detail?`<div class="h-insight-detail">${esc(priorityInsight.detail)}</div>`:''}
      </div>
    </div>
    <span class="h-insight-action text-accent" onclick="${priorityInsight.actionFn||`go('insights')`}">${priorityInsight.action?priorityInsight.action+' →':'View →'}</span>
  </div>`:''}

  <!-- ROW 6: Upcoming Bills & Subs -->
  <div class="card mb16">
    <div class="flex-sb mb4">
      <div class="card-title">Upcoming Bills &amp; Subs</div>
      <div class="flex gap8">
        <span class="text-accent fs12" style="cursor:pointer" onclick="go('bills')">Bills →</span>
        <span class="text-accent fs12" style="cursor:pointer" onclick="go('subs')">Subs →</span>
      </div>
    </div>
    ${upcomingAll.length===0?`<div class="empty" style="padding:20px 0"><div class="empty-icon">📅</div><div>No upcoming bills or subscriptions.<br><span style="color:var(--accent);cursor:pointer" onclick="go('bills')">Add a bill →</span></div></div>`:
      `<div class="h-upcoming-grid">${upcomingAll.map(item=>{
        const d=daysUntil(item.date);
        const dStr=d<=0?'Today':d===1?'Tomorrow':d+' days';
        const color=item.type==='bill'?'var(--teal)':'var(--purple)';
        return `<div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px 12px">
          <div class="flex-sb mb4">
            <span class="fw7 fs12" style="display:flex;align-items:center;gap:5px"><span class="dot" style="background:${color}"></span>${esc(item.name)}</span>
            ${d<=3?'<span class="badge badge-red" style="font-size:10px">Soon</span>':d<=7?'<span class="badge badge-yellow" style="font-size:10px">7d</span>':''}
          </div>
          <div class="text-muted fs12">${dStr}</div>
          <div class="fw7 fs13 mt4">${fmt(item.amount)}</div>
        </div>`;
      }).join('')}</div>`}
  </div>

  <!-- ROW 7: Two-col: Credit Cards | Goals -->
  <div class="h-two-col mb16">
    <div class="card">
      <div class="flex-sb mb16">
        <div class="card-title">Credit Cards</div>
        <span class="text-accent fs12" style="cursor:pointer" onclick="go('cards')">View all →</span>
      </div>
      ${sortedCards.length===0?`<div class="empty" style="padding:20px 0"><div class="empty-icon">💳</div><div>No cards added yet.<br><span style="color:var(--accent);cursor:pointer" onclick="go('cards')">Add a card →</span></div></div>`:
        sortedCards.slice(0,4).map(c=>{
          const p=c.limit>0?(c.balance/c.limit)*100:0;
          return `<div class="mb10">
            <div class="flex-sb fs12 mb6"><span class="fw7">${esc(c.name)}</span><span class="${utilTxt(p)} fw7">${pct(p)}</span></div>
            <div class="bar-wrap"><div class="bar-fill ${utilCls(p)}" style="width:${Math.min(p,100)}%"></div></div>
            <div class="flex-sb fs11 text-muted mt4"><span>${fmt(c.balance||0)}</span><span>of ${fmt(c.limit||0)}</span></div>
          </div>`;
        }).join('')}
    </div>
    <div class="card">
      <div class="flex-sb mb16">
        <div class="card-title">Goals</div>
        <span class="text-accent fs12" style="cursor:pointer" onclick="go('goals')">View all →</span>
      </div>
      ${S.goals.length===0?`<div class="empty" style="padding:20px 0"><div class="empty-icon">🎯</div><div>No goals yet.<br><span style="color:var(--accent);cursor:pointer" onclick="go('goals')">Add a goal →</span></div></div>`:
        S.goals.slice(0,4).map(g=>{
          const p=g.target>0?Math.min(g.current/g.target*100,100):0;
          return `<div class="mb10">
            <div class="flex-sb fs12 mb6"><span class="fw7">${esc(g.name)}</span><span class="text-accent">${pct(p)}</span></div>
            <div class="bar-wrap"><div class="bar-fill bar-accent" style="width:${p}%"></div></div>
            <div class="fs11 text-muted mt4">${fmt(g.current||0)} / ${fmt(g.target||0)}</div>
          </div>`;
        }).join('')}
    </div>
  </div>

  <!-- ROW 8: Paycheck Allocation (conditional) -->
  ${paycheckAlloc?`<div class="card mb16" style="border-left:3px solid var(--accent)">
    <div class="flex-sb mb12">
      <div><div class="card-title">Paycheck Allocation</div><div class="text-muted fs12">Pay period: ${paycheckAlloc.periodLabel}</div></div>
      <div class="text-accent fw7 fs14">~${fmt(paycheckAlloc.total)}</div>
    </div>
    <div class="h-paycheck-grid">
      <div class="h-paycheck-cell">
        <div class="h-paycheck-val" style="color:${(paycheckAlloc.billsDue+paycheckAlloc.subsDue)>paycheckAlloc.total*0.5?'var(--red)':(paycheckAlloc.billsDue+paycheckAlloc.subsDue)>paycheckAlloc.total*0.3?'#f59e0b':'var(--text)'}">${fmt(paycheckAlloc.billsDue+paycheckAlloc.subsDue)}</div>
        <div class="h-paycheck-lbl">Bills &amp; Subs</div>
      </div>
      <div class="h-paycheck-cell">
        <div class="h-paycheck-val" style="color:var(--accent)">${paycheckAlloc.hasBudget?fmt(paycheckAlloc.estSpending):'—'}</div>
        <div class="h-paycheck-lbl">Est. Spending${!paycheckAlloc.hasBudget?`<br><span style="font-size:9px;color:var(--accent);cursor:pointer;font-weight:600" onclick="openBudgetModal()">Set budget →</span>`:''}</div>
      </div>
      <div class="h-paycheck-cell">
        <div class="h-paycheck-val ${paycheckAlloc.remaining>=0?'text-green':'text-red'}">${paycheckAlloc.remaining<0?'-':''}${fmt(Math.abs(paycheckAlloc.remaining))}</div>
        <div class="h-paycheck-lbl">${paycheckAlloc.remaining>=0?'Remaining':'Over-committed'}</div>
      </div>
    </div>
    <div class="flex-sb mt10" style="align-items:center">
      <span class="fs11 text-muted">${[paycheckAlloc.billsDue+paycheckAlloc.subsDue>0?`Bills/subs: ${fmt(paycheckAlloc.billsDue+paycheckAlloc.subsDue)}`:'',paycheckAlloc.goalContribs>0?`Goals: ${fmt(paycheckAlloc.goalContribs)}`:'',paycheckAlloc.hasBudget?`Spending: ${fmt(paycheckAlloc.estSpending)}`:''].filter(Boolean).join(' · ')}</span>
      <button class="btn btn-ghost btn-xs" onclick="bSub='paycheck';go('budget')" style="font-size:11px;flex-shrink:0">Full planner →</button>
    </div>
  </div>`:''}

  <!-- ROW 9: Recent Transactions -->
  <div class="card mb16">
    <div class="flex-sb mb16">
      <div class="card-title">Recent Transactions</div>
      <span class="text-accent fs12" style="cursor:pointer" onclick="go('budget')">View all →</span>
    </div>
    ${recentTx.length===0?`<div class="empty" style="padding:20px 0"><div class="empty-icon">📂</div><div>No transactions yet.<br><span style="color:var(--accent);cursor:pointer" onclick="openUploadModal('budget')">Upload a CSV →</span></div></div>`:
      recentTx.map(t=>{
        if(t._merged){
          const splits=(t._splits||[]);
          return `<div class="tx-feed-item">
            <div class="tx-cat-dot" style="background:#6366f122;color:#6366f1">💼</div>
            <div style="flex:1;min-width:0">
              <div class="flex-sb" style="gap:4px"><span class="fs13 fw7" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(t.description)}</span>${splits.length>1?`<span class="badge fs10" style="background:var(--surface3);color:var(--muted);flex-shrink:0">${splits.length} accts</span>`:''}</div>
              <div class="fs11 text-muted">${t.date} · ${splits.map(s=>`${esc(s.account||'?')}: +${fmt(s.amount)}`).join(' + ')}</div>
            </div>
            <div class="fs13 fw7 text-green">+${fmt(t.amount)}</div>
          </div>`;
        }
        const isIncome=t.amount>0&&t.incomeType;
        const clr=isIncome?'var(--green)':CAT_CLR[t.category]||'var(--muted)';
        const icon=isIncome?(CAT_ICON['Income']||'💰'):(CAT_ICON[t.category]||'•');
        const sub=isIncome?`Income · ${esc(t.account||'')}`:t.category||'';
        const amtClr=t.amount>0?'text-green':'text-red';
        return `<div class="tx-feed-item">
          <div class="tx-cat-dot" style="background:${clr}22;color:${clr}">${icon}</div>
          <div style="flex:1;min-width:0"><div class="fs13 fw7" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(t.description||'')}</div><div class="fs11 text-muted">${normalizeDate(t.date)||t.date||''} · ${sub}</div></div>
          <div class="fs13 fw7 ${amtClr}">${t.amount>=0?'+':''}${fmt(t.amount)}</div>
        </div>`;
      }).join('')}
  </div>
  ${(()=>{
    const dismissed=localStorage.getItem('anchor_pro_banner_dismissed');
    if(dismissed) return '';
    return `<div class="pro-banner" id="pro-home-banner">
      <span>✨ <strong>Anchor Pro</strong> is coming — direct bank &amp; brokerage connections, no more CSV uploads.</span>
      <span class="flex gap10 align-center flex-shrink-0">
        <span style="color:var(--accent);cursor:pointer;font-weight:600;white-space:nowrap" onclick="openWaitlist('pro')">Join the waitlist →</span>
        <button class="pro-banner-dismiss" onclick="localStorage.setItem('anchor_pro_banner_dismissed','1');const b=document.getElementById('pro-home-banner');if(b)b.remove()" title="Dismiss">×</button>
      </span>
    </div>`;
  })()}`;

  updateBellBadge();
}

function statCard(label,val,sub,cls,tab){
  return `<div class="stat" style="cursor:pointer" onclick="go('${tab}')">
    <div class="stat-label">${label}</div>
    <div class="stat-value ${cls}">${val}</div>
    <div class="stat-sub">${sub}</div>
  </div>`;
}

// ── CREDIT CARDS ──────────────────────────────────────────────────────────────
const CARD_TYPE_LBL={visa:'Visa',mastercard:'MC',amex:'Amex',discover:'Disc',store:'Store',other:'Other'};
const CARD_ISSUER_LBL={bofa:'BofA',chase:'Chase',citi:'Citi',capone:'Cap One',creditone:'Credit One',apple:'Apple',amazon:'Amazon',other:'Other'};

function openCardModal(id){
  editId=id||null;
  const c=id?S.cards.find(x=>x.id===id):null;
  $('m-card-title').textContent=id?'Edit Credit Card':'Add Credit Card';
  $('f-card-name').value=c?c.name:'';
  $('f-card-type').value=c&&c.cardType?c.cardType:'';
  $('f-card-issuer').value=c&&c.issuer?c.issuer:'';
  $('f-card-limit').value=c?c.limit:'';
  $('f-card-balance').value=c?c.balance:'';
  $('f-card-apr').value=c&&c.apr?c.apr:'';
  $('f-card-rewards').value=c&&c.rewards?c.rewards:'none';
  if(!id) renderCardChips(); else { const ch=$('card-chips'); if(ch) ch.innerHTML=''; }
  openModal('m-card');
}
function saveCard(){
  const name=$('f-card-name').value.trim();
  if(!name) return alert('Card name required.');
  const limit=parseFloat($('f-card-limit').value)||0;
  const balance=parseFloat($('f-card-balance').value)||0;
  const cardType=$('f-card-type').value;
  const issuer=$('f-card-issuer').value;
  const apr=parseFloat($('f-card-apr').value)||0;
  const rewards=$('f-card-rewards').value;
  if(editId){ const c=S.cards.find(x=>x.id===editId); if(c){ if(c.balance!==balance){c.balanceAsOf=_ccToday();c.needsBalance=false;} c.name=name;c.limit=limit;c.balance=balance;c.cardType=cardType;c.issuer=issuer;c.apr=apr;c.rewards=rewards;} }
  else S.cards.push({id:uid(),name,limit,balance,cardType,issuer,apr,rewards,balanceAsOf:_ccToday()});
  syncCardLiabilities();
  save(); closeModal('m-card'); renderCards(); showSaveToast('Card saved');
}
async function deleteCard(id){ if(!await appConfirm('Delete this card?',{danger:true,confirmText:'Delete'})) return; S.cards=S.cards.filter(x=>x.id!==id); syncCardLiabilities(); save(); renderCards() }

function renderCards(){
  _cardBalanceMigrate();
  const el=$('cards-body');
  if(!S.cards.length){
    el.innerHTML=`<div class="empty"><div class="empty-icon">💳</div><div>No credit cards added yet.<br>Click "+ Add Card" to get started, or "Upload Statement" to import a CSV.</div></div>`;
    return;
  }
  const totalLim=S.cards.reduce((a,c)=>a+(c.limit||0),0);
  const totalBal=S.cards.reduce((a,c)=>a+(c.balance||0),0);
  const overall=totalLim>0?(totalBal/totalLim)*100:0;
  const curYear=new Date().getFullYear().toString();
  const interestYTD=S.cards.reduce((tot,c)=>tot+(c.interestHistory||[]).filter(h=>h.date.startsWith(curYear)).reduce((a,h)=>a+h.amount,0),0);
  const highAprCards=S.cards.filter(c=>(c.apr||0)>20&&c.balance>0).sort((a,b)=>b.apr-a.apr);
  const sorted=[...S.cards].sort((a,b)=>{const pa=a.limit>0?a.balance/a.limit:0,pb=b.limit>0?b.balance/b.limit:0;return pb-pa;});
  const dti=calcDTIData();
  const dtiClr=dti.dtiPercent===null?'var(--muted)':dti.dtiPercent<15?'var(--green)':dti.dtiPercent<35?'var(--teal)':dti.dtiPercent<43?'#F97316':'var(--red)';
  const csh=(AnchorDB.creditScoreHistory||[]);
  const latestCS=csh.length?csh[csh.length-1]:null;
  const csR=latestCS?csRange(latestCS.score):null;
  const cs3moAgo=csh.length>=2?csh.slice().reverse().find(e=>{const d=new Date(latestCS.date)-new Date(e.date+'T00:00:00');return d>=60*86400000;})||null:null;
  const cs3moDiff=cs3moAgo?latestCS.score-cs3moAgo.score:null;
  // SVG sparkline helper
  function csSpark(entries){
    if(entries.length<2) return '';
    const scores=entries.map(e=>e.score);
    const mn=Math.min(...scores)-20,mx=Math.max(...scores)+20;
    const w=160,h=40;
    const pts=entries.map((e,i)=>{
      const x=Math.round(i/(entries.length-1)*w);
      const y=Math.round(h-(e.score-mn)/(mx-mn)*h);
      return x+','+y;
    }).join(' ');
    const lastR=csRange(entries[entries.length-1].score);
    return `<svg width="${w}" height="${h}" style="display:block;margin-top:8px;overflow:visible"><polyline points="${pts}" fill="none" stroke="${lastR.color}" stroke-width="2" stroke-linejoin="round"/>${entries.map((e,i)=>{const x=Math.round(i/(entries.length-1)*w);const y=Math.round(h-(e.score-mn)/(mx-mn)*h);const r=csRange(e.score);return i===entries.length-1?`<circle cx="${x}" cy="${y}" r="4" fill="${r.color}"/>`:'';}).join('')}</svg>`;
  }

  el.innerHTML=`
  ${highAprCards.length>0?`<div class="alert alert-warn" style="margin-bottom:16px">⚠ <strong>High APR ${highAprCards.length>1?'cards':'card'}:</strong> ${highAprCards.map(c=>`${esc(c.name)} (${c.apr}%)`).join(', ')} — minimize balances to reduce interest costs.</div>`:''}
  ${S.cards.filter(c=>c.needsBalance).map(c=>`<div class="alert alert-warn" style="margin-bottom:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap"><span style="flex:1;min-width:220px">⚠ <strong>${esc(c.name)} balance isn't confirmed.</strong> Imported statements show activity, not what you owe — enter the balance your bank shows today and Anchor will track from there.</span><button class="btn btn-primary btn-sm" onclick="promptCardBalance('${c.id}')">Confirm balance</button></div>`).join('')}

  <div class="${interestYTD?'g4':'g3'} mb16">
    <div class="stat"><div class="stat-label">Total Balance</div><div class="stat-value ${totalBal>0?'text-red':'text-green'}">${fmt(totalBal)}</div><div class="stat-sub">${S.cards.length} card${S.cards.length!==1?'s':''}${S.cards.some(c=>c.needsBalance)?' · unconfirmed':''}</div></div>
    <div class="stat"><div class="stat-label">Total Limit</div><div class="stat-value">${fmt(totalLim)}</div><div class="stat-sub">Available: ${fmt(totalLim-totalBal)}</div></div>
    <div class="stat"><div class="stat-label">Overall Utilization</div><div class="stat-value ${utilTxt(overall)}">${pct(overall)}</div><div class="stat-sub">${overall<30?'Good standing':overall<50?'Moderate – watch this':'High – reduce debt urgently'}</div><div class="bar-wrap mt8"><div class="bar-fill ${utilCls(overall)}" style="width:${Math.min(overall,100)}%"></div></div></div>
    ${interestYTD?`<div class="stat"><div class="stat-label">Interest Paid YTD</div><div class="stat-value text-red">${fmt(interestYTD)}</div><div class="stat-sub">${curYear} year to date</div></div>`:''}
  </div>

  <div class="g2 mb16">
    <!-- DTI Card -->
    <div class="card">
      <div class="stat-label mb10">DEBT-TO-INCOME RATIO</div>
      ${(()=>{
        const showDual=dti.netDTI&&dti.grossDTI;
        if(showDual){
          const nClr=dti.netDTI.dtiPercent<15?'var(--green)':dti.netDTI.dtiPercent<35?'var(--teal)':dti.netDTI.dtiPercent<43?'#F97316':'var(--red)';
          const gClr=dti.grossDTI.dtiPercent<15?'var(--green)':dti.grossDTI.dtiPercent<35?'var(--teal)':dti.grossDTI.dtiPercent<43?'#F97316':'var(--red)';
          const bracketLabel=b=>b==='excellent'?'Excellent':b==='healthy'?'Healthy':b==='concerning'?'Concerning':'Stress';
          return `<div class="g2 mb10" style="gap:10px">
            <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px">
              <div class="text-muted fs11 mb4">Take-home (net)</div>
              <div style="font-size:22px;font-weight:700;color:${nClr}">${dti.netDTI.dtiPercent.toFixed(1)}%</div>
              <div class="badge fs10 mt4" style="background:${nClr}22;color:${nClr}">${bracketLabel(dti.netDTI.bracket)}</div>
              <div class="text-muted fs11 mt6">${fmt(dti.netDTI.income)}/mo income</div>
            </div>
            <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px">
              <div class="text-muted fs11 mb4">Bank standard (gross)</div>
              <div style="font-size:22px;font-weight:700;color:${gClr}">${dti.grossDTI.dtiPercent.toFixed(1)}%</div>
              <div class="badge fs10 mt4" style="background:${gClr}22;color:${gClr}">${bracketLabel(dti.grossDTI.bracket)}</div>
              <div class="text-muted fs11 mt6">${fmt(dti.grossDTI.income)}/mo income</div>
            </div>
          </div>
          <div class="text-muted fs12 mb10">${fmt(dti.monthlyDebtPayments)}/mo total debt minimums</div>
          <div class="bar-wrap mb6" style="height:8px;border-radius:4px;position:relative">
            <div style="position:absolute;left:0;top:0;height:100%;width:${Math.min(dti.dtiPercent,100)}%;background:${dtiClr};border-radius:4px;transition:width .4s"></div>
            <div style="position:absolute;left:35%;top:-4px;height:16px;width:1px;background:var(--yellow);opacity:.6" title="35% threshold"></div>
            <div style="position:absolute;left:43%;top:-4px;height:16px;width:1px;background:var(--red);opacity:.6" title="43% stress threshold"></div>
          </div>
          <div class="text-muted fs11 mb8">Active basis (${dti.activeBasis==='gross'?'bank standard':'take-home'}): ${dti.dtiPercent.toFixed(1)}%</div>`;
        }
        if(dti.dtiPercent!==null){
          return `<div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px">
            <span style="font-size:28px;font-weight:700;color:${dtiClr}">${dti.dtiPercent.toFixed(1)}%</span>
            <span class="badge fs11" style="background:${dtiClr}22;color:${dtiClr};padding:2px 8px">${dti.bracket==='excellent'?'Excellent':dti.bracket==='healthy'?'Healthy':dti.bracket==='concerning'?'Concerning':'Above Stress Threshold'}</span>
            <span class="text-muted fs11">${dti.activeBasis==='gross'?'bank standard':'take-home'}</span>
          </div>
          <div class="text-muted fs12 mb10">${fmt(dti.monthlyDebtPayments)} monthly debt ÷ ${fmt(dti.monthlyIncome)} income</div>
          <div class="bar-wrap mb10" style="height:8px;border-radius:4px;position:relative">
            <div style="position:absolute;left:0;top:0;height:100%;width:${Math.min(dti.dtiPercent,100)}%;background:${dtiClr};border-radius:4px;transition:width .4s"></div>
            <div style="position:absolute;left:35%;top:-4px;height:16px;width:1px;background:var(--yellow);opacity:.6" title="35% threshold"></div>
            <div style="position:absolute;left:43%;top:-4px;height:16px;width:1px;background:var(--red);opacity:.6" title="43% stress threshold"></div>
          </div>`;
        }
        return `<div class="text-muted fs12 mb12">${!dti.monthlyIncome?'Upload a bank CSV with income to calculate DTI':'Debt data unavailable'}</div>`;
      })()}
      <div class="flex gap6 mb10" style="flex-wrap:wrap">
        <span class="badge fs10" style="background:rgba(0,212,170,.15);color:var(--green)">Under 35% healthy</span>
        <span class="badge fs10" style="background:rgba(249,115,22,.15);color:#F97316">35–43% concerning</span>
        <span class="badge fs10" style="background:rgba(255,77,109,.15);color:var(--red)">Over 43% stress</span>
      </div>
      <div class="text-muted fs11">DTI = total monthly minimums ÷ monthly income · <span style="color:var(--accent);cursor:pointer;text-decoration:underline" onclick="openIncomeConfig()">Configure income →</span></div>
    </div>
    <!-- Credit Score Card -->
    <div class="card">
      <div class="flex-sb mb10">
        <div class="stat-label">CREDIT SCORE</div>
        <span style="color:var(--accent);cursor:pointer;font-size:12px;text-decoration:underline" onclick="openCreditScoreModal()">+ Log score →</span>
      </div>
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px">
        <div style="width:56px;height:56px;border-radius:50%;border:5px solid ${csR?csR.color:'var(--border)'};display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <span style="font-size:14px;font-weight:500;color:${csR?csR.color:'var(--muted)'}">${latestCS?latestCS.score:'—'}</span>
        </div>
        <div>
          <div class="fw7 fs14" style="color:${csR?csR.color:'var(--muted)'}">${csR?csR.label:'No score logged'}</div>
          ${latestCS?`<div class="text-muted fs11">as of ${latestCS.date}${latestCS.note?` · ${esc(latestCS.note)}`:''}</div>`:'<div class="text-muted fs11">Log your score to track changes over time</div>'}
        </div>
      </div>
      <div class="g2 mb10" style="gap:8px">
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;text-align:center">
          <div class="fw7 fs13">${latestCS?latestCS.date:'—'}</div>
          <div class="text-muted fs11">Last logged</div>
        </div>
        <div style="background:var(--surface2);border-radius:var(--r-sm);padding:10px;text-align:center">
          <div class="fw7 fs13 ${cs3moDiff===null?'':cs3moDiff>=0?'text-green':'text-red'}">${cs3moDiff===null?'—':(cs3moDiff>=0?'+':'')+cs3moDiff+' pts'}</div>
          <div class="text-muted fs11">3-month change</div>
        </div>
      </div>
      ${csh.length>=3?csSpark(csh):''}
      ${csh.length?`<div class="mt8 fs11 text-muted">${csh.length} score entr${csh.length===1?'y':'ies'} · <span style="cursor:pointer;text-decoration:underline;color:var(--accent)" onclick="openCreditScoreModal()">Add new</span></div>`:''}
    </div>
  </div>

  ${(()=>{
    const insights=[];
    if(dti.dtiPercent!==null&&dti.dtiPercent>43&&dti.monthlyIncome){
      insights.push(`🎯 DTI of ${dti.dtiPercent.toFixed(1)}% is above the 43% stress threshold. Paying down card balances lowers your minimum payments and improves DTI simultaneously.`);
    }
    const highUtil=S.cards.filter(c=>c.limit>0&&(c.balance/c.limit)>0.3);
    if(highUtil.length){
      insights.push(`📊 ${highUtil.length} card${highUtil.length>1?'s have':' has'} utilization over 30% — paying these down could add 50–100 points to your credit score within 1–2 billing cycles.`);
    }
    if(highAprCards.length&&dti.dtiPercent!==null&&dti.dtiPercent>35){
      insights.push(`💡 You have ${highAprCards.length} high-APR card${highAprCards.length>1?'s':''}. Paying these down improves both DTI and reduces interest costs.`);
    }
    if(!insights.length) return '';
    return `<div class="card mb16" style="border-left:3px solid var(--accent)">
      <div class="fw6 fs13 mb8">Credit &amp; DTI Insights</div>
      ${insights.map(i=>`<div class="fs12 text-muted" style="padding:6px 0;border-bottom:1px solid var(--border)">${i}</div>`).join('')}
    </div>`;
  })()}

  <div class="card mb16">
    <div class="card-header"><div class="card-title">All Cards</div><span class="text-muted fs12">Sorted by utilization (highest first)</span></div>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Card</th><th>Balance</th><th>Limit</th><th>Available</th><th style="min-width:160px">Utilization</th><th>Actions</th></tr></thead>
        <tbody>
          ${sorted.map((c,i)=>{
            const p=c.limit>0?(c.balance/c.limit)*100:0;
            const meta=[c.issuer?CARD_ISSUER_LBL[c.issuer]||c.issuer:'',c.cardType?CARD_TYPE_LBL[c.cardType]||c.cardType:'',c.apr?c.apr+'% APR':'',c.rewards&&c.rewards!=='none'?c.rewards:''].filter(Boolean).join(' · ');
            const cardInt=(c.interestHistory||[]).filter(h=>h.date.startsWith(curYear)).reduce((a,h)=>a+h.amount,0);
            const monthlyEst=c.apr&&c.balance?c.apr/100/12*c.balance:0;
            const lastPmt=c.lastPayment;
            return `<tr>
              <td>
                <div class="fw7">${esc(c.name)}${(c.apr||0)>20?'<span class="badge badge-red" style="margin-left:6px;font-size:10px">⚠ High APR</span>':''}</div>
                ${meta?`<div class="fs11 text-muted">${meta}</div>`:''}
                ${monthlyEst>0?`<div class="fs11 text-red">~${fmt(monthlyEst)}/mo est. interest</div>`:''}
                ${cardInt>0?`<div class="fs11" style="color:#f59e0b">Interest YTD: ${fmt(cardInt)}</div>`:''}
                ${lastPmt?`<div class="fs11 text-muted">Last pmt: ${fmt(lastPmt.amount)} on ${lastPmt.date}</div>`:''}
                ${c.lastStatement?`<div class="fs11 text-muted">Statement thru: ${c.lastStatement}</div>`:''}
                ${c.balanceAsOf?`<div class="fs11 text-muted">Balance as of ${c.balanceAsOf}</div>`:''}
                ${i===0&&S.cards.length>1?'<div class="fs11 text-yellow">Highest utilization — pay first</div>':''}
              </td>
              <td class="${c.balance>0?'text-red':'text-green'} fw7">${fmt(c.balance)}</td>
              <td>${fmt(c.limit)}</td>
              <td class="text-green">${fmt(Math.max(0,c.limit-c.balance))}</td>
              <td>
                <div class="flex gap8">
                  <div style="flex:1"><div class="bar-wrap bar-wrap-md"><div class="bar-fill ${utilCls(p)}" style="width:${Math.min(p,100)}%"></div></div></div>
                  <span class="${utilTxt(p)} fw7" style="min-width:44px">${pct(p)}</span>
                </div>
              </td>
              <td><div class="flex gap6" style="flex-wrap:wrap">
                <button class="btn btn-ghost btn-xs" onclick="openCCUploadForCard('${c.id}')">Statement</button>
                <button class="btn btn-ghost btn-sm" onclick="openCardModal('${c.id}')">Edit</button>
                <button class="btn btn-danger btn-sm" onclick="deleteCardConfirm('${c.id}')">Delete</button>
              </div></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-title mb16">Paydown Priority &amp; Payoff Calculator</div>
    ${sorted.filter(c=>c.balance>0).length===0?'<div class="text-muted fs12">No cards with outstanding balances.</div>':
      sorted.filter(c=>c.balance>0).map((c,i)=>{
        const p=c.limit>0?(c.balance/c.limit)*100:0;
        const r=(c.apr||0)/100/12;
        const monthlyInt=r*c.balance;
        const minPmt=c.apr&&c.balance?Math.max(25,c.balance*0.01+monthlyInt):0;
        const annualInt=monthlyInt*12;
        return `<div style="padding:14px 0;${i>0?'border-top:1px solid var(--border)':''}">
          <div style="display:flex;align-items:center;gap:14px;margin-bottom:${c.apr&&c.balance?'12px':'0'}">
            <div style="width:30px;height:30px;border-radius:50%;background:${i===0?'var(--accent)':'var(--surface2)'};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;color:${i===0?'#fff':'var(--text)'}">${i+1}</div>
            <div style="flex:1">
              <div class="fw7 fs12">${esc(c.name)} ${(c.apr||0)>20?`<span class="badge badge-red fs10">⚠ ${c.apr}% APR</span>`:c.apr?`<span class="badge badge-muted fs10">${c.apr}% APR</span>`:''}</div>
              <div class="bar-wrap mt8"><div class="bar-fill ${utilCls(p)}" style="width:${Math.min(p,100)}%"></div></div>
            </div>
            <div style="text-align:right"><div class="${utilTxt(p)} fw7">${pct(p)}</div><div class="text-muted fs12">${fmt(c.balance)} owed</div></div>
          </div>
          ${c.apr&&c.balance?`<div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;margin-left:44px">
            <div class="g3 mb10 fs12 text-center" style="gap:8px">
              <div style="background:var(--bg);border-radius:var(--r-sm);padding:8px"><div class="text-muted fs11">Est. interest/mo</div><div class="fw7 text-red">${fmt(monthlyInt)}</div></div>
              <div style="background:var(--bg);border-radius:var(--r-sm);padding:8px"><div class="text-muted fs11">Interest/year</div><div class="fw7 text-red">${fmt(annualInt)}</div></div>
              <div style="background:var(--bg);border-radius:var(--r-sm);padding:8px"><div class="text-muted fs11">Min payment</div><div class="fw7">${fmt(Math.round(minPmt))}</div></div>
            </div>
            <div class="fw7 fs12 mb6">Payoff Calculator</div>
            <div class="flex gap8 mb8" style="align-items:center">
              <input type="number" id="payoff-input-${c.id}" class="form-input" style="flex:1;padding:6px 10px;font-size:12px" placeholder="Monthly payment" value="${Math.round(minPmt*2)}" min="1" oninput="calcPayoff('${c.id}',${c.balance},${c.apr})">
              <span class="text-muted fs12">/mo</span>
            </div>
            <div id="payoff-result-${c.id}" class="fs12"></div>
          </div>`:''}
        </div>`;
      }).join('')}
  </div>`;

  setTimeout(()=>{
    sorted.filter(c=>c.balance>0&&c.apr).forEach(c=>{
      const r=c.apr/100/12;
      const minPmt=Math.max(25,c.balance*0.01+r*c.balance);
      calcPayoff(c.id,c.balance,c.apr,Math.round(minPmt*2));
    });
  },150);
}

// ── CREDIT CARD CSV ────────────────────────────────────────────────────────────
function parseCCCSV(e, preCardId){
  const file=e.target.files[0]; if(!file) return;
  pendingCCFile=file;
  e.target.value='';
  // populate card selector
  const sel=$('f-cc-card-select');
  sel.innerHTML='<option value="_new">+ Create new card from this statement</option>';
  S.cards.forEach(c=>{sel.innerHTML+=`<option value="${c.id}">${esc(c.name)}</option>`;});
  if(preCardId) sel.value=preCardId;
  toggleNewCardName();
  openModal('m-cc-upload');
}

function toggleNewCardName(){
  const v=$('f-cc-card-select').value;
  $('f-cc-newname-wrap').style.display=v==='_new'?'':'none';
}

function openCCUploadForCard(cardId){
  openUploadModal('cc',cardId);
}

function doCCParse(){
  if(!pendingCCFile){closeModal('m-cc-upload');return;}
  const cardSel=$('f-cc-card-select').value;
  const newName=($('f-cc-newname').value||'').trim();
  const fmtOverride=$('f-cc-fmt').value;

  if(cardSel==='_new'&&!newName){alert('Please enter a name for the new card.');return;}
  if(cardSel!=='_new'&&!S.cards.find(c=>c.id===cardSel)){alert('Card not found.');return;}

  closeModal('m-cc-upload');
  Papa.parse(pendingCCFile,{
    skipEmptyLines:true,
    complete(res){
      const rows=res.data;
      // find header row
      let hdrIdx=-1;
      for(let i=0;i<Math.min(rows.length,10);i++){
        const r=rows[i].map(x=>(x||'').toLowerCase().trim());
        if(r.some(x=>/posted.date/i.test(x))||r.some(x=>x==='payee')){hdrIdx=i;break;}
        if(r.some(x=>x==='date')&&r.some(x=>x==='amount')){hdrIdx=i;break;}
      }
      if(hdrIdx<0){alert('Could not find header row in this CSV.');pendingCCFile=null;return;}
      const headers=rows[hdrIdx].map(x=>(x||'').trim());
      const dataRows=rows.slice(hdrIdx+1);
      const fmt=fmtOverride==='auto'?detectFormat(headers):fmtOverride;

      const objRows=dataRows.map(r=>{const o={};headers.forEach((h,i)=>o[h]=r[i]||'');return o;});
      const{dateKey,descKey,amtKey,confidence}=getRowFields(objRows,fmt);
      if(!dateKey||!amtKey){pendingCCFile=null;return alert(`Could not identify the Date/Amount columns for this file (detected format: ${fmt}). Try a specific format instead of Auto-detect.`);}

      const today=new Date().toISOString().slice(0,10);
      const pending=[];
      objRows.forEach(row=>{
        const rawDesc=(row[descKey]||'').trim();
        const rawDate=(row[dateKey]||'').trim();
        const rawAmt=(row[amtKey]||'').replace(/[$,]/g,'').trim();
        const amt=parseFloat(rawAmt);
        if(!rawDesc||isNaN(amt)) return;

        // BofA CC: negative = charge, positive = payment/credit
        const isInterest=/interest charged/i.test(rawDesc);
        const isPayment=!isInterest&&amt>0&&/payment from|online\/mobile recurring from|mobile payment|autopay|atm payment|online payment|payment[\s-]*thank/i.test(rawDesc);
        const isRefund=!isInterest&&amt>0&&!isPayment;   // merchant refund / statement credit: lowers the balance but is NOT a payment
        const isAdvance=!isInterest&&amt<0&&!isFeeDesc(rawDesc)&&/cash advance|balance transfer/i.test(rawDesc);   // money moved to another account, not spending
        const kind=isInterest?'interest':isPayment?'payment':isRefund?'refund':isAdvance?'advance':'charge';
        pending.push({date:rawDate||today,description:rawDesc,amount:amt,kind,ref:String(row['Reference Number']||'').trim(),category:kind==='charge'?autoCat(rawDesc):(kind==='interest'?'Interest':'Transfers'),include:true});
      });

      pendingCCFile=null;
      if(!pending.length) return alert('No valid charges, payments, or interest lines found in this file.');

      _csvPendingRows=pending;
      _csvPendingKind='cc';
      _csvPendingMeta={cardSel,newName,confidence};
      showCCPreview();
    },
    error(err){alert('Parse error: '+err.message);pendingCCFile=null;}
  });
}

// PREVIEW — credit card statement CSV
function _csvCCPreviewRows(rows){
  return rows.map((r,i)=>`<tr>
    <td class="text-muted" style="white-space:nowrap">${esc(r.date)}</td>
    <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(r.description)}">${esc(r.description)}</td>
    <td class="fw7 ${(r.kind==='charge'||r.kind==='advance'||r.kind==='interest')?'text-red':'text-green'}" style="white-space:nowrap">${(r.kind==='charge'||r.kind==='advance'||r.kind==='interest')?'-':'+'}${fmt(Math.abs(r.amount))}</td>
    <td class="text-muted fs11" style="white-space:nowrap;text-transform:capitalize">${r.kind}</td>
    <td style="text-align:center"><input type="checkbox" ${r.include?'checked':''} onchange="_csvPendingRows[${i}].include=this.checked"></td>
  </tr>`).join('');
}
function showCCPreview(){
  const body=$('csv-preview-body'), actions=$('csv-preview-actions');
  const rows=_csvPendingRows, meta=_csvPendingMeta;
  const charges=rows.filter(r=>r.kind==='charge'||r.kind==='advance'), payments=rows.filter(r=>r.kind==='payment'||r.kind==='refund'), interest=rows.filter(r=>r.kind==='interest');
  const chargeAmt=charges.reduce((a,r)=>a+Math.abs(r.amount),0);
  const paymentAmt=payments.reduce((a,r)=>a+r.amount,0);
  const interestAmt=interest.reduce((a,r)=>a+Math.abs(r.amount),0);
  const cardName=meta.cardSel==='_new'?(meta.newName||'New Card'):((S.cards.find(c=>c.id===meta.cardSel)||{}).name||'Card');
  const lowConf=meta.confidence!=null&&meta.confidence<0.6;
  const preview=rows.slice(0,10);
  body.innerHTML=`
    <div style="margin-bottom:14px">
      <div class="fw7 mb2" style="font-size:15px">${esc(cardName)} Statement</div>
      <div class="text-muted fs12">${rows.length} line${rows.length!==1?'s':''} extracted</div>
    </div>
    ${lowConf?`<div class="pdf-warning">Column detection confidence is low for this file — double-check Date/Amount look right below.</div>`:''}
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px">
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Charges</div><div class="stat-value text-red" style="font-size:18px">${fmt(chargeAmt)}</div><div class="stat-sub">${charges.length}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Payments &amp; credits</div><div class="stat-value text-green" style="font-size:18px">${fmt(paymentAmt)}</div><div class="stat-sub">${payments.length}</div></div>
      <div class="stat" style="padding:10px 12px"><div class="stat-label">Interest</div><div class="stat-value text-red" style="font-size:18px">${fmt(interestAmt)}</div><div class="stat-sub">${interest.length}</div></div>
    </div>
    <div class="fw7 mb8 fs13">Preview <span class="text-muted fw4 fs11">(first ${preview.length} of ${rows.length})</span></div>
    <div class="tbl-wrap" style="max-height:220px;overflow-y:auto;margin-bottom:8px;border:1px solid var(--border);border-radius:var(--r-sm)">
      <table class="pdf-preview-tbl">
        <thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Type</th><th style="text-align:center">Include</th></tr></thead>
        <tbody>${_csvCCPreviewRows(preview)}</tbody>
      </table>
    </div>
    ${rows.length>10?`<div class="text-muted fs12 mb6">+ ${rows.length-10} more will also be imported</div>`:''}`;
  actions.innerHTML=`<button class="btn btn-ghost" onclick="closeModal('m-csv-preview')">Cancel</button>
    <button class="btn btn-primary" onclick="importCCTransactions()">Import ${rows.filter(r=>r.include).length} Line${rows.filter(r=>r.include).length!==1?'s':''}</button>`;
  openModal('m-csv-preview');
}

// COMMIT — credit card statement CSV (creates the card here, not at parse time,
// so cancelling the preview never leaves a phantom card behind).
// Balance rule: a card's balance is a number you CONFIRMED as of a date (balanceAsOf).
// An import records every line, but only NEW lines dated AFTER that date move the balance —
// statements already inside the confirmed balance can never be counted twice, and re-importing
// the same file changes nothing. Interest and cash advances raise the balance; payments and refunds lower it.
async function importCCTransactions(){
  const meta=_csvPendingMeta;
  const toImport=_csvPendingRows.filter(r=>r.include);
  if(!toImport.length){closeModal('m-csv-preview');showSaveToast('No lines selected');return;}

  let targetCard=null;
  if(meta.cardSel==='_new'){
    targetCard={id:uid(),name:meta.newName,limit:0,balance:0,cardType:'',issuer:'',apr:0,rewards:'none',interestHistory:[],payments:[],lastStatement:'',lastPayment:null,balanceAsOf:'',needsBalance:true};
    S.cards.push(targetCard);
  } else {
    targetCard=S.cards.find(c=>c.id===meta.cardSel);
    if(!targetCard){alert('Card not found.');closeModal('m-csv-preview');return;}
  }

  const today=_ccToday();
  const asOf=targetCard.balanceAsOf||'';
  const stats={charges:0,chargeAmt:0,payments:0,paymentAmt:0,refunds:0,refundAmt:0,interest:0,interestAmt:0,cats:{},newTx:0,skipped:0,balanceDelta:0,beforeAnchor:0,noAnchor:!asOf,asOf};
  const cents=v=>Math.round(Math.abs(v)*100);
  const prior=S.transactions.filter(t=>t.account===targetCard.name);   // what existed BEFORE this import
  const seen={};
  // Duplicate = same bank reference number, or (no reference) same date+description+amount seen more
  // times in this file than already stored. Two genuine identical purchases on one day both survive.
  const isDupTx=(nd,desc,amt,ref)=>{
    if(ref&&prior.some(t=>t.ref===ref)) return true;
    const key=nd+'|'+desc+'|'+cents(amt);
    const have=prior.filter(t=>(normalizeDate(t.date)||t.date)===nd&&cents(t.amount)===cents(amt)&&(t.description===desc||t.desc===desc)).length;
    const n=seen[key]||0; seen[key]=n+1;
    return n<have;
  };
  let latestDate='';

  toImport.forEach(r=>{
    const rawDesc=r.description,amt=r.amount,kind=r.kind;
    const nd=normalizeDate(r.date)||r.date||today;
    if(nd&&(!latestDate||nd>latestDate)) latestDate=nd;
    const move=delta=>{ if(asOf&&nd>asOf) stats.balanceDelta+=delta; else if(asOf) stats.beforeAnchor++; };   // only lines after the confirmed date move the balance

    if(kind==='interest'){
      const absAmt=Math.abs(amt);
      if(!targetCard.interestHistory) targetCard.interestHistory=[];
      const already=targetCard.interestHistory.find(h=>(normalizeDate(h.date)||h.date)===nd&&Math.abs(h.amount-absAmt)<0.01);
      if(already){stats.skipped++;return;}
      targetCard.interestHistory.push({date:nd,amount:absAmt});
      stats.interest++; stats.interestAmt+=absAmt;
      move(absAmt);
      return;
    }
    if(kind==='payment'||kind==='refund'){
      if(isDupTx(nd,rawDesc,amt,r.ref)){stats.skipped++;return;}
      const tx={id:uid(),date:nd,description:rawDesc,amount:amt,category:'Transfers',account:targetCard.name,source:'cc-csv',isPayment:true};
      if(r.ref) tx.ref=r.ref;
      if(kind==='refund'){
        tx.isRefund=true; stats.refunds++; stats.refundAmt+=amt;      // a refund is not a payment: keep it out of payment history
      } else {
        stats.payments++; stats.paymentAmt+=amt;
        if(!targetCard.payments) targetCard.payments=[];
        targetCard.payments.push({date:nd,amount:amt});
        const lp=targetCard.lastPayment&&(normalizeDate(targetCard.lastPayment.date)||targetCard.lastPayment.date);
        if(!lp||nd>lp) targetCard.lastPayment={date:nd,amount:amt};
      }
      S.transactions.push(tx);
      move(-amt);
      return;
    }
    // charge or cash advance (negative in a BofA CC export)
    const chargeAmt=Math.abs(amt);
    if(isDupTx(nd,rawDesc,chargeAmt,r.ref)){stats.skipped++;return;}
    const adv=kind==='advance';
    stats.charges++; stats.chargeAmt+=chargeAmt;
    const cat=adv?'Transfers':autoCat(rawDesc);
    if(!adv) stats.cats[cat]=(stats.cats[cat]||0)+chargeAmt;
    const tx={id:uid(),date:nd,description:rawDesc,amount:-chargeAmt,category:cat,account:targetCard.name,source:'cc-csv'};
    if(adv) tx.internalXfer=true;      // cash advance to checking: debt goes up, but it is not spending
    if(r.ref) tx.ref=r.ref;
    S.transactions.push(tx);
    stats.newTx++;
    move(chargeAmt);
  });

  const lastSt=targetCard.lastStatement&&(normalizeDate(targetCard.lastStatement)||targetCard.lastStatement);
  if(latestDate&&(!lastSt||latestDate>lastSt)) targetCard.lastStatement=latestDate;
  if(asOf&&stats.balanceDelta!==0) targetCard.balance=Math.round((targetCard.balance+stats.balanceDelta)*100)/100;
  if(!asOf) targetCard.needsBalance=true;

  syncCardLiabilities();
  detectCrossAccountDuplicates();
  autoClassifyNeedsReview();
  DataStore.sync('cc-csv-upload');
  closeModal('m-csv-preview');
  if(!targetCard.balanceAsOf) await promptCardBalance(targetCard.id);
  stats.noAnchor=!targetCard.balanceAsOf;
  showStatementSummary(stats,targetCard.name);
}

// Ask for the balance the bank shows today and make it the anchor future imports build on.
async function promptCardBalance(id){
  const c=S.cards.find(x=>x.id===id); if(!c) return;
  const v=await appPrompt('Confirm card balance',{
    message:'Statements show activity, not what you owe. Enter the balance your bank shows for '+c.name+' right now and Anchor will track from there.',
    label:'Balance today',prefix:'$',inputmode:'decimal',value:'',placeholder:'0.00',confirmText:'Save balance',
    validate:function(x){const n=parseFloat(String(x).replace(/[$,\s]/g,''));return (isNaN(n)||n<0)?'Enter a number, like 3780.00':'';}
  });
  if(v===null||v===undefined) return;
  c.balance=Math.round(parseFloat(String(v).replace(/[$,\s]/g,''))*100)/100;
  c.balanceAsOf=_ccToday(); c.needsBalance=false;
  syncCardLiabilities(); save(); renderCards(); showSaveToast('Balance saved');
}
function _ccToday(){ return new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10); }
// One-time upgrade for cards saved before balanceAsOf existed, plus ISO dates on card-CSV rows
function _cardBalanceMigrate(){
  let ch=false;
  (S.cards||[]).forEach(c=>{
    if(c.balanceAsOf===undefined){
      const hasCsv=(S.transactions||[]).some(t=>t.account===c.name&&t.source==='cc-csv');
      if(hasCsv){c.balanceAsOf='';c.needsBalance=true;} else {c.balanceAsOf=_ccToday();}
      ch=true;
    }
  });
  if(!AnchorDB.ccDatesFixed){
    (S.transactions||[]).forEach(t=>{ if(t.source==='cc-csv'){const n=normalizeDate(t.date); if(n&&n!==t.date){t.date=n;ch=true;}} });
    (S.cards||[]).forEach(c=>{
      (c.interestHistory||[]).forEach(h=>{const n=normalizeDate(h.date); if(n&&n!==h.date){h.date=n;ch=true;}});
      (c.payments||[]).forEach(h=>{const n=normalizeDate(h.date); if(n&&n!==h.date){h.date=n;ch=true;}});
      if(c.lastPayment){const n=normalizeDate(c.lastPayment.date); if(n&&n!==c.lastPayment.date){c.lastPayment.date=n;ch=true;}}
      if(c.lastStatement){const n=normalizeDate(c.lastStatement); if(n&&n!==c.lastStatement){c.lastStatement=n;ch=true;}}
    });
    AnchorDB.ccDatesFixed=true; ch=true;
  }
  if(ch) save();
}

function showStatementSummary(stats,cardName){
  const top3=Object.entries(stats.cats).sort((a,b)=>b[1]-a[1]).slice(0,3);
  const net=stats.balanceDelta||0;
  $('m-statement-body').innerHTML=`
    <div class="fw7 mb10">Card: ${esc(cardName)}</div>
    <div class="g2 mb12" style="gap:8px">
      <div class="stat" style="padding:10px"><div class="stat-label">Charges</div><div class="stat-value text-red fs16">${fmt(stats.chargeAmt)}</div><div class="stat-sub">${stats.charges} transaction${stats.charges!==1?'s':''}</div></div>
      <div class="stat" style="padding:10px"><div class="stat-label">Payments</div><div class="stat-value text-green fs16">${fmt(stats.paymentAmt)}</div><div class="stat-sub">${stats.payments} payment${stats.payments!==1?'s':''}</div></div>
      ${stats.interestAmt>0?`<div class="stat" style="padding:10px"><div class="stat-label">Interest Charged</div><div class="stat-value text-red fs16">${fmt(stats.interestAmt)}</div><div class="stat-sub">${stats.interest} charge${stats.interest!==1?'s':''}</div></div>`:''}
      <div class="stat" style="padding:10px"><div class="stat-label">Net Balance Change</div><div class="stat-value ${net>0?'text-red':'text-green'} fs16">${net>0?'+':''}${fmt(net)}</div><div class="stat-sub">${stats.newTx} new tx imported</div></div>
    </div>
    ${stats.noAnchor?`<div class="alert alert-warn fs12 mb10">Balance not changed — enter your bank's balance on the Credit Cards page so Anchor can track from it.</div>`:(stats.beforeAnchor>0?`<div class="fs12 text-muted mb10">${stats.beforeAnchor} line${stats.beforeAnchor!==1?'s':''} dated on or before your balance date (${esc(stats.asOf)}) were recorded but not added to the balance — it already includes them.</div>`:'')}
    ${stats.refunds>0?`<div class="fs12 text-muted mb10">${stats.refunds} refund${stats.refunds!==1?'s':''} / credit${stats.refunds!==1?'s':''} (${fmt(stats.refundAmt)}) lowered the balance but are not counted as payments.</div>`:''}
    ${top3.length?`<div class="fw7 fs12 mb6">Top Spending Categories</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      ${top3.map(([cat,amt],i)=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:var(--surface2);border-radius:var(--r-sm)"><span class="fw7 fs12">${i+1}. ${cat}</span><span class="fw7 fs12 text-red">${fmt(amt)}</span></div>`).join('')}
    </div>`:''}
    ${stats.skipped>0?`<div class="fs12 text-muted mt10">${stats.skipped} duplicate transaction${stats.skipped!==1?'s':''} skipped.</div>`:''}`;
  openModal('m-statement-summary');
}

function calcPayoff(cardId, balance, apr, overrideM){
  const inpEl=$(`payoff-input-${cardId}`);
  const monthly=overrideM!=null?overrideM:(inpEl?parseFloat(inpEl.value)||0:0);
  const el=$(`payoff-result-${cardId}`);
  if(!el) return;
  if(!balance||!apr||monthly<=0){el.innerHTML='';return;}

  const r=apr/100/12;
  const minPmt=Math.max(25,balance*0.01+r*balance);

  function simulate(pmt){
    if(pmt<=r*balance) return{months:Infinity,totalInt:Infinity,totalPaid:Infinity};
    let bal=balance, months=0, totalInt=0;
    while(bal>0&&months<600){
      const int=bal*r; totalInt+=int; bal+=int-pmt; months++;
      if(bal<0) bal=0;
    }
    return{months,totalInt,totalPaid:pmt*months};
  }

  const custom=simulate(monthly);
  const min=simulate(minPmt);
  const savings=min.totalInt-custom.totalInt;
  const fmtMo=m=>m>=600?'500+ months':`${m} mo${m!==1?'s':''}`;

  el.innerHTML=`<div class="g2" style="gap:6px;font-size:11px">
    <div style="background:var(--bg);border-radius:var(--r-sm);padding:8px;text-align:center">
      <div class="text-muted">Min pmt (${fmt(Math.round(minPmt))})</div>
      <div class="fw7 text-red">${fmtMo(min.months)}</div>
      <div class="text-muted">${fmt(Math.round(min.totalInt))} interest</div>
    </div>
    <div style="background:var(--bg);border-radius:var(--r-sm);padding:8px;text-align:center">
      <div class="text-muted">Your pmt (${fmt(monthly)})</div>
      <div class="fw7 ${custom.months>=600?'text-red':'text-green'}">${fmtMo(custom.months)}</div>
      <div class="text-muted">${fmt(Math.round(custom.totalInt))} interest</div>
    </div>
  </div>
  ${savings>0&&custom.months<600?`<div class="mt6 text-green fw7 fs11 text-center">Save ${fmt(Math.round(savings))} in interest vs min payment</div>`:''}
  ${custom.months>=600?`<div class="mt6 text-red fw7 fs11 text-center">Payment too low — won't pay off the balance!</div>`:''}`;
}

// ── BUDGET ────────────────────────────────────────────────────────────────────
// ── SMART SUGGESTIONS ─────────────────────────────────────────────────────────
function _futureDate(months){ const d=new Date(); d.setMonth(d.getMonth()+months); return d.toISOString().split('T')[0]; }
function _renderChips(containerId,chips,activeProp,onClickFn,clearFn){
  const el=$(containerId); if(!el) return;
  el.innerHTML=`<div class="chip-section">
    <div class="chip-section-label">Quick select:</div>
    <div class="chip-group" id="${containerId}-inner">${chips.map((c,i)=>`<button type="button" class="chip${c[activeProp]?' active':''}" onclick="${onClickFn}(${i})">${c.label}</button>`).join('')}</div>
    <div class="chip-footer"><span class="chip-clear${chips.some(c=>c[activeProp])?' vis':''}" id="${containerId}-clear" onclick="${clearFn}()">Clear</span></div>
  </div>`;
}

