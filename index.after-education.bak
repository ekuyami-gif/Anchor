    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-bank');pendingFile=null">Cancel</button>
      <button class="btn btn-primary" onclick="doParse()">Import</button>
    </div>
  </div>
</div>

<!-- MODAL: Merchant memory manager -->
<div class="overlay" id="m-merchants">
  <div class="modal" style="max-width:540px">
    <div class="modal-title">Merchant Rules</div>
    <div class="text-muted fs12 mb16">Keywords that permanently auto-categorize matching transactions. Checked before built-in rules.</div>
    <div id="m-merchants-body"></div>
    <div class="divider"></div>
    <div style="font-size:13px;font-weight:600;margin-bottom:12px">Add New Rule</div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Keyword</label><input class="form-input" id="f-merch-kw" placeholder="e.g. wholefds" type="text"></div>
      <div class="form-group"><label class="form-label">Category</label>
        <select class="form-input" id="f-merch-cat">
          <option>Housing</option><option>Food</option><option>Transport</option>
          <option>Bills</option><option>Subscriptions</option><option>Shopping</option>
          <option>Medical</option><option>Entertainment</option>
          <option>Charity</option><option>Investments</option><option>Credit Card Payments</option>
          <option>Education</option><option>Fees</option><option>Transfers</option><option>Other</option>
        </select>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-merchants')">Close</button>
      <button class="btn btn-primary" onclick="addMerchantRule()">Add Rule</button>
    </div>
  </div>
</div>

<!-- MODAL: Data Summary -->
<div class="overlay" id="m-datasummary">
  <div class="modal" style="max-width:560px">
