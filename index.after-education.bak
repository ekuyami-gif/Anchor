    <p class="fs13 mb8">You typed <strong id="m-acct-match-typed"></strong>, which looks like an existing account:</p>
    <div style="background:var(--surface2);border-radius:var(--r);padding:14px;margin-bottom:14px">
      <div class="fw7 fs14" id="m-acct-match-existing"></div>
      <div class="text-muted fs12 mt4" id="m-acct-match-count"></div>
