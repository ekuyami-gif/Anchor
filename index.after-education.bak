<!-- MODAL: Card -->
<div class="overlay" id="m-card">
  <div class="modal" style="max-width:500px">
    <div class="modal-title" id="m-card-title">Add Credit Card</div>
    <div class="form-group"><label class="form-label">Card Name</label><input class="form-input" id="f-card-name" placeholder="e.g. Chase Sapphire" type="text"></div>
    <div id="card-chips"></div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Card Type</label>
        <select class="form-input" id="f-card-type">
          <option value="">Unknown</option><option value="visa">Visa</option><option value="mastercard">Mastercard</option>
          <option value="amex">Amex</option><option value="discover">Discover</option><option value="store">Store Card</option><option value="other">Other</option>
        </select>
      </div>
      <div class="form-group"><label class="form-label">Issuer</label>
        <select class="form-input" id="f-card-issuer">
          <option value="">Unknown</option><option value="bofa">Bank of America</option><option value="chase">Chase</option>
          <option value="citi">Citi</option><option value="capone">Capital One</option><option value="creditone">Credit One</option>
          <option value="apple">Apple</option><option value="amazon">Amazon</option><option value="other">Other</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Credit Limit ($)</label><input class="form-input" id="f-card-limit" placeholder="5000" type="number" min="0"></div>
      <div class="form-group"><label class="form-label">Current Balance ($)</label><input class="form-input" id="f-card-balance" placeholder="1200" type="number" min="0"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">APR (%)</label><input class="form-input" id="f-card-apr" placeholder="24.99" type="number" min="0" step="0.01"></div>
      <div class="form-group"><label class="form-label">Rewards</label>
        <select class="form-input" id="f-card-rewards">
          <option value="none">None</option><option value="cashback">Cash Back</option><option value="points">Points</option><option value="miles">Miles</option>
        </select>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('m-card')">Cancel</button>
      <button class="btn btn-primary" onclick="saveCard()">Save Card</button>
    </div>
  </div>
</div>

